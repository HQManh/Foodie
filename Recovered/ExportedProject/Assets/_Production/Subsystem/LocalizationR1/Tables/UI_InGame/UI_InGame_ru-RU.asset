MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: UI_InGame_ru-RU
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: ru-RU
  m_SharedData: {fileID: 11400000, guid: a34c71713b2ebf445aa5dfcbb87e843e, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 57797273182208
    m_Localized: Все сердца разбиты
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542336
    m_Localized: Как всегда хорошо
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542337
    m_Localized: Замороженные ингредиенты брать нельзя. Возьмите предмет рядом, чтобы разбить лёд.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542338
    m_Localized: Забрать
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542339
    m_Localized: Найдите ключ в очередях ингредиентов, чтобы открыть.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542340
    m_Localized: Взрыв вкуса
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542341
    m_Localized: Набор еды
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542342
    m_Localized: БЕСПЛАТНО
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542343
    m_Localized: Замороженный предмет
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542344
    m_Localized: Понятно!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542345
    m_Localized: ТРУДНЫЙ ДЕНЬ!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542346
    m_Localized: Привет, приятно познакомиться
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542347
    m_Localized: Скрытый предмет
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542348
    m_Localized: Скрытые предметы раскрываются, только когда доходят до верхнего ряда.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542349
    m_Localized: Удерживайте, чтобы увидеть карту
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542350
    m_Localized: Удерживайте для просмотра
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542351
    m_Localized: ДОМОЙ
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542352
    m_Localized: Ледяной блок
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542353
    m_Localized: Ингредиенты закончились!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542354
    m_Localized: Выйти
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542355
    m_Localized: Открываемся!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542356
    m_Localized: Связанные предметы
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542357
    m_Localized: Замок и ключ
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542358
    m_Localized: Музыка
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542359
    m_Localized: Новый бустер
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542360
    m_Localized: Новый ингредиент
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542361
    m_Localized: ОК
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542362
    m_Localized: Ой?!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542363
    m_Localized: Нет ходов
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542364
    m_Localized: Терпение кончилось
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542365
    m_Localized: Нет мест
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542366
    m_Localized: Пауза
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542367
    m_Localized: Идеально
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542368
    m_Localized: Берите связанные ячейки вместе, когда все они окажутся впереди.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542369
    m_Localized: Выйти из дня?
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542370
    m_Localized: ЕЩЁ РАЗ
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542371
    m_Localized: Обслужите нескольких посетителей, чтобы разбить ледяной блок на столе.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542372
    m_Localized: Что-то пошло не так. Попробуйте ещё раз!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542373
    m_Localized: Звук
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542374
    m_Localized: ОЧЕНЬ ТРУДНЫЙ ДЕНЬ!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542375
    m_Localized: Нажмите, чтобы продолжить
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542376
    m_Localized: Нажмите, чтобы играть
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542377
    m_Localized: Вкус растёт
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542378
    m_Localized: Эти блюда двигаются и берутся вместе, как один блок.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542379
    m_Localized: Щипцы
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542380
    m_Localized: Вибрация
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542381
    m_Localized: СМОТРЕТЬ
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542382
    m_Localized: Вы потеряете 1 сердце!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542383
    m_Localized: ПОЯВИЛСЯ БОСС!
    m_Metadata:
      m_Items: []
  - m_Id: 791119221743616
    m_Localized: ПОЯВИЛСЯ БОСС
    m_Metadata:
      m_Items: []
  - m_Id: 791119234326528
    m_Localized: Нет мест!
    m_Metadata:
      m_Items: []
  - m_Id: 5836114773401600
    m_Localized: Замёрзшая клетка
    m_Metadata:
      m_Items: []
  - m_Id: 5836114806956032
    m_Localized: Новинка
    m_Metadata:
      m_Items: []
  - m_Id: 5838819617136640
    m_Localized: Новый ресторан
    m_Metadata:
      m_Items: []
  - m_Id: 5838819617136641
    m_Localized: Скоро откроется новый ресторан!
    m_Metadata:
      m_Items: []
  - m_Id: 7340303286525952
    m_Localized: Отлично!
    m_Metadata:
      m_Items: []
  - m_Id: 7340303307497472
    m_Localized: Не вышло!
    m_Metadata:
      m_Items: []
  - m_Id: 7542428218155008
    m_Localized: Мастерски!
    m_Metadata:
      m_Items: []
  - m_Id: 7542428239126528
    m_Localized: Легендарно!
    m_Metadata:
      m_Items: []
  - m_Id: 7542428243320832
    m_Localized: Тяжеловато!
    m_Metadata:
      m_Items: []
  - m_Id: 7542428243320833
    m_Localized: Кухонный хаос!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
