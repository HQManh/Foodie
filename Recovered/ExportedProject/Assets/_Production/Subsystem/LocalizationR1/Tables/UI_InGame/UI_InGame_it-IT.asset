  m_TableData:
  - m_Id: 57797273182208
    m_Localized: Tutti i cuori spezzati
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542336
    m_Localized: Buono come sempre
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542337
    m_Localized: Gli ingredienti congelati non si possono prendere. Prendi un oggetto vicino per rompere il ghiaccio.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542338
    m_Localized: Riscatta
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542339
    m_Localized: Trova la chiave nelle file di ingredienti per sbloccare.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542340
    m_Localized: Esplosione di sapore
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542341
    m_Localized: Pacchetto di cibo
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542342
    m_Localized: GRATIS
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542343
    m_Localized: Oggetto congelato
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542344
    m_Localized: Capito!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542345
    m_Localized: GIORNATA DIFFICILE!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542346
    m_Localized: Ciao, piacere di conoscerti
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542347
    m_Localized: Oggetto nascosto
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542348
    m_Localized: Gli oggetti nascosti si rivelano solo quando raggiungono la fila in alto.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542349
    m_Localized: Tieni premuto per vedere la mappa
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542350
    m_Localized: Tieni premuto per vedere
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542351
    m_Localized: HOME
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542352
    m_Localized: Blocco di ghiaccio
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542353
    m_Localized: Ingredienti esauriti!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542354
    m_Localized: Esci
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542355
    m_Localized: Apriamo bottega!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542356
    m_Localized: Oggetti collegati
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542357
    m_Localized: Lucchetto e chiave
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542358
    m_Localized: Musica
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542359
    m_Localized: Nuovo potenziamento
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542360
    m_Localized: Nuovo ingrediente
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542361
    m_Localized: OK
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542362
    m_Localized: Ops?!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542363
    m_Localized: Mosse esaurite
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542364
    m_Localized: Pazienza esaurita
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542365
    m_Localized: Spazi esauriti
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542366
    m_Localized: In pausa
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542367
    m_Localized: Perfetto
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542368
    m_Localized: Prendi insieme gli spazi collegati quando sono tutti arrivati davanti.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542369
    m_Localized: Abbandonare la giornata?
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542370
    m_Localized: RIPROVA
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542371
    m_Localized: Servi un certo numero di clienti per rompere il blocco di ghiaccio sul tavolo.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542372
    m_Localized: Qualcosa è andato storto. Riprova!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542373
    m_Localized: Suoni
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542374
    m_Localized: GIORNATA DIFFICILISSIMA!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542375
    m_Localized: Tocca per continuare
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542376
    m_Localized: Tocca per giocare
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542377
    m_Localized: Il sapore cresce
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542378
    m_Localized: Questi cibi si muovono e si prendono insieme come un unico blocco.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542379
    m_Localized: Pinza
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542380
    m_Localized: Vibrazione
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542381
    m_Localized: GUARDA
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542382
    m_Localized: Perderai 1 cuore!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542383
    m_Localized: ARRIVA IL BOSS!
    m_Metadata:
      m_Items: []
