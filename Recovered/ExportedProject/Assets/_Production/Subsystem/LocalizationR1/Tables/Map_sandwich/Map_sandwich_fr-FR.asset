  m_TableData:
  - m_Id: 47151316996
    m_Localized: Sandwich salé
    m_Metadata:
      m_Items: []
  - m_Id: 47134539776
    m_Localized: Du pain grillé garni de tout ce que le grill a bien voulu céder.
    m_Metadata:
      m_Items: []
  - m_Id: 47151316997
    m_Localized: Sandwich aux fruits
    m_Metadata:
      m_Items: []
  - m_Id: 47151316992
    m_Localized: Du pain moelleux, un nuage de crème et des fruits éclatants à l'intérieur.
    m_Metadata:
      m_Items: []
  - m_Id: 47151316998
    m_Localized: Salade
    m_Metadata:
      m_Items: []
  - m_Id: 47151316993
    m_Localized: Un bol de verdure croquante avec une touche de mayo.
    m_Metadata:
      m_Items: []
  - m_Id: 47151316999
    m_Localized: Jus frais
    m_Metadata:
      m_Items: []
  - m_Id: 47151316994
    m_Localized: Pressé à la demande, glaçons en option.
    m_Metadata:
      m_Items: []
  - m_Id: 47151317000
    m_Localized: Soupe
    m_Metadata:
      m_Items: []
  - m_Id: 47151316995
    m_Localized: Un bol chaud et onctueux avec une petite surprise sur le dessus.
    m_Metadata:
      m_Items: []
  - m_Id: 881833574129664
    m_Localized: Une tranche de bacon cru qui attend la poêle.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295488
    m_Localized: Un œuf bien ferme prêt pour les sandwichs.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295489
    m_Localized: Fait griller le pain, chaud et doré.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295490
    m_Localized: Du pain moelleux coupé en triangles.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295491
    m_Localized: Une tranche de fromage doré et fondant.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295492
    m_Localized: Du poulet cru qui attend sa panure.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295493
    m_Localized: Grillé jusqu'à être doré et croquant.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295494
    m_Localized: Un concombre frais et croquant.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295495
    m_Localized: Des rondelles fraîches et croquantes.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295496
    m_Localized: Tranche et coupe en dés toutes les garnitures.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295497
    m_Localized: Un œuf frais prêt pour le petit-déjeuner.
    m_Metadata:
      m_Items: []
