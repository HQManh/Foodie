  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: Map_sandwich_hu
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: hu
  m_SharedData: {fileID: 11400000, guid: f98ead670a214fa419c82916a68f9bfa, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 47151316996
    m_Localized: Sós szendvics
    m_Metadata:
      m_Items: []
  - m_Id: 47134539776
    m_Localized: Pirított kenyér, megpakolva mindennel, amit a grill nélkülözni tudott.
    m_Metadata:
      m_Items: []
  - m_Id: 47151316997
    m_Localized: Gyümölcsös szendvics
    m_Metadata:
      m_Items: []
  - m_Id: 47151316992
    m_Localized: Puha kenyér, benne egy felhőnyi tejszín és élénk gyümölcsök.
    m_Metadata:
      m_Items: []
  - m_Id: 47151316998
    m_Localized: Saláta
    m_Metadata:
      m_Items: []
  - m_Id: 47151316993
    m_Localized: Egy tál ropogós zöldség egy csepp majonézzel.
    m_Metadata:
      m_Items: []
  - m_Id: 47151316999
    m_Localized: Friss gyümölcslé
    m_Metadata:
      m_Items: []
  - m_Id: 47151316994
    m_Localized: Rendelésre facsarva, jég igény szerint.
    m_Metadata:
      m_Items: []
  - m_Id: 47151317000
    m_Localized: Leves
    m_Metadata:
      m_Items: []
  - m_Id: 47151316995
    m_Localized: Egy tál meleg, krémes finomság, a tetején valami extrával.
    m_Metadata:
      m_Items: []
  - m_Id: 881833574129664
    m_Localized: Nyers baconcsík, ami a serpenyőre vár.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295488
    m_Localized: Kemény tojás a szendvicsekhez.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295489
    m_Localized: Melegre és aranyosra pirítja a kenyeret.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295490
    m_Localized: Puha kenyér takaros háromszögekre vágva.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295491
    m_Localized: Olvadós, aranyló sajtszelet.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295492
    m_Localized: Nyers csirke, ami ropogós bundára vár.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295493
    m_Localized: Aranyosra és ropogósra sütve.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295494
    m_Localized: Hűs, ropogós zöld uborka.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295495
    m_Localized: Friss zöld karikák ropogós falatokhoz.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295496
    m_Localized: Minden tölteléket felszel és felkockáz.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295497
    m_Localized: Friss tojás reggeli tervekkel.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295498
    m_Localized: Tejszín és gyümölcs a vendég választása szerint.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295499
    m_Localized: A vendég kedvenc gyümölcséből préselve.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295500
    m_Localized: Rendelésre kevert friss tál.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295501
    m_Localized: A vendég kedvenc feltéteivel rakva.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295502
    m_Localized: Egy tál meleg leves a kedvenc ízzel.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295503
    m_Localized: Kívül aranyló és ropogós, belül szaftos.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295504
    m_Localized: Tükörtojás, rétegezésre készen.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295505
    m_Localized: Tojást, bacont és csirkét süt.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295506
    m_Localized: Egy fürt édes lila szőlő.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295507
    m_Localized: Édes lila lé, frissen préselve.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295508
    m_Localized: Egy vékony szelet ízletes sonka.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295509
    m_Localized: Csilingelő kockák a hideg italokhoz.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295510
    m_Localized: Friss levet présel a gyümölcsből.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295511
    m_Localized: Szőrös gyümölcs élénkzöld belsővel.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295512
    m_Localized: Savanykás zöld lé, tele frissességgel.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295513
    m_Localized: Zöld kivikarikák apró magokkal.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295514
    m_Localized: Egy fej friss, ropogós saláta.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295515
    m_Localized: Ropogós zöld csíkok minden rétegbe.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489792
    m_Localized: Aranyló trópusi gyümölcs, tele napfénnyel.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489793
    m_Localized: Sűrű, aranyló lé trópusi ízzel.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489794
    m_Localized: Érett mangó lédús, aranyló szeletei.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489795
    m_Localized: Krémes szósz, ami mindent összetart.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489796
    m_Localized: Friss, hideg tej a krémes italokhoz.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489797
    m_Localized: Dundi gomba az erdőből.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489798
    m_Localized: Apró gombakockák a fazékba.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489799
    m_Localized: Krémes és földízű, gőzölögve tálalva.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489800
    m_Localized: Friss zöld ág a fogás befejezéséhez.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489801
    m_Localized: Addig rotyogtatja a levest, míg meleg és laktató.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489802
    m_Localized: Kerek narancssárga tök, belül édes.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489803
    m_Localized: Narancssárga kockák rotyogtatásra.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489804
    m_Localized: Selymes, édes és melengető.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489805
    m_Localized: Puha fehér szeletek bármilyen szendvicshez.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489806
    m_Localized: Édes piros bogyó levélkalappal.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489807
    m_Localized: Édes rózsaszín lé, frissen préselve.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489808
    m_Localized: Lédús piros szeletek az édes szendvicsekhez.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489809
    m_Localized: Aranyló szemek édes roppanással.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489810
    m_Localized: Meleg, aranyló és ropogós.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489811
    m_Localized: Érett piros paradicsom, lédús és élénk.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489812
    m_Localized: Lédús piros kockák rotyogtatásra.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489813
    m_Localized: Lédús piros karikák minden szendvicsbe.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489814
    m_Localized: Sűrű piros leves, meleg és megnyugtató.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489815
    m_Localized: Egy pihe-puha adag édes tejszínhab.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489816
    m_Localized: Baconcsík
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489817
    m_Localized: Főtt tojás
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489818
    m_Localized: Kenyérpirító
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489819
    m_Localized: Kenyérháromszög
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489820
    m_Localized: Sajtszelet
    m_Metadata:
      m_Items: []
