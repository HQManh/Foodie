  m_Name: Map_sandwich_vi-VN
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: vi-VN
  m_SharedData: {fileID: 11400000, guid: f98ead670a214fa419c82916a68f9bfa, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 47151316996
    m_Localized: Sandwich mặn
    m_Metadata:
      m_Items: []
  - m_Id: 47134539776
    m_Localized: Bánh mì nướng kẹp đầy mọi thứ vỉ nướng còn dư.
    m_Metadata:
      m_Items: []
  - m_Id: 47151316997
    m_Localized: Sandwich trái cây
    m_Metadata:
      m_Items: []
  - m_Id: 47151316992
    m_Localized: Bánh mì mềm, kẹp đám mây kem và trái cây tươi sắc.
    m_Metadata:
      m_Items: []
  - m_Id: 47151316998
    m_Localized: Salad
    m_Metadata:
      m_Items: []
  - m_Id: 47151316993
    m_Localized: Một bát rau giòn tươi điểm chút sốt mayonnaise.
    m_Metadata:
      m_Items: []
  - m_Id: 47151316999
    m_Localized: Nước ép tươi
    m_Metadata:
      m_Items: []
  - m_Id: 47151316994
    m_Localized: Ép tươi theo yêu cầu, đá tùy chọn.
    m_Metadata:
      m_Items: []
  - m_Id: 47151317000
    m_Localized: Súp
    m_Metadata:
      m_Items: []
  - m_Id: 47151316995
    m_Localized: Một bát súp kem ấm nóng có chút topping bên trên.
    m_Metadata:
      m_Items: []
  - m_Id: 881833574129664
    m_Localized: Thịt xông khói sống chờ lên chảo.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295488
    m_Localized: Trứng luộc chín vừa để kẹp bánh mì.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295489
    m_Localized: Nướng bánh mì vàng ấm.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295490
    m_Localized: Bánh mì mềm cắt tam giác ngay ngắn.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295491
    m_Localized: Lát phô mai vàng béo tan chảy.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295492
    m_Localized: Thịt gà sống chờ lớp áo giòn.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295493
    m_Localized: Chiên vàng giòn rụm.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295494
    m_Localized: Quả dưa leo mát lạnh giòn tan.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295495
    m_Localized: Lát dưa leo tươi giòn.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295496
    m_Localized: Thái lát, thái hạt lựu mọi loại nhân.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295497
    m_Localized: Quả trứng tươi sẵn sàng cho bữa sáng.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295498
    m_Localized: Kem và trái cây theo ý khách.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295499
    m_Localized: Ép từ loại trái cây khách yêu thích.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295500
    m_Localized: Tô salad tươi trộn theo yêu cầu.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295501
    m_Localized: Kẹp đầy nhân khách yêu thích.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295502
    m_Localized: Bát súp nóng đúng vị khách thích.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295503
    m_Localized: Vàng giòn bên ngoài, mọng nước bên trong.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295504
    m_Localized: Trứng ốp la sẵn sàng xếp lớp.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295505
    m_Localized: Chiên trứng, thịt xông khói và gà.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295506
    m_Localized: Chùm nho tím ngọt lịm.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295507
    m_Localized: Nước ép nho tím ngọt, vừa ép xong.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295508
    m_Localized: Lát giăm bông mỏng đậm đà.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295509
    m_Localized: Đá viên lanh canh giữ đồ uống mát lạnh.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295510
    m_Localized: Ép trái cây thành nước ép tươi.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295511
    m_Localized: Trái cây vỏ lông, ruột xanh tươi.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295512
    m_Localized: Nước ép xanh chua ngọt đầy sảng khoái.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295513
    m_Localized: Những lát kiwi xanh lấm tấm hạt.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295514
    m_Localized: Bắp xà lách tươi giòn.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295515
    m_Localized: Xà lách thái sợi giòn cho mọi lớp.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489792
    m_Localized: Trái cây nhiệt đới vàng óng đầy nắng.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489793
    m_Localized: Nước ép xoài vàng sánh vị nhiệt đới.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489794
    m_Localized: Lát xoài chín vàng mọng nước.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489795
    m_Localized: Sốt béo ngậy kết dính mọi thứ.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489796
    m_Localized: Sữa tươi mát lạnh cho đồ uống béo ngậy.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489797
    m_Localized: Cây nấm mập mạp từ rừng.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489798
    m_Localized: Nấm thái hạt lựu sẵn sàng vào nồi.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489799
    m_Localized: Béo ngậy thơm lừng, dọn nóng hổi.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489800
    m_Localized: Nhánh rau thơm xanh để hoàn thiện món ăn.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489801
    m_Localized: Hầm súp nóng hổi đậm đà.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489802
    m_Localized: Quả bí đỏ tròn trịa, ngọt bên trong.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489803
    m_Localized: Bí đỏ thái hạt lựu sẵn sàng hầm.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489804
    m_Localized: Mịn màng, ngọt ngào và ấm áp.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489805
    m_Localized: Lát bánh mì trắng mềm cho mọi loại sandwich.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489806
    m_Localized: Quả dâu đỏ ngọt đội mũ lá xanh.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489807
    m_Localized: Nước ép dâu hồng ngọt, vừa ép xong.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489808
    m_Localized: Lát dâu mọng nước cho sandwich ngọt.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489809
    m_Localized: Hạt bắp vàng ngọt giòn.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489810
    m_Localized: Ấm nóng, vàng giòn.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489811
    m_Localized: Quả cà chua chín đỏ mọng nước.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489812
    m_Localized: Cà chua thái hạt lựu sẵn sàng hầm.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489813
    m_Localized: Lát cà chua mọng nước cho mọi bánh mì.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489814
    m_Localized: Súp đỏ đậm đà, ấm áp dễ chịu.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489815
    m_Localized: Một vòng kem tươi bông mềm ngọt ngào.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489816
    m_Localized: Lát thịt xông khói
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489817
    m_Localized: Trứng luộc
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489818
    m_Localized: Máy nướng bánh mì
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489819
    m_Localized: Bánh mì tam giác
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489820
    m_Localized: Phô mai lát
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489821
    m_Localized: Ức gà
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489822
    m_Localized: Thịt xông khói giòn
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489823
