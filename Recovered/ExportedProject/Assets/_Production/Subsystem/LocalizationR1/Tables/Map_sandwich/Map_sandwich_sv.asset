  m_TableData:
  - m_Id: 47151316996
    m_Localized: Matig smörgås
    m_Metadata:
      m_Items: []
  - m_Id: 47134539776
    m_Localized: Rostat bröd staplat med allt som grillen kunde avvara.
    m_Metadata:
      m_Items: []
  - m_Id: 47151316997
    m_Localized: Fruktsmörgås
    m_Metadata:
      m_Items: []
  - m_Id: 47151316992
    m_Localized: Mjukt bröd med ett moln av grädde och färgglad frukt inuti.
    m_Metadata:
      m_Items: []
  - m_Id: 47151316998
    m_Localized: Sallad
    m_Metadata:
      m_Items: []
  - m_Id: 47151316993
    m_Localized: En krispig skål grönt med en klick majonnäs.
    m_Metadata:
      m_Items: []
  - m_Id: 47151316999
    m_Localized: Färskpressad juice
    m_Metadata:
      m_Items: []
  - m_Id: 47151316994
    m_Localized: Pressad på beställning, is om du vill.
    m_Metadata:
      m_Items: []
  - m_Id: 47151317000
    m_Localized: Soppa
    m_Metadata:
      m_Items: []
  - m_Id: 47151316995
    m_Localized: En varm, krämig skål med något gott på toppen.
    m_Metadata:
      m_Items: []
  - m_Id: 881833574129664
    m_Localized: Rått bacon som väntar på pannan.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295488
    m_Localized: Ett fast ägg redo för smörgåsar.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295489
    m_Localized: Rostar bröd varmt och gyllene.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295490
    m_Localized: Mjukt bröd skuret i trianglar.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295491
    m_Localized: En smältande skiva gyllene ost.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295492
    m_Localized: Rå kyckling som väntar på krispigt skal.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295493
    m_Localized: Stekt tills det är gyllene och krispigt.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295494
    m_Localized: En sval, krispig gurka.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295495
    m_Localized: Fräscha gröna skivor med krisp.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295496
    m_Localized: Skivar och tärnar alla fyllningar.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295497
    m_Localized: Ett färskt ägg med frukostplaner.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295498
    m_Localized: Grädde och frukt som gästen väljer.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295499
    m_Localized: Pressad av gästens favoritfrukt.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295500
    m_Localized: En fräsch skål blandad på beställning.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295501
    m_Localized: Fylld med gästens favoritpålägg.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295502
    m_Localized: En varm skål i gästens favoritsmak.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295503
    m_Localized: Gyllene och krispig, saftig inuti.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295504
    m_Localized: Ett stekt ägg redo att staplas.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295505
    m_Localized: Steker ägg, bacon och kyckling.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295506
    m_Localized: En klase söta lila druvor.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295507
    m_Localized: Söt lila juice, nypressad.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295508
    m_Localized: En tunn skiva smakrik skinka.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295509
    m_Localized: Klirrande isbitar som håller drinkar kalla.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295510
    m_Localized: Pressar frukt till färsk juice.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295511
    m_Localized: En luden frukt med klargrönt inre.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295512
    m_Localized: Syrlig grön juice full av fräschör.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295513
    m_Localized: Gröna kiwiskivor med små frön.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295514
    m_Localized: Ett krispigt huvud färsk sallad.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295515
    m_Localized: Krispiga strimlor till varje lager.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489792
    m_Localized: En gyllene tropisk frukt full av sol.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489793
    m_Localized: Tjock gyllene juice med tropisk smak.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489794
    m_Localized: Saftiga skivor mogen mango.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489795
    m_Localized: Krämig sås som håller ihop allt.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489796
    m_Localized: Färsk kall mjölk till krämiga drinkar.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489797
    m_Localized: En fyllig svamp från skogen.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489798
    m_Localized: Små svamptärningar redo för grytan.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489799
    m_Localized: Krämig och mustig, serverad rykande varm.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489800
    m_Localized: En färsk kvist som pricken över i.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489801
    m_Localized: Sjuder soppor tills de är varma och mustiga.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489802
    m_Localized: En rund orange pumpa, söt inuti.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489803
    m_Localized: Orange tärningar redo att sjuda.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489804
    m_Localized: Len, söt och värmande.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489805
    m_Localized: Mjuka vita skivor till alla smörgåsar.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489806
    m_Localized: Ett sött bär med en grön hatt.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489807
    m_Localized: Söt rosa juice, nypressad.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489808
    m_Localized: Saftiga skivor till söta smörgåsar.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489809
    m_Localized: Gyllene korn med söt krispighet.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489810
    m_Localized: Varmt, gyllene och krispigt.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489811
    m_Localized: En mogen röd tomat, saftig och klar.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489812
    m_Localized: Saftiga tärningar redo att sjuda.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489813
    m_Localized: Saftiga skivor till varje smörgås.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489814
    m_Localized: Mustig röd soppa, varm och tröstande.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489815
    m_Localized: En fluffig virvel av söt grädde.
    m_Metadata:
      m_Items: []
