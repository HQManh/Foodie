  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: Map_burger_vi-VN
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: vi-VN
  m_SharedData: {fileID: 11400000, guid: 70ba2199d21f4314980f738ed34bd399, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 57789920567296
    m_Localized: Quầy burger khởi đầu. Sở hữu ngay từ đầu.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927424
    m_Localized: Ngôi nhà burger hoàn chỉnh với mặt tiền rộng hơn và nhiều chỗ trang trí hơn.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927425
    m_Localized: Ngọt như mật ong và càng đáng yêu gấp đôi khi khoai chiên tới.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927426
    m_Localized: Nướng hoàn hảo, miếng thịt này chín thật khéo.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927427
    m_Localized: Tái, sống và nóng lòng lên vỉ nướng.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927428
    m_Localized: Bảng thực đơn nhỏ đặt cạnh cửa.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927429
    m_Localized: Bảng quảng cáo cao dựng trước cửa tiệm.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927430
    m_Localized: Xếp chồng nhiều lớp và đang cực kỳ phong độ.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927431
    m_Localized: Chiên nguyên liệu đến khi vàng giòn.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927432
    m_Localized: Rót cola có ga.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927433
    m_Localized: Cắt nguyên liệu thành miếng.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927434
    m_Localized: Bánh nướng giòn với cơ bụng thép.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927435
    m_Localized: Chiếc bánh cuối cùng đã chịu mở lòng.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927436
    m_Localized: Chiếc bánh mềm vẫn còn nằm ườn.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927437
    m_Localized: Nơi nguyên liệu xuất hiện.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927438
    m_Localized: Biển hiệu nhà hàng gắn phía trên mái.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927439
    m_Localized: Quá ngầu để vội vàng, luôn gọi món kèm tiếng rừ rừ đúng lúc.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927440
    m_Localized: Chân nhỏ xíu, bụng thì to, thêm phô mai chẳng ngại ngần.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927441
    m_Localized: Một khối sữa đầy tiềm năng chờ được bào.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927442
    m_Localized: Phô mai lát, sẵn sàng làm tan chảy trái tim.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927443
    m_Localized: Vàng lỏng khiến mọi thứ trở nên tuyệt vời.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927444
    m_Localized: Ức gà khoác áo bột, sẵn sàng ra mắt giòn rụm.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927445
    m_Localized: Nhợt nhạt đơn sơ, vẫn chờ ngày được lên chảo.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927446
    m_Localized: Giòn bên ngoài, mọng bên trong, ngon mút tay.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927447
    m_Localized: Miếng gà viên nhỏ khoác áo giáp bột.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927448
    m_Localized: Nhỏ xinh vừa miệng và mơ về nồi chiên.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927449
    m_Localized: Đùi gà khoác áo bột, mũm mĩm và sẵn sàng.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927450
    m_Localized: Phần thịt mọng nhất, vẫn đang giấu tiềm năng.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927451
    m_Localized: Cánh gà tẩm bột trước khi kịp học bay.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927452
    m_Localized: Chiếc cánh gà chưa hề có chút giòn nào.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927453
    m_Localized: Bột đỏ mang đến vị nóng, chẳng hề dịu dàng.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927454
    m_Localized: Những cọng xanh hơi ghen tị với hành tây.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927455
    m_Localized: Hoa giấy xanh tí hon cho bữa tiệc giòn tan.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927456
    m_Localized: Chiếc cốc rỗng khát khao lẽ sống.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927457
    m_Localized: Nước ngọt sẫm màu sủi bọt vì phấn khích.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927458
    m_Localized: Cola đá, phục vụ kèm thái độ lạnh lùng.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927459
    m_Localized: Xếp theo yêu cầu, ăn ngay trước khi bánh gục ngã.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927460
    m_Localized: Nước ga mát lạnh khiến mỗi miếng burger thêm sảng khoái.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927461
    m_Localized: Vàng ruộm bên ngoài, mọng nước bên trong, bốn miếng là hết.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927462
    m_Localized: Nóng hổi, mặn mà và không thể chia đều.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927463
    m_Localized: Vị khách nhỏ trung thành, coi mỗi chiếc burger là báu vật khiến đuôi vẫy tít.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927464
    m_Localized: Mong manh, gặp áp lực là nứt ngay.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927465
    m_Localized: Ốp la lòng đào và vui vẻ hết cỡ.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927466
    m_Localized: Chiên đồ ăn đến khi vàng giòn.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927467
    m_Localized: Phủ nguyên liệu một lớp bột.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927468
    m_Localized: Nước quyết định sống thật ngầu.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927469
    m_Localized: Mọi món giòn gói trong một hộp, bữa tiệc gà hoành tráng.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927470
    m_Localized: Lá xanh giòn tan, bắt đầu thôi nào.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927471
    m_Localized: Rau thái sợi cuối cùng cũng rời khỏi cây.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927472
    m_Localized: Cả một cây xà lách với cái đầu rất tỉnh táo.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927473
    m_Localized: Dây đèn giăng dọc bên trái.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927474
    m_Localized: Biển hiệu nhà hàng gắn phía trên mái.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927475
    m_Localized: Điều hành giờ cao điểm như họp hội đồng quản trị và đòi dưa chua hảo hạng.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927476
    m_Localized: Chậu cây cạnh lối vào.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927477
    m_Localized: Củ khoai giản dị mơ làm ngôi sao khoai chiên.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927478
    m_Localized: Cắt thành que, giờ là cọng khoai chờ chiên.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927479
    m_Localized: Khoai chiên vàng nóng đến mức gây tranh cãi về muối.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927480
    m_Localized: Khoai chiên vùi dưới phô mai, chẳng hối hận chút nào.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927481
    m_Localized: Nhảy tưng tưng vào khi đói, ra về với vụn bánh dính cả hai má.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927482
    m_Localized: Người giao hàng đuôi đỏ nhanh nhất thị trấn, trừ khi ai đó làm rơi cọng khoai.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927483
    m_Localized: Tím, hăng và thầm lặng đa cảm.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927484
    m_Localized: Những khoanh hành khiến đầu bếp rơi lệ.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927485
    m_Localized: Mô hình burger khổng lồ trên mái nhà.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927486
    m_Localized: Biển treo ở phía bên phải tòa nhà.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927487
    m_Localized: Biển treo ở phía bên phải tòa nhà.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927488
    m_Localized: Tròn, đỏ và về mặt kỹ thuật là trái cây.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927489
    m_Localized: Những lát cà chua mọng nước chẳng còn thiếu gì.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927490
    m_Localized: Dây leo rủ xuống mép mái nhà.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927491
    m_Localized: Nhà lớn hơn
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927492
    m_Localized: Gấu Ôm Mật Ong
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927493
    m_Localized: Thịt bò viên
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927494
    m_Localized: Thịt bò viên sống
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927495
    m_Localized: Bảng thực đơn nhỏ
    m_Metadata:
