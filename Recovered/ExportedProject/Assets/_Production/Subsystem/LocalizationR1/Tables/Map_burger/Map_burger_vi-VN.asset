    m_Metadata:
      m_Items: []
  - m_Id: 57789949927557
    m_Localized: Dây leo
    m_Metadata:
      m_Items: []
  - m_Id: 3010520264204288
    m_Localized: Thái rau nhanh hơn cả lúc xà lách đỏ mặt.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758720
    m_Localized: Thái lát, thái hạt lựu, xong. Hành tây chẳng có cơ hội nào.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758721
    m_Localized: Rót cola có ga trong nháy mắt, cả bọt luôn.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758722
    m_Localized: Ga sủi tưng bừng! Đài phun nước ngọt và niềm vui.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758723
    m_Localized: Lăn gà qua bột với tốc độ tối đa. Bừa bộn nhưng ngon.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758724
    m_Localized: Một trận bão tuyết bột mì. Mỗi miếng nugget được đắp một tấm chăn ấm.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758725
    m_Localized: Khoai tây chiên vàng ươm trong thời gian kỷ lục. Đảm bảo giòn rụm.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758726
    m_Localized: Mở khóa độ giòn vượt trội. Khoai tây chiên tự hào tỏa sáng.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758727
    m_Localized: Patty xèo xèo nhanh hơn. Bụng sôi to hơn.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758728
    m_Localized: Nóng đến mức bánh burger tự lật. Theo đúng nghĩa đen.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758729
    m_Localized: Dao Thái Siêu Tốc
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758730
    m_Localized: Dao Thái Ninja
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758731
    m_Localized: Máy Cola Nhanh
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758732
    m_Localized: Mạch Phun Cola
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758733
    m_Localized: Tô Tẩm Bột Siêu Tốc
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758734
    m_Localized: Tô Cuồng Bột
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758735
    m_Localized: Nồi Chiên Giòn Rụm
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758736
    m_Localized: Nồi Chiên Vàng
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758737
    m_Localized: Bếp Nướng Xèo Xèo
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758738
    m_Localized: Bếp Nướng Xèo Xèo Mega
    m_Metadata:
      m_Items: []
  - m_Id: 8069138441297920
    m_Localized: Rau xà lách được thái sợi trước cả khi chạm thớt.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138487435264
    m_Localized: Thớt Samurai
    m_Metadata:
      m_Items: []
  - m_Id: 8069138491629568
    m_Localized: Sắc đến mức cắt cả không khí. Cà chua phải chào kính.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138491629569
    m_Localized: Thớt Lưỡi Kiếm Huyền Thoại
    m_Metadata:
      m_Items: []
  - m_Id: 8069138491629570
    m_Localized: Phun trào bọt ga. Ly tự đầy luôn.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138491629571
    m_Localized: Núi Lửa Cola
    m_Metadata:
      m_Items: []
  - m_Id: 8069138491629572
    m_Localized: Bọt ga mãi mãi. Cơn khát không có cửa.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138491629573
    m_Localized: Đài Phun Ga Vô Tận
    m_Metadata:
      m_Items: []
  - m_Id: 8069138491629574
    m_Localized: Tẩm bột nugget nhanh hơn bạn kịp nói giòn rụm.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138495823872
    m_Localized: Bão Tuyết Bột Mì
    m_Metadata:
      m_Items: []
  - m_Id: 8069138495823873
    m_Localized: Mỗi miếng nugget đều ra lò sang chảnh như hoàng gia.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138495823874
    m_Localized: Bát Bột Vàng
    m_Metadata:
      m_Items: []
  - m_Id: 8069138495823875
    m_Localized: Khoai tây nhảy vào trắng bệch, bật ra vàng ươm.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138495823876
    m_Localized: Nồi Chiên Turbo
    m_Metadata:
      m_Items: []
  - m_Id: 8069138495823877
    m_Localized: Giòn rụm với tốc độ ánh sáng.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138495823878
    m_Localized: Lò Phản Ứng Chiên Huyền Thoại
    m_Metadata:
      m_Items: []
  - m_Id: 8069138495823879
    m_Localized: Patty chín trong nháy mắt. Coi chừng lông mày.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138495823880
    m_Localized: Bếp Nướng Núi Lửa
    m_Metadata:
      m_Items: []
  - m_Id: 8069138500018176
    m_Localized: Nóng như mặt trời, nhanh như tên lửa. Hạnh phúc hamburger.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138500018177
    m_Localized: Bếp Nướng Mặt Trời Huyền Thoại
    m_Metadata:
      m_Items: []
