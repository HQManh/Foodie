  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: Map_burger_ro
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: ro
  m_SharedData: {fileID: 11400000, guid: 70ba2199d21f4314980f738ed34bd399, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 57789920567296
    m_Localized: Taraba de burgeri de început. A ta de la început.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927424
    m_Localized: O casă de burgeri completă, cu fațadă mai lată și mai mult loc pentru decor.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927425
    m_Localized: Dulce ca mierea și de două ori mai drăgălaș când vin cartofii.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927426
    m_Localized: Făcută la perfecție, chifteaua asta s-a descurcat de minune.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927427
    m_Localized: În sânge, crud și abia așteaptă plita.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927428
    m_Localized: Panou mic de meniu lângă ușă.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927429
    m_Localized: Panou publicitar înalt în fața magazinului.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927430
    m_Localized: Stivuit, stratificat și absolut în formă.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927431
    m_Localized: Prăjește ingredientele până devin aurii și crocante.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927432
    m_Localized: Toarnă cola acidulată.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927433
    m_Localized: Taie ingredientele în bucăți.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927434
    m_Localized: Chiflă prăjită cu fesieri de oțel.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927435
    m_Localized: O chiflă care, în sfârșit, și-a deschis sufletul.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927436
    m_Localized: O chiflă moale care încă lenevește.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927437
    m_Localized: De aici vin ingredientele.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927438
    m_Localized: Firma restaurantului montată deasupra acoperișului.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927439
    m_Localized: Prea cool ca să se grăbească și comandă mereu cu un tors perfect sincronizat.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927440
    m_Localized: Lăbuțe mici, poftă mare și nicio jenă pentru brânză în plus.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927441
    m_Localized: Un bloc lactat cu potențial de răzătoare.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927442
    m_Localized: Brânză feliată, gata să topească inimi.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927443
    m_Localized: Aur topit care face totul grozav.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927444
    m_Localized: Piept îmbrăcat în făină, gata de debutul crocant.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927445
    m_Localized: Simplu și palid, încă își așteaptă marea prăjeală.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927446
    m_Localized: Crocant pe dinafară, suculent pe dinăuntru, să-ți lingi degetele.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927447
    m_Localized: Un nugget mic în armura lui de făină.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927448
    m_Localized: Mic, de o îmbucătură și visând la friteuză.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927449
    m_Localized: Pulpă în haină de făină, plinuță și gata.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927450
    m_Localized: Cea mai suculentă bucată, care încă își ascunde potențialul.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927451
    m_Localized: Aripioare trase prin aluat înainte să învețe să zboare.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927452
    m_Localized: O aripioară fără pic de crocănțeală încă.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927453
    m_Localized: Pudră roșie care aduce căldura, fără pic de răcoare.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927454
    m_Localized: Tulpini verzi cu o ușoară invidie pe ceapă.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927455
    m_Localized: Confetti verzi mititele pentru o petrecere crocantă.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927456
    m_Localized: Un pahar gol, însetat de un scop.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927457
    m_Localized: Suc acidulat închis la culoare, care fierbe de entuziasm.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927458
    m_Localized: Cola cu gheață, servită cu răceală.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927459
    m_Localized: Asamblat la comandă și cel mai bun mâncat înainte să cedeze chifla.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927460
    m_Localized: Bule reci ca gheața care fac fiecare mușcătură de burger mai zgomotoasă.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927461
    m_Localized: Auriu pe dinafară, suculent înăuntru și gata din patru mușcături.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927462
    m_Localized: Fierbinți, sărați și imposibil de împărțit corect.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927463
    m_Localized: Un mic client fidel pentru care fiecare burger e o comoară de dat din coadă.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927464
    m_Localized: Fragil, crapă sub presiune.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927465
    m_Localized: Ochi cu gălbenușul în sus și ou-t de vesel.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927466
    m_Localized: Prăjește mâncarea până devine aurie și crocantă.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927467
    m_Localized: Îmbracă ingredientele într-un strat de aluat.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927468
    m_Localized: Apă care a decis să rămână cool.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927469
    m_Localized: Tot ce e crocant, într-un singur ospăț glorios.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927470
    m_Localized: 'Frunze verzi crocante: să înceapă salata!'
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927471
    m_Localized: Frunze tocate care, în sfârșit, și-au părăsit căpățâna.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927472
    m_Localized: O căpățână întreagă de salată, cu capul pe umeri.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927473
    m_Localized: Instalație de lumini de-a lungul părții stângi.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927474
    m_Localized: Firma restaurantului montată deasupra acoperișului.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927475
    m_Localized: Conduce aglomerația de la prânz ca pe o ședință de consiliu și cere murături premium.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927476
    m_Localized: Plantă în ghiveci lângă intrare.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927477
    m_Localized: Un cartof modest, cu vise de vedetă a cartofilor prăjiți.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927478
    m_Localized: Tăiat bețișoare, acum e un cartof prăjit în așteptare.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927479
    m_Localized: Cartofi aurii destul de fierbinți cât să pornească o dezbatere despre sare.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927480
    m_Localized: Cartofi îngropați în brânză, fără niciun regret.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927481
    m_Localized: Intră țopăind, flămândă, și pleacă cu firimituri pe ambii obraji.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927482
    m_Localized: Cel mai rapid curier cu coadă roșie din oraș, dacă nu scapă cineva un cartof.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927483
    m_Localized: Mov, iute și în secret emotivă.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927484
    m_Localized: Inele tăiate care l-au făcut pe bucătar să plângă.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927485
    m_Localized: Un burger uriaș decorativ pe acoperiș.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927486
    m_Localized: Firmă atârnată pe partea dreaptă a clădirii.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927487
    m_Localized: Firmă atârnată pe partea dreaptă a clădirii.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927488
    m_Localized: Rotundă, roșie și, tehnic vorbind, un fruct.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927489
    m_Localized: Felii suculente cărora nu le mai lipsește nimic.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927490
    m_Localized: Plante agățătoare care atârnă de marginea acoperișului.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927491
    m_Localized: Casă mai mare
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927492
    m_Localized: Ursulețul Îmbrățișare de Miere
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927493
    m_Localized: Chiftea de vită
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927494
    m_Localized: Chiftea crudă
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927495
    m_Localized: Panou mic de meniu
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927496
    m_Localized: Panou înalt de meniu
    m_Metadata:
      m_Items: []
