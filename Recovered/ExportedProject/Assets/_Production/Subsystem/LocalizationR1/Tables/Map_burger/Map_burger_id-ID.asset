  - m_Id: 57789949927553
    m_Localized: Papan Gantung
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927554
    m_Localized: Papan Tiang
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927555
    m_Localized: Tomat
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927556
    m_Localized: Tomat Iris
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927557
    m_Localized: Tanaman Rambat
    m_Metadata:
      m_Items: []
  - m_Id: 3010520264204288
    m_Localized: Mencincang sayur lebih cepat daripada selada yang tersipu.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758720
    m_Localized: Iris, dadu, selesai. Bawang tak punya kesempatan.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758721
    m_Localized: Menuang cola bersoda dalam sekejap, lengkap dengan gelembungnya.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758722
    m_Localized: Soda melimpah! Air mancur soda dan keceriaan.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758723
    m_Localized: Melumuri ayam dengan tepung secepat kilat. Berantakan tapi enak.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758724
    m_Localized: Badai salju tepung. Setiap nugget mendapat selimut hangat.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758725
    m_Localized: Kentang goreng keemasan dalam waktu singkat. Renyah dijamin.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758726
    m_Localized: Kerenyahan ekstra terbuka. Kentang gorengnya bersinar bangga.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758727
    m_Localized: Patty berdesis lebih cepat. Perut berbunyi lebih keras.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758728
    m_Localized: Begitu panas sampai burger pun terbalik karenanya. Secara harfiah.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758729
    m_Localized: Pencincang Cepat
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758730
    m_Localized: Pencincang Ninja
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758731
    m_Localized: Mesin Soda Kilat
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758732
    m_Localized: Geyser Cola
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758733
    m_Localized: Mangkuk Tepung Kilat
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758734
    m_Localized: Mangkuk Badai Tepung
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758735
    m_Localized: Penggoreng Renyah
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758736
    m_Localized: Penggoreng Emas
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758737
    m_Localized: Griddle Sizzle
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758738
    m_Localized: Griddle Sizzle Mega
    m_Metadata:
      m_Items: []
  - m_Id: 8069138441297920
    m_Localized: Selada sudah teriris sebelum mendarat.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138487435264
    m_Localized: Pencacah Samurai
    m_Metadata:
      m_Items: []
  - m_Id: 8069138491629568
    m_Localized: Begitu tajam sampai membelah udara. Tomat pun memberi hormat.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138491629569
    m_Localized: Talenan Pisau Legendaris
    m_Metadata:
      m_Items: []
  - m_Id: 8069138491629570
    m_Localized: Meletus penuh gelembung. Gelas terisi sendiri.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138491629571
    m_Localized: Gunung Berapi Kola
