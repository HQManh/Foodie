  m_Name: Map_burger_id-ID
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: id-ID
  m_SharedData: {fileID: 11400000, guid: 70ba2199d21f4314980f738ed34bd399, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 57789920567296
    m_Localized: Kedai burger awal. Sudah dimiliki sejak mulai.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927424
    m_Localized: Rumah burger lengkap dengan bagian depan lebih lebar dan ruang dekorasi lebih banyak.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927425
    m_Localized: Manis seperti madu dan dua kali lebih manja saat kentang goreng datang.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927426
    m_Localized: Dipanggang sempurna, patty ini benar-benar matang dan hebat.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927427
    m_Localized: Mentah, belum dimasak, dan siap bertarung di panggangan.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927428
    m_Localized: Papan menu kecil yang berdiri di samping pintu.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927429
    m_Localized: Papan iklan tinggi di depan toko.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927430
    m_Localized: Bertumpuk, berlapis, dan benar-benar sedang di puncak.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927431
    m_Localized: Goreng bahan hingga keemasan dan renyah.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927432
    m_Localized: Menuang kola bersoda.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927433
    m_Localized: Memotong bahan menjadi potongan.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927434
    m_Localized: Roti panggang dengan roti baja.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927435
    m_Localized: Roti yang akhirnya membuka isi hatinya.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927436
    m_Localized: Roti lembut yang masih bermalas-malasan.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927437
    m_Localized: Tempat asal bahan-bahan.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927438
    m_Localized: Papan nama restoran yang dipasang di atas atap.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927439
    m_Localized: Terlalu santai untuk terburu-buru dan selalu memesan dengan dengkuran yang pas.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927440
    m_Localized: Cakar mungil, nafsu makan besar, dan sama sekali tak malu minta keju ekstra.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927441
    m_Localized: Sebongkah olahan susu dengan potensi yang luar parut.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927442
    m_Localized: Keju iris, siap meluluhkan hati.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927443
    m_Localized: Emas cair yang membuat semuanya jadi luar biasa.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927444
    m_Localized: Dada ayam berbalut tepung, siap debut renyah.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927445
    m_Localized: Polos dan pucat, masih menunggu saat digoreng.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927446
    m_Localized: Renyah di luar, juicy di dalam, bikin jilat jari.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927447
    m_Localized: Nugget kecil yang memakai baju zirah tepung.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927448
    m_Localized: Kecil, sekali gigit, dan bermimpi masuk penggorengan.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927449
    m_Localized: Paha berbalut mantel tepung, montok dan siap.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927450
    m_Localized: Potongan paling juicy, masih menyembunyikan potensinya.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927451
    m_Localized: Sayap dibalur adonan sebelum sempat belajar terbang.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927452
    m_Localized: Sayap yang belum punya kerenyahan sama sekali.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927453
    m_Localized: Bubuk merah yang membawa rasa panas, tanpa ampun.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927454
    m_Localized: Batang hijau yang sedikit iri pada bawang.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927455
    m_Localized: Konfeti hijau mungil untuk pesta yang renyah.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927456
    m_Localized: Gelas kosong yang haus akan tujuan hidup.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927457
    m_Localized: Soda gelap yang berbuih penuh semangat.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927458
    m_Localized: Kola dengan es, disajikan dengan sikap sedingin es.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927459
    m_Localized: Disusun sesuai pesanan, paling enak dimakan sebelum rotinya menyerah.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927460
    m_Localized: Gelembung sedingin es yang membuat setiap gigitan burger makin seru.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927461
    m_Localized: Keemasan di luar, juicy di dalam, habis dalam empat gigitan.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927462
    m_Localized: Panas, asin, dan mustahil dibagi dengan adil.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927463
    m_Localized: Pelanggan setia yang menganggap setiap burger harta yang bikin ekornya bergoyang.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927464
    m_Localized: Rapuh, dan akan retak di bawah tekanan.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927465
    m_Localized: Mata sapi yang telur-lalu ceria.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927466
    m_Localized: Menggoreng makanan hingga keemasan dan renyah.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927467
    m_Localized: Membalut bahan dengan lapisan adonan.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927468
    m_Localized: Air yang memutuskan untuk tetap kalem.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927469
    m_Localized: Semua yang renyah, dikemas dalam satu pesta ayam yang megah.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927470
    m_Localized: Daun hijau renyah, ayo mulai berselada ria.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927471
    m_Localized: Sayuran iris yang akhirnya meninggalkan kepalanya.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927472
    m_Localized: Sebutir selada utuh yang selalu kepala dingin.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927473
    m_Localized: Lampu tali yang terpasang di sisi kiri.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927474
    m_Localized: Papan nama restoran yang dipasang di atas atap.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927475
    m_Localized: Mengatur jam sibuk makan siang layaknya rapat direksi dan menuntut acar premium.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927476
    m_Localized: Tanaman pot di samping pintu masuk.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927477
    m_Localized: Kentang sederhana yang bermimpi jadi bintang kentang goreng.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927478
    m_Localized: Dipotong batang, kini calon kentang goreng.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927479
    m_Localized: Kentang goreng emas yang cukup panas untuk memicu debat soal garam.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927480
    m_Localized: Kentang goreng terkubur keju, tanpa penyesalan sedikit pun.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927481
    m_Localized: Datang melompat kelaparan dan pulang dengan remah di kedua pipi.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927482
    m_Localized: Kurir berekor merah tercepat di kota, kecuali ada yang menjatuhkan kentang goreng.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927483
    m_Localized: Ungu, tajam, dan diam-diam perasa.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927484
    m_Localized: Irisan cincin yang membuat koki menangis.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927485
    m_Localized: Properti burger raksasa di atas atap.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927486
    m_Localized: Papan yang tergantung di sisi kanan bangunan.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927487
    m_Localized: Papan yang tergantung di sisi kanan bangunan.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927488
    m_Localized: Bulat, merah, dan secara teknis adalah buah.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927489
    m_Localized: Irisan juicy yang sudah tak kurang apa-apa.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927490
    m_Localized: Tanaman rambat yang menjuntai di tepi atap.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927491
    m_Localized: Rumah Lebih Besar
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927492
    m_Localized: Beruang Pelukan Madu
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927493
