  - m_Id: 57789949927547
    m_Localized: Kentang Goreng Keju
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927548
    m_Localized: Bunbun Bella
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927549
    m_Localized: Kurier Tikus Merah
    m_Metadata:
