    m_Metadata:
      m_Items: []
  - m_Id: 57789949927554
    m_Localized: Papan Tanda Tiang
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927555
    m_Localized: Tomato
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927556
    m_Localized: Tomato Dihiris
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927557
    m_Localized: Pokok Menjalar
    m_Metadata:
      m_Items: []
  - m_Id: 3010520264204288
    m_Localized: Mencincang sayur lebih pantas daripada salad tersipu malu.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758720
    m_Localized: Hiris, dadu, siap. Bawang tiada peluang.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758721
    m_Localized: Menuang kola berbuih dalam sekelip mata, lengkap dengan gelembung.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758722
    m_Localized: Buih melimpah! Air pancut soda dan keriangan.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758723
    m_Localized: Menyalut ayam dengan tepung pada kelajuan tinggi. Bersepah tetapi sedap.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758724
    m_Localized: Ribut salji tepung. Setiap nugget mendapat selimut yang selesa.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758725
    m_Localized: Kentang goreng keemasan dalam masa rekod. Rangup dijamin.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758726
    m_Localized: Kerangupan ekstra dibuka. Kentang goreng bersinar bangga.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758727
    m_Localized: Patty berdesis lebih pantas. Perut berbunyi lebih kuat.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758728
    m_Localized: Begitu panas sehingga burger pun terbalik. Secara harfiah.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758729
    m_Localized: Pencincang Pantas
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758730
    m_Localized: Pencincang Ninja
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758731
    m_Localized: Mesin Soda Pantas
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758732
    m_Localized: Geiser Kola
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758733
    m_Localized: Mangkuk Adunan Pantas
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758734
    m_Localized: Mangkuk Kegilaan Tepung
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758735
    m_Localized: Penggoreng Rangup
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758736
    m_Localized: Penggoreng Emas
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758737
    m_Localized: Griddle Sizzle
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758738
    m_Localized: Griddle Sizzle Mega
    m_Metadata:
      m_Items: []
  - m_Id: 8069138441297920
    m_Localized: Salad sudah dihiris sebelum mendarat.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138487435264
    m_Localized: Pencincang Samurai
    m_Metadata:
      m_Items: []
  - m_Id: 8069138491629568
    m_Localized: Begitu tajam hingga membelah udara. Tomato pun memberi tabik.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138491629569
    m_Localized: Papan Pisau Legenda
    m_Metadata:
      m_Items: []
  - m_Id: 8069138491629570
    m_Localized: Meletus dengan buih. Cawan terisi sendiri.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138491629571
    m_Localized: Gunung Berapi Kola
