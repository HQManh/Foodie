  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: Map_burger_ms
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: ms
  m_SharedData: {fileID: 11400000, guid: 70ba2199d21f4314980f738ed34bd399, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 57789920567296
    m_Localized: Gerai burger permulaan. Dimiliki sejak awal.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927424
    m_Localized: Rumah burger penuh dengan bahagian depan lebih luas dan lebih ruang hiasan.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927425
    m_Localized: Manis seperti madu dan dua kali lebih manja apabila kentang goreng tiba.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927426
    m_Localized: Dipanggang dengan sempurna, pati ini masak dan hebat.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927427
    m_Localized: Mentah, belum dimasak dan tidak sabar ke plat pemanggang.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927428
    m_Localized: Papan menu kecil berdiri di sebelah pintu.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927429
    m_Localized: Papan iklan tinggi di hadapan kedai.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927430
    m_Localized: Bertingkat, berlapis dan benar-benar hebat.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927431
    m_Localized: Goreng bahan hingga keemasan dan rangup.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927432
    m_Localized: Menuang kola berbuih.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927433
    m_Localized: Memotong bahan kepada kepingan.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927434
    m_Localized: Roti bakar dengan kekuatan besi.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927435
    m_Localized: Roti yang akhirnya membuka isi hatinya.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927436
    m_Localized: Roti lembut yang masih bermalas-malasan.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927437
    m_Localized: Tempat datangnya bahan-bahan.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927438
    m_Localized: Papan tanda restoran dipasang di atas bumbung.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927439
    m_Localized: Terlalu tenang untuk tergesa-gesa dan sentiasa memesan dengan dengkuran yang tepat masanya.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927440
    m_Localized: Tapak kecil, selera besar dan langsung tidak malu minta keju tambahan.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927441
    m_Localized: Seketul tenusu dengan potensi yang hebat untuk diparut.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927442
    m_Localized: Keju dihiris, sedia mencairkan hati.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927443
    m_Localized: Emas cair yang membuat segalanya hebat.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927444
    m_Localized: Dada ayam bersalut tepung, sedia untuk debut rangup.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927445
    m_Localized: Biasa dan pucat, masih menanti saat digoreng.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927446
    m_Localized: Rangup di luar, berjus di dalam, sedap sampai jilat jari.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927447
    m_Localized: Nuget kecil memakai baju besi tepung.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927448
    m_Localized: Kecil, sekali suap dan bermimpi masuk penggoreng.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927449
    m_Localized: Paha bersalut tepung, montok dan bersedia.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927450
    m_Localized: Potongan paling berjus, masih menyembunyikan potensinya.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927451
    m_Localized: Kepak disalut adunan sebelum sempat belajar terbang.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927452
    m_Localized: Kepak yang belum ada kerangupan langsung.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927453
    m_Localized: Serbuk merah yang membawa rasa pedas, langsung tak tenang.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927454
    m_Localized: Batang hijau yang sedikit cemburukan bawang.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927455
    m_Localized: Konfeti hijau kecil untuk sambutan yang rangup.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927456
    m_Localized: Cawan kosong yang dahagakan tujuan.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927457
    m_Localized: Soda gelap yang berbuih penuh keterujaan.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927458
    m_Localized: Kola berais, dihidang dengan sikap dingin.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927459
    m_Localized: Disusun mengikut pesanan, paling sedap dimakan sebelum roti menyerah.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927460
    m_Localized: Buih sejuk ais yang membuat setiap gigitan burger lebih meriah.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927461
    m_Localized: Keemasan di luar, berjus di dalam dan habis dalam empat gigitan.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927462
    m_Localized: Panas, masin dan mustahil dikongsi dengan adil.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927463
    m_Localized: Pelanggan kecil yang setia, setiap burger ibarat harta yang buat ekornya bergoyang.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927464
    m_Localized: Rapuh, dan akan retak di bawah tekanan.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927465
    m_Localized: Telur mata kerbau yang sangat ceria.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927466
    m_Localized: Menggoreng makanan hingga keemasan dan rangup.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927467
    m_Localized: Menyalut bahan dengan lapisan adunan.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927468
    m_Localized: Air yang memutuskan untuk kekal tenang.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927469
    m_Localized: Semua yang rangup, dikotakkan dalam satu jamuan ayam yang hebat.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927470
    m_Localized: Daun hijau rangup, jom mula bersalad.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927471
    m_Localized: Sayur hijau dihiris yang akhirnya meninggalkan kepalanya.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927472
    m_Localized: Sebiji salad utuh yang sangat tenang kepalanya.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927473
    m_Localized: Lampu tali dipasang di sepanjang sebelah kiri.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927474
    m_Localized: Papan tanda restoran dipasang di atas bumbung.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927475
    m_Localized: Mengendalikan waktu puncak seperti mesyuarat lembaga dan menuntut jeruk premium.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927476
    m_Localized: Tanaman pasu di sebelah pintu masuk.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927477
    m_Localized: Kentang sederhana yang bercita-cita jadi bintang kentang goreng.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927478
    m_Localized: Dipotong batang, kini bakal kentang goreng.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927479
    m_Localized: Kentang goreng keemasan yang cukup panas untuk mencetus perdebatan garam.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927480
    m_Localized: Kentang goreng tertimbus keju, tiada penyesalan langsung.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927481
    m_Localized: Melompat masuk kelaparan dan keluar dengan serbuk roti di kedua-dua pipi.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927482
    m_Localized: Kurier berekor merah terpantas di bandar, kecuali ada yang terjatuhkan kentang goreng.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927483
    m_Localized: Ungu, tajam baunya dan diam-diam emosional.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927484
    m_Localized: Hirisan gelang yang membuat cef menangis.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927485
    m_Localized: Replika burger gergasi di atas bumbung.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927486
    m_Localized: Papan tanda tergantung di sebelah kanan bangunan.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927487
    m_Localized: Papan tanda tergantung di sebelah kanan bangunan.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927488
    m_Localized: Bulat, merah dan secara teknikal sejenis buah.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927489
    m_Localized: Hirisan berjus yang tidak kurang apa-apa lagi.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927490
    m_Localized: Pokok menjalar yang berjuntai di tepi bumbung.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927491
    m_Localized: Rumah Lebih Besar
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927492
