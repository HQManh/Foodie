  m_Name: Map_burger_sv
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: sv
  m_SharedData: {fileID: 11400000, guid: 70ba2199d21f4314980f738ed34bd399, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 57789920567296
    m_Localized: Startburgarståndet. Ditt från början.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927424
    m_Localized: Ett helt burgarhus med bredare fasad och mer plats för dekor.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927425
    m_Localized: Söt som honung och dubbelt så gosig när pommesen kommer.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927426
    m_Localized: Perfekt grillad – den här biffen har gjort bra ifrån sig.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927427
    m_Localized: Rå, ostekt och sugen på stekhällen.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927428
    m_Localized: Liten menytavla bredvid dörren.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927429
    m_Localized: Hög reklamskylt framför butiken.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927430
    m_Localized: Staplad, lagrad och helt i form.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927431
    m_Localized: Steker ingredienserna gyllenbruna och krispiga.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927432
    m_Localized: Häller upp bubblande cola.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927433
    m_Localized: Hackar ingredienser i bitar.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927434
    m_Localized: Rostat bröd med stålbakdel.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927435
    m_Localized: Ett bröd som äntligen har öppnat sig.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927436
    m_Localized: Ett mjukt bröd som fortfarande latar sig.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927437
    m_Localized: Härifrån kommer ingredienserna.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927438
    m_Localized: Restaurangskylt monterad ovanför taket.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927439
    m_Localized: För cool för att stressa och beställer alltid med ett perfekt tajmat spinnande.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927440
    m_Localized: Små tassar, stor aptit och ingen skam alls över extra ost.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927441
    m_Localized: En bit mejeri med rivande potential.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927442
    m_Localized: Skivad ost, redo att smälta några hjärtan.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927443
    m_Localized: Smält guld som gör allt fantastiskt.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927444
    m_Localized: Bröst klätt i mjöl, redo för sin krispiga debut.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927445
    m_Localized: Blek och enkel, väntar fortfarande på sin stora fritering.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927446
    m_Localized: Krispig utanpå, saftig inuti – så gott att du slickar fingrarna.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927447
    m_Localized: En liten nugget i sin mjölrustning.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927448
    m_Localized: Liten, lagom för en tugga och drömmer om fritösen.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927449
    m_Localized: Lår i mjölrock, rejält och redo.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927450
    m_Localized: Den saftigaste biten, som fortfarande döljer sin potential.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927451
    m_Localized: Vingar i smet innan de hunnit lära sig flyga.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927452
    m_Localized: En vinge som ännu inte har någon krispighet.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927453
    m_Localized: Rött pulver som tar med hettan – ingen kyla här.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927454
    m_Localized: Gröna strån med en mild lökavund.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927455
    m_Localized: Pytteliten grön konfetti till en krispig fest.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927456
    m_Localized: En tom mugg som törstar efter mening.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927457
    m_Localized: Mörk läsk som bubblar av förväntan.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927458
    m_Localized: Cola på is, serverad med kalla handen.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927459
    m_Localized: Staplad på beställning och bäst att äta innan brödet ger upp.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927460
    m_Localized: Iskalla bubblor som gör varje burgartugga högre.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927461
    m_Localized: Gyllene utanpå, saftig inuti och borta på fyra tuggor.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927462
    m_Localized: Heta, salta och omöjliga att dela rättvist.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927463
    m_Localized: En trogen liten gäst som ser varje burgare som en svansviftande skatt.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927464
    m_Localized: Skört – spricker under press.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927465
    m_Localized: Solsidan upp och ägg-stremt glad.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927466
    m_Localized: Friterar maten gyllenbrun och krispig.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927467
    m_Localized: Täcker ingredienser med ett lager smet.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927468
    m_Localized: Vatten som bestämde sig för att hålla huvudet kallt.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927469
    m_Localized: Allt krispigt samlat i en härlig kycklingfest.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927470
    m_Localized: Krispiga gröna blad – nu salladsstartar vi.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927471
    m_Localized: Strimlade blad som äntligen lämnat huvudet.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927472
    m_Localized: Ett helt salladshuvud som håller huvudet kallt.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927473
    m_Localized: Ljusslinga längs vänster sida.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927474
    m_Localized: Restaurangskylt monterad ovanför taket.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927475
    m_Localized: Styr lunchrusningen som ett styrelsemöte och kräver premiumpickles.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927476
    m_Localized: Krukväxt vid entrén.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927477
    m_Localized: En enkel potatis med pommesstjärnedrömmar.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927478
    m_Localized: Skuren i stavar – nu en pommes frites i väntan.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927479
    m_Localized: Gyllene pommes, heta nog att starta en saltdebatt.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927480
    m_Localized: Pommes begravda under ost – inga ånger alls.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927481
    m_Localized: Skuttar in hungrig och går med smulor på båda kinderna.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927482
    m_Localized: Stadens snabbaste rödsvansade bud, om inte någon tappar en pommes.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927483
    m_Localized: Lila, stark och i hemlighet känslosam.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927484
    m_Localized: Skivade ringar som fick kocken att gråta.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927485
    m_Localized: En jättelik dekorburgare på taket.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927486
    m_Localized: Skylt som hänger på byggnadens högra sida.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927487
    m_Localized: Skylt som hänger på byggnadens högra sida.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927488
    m_Localized: Rund, röd och tekniskt sett en frukt.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927489
    m_Localized: Saftiga skivor som inte saknar något.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927490
    m_Localized: Hängande rankor över takkanten.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927491
    m_Localized: Större hus
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927492
    m_Localized: Honungskramsbjörnen
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927493
    m_Localized: Nötbiff
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927494
    m_Localized: Rå nötbiff
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927495
    m_Localized: Liten menytavla
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927496
    m_Localized: Hög menytavla
    m_Metadata:
