  - m_Id: 57789949927543
    m_Localized: Blomkruka
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927544
    m_Localized: Potatis
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927545
    m_Localized: Skuren potatis
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927546
    m_Localized: Pommes frites
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927547
    m_Localized: Pommes med ost
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927548
    m_Localized: Bunbun Bella
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927549
    m_Localized: Röda råttbudet
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927550
    m_Localized: Rödlök
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927551
    m_Localized: Skivad rödlök
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927552
    m_Localized: Jätteburgare
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927553
    m_Localized: Hängande skylt
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927554
    m_Localized: Stolpskylt
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927555
    m_Localized: Tomat
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927556
    m_Localized: Skivad tomat
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927557
    m_Localized: Rankor
    m_Metadata:
      m_Items: []
  - m_Id: 3010520264204288
    m_Localized: Hackar grönsaker snabbare än en sallad hinner rodna.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758720
    m_Localized: Skiva, tärna, klart. Löken hade ingen chans.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758721
    m_Localized: Häller upp bruskall cola på ett ögonblick, bubblor och allt.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758722
    m_Localized: Massor av bubbel! En fontän av läsk och glädje.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758723
    m_Localized: Panerar kyckling i mjöl i full fart. Stökigt men gott.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758724
    m_Localized: En snöstorm av mjöl. Varje nugget får en mysig filt.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758725
    m_Localized: Gyllene pommes frites på rekordtid. Knaprighet garanterad.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758726
    m_Localized: Extra krispighet upplåst. Pommesen strålar av stolthet.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758727
    m_Localized: Burgarna fräser snabbare. Magarna kurrar högre.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758728
    m_Localized: Så het att burgarna vänder sig om. Bokstavligen.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758729
    m_Localized: Snabb hackare
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758730
    m_Localized: Ninja-hackare
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758731
    m_Localized: Brusfart-maskin
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758732
    m_Localized: Cola-gejser
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758733
    m_Localized: Snabb panerskål
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758734
    m_Localized: Mjölfrenesi-skål
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758735
    m_Localized: Knaprig fritös
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758736
    m_Localized: Gyllene fritös
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758737
    m_Localized: Fräsande stekbord
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758738
    m_Localized: Mega-fräsande stekbord
    m_Metadata:
      m_Items: []
  - m_Id: 8069138441297920
    m_Localized: Salladen är strimlad innan den ens landar.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138487435264
    m_Localized: Samurajhackare
    m_Metadata:
      m_Items: []
  - m_Id: 8069138491629568
    m_Localized: Så vass att den skär luften. Tomaterna gör honnör.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138491629569
    m_Localized: Legendarisk knivbräda
    m_Metadata:
      m_Items: []
  - m_Id: 8069138491629570
    m_Localized: Den får utbrott av bubblor. Muggarna fyller sig själva.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138491629571
    m_Localized: Colavulkan
    m_Metadata:
      m_Items: []
  - m_Id: 8069138491629572
    m_Localized: Bubblor för evigt. Törsten har ingen chans.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138491629573
    m_Localized: Oändlig bubbelfontän
    m_Metadata:
      m_Items: []
  - m_Id: 8069138491629574
    m_Localized: Panerar nuggets snabbare än du hinner säga krisp.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138495823872
