  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: Notifications_ro
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: ro
  m_SharedData: {fileID: 11400000, guid: aa4f23c3016fe6d4fa68e38c9fc52637, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 5935534694400
    m_Localized: Clienții tăi sunt flămânzi! Revino și aprinde bucătăria.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694401
    m_Localized: Plita e fierbinte și comenzile se adună. E timpul să gătești!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694402
    m_Localized: O nouă zi la restaurant te așteaptă.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694403
    m_Localized: Viețile tale s-au refăcut. Gata de încă o tură?
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694404
    m_Localized: Oaspeți flămânzi stau la coadă afară. Nu-i lăsa să aștepte!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694405
    m_Localized: Recompensa ta zilnică te așteaptă!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694406
    m_Localized: Echipa ți-a simțit lipsa, chef! Treci să le spui salut.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694407
    m_Localized: Poți termina ziua următoare cu 3 stele?
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694408
    m_Localized: Au sosit ingrediente proaspete. Hai să gătim ceva gustos!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694409
    m_Localized: Îmbunătățește-ți restaurantul și fă-l subiectul orașului.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694410
    m_Localized: Șeful Hogsworth întreabă unde a dispărut bucătarul...
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694411
    m_Localized: Cartofii sunt crocanți, burgerii suculenți. Vino să-i servești!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694412
    m_Localized: O mică pauză de gătit? Bucătăria te așteaptă oricând.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694413
    m_Localized: Câștigă monede azi și dă-le ustensilelor o îmbunătățire strălucitoare.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694414
    m_Localized: Începe aglomerația de la prânz. Pune-ți șorțul!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694415
    m_Localized: Faima ta crește! Servește în continuare ca să deblochezi recompense noi.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694416
    m_Localized: Clienți noi au auzit de mâncarea ta. Vino să-i cunoști!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694417
    m_Localized: Cafeaua se face și gogoșile așteaptă. Deschide cafeneaua!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694418
    m_Localized: Încă o zi? Restaurantul te cheamă.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694419
    m_Localized: Servește repede, câștigă mult și ține-i pe toți clienții zâmbitori!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694420
    m_Localized: Chef, bucătăria are nevoie de tine! Atinge pentru a începe să gătești.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
