  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: Notifications_da
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: da
  m_SharedData: {fileID: 11400000, guid: aa4f23c3016fe6d4fa68e38c9fc52637, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 5935534694400
    m_Localized: Dine kunder er sultne! Kom tilbage og tænd op i køkkenet.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694401
    m_Localized: Stegepladen er varm, og bestillingerne hober sig op. Tid til at lave mad!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694402
    m_Localized: En ny dag i restauranten venter på dig.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694403
    m_Localized: Dine liv er fyldt op igen. Klar til endnu en vagt?
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694404
    m_Localized: Sultne gæster står i kø udenfor. Lad dem ikke vente!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694405
    m_Localized: Din daglige belønning er klar!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694406
    m_Localized: Dit personale savner dig, kok! Kom og sig hej.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694407
    m_Localized: Kan du klare næste dag med 3 stjerner?
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694408
    m_Localized: Friske ingredienser er lige kommet. Lad os lave noget lækkert!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694409
    m_Localized: Opgrader din restaurant, og bliv byens samtaleemne.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694410
    m_Localized: Boss Hogsworth spørger, hvor kokken er blevet af...
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694411
    m_Localized: Pomfritterne er sprøde, og burgerne er saftige. Kom og servér dem!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694412
    m_Localized: Trænger du til en madpause? Dit køkken er klar, når du er.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694413
    m_Localized: Tjen mønter i dag, og giv dine køkkenredskaber en skinnende opgradering.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694414
    m_Localized: Frokostrushet er i gang. Tag forklædet på!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694415
    m_Localized: Din berømmelse vokser! Bliv ved med at servere for at låse nye belønninger op.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694416
    m_Localized: Nye kunder har hørt om din mad. Kom og mød dem!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694417
    m_Localized: Kaffen brygger, og donutsene venter. Åbn caféen!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694418
    m_Localized: Én dag mere? Din restaurant kalder.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694419
    m_Localized: Server hurtigt, tjen stort, og hold alle kunder glade!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694420
    m_Localized: Kok, køkkenet har brug for dig! Tryk for at begynde at lave mad.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
