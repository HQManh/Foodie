  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: Notifications_tr
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: tr
  m_SharedData: {fileID: 11400000, guid: aa4f23c3016fe6d4fa68e38c9fc52637, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 5935534694400
    m_Localized: Müşterilerin acıktı! Geri gel ve mutfağı ateşle.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694401
    m_Localized: Izgara sıcak, siparişler birikiyor. Pişirme zamanı!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694402
    m_Localized: Restoranda yeni bir gün seni bekliyor.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694403
    m_Localized: Canların yine dolu. Bir vardiyaya daha hazır mısın?
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694404
    m_Localized: Aç misafirler dışarıda sıraya girdi. Onları bekletme!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694405
    m_Localized: Günlük ödülün alınmaya hazır!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694406
    m_Localized: Şef, personelin seni özledi! Gel bir merhaba de.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694407
    m_Localized: Sonraki günü 3 yıldızla geçebilir misin?
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694408
    m_Localized: Taze malzemeler yeni geldi. Hadi lezzetli bir şeyler pişirelim!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694409
    m_Localized: Restoranını yükselt ve şehrin dilinden düşmesin.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694410
    m_Localized: Patron Hogsworth şefin nereye gittiğini soruyor...
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694411
    m_Localized: Patatesler çıtır, burgerler sulu. Gel ve servis et!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694412
    m_Localized: Biraz yemek molası? Mutfağın hazır, sen de hazır ol.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694413
    m_Localized: Bugün altın kazan ve mutfak aletlerine parıl parıl bir yükseltme yap.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694414
    m_Localized: Öğle telaşı başlıyor. Önlüğünü kap!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694415
    m_Localized: Şöhretin artıyor! Yeni ödüller açmak için servis yapmaya devam et.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694416
    m_Localized: Yeni müşteriler yemeklerini duymuş. Gel ve onlarla tanış!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694417
    m_Localized: Kahve demleniyor, donutlar bekliyor. Kafeyi aç!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694418
    m_Localized: Bir gün daha? Restoranın seni çağırıyor.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694419
    m_Localized: Hızlı servis yap, çok kazan ve her müşteriyi gülümset!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694420
    m_Localized: Şef, mutfağın sana ihtiyacı var! Pişirmeye başlamak için dokun.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
