  m_Name: Map_sushi_it-IT
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: it-IT
  m_SharedData: {fileID: 11400000, guid: 6661c9f2ba46546428a729e8cde76aa0, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 57786321854464
    m_Localized: Palloncini vivaci rendono festoso ogni servizio di sushi.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214592
    m_Localized: Il ristorante di sushi originale.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214593
    m_Localized: Un ristorante più grande pronto per altri miglioramenti sushi.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214594
    m_Localized: Un bonsai potato con cura che aggiunge un tocco di verde rilassante.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214595
    m_Localized: Un'amichevole insegna a forma di capibara per la facciata.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214596
    m_Localized: Un gatto accogliente che invita i clienti a entrare.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214597
    m_Localized: Un bancone pieno che mostra i piatti migliori del ristorante.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214598
    m_Localized: Un tagliere sul tetto carico di sushi e roll.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214599
    m_Localized: Bandiere e tende colorate vestono la facciata del ristorante.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214600
    m_Localized: Un'elegante ospite kitsune che ordina sushi con grazia teatrale.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214601
    m_Localized: Questa capra blu adora il matcha e si esercita in allegre buone maniere a tavola.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214602
    m_Localized: Studia il menù con diligenza, ma scambia comunque il pranzo con l'eucalipto.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214603
    m_Localized: Un piccolo shishi coraggioso che sfida ogni roll di sushi a duello.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214604
    m_Localized: Un tetto tradizionale che aggiunge un piano al ristorante.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214605
    m_Localized: Uno shiba yokozuna che affronta ogni vassoio di sushi come un incontro per il titolo.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214606
    m_Localized: Sgabelli comodi per gli ospiti del sushi.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214607
    m_Localized: L'oyabun lupo parla piano e controlla il bancone del sushi con un solo sguardo.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214608
    m_Localized: Palloncini della festa
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214609
    m_Localized: Ampliamento sushi
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214610
    m_Localized: Giardino bonsai
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214611
    m_Localized: Insegna capibara
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214612
    m_Localized: Gatto portafortuna
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214613
    m_Localized: Bancone espositivo
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214614
    m_Localized: Tagliere per sushi
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214615
    m_Localized: Bandiere sushi
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214616
    m_Localized: Kitsune Ojou
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214617
    m_Localized: Aoi Yagi
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214618
    m_Localized: Koala Senpai
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214619
    m_Localized: Shishi-kun
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214620
    m_Localized: Tetto del primo piano
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214621
    m_Localized: Shiba Yokozuna
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214622
    m_Localized: Sgabelli sushi
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214623
    m_Localized: Ookami Oyabun
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214624
    m_Localized: Sushi nigiri
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214625
    m_Localized: Riso pressato a mano con sopra una fetta di pesce come una minuscola coperta.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214626
    m_Localized: Maki
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214627
    m_Localized: Arrotolato stretto nell'alga e tagliato prima che qualcuno sbirci dentro.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214628
    m_Localized: Sushi gunkan
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214629
    m_Localized: Una barchetta di alga carica di condimenti fino all'orlo.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214630
    m_Localized: Piatto di sashimi
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214631
    m_Localized: Pesce fresco tagliato sottile, senza nulla dietro cui nascondersi.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214632
    m_Localized: Tè verde
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214633
    m_Localized: Caldo e rilassante, versato per mandare via il wasabi.
    m_Metadata:
      m_Items: []
  - m_Id: 2945767655333888
    m_Localized: Un gatto accogliente che invita i clienti a entrare.
    m_Metadata:
      m_Items: []
  - m_Id: 2945767667916800
    m_Localized: Sgabelli comodi per gli ospiti del sushi.
    m_Metadata:
      m_Items: []
  - m_Id: 2945767667916801
    m_Localized: Lanterne di carta luminose che illuminano il ristorante.
    m_Metadata:
      m_Items: []
  - m_Id: 2945767667916802
    m_Localized: Un'amichevole insegna a forma di capibara per la facciata.
    m_Metadata:
      m_Items: []
  - m_Id: 2945767667916803
    m_Localized: Un'amichevole insegna a forma di capibara per la facciata.
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111104
    m_Localized: Un enorme tonno appollaiato sul tetto che mostra con orgoglio il pescato fresco del giorno.
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111105
    m_Localized: Un tagliere sul tetto carico di sushi e roll.
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111106
    m_Localized: Gatto portafortuna
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111107
    m_Localized: Sgabelli sushi
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111108
    m_Localized: Lanterne di carta
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111109
    m_Localized: Insegna capibara
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111110
    m_Localized: Insegna capibara
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111111
    m_Localized: Tonno Gigante
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111112
    m_Localized: Tagliere per sushi
    m_Metadata:
      m_Items: []
  - m_Id: 3010516803903488
    m_Localized: Le verdure sono già tagliate prima ancora di battere ciglio.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069312
    m_Localized: Lame così veloci che i cetrioli si arrendono in anticipo.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069313
    m_Localized: Affetta il pesce crudo con una morbidezza da sashimi extra.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069314
    m_Localized: Ogni taglio è un'opera d'arte. I pesci si sentono onorati.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069315
    m_Localized: Riso soffice in un lampo. I chicchi fanno la fila per essere cotti.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069316
    m_Localized: Un riso così perfetto da meritare una standing ovation.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069318
    m_Localized: Grattugia il wasabi alla velocità della luce. Lacrime facoltative.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069319
    m_Localized: Gratta così in fretta che il wasabi non se n'è accorto.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069322
    m_Localized: Fa bollire la bontà più in fretta di quanto dici «umami».
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069323
    m_Localized: Una leggenda gorgogliante che cuoce a velocità warp.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263617
    m_Localized: Tè caldo in un attimo. I clienti restano calmi e sorseggiano.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263618
    m_Localized: Versa tè perfetto e pace interiore in un colpo solo.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263619
    m_Localized: Tagliere Fulmineo
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263620
    m_Localized: Tagliere Ninja
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263621
    m_Localized: Tagliere Pesce Affilato
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263622
    m_Localized: Tagliere del Maestro Sashimi
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263623
    m_Localized: Cuociriso Turbo
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263624
    m_Localized: Cuociriso Mega
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263626
    m_Localized: Grattugia Sprint
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263627
    m_Localized: Turbine di Wasabi
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263630
    m_Localized: Pentola Rapida
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263631
    m_Localized: Calderone Umami
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263633
    m_Localized: Teiera Rapida
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263634
    m_Localized: Teiera del Maestro Zen
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069317
    m_Localized: Uno striscione sushi blu brillante che cattura ogni sguardo affamato.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069320
    m_Localized: Una fresca tenda noren blu che ondeggia dolcemente sopra l'ingresso.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069321
    m_Localized: Una vivace tenda noren rossa che accoglie gli ospiti affamati sulla porta.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263616
    m_Localized: Una lanterna di pietra muschiosa che porta un tocco di calma da tempio.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263625
    m_Localized: Striscione Sushi
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263628
    m_Localized: Noren Blu
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263629
    m_Localized: Noren Rosso
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263632
    m_Localized: Santuario di Pietra
    m_Metadata:
      m_Items: []
  - m_Id: 5836103830462464
    m_Localized: Taglia il pesce fresco in morbide strisce di sashimi.
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433984
    m_Localized: Trasforma le verdure croccanti in bastoncini ordinati.
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433985
    m_Localized: Grattugia il wasabi in una piccante sorpresa verde.
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433986
    m_Localized: Fa sobbollire il brodo in una ciotola calda e confortante.
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433987
    m_Localized: Cuoce il riso a vapore in soffice e appiccicoso oro da sushi.
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433988
    m_Localized: Prepara il tè verde, calma in ogni sorso.
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433989
    m_Localized: Grattugia
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433990
    m_Localized: Pentola
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433991
    m_Localized: Cuociriso
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433992
    m_Localized: Teiera
    m_Metadata:
      m_Items: []
  - m_Id: 5867052983115776
    m_Localized: Un avocado cremoso, il regalo preferito dell'Occidente al sushi.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053008281600
    m_Localized: Morbidi cubetti verdi pronti per un roll.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053008281601
    m_Localized: Fette vellutate che avvolgono il riso come un kimono.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475904
    m_Localized: Una tazza vuota in attesa di un tè versato con calma.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475905
    m_Localized: Tè verde montato, calmo come un giardino di Kyoto.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475906
    m_Localized: Piccoli cubetti dorati di frittata dolce.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475907
    m_Localized: Una frittata dolce arrotolata, stratificata con pazienza.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475908
    m_Localized: Fette dorate di uovo arrotolato, dolci e morbide.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475909
    m_Localized: Un pesce piatto e bianco amato dai maestri del sushi.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475910
    m_Localized: Teneri cubetti di rombo per un boccone leggero.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475911
    m_Localized: Fette bianche delicate, quasi trasparenti.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475912
    m_Localized: Un pesce argentato e lucente pieno di sapore di mare.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475913
    m_Localized: Sgombro a bocconcini pronto per un roll.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475914
    m_Localized: Fette lucide dal gusto deciso e ricco.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475915
    m_Localized: Un filetto arancione brillante dritto dalle acque fredde.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475916
    m_Localized: Cubetti di salmone pronti a guarnire una barchetta.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475917
    m_Localized: Fette di salmone burrose che si sciolgono in bocca.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475918
    m_Localized: Tonno rosso intenso, il re del mercato del pesce.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475919
    m_Localized: Cubetti di tonno per un boccone deciso e carnoso.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475920
    m_Localized: Fette color rubino tagliate con coltello da maestro.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475921
    m_Localized: Una barchetta d'alga carica di ciò che l'ospite desidera.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475922
    m_Localized: Un roll preparato proprio come piace all'ospite.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475923
    m_Localized: Riso pressato a mano con sopra il preferito dell'ospite.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475924
    m_Localized: Un piatto di fette fresche scelte su ordinazione.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475925
    m_Localized: Un limone brillante per risvegliare ogni boccone.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475926
    m_Localized: Sottili fette di limone che illuminano il pesce.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475927
    m_Localized: Maionese giapponese cremosa dal gusto delicato.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475928
    m_Localized: Un polpo crudo, tutto braccia e nessun piano.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475929
    m_Localized: Lessato rosa e tenero, pronto per il coltello.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475930
    m_Localized: Bocconcini di polpo, come takoyaki senza la pallina.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475931
    m_Localized: Fettine di tako con un fascino gommoso.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475932
    m_Localized: Riso a chicco corto, lucidato e in attesa del suo bagno.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475933
    m_Localized: Riso soffice condito con aceto, l'anima di ogni sushi.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475934
    m_Localized: Minuscole perle arancioni che scoppiano a ogni morso.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475935
    m_Localized: Uova di pesce volante croccanti che brillano come gioielli.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475936
    m_Localized: Grandi uova di salmone lucenti che esplodono di sapore di mare.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475937
    m_Localized: Fogli d'alga croccanti, tostati e pronti ad avvolgere.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475938
    m_Localized: Una foglia profumata che dà un tocco fresco e mentolato.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475939
    m_Localized: Un gambero crudo arricciato come un piccolo punto di domanda.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475940
    m_Localized: Lessato rosa e orgoglioso, pronto per il riso.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475941
    m_Localized: Gamberi a bocconcini pronti per un roll.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475942
    m_Localized: Aperto piatto come un ventaglio per il nigiri perfetto.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475943
    m_Localized: Foglie di tè verde raccolte su colline nebbiose.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475944
    m_Localized: Una radice nodosa dal carattere notoriamente pungente.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475945
    m_Localized: Un tocco verde di piccante che libera il naso.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475946
    m_Localized: Acqua fresca, pronta a diventare tè.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475947
    m_Localized: Avocado
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475948
    m_Localized: Avocado a cubetti
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475949
    m_Localized: Avocado a fette
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475950
    m_Localized: Tazza
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475951
    m_Localized: Matcha
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475952
    m_Localized: Tagliere per pesce
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475953
    m_Localized: Tagliere per verdure
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475954
