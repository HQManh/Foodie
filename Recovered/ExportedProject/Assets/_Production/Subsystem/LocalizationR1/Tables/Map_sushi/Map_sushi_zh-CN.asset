    m_Localized: 大米
    m_Metadata:
      m_Items: []
  - m_Id: 5867053016670216
    m_Localized: 寿司饭
    m_Metadata:
      m_Items: []
  - m_Id: 5867053016670217
    m_Localized: 毛鳞鱼籽
    m_Metadata:
      m_Items: []
