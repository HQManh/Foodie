  m_TableData:
  - m_Id: 57786321854464
    m_Localized: Bunte Ballons machen jeden Sushi-Service festlich.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214592
    m_Localized: Das ursprüngliche Sushi-Restaurant.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214593
    m_Localized: Ein größeres Restaurant, bereit für mehr Sushi-Upgrades.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214594
    m_Localized: Ein sauber gestutzter Bonsai, der einen ruhigen grünen Akzent setzt.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214595
    m_Localized: Ein freundliches Capybara-Schild für die Ladenfront.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214596
    m_Localized: Eine einladende Katze, die Gäste hereinwinkt.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214597
    m_Localized: Eine volle Theke mit den besten Gerichten des Restaurants.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214598
    m_Localized: Ein Schneidebrett auf dem Dach voller Sushi und Rollen.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214599
    m_Localized: Bunte Flaggen und Markisen schmücken die Restaurantfassade.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214600
    m_Localized: Ein anmutiger Kitsune-Gast, der Sushi mit theatralischer Eleganz bestellt.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214601
    m_Localized: Diese blaue Ziege liebt Matcha und übt fröhliche Tischmanieren.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214602
    m_Localized: Studiert die Karte fleißig, tauscht das Mittagessen aber trotzdem gegen Eukalyptus.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214603
    m_Localized: Ein mutiger kleiner Shishi, der jede Sushirolle zum Duell fordert.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214604
    m_Localized: Ein traditionelles Dach, das dem Restaurant eine weitere Etage gibt.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214605
    m_Localized: Ein Shiba-Yokozuna, für den jede Sushiplatte ein Meisterschaftskampf ist.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214606
    m_Localized: Bequeme Hocker für Sushi-Gäste.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214607
    m_Localized: Der Wolfs-Oyabun spricht leise und beherrscht die Sushitheke mit einem Blick.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214608
    m_Localized: Festballons
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214609
    m_Localized: Sushi-Erweiterung
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214610
    m_Localized: Bonsaigarten
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214611
    m_Localized: Capybara-Schild
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214612
    m_Localized: Glückskatze
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214613
    m_Localized: Auslagetheke
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214614
    m_Localized: Sushi-Schneidebrett
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214615
    m_Localized: Sushi-Flaggen
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214616
    m_Localized: Kitsune Ojou
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214617
    m_Localized: Aoi Yagi
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214618
    m_Localized: Koala Senpai
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214619
    m_Localized: Shishi-kun
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214620
    m_Localized: Dach des Obergeschosses
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214621
    m_Localized: Shiba Yokozuna
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214622
    m_Localized: Sushi-Hocker
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214623
    m_Localized: Ookami Oyabun
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214624
    m_Localized: Nigiri-Sushi
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214625
    m_Localized: Von Hand geformter Reis mit einer Scheibe Fisch wie eine kleine Decke.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214626
    m_Localized: Maki-Rolle
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214627
    m_Localized: Fest in Seetang gerollt und geschnitten, bevor jemand hineinspähen kann.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214628
    m_Localized: Gunkan-Sushi
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214629
    m_Localized: Ein kleines Seetangboot, bis zum Rand mit Belag beladen.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214630
    m_Localized: Sashimi-Teller
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214631
    m_Localized: Frischer Fisch, hauchdünn geschnitten, ohne etwas zu verbergen.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214632
    m_Localized: Grüner Tee
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214633
    m_Localized: Warm und beruhigend, eingeschenkt, um das Wasabi wegzuspülen.
    m_Metadata:
      m_Items: []
  - m_Id: 2945767655333888
    m_Localized: Eine einladende Katze, die Gäste hereinwinkt.
    m_Metadata:
      m_Items: []
  - m_Id: 2945767667916800
    m_Localized: Bequeme Hocker für Sushi-Gäste.
    m_Metadata:
      m_Items: []
  - m_Id: 2945767667916801
    m_Localized: Leuchtende Papierlaternen, die das Restaurant erhellen.
    m_Metadata:
      m_Items: []
  - m_Id: 2945767667916802
    m_Localized: Ein freundliches Capybara-Schild für die Ladenfront.
    m_Metadata:
      m_Items: []
  - m_Id: 2945767667916803
    m_Localized: Ein freundliches Capybara-Schild für die Ladenfront.
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111104
    m_Localized: Ein riesiger Thunfisch auf dem Dach, der stolz den frischen Fang des Tages zeigt.
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111105
    m_Localized: Ein Schneidebrett auf dem Dach voller Sushi und Rollen.
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111106
    m_Localized: Glückskatze
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111107
    m_Localized: Sushi-Hocker
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111108
    m_Localized: Papierlaternen
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111109
    m_Localized: Capybara-Schild
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111110
    m_Localized: Capybara-Schild
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111111
    m_Localized: Riesenthunfisch
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111112
    m_Localized: Sushi-Schneidebrett
    m_Metadata:
      m_Items: []
  - m_Id: 3010516803903488
    m_Localized: Das Gemüse ist geschnitten, bevor es blinzeln kann.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069312
    m_Localized: Klingen so schnell, dass sich die Gurken schon vorher ergeben.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069313
    m_Localized: Schneidet rohen Fisch mit extra Sashimi-Geschmeidigkeit.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069314
    m_Localized: Jeder Schnitt ist ein Kunstwerk. Die Fische fühlen sich geehrt.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069315
    m_Localized: Fluffiger Reis im Nu. Die Körner stehen Schlange, um gekocht zu werden.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069316
    m_Localized: Reis so perfekt, dass er Standing Ovations verdient.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069318
    m_Localized: Reibt Wasabi blitzschnell. Tränen optional.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069319
    m_Localized: Reibt so schnell, dass der Wasabi es nie kommen sah.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069322
    m_Localized: Kocht Köstlichkeit schneller, als man „Umami“ sagen kann.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069323
    m_Localized: Eine blubbernde Legende, die mit Warp-Geschwindigkeit kocht.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263617
    m_Localized: Heißer Tee im Nu. Die Gäste bleiben entspannt und nippen.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263618
    m_Localized: Schenkt perfekten Tee und inneren Frieden in einem Zug ein.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263619
    m_Localized: Flinkes Schneidebrett
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263620
    m_Localized: Ninja-Schneidebrett
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263621
    m_Localized: Schärferes Fischbrett
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263622
    m_Localized: Sashimi-Meisterbrett
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263623
    m_Localized: Turbo-Reiskocher
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263624
    m_Localized: Mega-Reiskocher
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263626
    m_Localized: Flinke Reibe
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263627
    m_Localized: Wasabi-Wirbelwind
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263630
    m_Localized: Flinker Schmortopf
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263631
    m_Localized: Umami-Kessel
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263633
    m_Localized: Schnellbrüh-Teekanne
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263634
    m_Localized: Zen-Meister-Teekanne
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069317
    m_Localized: Ein leuchtend blaues Sushi-Banner, das jeden hungrigen Blick einfängt.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069320
    m_Localized: Ein cooler blauer Noren-Vorhang, der sanft über dem Eingang schwingt.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069321
    m_Localized: Ein kräftig roter Noren-Vorhang, der hungrige Gäste an der Tür begrüßt.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263616
    m_Localized: Eine moosbewachsene Steinlaterne, die einen Hauch von Tempelruhe bringt.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263625
    m_Localized: Sushi-Banner
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263628
    m_Localized: Blauer Noren
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263629
    m_Localized: Roter Noren
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263632
    m_Localized: Steinschrein
    m_Metadata:
      m_Items: []
  - m_Id: 5836103830462464
    m_Localized: Schneidet frischen Fisch in seidige Sashimi-Streifen.
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433984
    m_Localized: Macht aus knackigem Gemüse ordentliche kleine Stifte.
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433985
    m_Localized: Reibt Wasabi zu einer scharfen grünen Überraschung.
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433986
    m_Localized: Lässt Brühe zu einer wärmenden Schüssel Wohlgefühl köcheln.
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433987
    m_Localized: Dämpft Reis zu fluffigem, klebrigem Sushi-Gold.
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433988
    m_Localized: Brüht grünen Tee – Ruhe in jedem Schluck.
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433989
    m_Localized: Reibe
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433990
    m_Localized: Topf
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433991
    m_Localized: Reiskocher
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433992
    m_Localized: Teekanne
    m_Metadata:
      m_Items: []
  - m_Id: 5867052983115776
    m_Localized: Eine cremige Avocado, das Lieblingsgeschenk des Westens an Sushi.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053008281600
    m_Localized: Weiche grüne Würfel, bereit für eine Rolle.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053008281601
    m_Localized: Seidige Scheiben, die sich wie ein Kimono über den Reis legen.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475904
    m_Localized: Ein leerer Becher wartet auf einen ruhigen Aufguss Tee.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475905
    m_Localized: Aufgeschlagener Grüntee, ruhig wie ein Garten in Kyoto.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475906
    m_Localized: Kleine goldene Würfel aus süßem Omelett.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475907
    m_Localized: Ein süßes gerolltes Omelett, mit Geduld geschichtet.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475908
    m_Localized: Goldene Scheiben vom gerollten Ei, süß und weich.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475909
    m_Localized: Ein flacher weißer Fisch, von Sushi-Meistern geschätzt.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475910
    m_Localized: Zarte Plattfischwürfel für einen leichten Happen.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475911
    m_Localized: Zarte weiße Scheiben, fast durchsichtig.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475912
    m_Localized: Ein glänzender Silberfisch voller Meeresgeschmack.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475913
    m_Localized: Mundgerechte Makrele, bereit für eine Rolle.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475914
    m_Localized: Glänzende Scheiben mit kräftigem, vollem Geschmack.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475915
    m_Localized: Ein leuchtend oranges Filet direkt aus kalten Gewässern.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475916
    m_Localized: Lachswürfel, bereit für ein kleines Boot.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475917
    m_Localized: Butterzarte Lachsscheiben, die auf der Zunge zergehen.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475918
    m_Localized: Tiefroter Thunfisch, der König des Fischmarkts.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475919
    m_Localized: Thunfischwürfel für einen kräftigen, fleischigen Biss.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475920
    m_Localized: Rubinrote Scheiben, mit Meistermesser geschnitten.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475921
    m_Localized: Ein Algenboot, beladen mit allem, was der Gast sich wünscht.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475922
    m_Localized: Eine Rolle, genau so, wie der Gast sie mag.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475923
    m_Localized: Handgeformter Reis mit dem Lieblingsbelag des Gastes.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475924
    m_Localized: Ein Teller frischer Scheiben, ganz nach Bestellung.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475925
    m_Localized: Eine frische Zitrone, die jeden Bissen weckt.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475926
    m_Localized: Dünne Zitronenscheiben, die den Fisch aufhellen.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475927
    m_Localized: Cremige japanische Mayo mit sanfter Säure.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475928
    m_Localized: Ein roher Oktopus, viele Arme und keine Pläne.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475929
    m_Localized: Rosa und zart gekocht, bereit fürs Messer.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475930
    m_Localized: Kleine Oktopushappen, wie Takoyaki ohne Kugel.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475931
    m_Localized: Dünne Tako-Scheiben mit bissfestem Charme.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475932
    m_Localized: Rundkornreis, poliert und bereit für sein Bad.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475933
    m_Localized: Lockerer Essigreis, die Seele jedes Sushis.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475934
    m_Localized: Winzige orange Perlen, die bei jedem Bissen platzen.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475935
    m_Localized: Knuspriger Fliegenfischrogen, der wie Juwelen funkelt.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475936
    m_Localized: Großer glänzender Lachsrogen, der vor Meeresgeschmack platzt.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475937
    m_Localized: Knusprige Algenblätter, geröstet und bereit zum Wickeln.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475938
    m_Localized: Ein duftendes Blatt mit frischem, minzigem Kick.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475939
    m_Localized: Eine rohe Garnele, gekrümmt wie ein kleines Fragezeichen.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475940
    m_Localized: Rosa und stolz gekocht, bereit für den Reis.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475941
    m_Localized: Mundgerechte Garnelen, bereit für eine Rolle.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475942
    m_Localized: Flach geöffnet wie ein Fächer für das perfekte Nigiri.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475943
    m_Localized: Grüntee-Blätter, gepflückt an nebligen Hängen.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475944
    m_Localized: Eine knorrige Wurzel mit berüchtigt scharfem Temperament.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475945
    m_Localized: Ein grüner Klecks Schärfe, der die Nase freimacht.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475946
    m_Localized: Frisches Wasser, bereit, Tee zu werden.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475947
    m_Localized: Avocado
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475948
    m_Localized: Avocadowürfel
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475949
    m_Localized: Avocadoscheiben
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475950
    m_Localized: Becher
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475951
    m_Localized: Matcha
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475952
    m_Localized: Fischbrett
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475953
    m_Localized: Gemüsebrett
    m_Metadata:
      m_Items: []
