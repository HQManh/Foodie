  - m_Id: 5867053016670228
    m_Localized: Geriebener Wasabi
    m_Metadata:
      m_Items: []
  - m_Id: 5867053016670229
    m_Localized: Wasser
    m_Metadata:
      m_Items: []
  - m_Id: 8069165779771392
    m_Localized: Gurken sind geschnitten, bevor sie es merken.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165817520128
    m_Localized: Samurai-Schneidebrett
    m_Metadata:
      m_Items: []
  - m_Id: 8069165821714432
    m_Localized: Ein einziger Schwung, Gemüse für eine perfekte Rolle.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165825908736
    m_Localized: Legendäres Katana-Brett
    m_Metadata:
      m_Items: []
  - m_Id: 8069165834297344
    m_Localized: Seidige Scheiben im Nu. Die Fische sind einverstanden.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165880434688
    m_Localized: Großes Sashimi-Brett
    m_Metadata:
      m_Items: []
  - m_Id: 8069165884628992
    m_Localized: So präzise Schnitte, dass selbst der Koch staunt.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165888823296
    m_Localized: Legendärer Sashimi-Altar
    m_Metadata:
      m_Items: []
  - m_Id: 8069165897211904
    m_Localized: Lockerer Reis, fertig bevor die Schüssel steht.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165901406208
    m_Localized: Turbo-Reiskocher
    m_Metadata:
      m_Items: []
  - m_Id: 8069165905600512
    m_Localized: Jedes Korn ist perfekt. Jedes Mal.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165913989120
    m_Localized: Legendärer Reisschrein
    m_Metadata:
      m_Items: []
  - m_Id: 8069165918183424
    m_Localized: Scharfe grüne Wolken, fertig in einer Sekunde.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165922377728
    m_Localized: Wasabi-Taifun
    m_Metadata:
      m_Items: []
  - m_Id: 8069165922377729
    m_Localized: So schnell, dass die Nase quer durch den Raum kribbelt.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165930766336
    m_Localized: Legendärer Wasabi-Sturm
    m_Metadata:
      m_Items: []
  - m_Id: 8069165934960640
    m_Localized: Die Brühe sprudelt im Nu voller Geschmack.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165934960641
    m_Localized: Umami-Vulkan
    m_Metadata:
      m_Items: []
  - m_Id: 8069166039818240
    m_Localized: Die leckerste Suppe der Stadt, blitzschnell serviert.
    m_Metadata:
      m_Items: []
  - m_Id: 8069166039818241
    m_Localized: Legendärer Umami-Topf
    m_Metadata:
      m_Items: []
  - m_Id: 8069166044012544
    m_Localized: Brüht Ruhe und grünen Tee schneller als je zuvor.
    m_Metadata:
      m_Items: []
  - m_Id: 8069166044012545
    m_Localized: Erleuchtete Teekanne
    m_Metadata:
      m_Items: []
  - m_Id: 8069166044012546
    m_Localized: Perfekter Tee, bevor du überhaupt tief Luft holst.
    m_Metadata:
      m_Items: []
  - m_Id: 8069166044012547
    m_Localized: Legendäre Zen-Teekanne
    m_Metadata:
      m_Items: []
