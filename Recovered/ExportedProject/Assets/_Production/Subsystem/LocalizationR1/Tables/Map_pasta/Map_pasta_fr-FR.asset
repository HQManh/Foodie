  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 2207008936681472
    m_Localized: La petite trattoria chaleureuse où commence votre histoire de pâtes.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624512
    m_Localized: Ajoute un étage chaleureux à votre trattoria.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624513
    m_Localized: Prépare une sauce onctueuse en un éclair.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624514
    m_Localized: Un tourbillon de sauce. Couvercle vivement conseillé.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624515
    m_Localized: Les tomates sont coupées en dés avant même de rougir.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624516
    m_Localized: Coupe si vite que les oignons n'ont même pas le temps de pleurer.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624517
    m_Localized: Une table à carreaux et des chaises confortables pour des pâtes en plein air.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624518
    m_Localized: Une lanterne chaleureuse qui brille près de la porte.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624519
    m_Localized: Une fière enseigne de capybara chef qui couronne le toit.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624520
    m_Localized: Une ardoise qui affiche les pâtes du jour.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624521
    m_Localized: Les sauces grésillent deux fois plus vite.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624522
    m_Localized: Grésillement renforcé débloqué. La poêle rayonne de fierté.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624523
    m_Localized: Des plantes fraîches en pot qui égaient l'entrée.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013120
    m_Localized: L'eau bout avant que vous puissiez dire al dente.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013121
    m_Localized: Une légende bouillonnante qui cuit les pâtes à la vitesse de l'éclair.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013122
    m_Localized: Une belle grappe de raisin qui décore le toit.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013123
    m_Localized: Une assiette géante de spaghetti enroulés tout en haut du toit !
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013124
    m_Localized: Sert un soda pétillant en un clin d'œil.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013125
    m_Localized: Ça pétille fort ! Une fontaine de bulles et de joie.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013126
    m_Localized: Trattoria à l'étage
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013127
    m_Localized: Mixeur à sauce
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013128
    m_Localized: Tornade de sauce
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013129
    m_Localized: Planche express
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013130
    m_Localized: Planche ninja des pâtes
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013131
    m_Localized: Table en terrasse
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013132
    m_Localized: Lanterne murale
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207424
    m_Localized: Enseigne Capy Chef
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207425
    m_Localized: Menu à la craie
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207426
    m_Localized: Poêle grésillante
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207427
    m_Localized: Poêle ardente
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207428
    m_Localized: Basilic en pot
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207429
    m_Localized: Marmite express
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207430
    m_Localized: Chaudron méga-ébullition
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207431
    m_Localized: Raisins du toit
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207432
    m_Localized: Spaghetti géants
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207433
    m_Localized: Fontaine pétillante
    m_Metadata:
      m_Items: []
  - m_Id: 2207008995401728
    m_Localized: Geyser de soda
    m_Metadata:
      m_Items: []
  - m_Id: 2508025511272448
    m_Localized: Un ours redoutable en costume rayé et fedora orné d'une rose, qui exige de généreuses portions de pâtes et un respect absolu.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243968
    m_Localized: Une chatte tigrée élégante, chapeau violet et robe assortie, qui commande ses pâtes avec un goût irréprochable et un ronron satisfait.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243969
    m_Localized: Un chinchilla soigné en uniforme bleu de facteur, qui suit l'odeur des pâtes fraîches entre deux tournées.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243970
    m_Localized: Un coq fier, haut-de-forme et écharpe tricolore, qui préside le comptoir à pâtes avec de grands discours.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243971
    m_Localized: Un mouton doux, lunettes rondes et écharpe à clochette, pour qui chaque assiette de pâtes est une véritable occasion.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243972
