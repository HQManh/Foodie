    m_Localized: Machine à soda
    m_Metadata:
      m_Items: []
  - m_Id: 4376267120959488
    m_Localized: Trattoria chaleureuse
    m_Metadata:
      m_Items: []
  - m_Id: 4741103310856192
    m_Localized: Les tomates sont hachées avant de pouvoir rougir.
    m_Metadata:
      m_Items: []
  - m_Id: 4741103344410624
    m_Localized: Planche à pâtes samouraï
    m_Metadata:
      m_Items: []
  - m_Id: 4741103344410625
    m_Localized: Un seul coup, une salade entière. Le baiser du chef.
    m_Metadata:
      m_Items: []
  - m_Id: 4741103348604928
    m_Localized: Lame à pâtes légendaire
    m_Metadata:
      m_Items: []
  - m_Id: 4741103348604929
    m_Localized: Une sauce onctueuse en un tourbillon. Serviettes conseillées.
    m_Metadata:
      m_Items: []
  - m_Id: 4741103348604930
    m_Localized: Ouragan de sauce
    m_Metadata:
      m_Items: []
  - m_Id: 4741103348604931
    m_Localized: Une sauce soyeuse à la vitesse d'une rotation.
    m_Metadata:
      m_Items: []
  - m_Id: 4741103352799232
    m_Localized: Vortex de sauce légendaire
    m_Metadata:
      m_Items: []
  - m_Id: 4741103352799233
    m_Localized: Les steaks grésillent en un clin d'œil. Écoutez ce son !
    m_Metadata:
      m_Items: []
  - m_Id: 4741103356993536
    m_Localized: Poêle infernale
    m_Metadata:
      m_Items: []
  - m_Id: 4741103356993537
    m_Localized: Grillé à la perfection avant que vous disiez bellissimo.
    m_Metadata:
      m_Items: []
  - m_Id: 4741103356993538
    m_Localized: Poêle grésillante légendaire
    m_Metadata:
      m_Items: []
  - m_Id: 4741103356993539
    m_Localized: Les pâtes sont al dente en un éclair.
    m_Metadata:
      m_Items: []
  - m_Id: 4741103356993540
    m_Localized: Marmite volcan
    m_Metadata:
      m_Items: []
  - m_Id: 4741103361187840
    m_Localized: Bout si vite que l'eau s'en aperçoit à peine.
    m_Metadata:
      m_Items: []
  - m_Id: 4741103361187841
    m_Localized: Chaudron à pâtes légendaire
    m_Metadata:
      m_Items: []
  - m_Id: 4741103361187842
