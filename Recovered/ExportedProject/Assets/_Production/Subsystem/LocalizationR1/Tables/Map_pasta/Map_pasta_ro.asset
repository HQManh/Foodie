  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: Map_pasta_ro
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: ro
  m_SharedData: {fileID: 11400000, guid: b8c57adbeaeeddd48bdbbb34b0659dca, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 2207008936681472
    m_Localized: Mica trattorie primitoare unde începe povestea ta cu paste.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624512
    m_Localized: Adaugă un etaj primitor trattoriei tale.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624513
    m_Localized: Pregătește un sos catifelat cât ai clipi.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624514
    m_Localized: Un vârtej de sos. Capacul e recomandat cu tărie.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624515
    m_Localized: Roșiile sunt tăiate cubulețe înainte să se înroșească.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624516
    m_Localized: Toacă atât de repede, încât cepele nici nu apucă să plângă.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624517
    m_Localized: O masă în carouri și scaune comode pentru paste în aer liber.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624518
    m_Localized: Un felinar cald care strălucește lângă ușă.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624519
    m_Localized: O firmă mândră cu capibara bucătar pe acoperiș.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624520
    m_Localized: O tablă cu pastele speciale ale zilei.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624521
    m_Localized: Sosurile sfârâie de două ori mai repede.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624522
    m_Localized: Sfârâit extra deblocat. Tigaia strălucește de mândrie.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624523
    m_Localized: Plante proaspete în ghivece care înviorează intrarea.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013120
    m_Localized: Apa fierbe înainte să apuci să spui al dente.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013121
    m_Localized: O legendă clocotitoare care fierbe pastele cu viteza luminii.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013122
    m_Localized: Un ciorchine plin de struguri care împodobește acoperișul.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013123
    m_Localized: O farfurie uriașă de spaghete răsucite sus pe acoperiș!
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013124
    m_Localized: Toarnă suc acidulat cât ai pocni din degete.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013125
    m_Localized: Bule din belșug! O fântână de bule și bucurie.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013126
    m_Localized: Trattoria cu etaj
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013127
    m_Localized: Blender pentru sos
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013128
    m_Localized: Tornadă de sos
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013129
    m_Localized: Tocător Rapid
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013130
    m_Localized: Tocător ninja pentru paste
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013131
    m_Localized: Masă pe terasă
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013132
    m_Localized: Felinar de perete
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207424
    m_Localized: Firmă Capy Chef
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207425
    m_Localized: Meniu cu cretă
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207426
    m_Localized: Tigaie sfârâitoare
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207427
    m_Localized: Tigaie arzătoare
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207428
    m_Localized: Busuioc în ghiveci
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207429
    m_Localized: Oală cu fierbere rapidă
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207430
    m_Localized: Ceaun cu fierbere mega
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207431
    m_Localized: Struguri pe acoperiș
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207432
    m_Localized: Spaghete uriașe
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207433
    m_Localized: Fântână acidulată
    m_Metadata:
      m_Items: []
  - m_Id: 2207008995401728
    m_Localized: Gheizer de suc
    m_Metadata:
      m_Items: []
  - m_Id: 2508025511272448
    m_Localized: Un urs impunător în costum cu dungi și fedora împodobită cu un trandafir, care așteaptă porții generoase de paste și respect absolut.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243968
    m_Localized: O pisică tărcată elegantă, cu pălărie mov și rochie asortată, care comandă paste cu gust impecabil și un tors mulțumit.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243969
    m_Localized: O chinchilla ordonată în uniformă albastră de poștaș, care urmează aroma pastelor proaspete între livrări.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243970
    m_Localized: Un cocoș mândru cu joben și eșarfă tricoloră, care prezidează tejgheaua de paste cu discursuri grandioase.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243971
    m_Localized: O oaie blândă cu ochelari rotunzi și eșarfă cu clopoțel, pentru care fiecare farfurie de paste e o ocazie specială.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243972
    m_Localized: Măr
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243973
    m_Localized: Măr feliat
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243974
    m_Localized: Don Orsino
    m_Metadata:
      m_Items: []
  - m_Id: 2508025536438272
    m_Localized: Friptură de vită la grătar
    m_Metadata:
      m_Items: []
  - m_Id: 2508025536438273
    m_Localized: Friptură de vită crudă
    m_Metadata:
      m_Items: []
  - m_Id: 2508025536438274
    m_Localized: Oală de fiert
    m_Metadata:
      m_Items: []
  - m_Id: 2508025536438275
