    m_Metadata:
      m_Items: []
  - m_Id: 2508025536438303
    m_Localized: Maioneză
    m_Metadata:
      m_Items: []
  - m_Id: 2508025536438304
    m_Localized: Carne și fructe de mare
    m_Metadata:
      m_Items: []
  - m_Id: 2508025536438305
    m_Localized: Meniu mare
    m_Metadata:
      m_Items: []
  - m_Id: 2508025536438306
    m_Localized: Lapte
    m_Metadata:
