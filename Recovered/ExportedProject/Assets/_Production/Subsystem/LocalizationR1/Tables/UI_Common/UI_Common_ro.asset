    m_Metadata:
      m_Items: []
  - m_Id: 57759218262028
    m_Localized: 'Servite: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 57759218262029
    m_Localized: Încearcă să îți îmbunătățești restaurantul
    m_Metadata:
      m_Items: []
  - m_Id: 57759218262030
    m_Localized: Iată obiectele pe care le poți cumpăra
    m_Metadata:
      m_Items: []
  - m_Id: 57759218262031
    m_Localized: Cu monedele câștigate ieri, hai să îmbunătățim ceva!
    m_Metadata:
      m_Items: []
  - m_Id: 57759218262032
    m_Localized: Acum să mergem la fila de îmbunătățire a ustensilelor!
    m_Metadata:
      m_Items: []
  - m_Id: 57759218262033
    m_Localized: Încearcă să îmbunătățești această plită!
    m_Metadata:
      m_Items: []
  - m_Id: 57759218262034
    m_Localized: Acum că ai îmbunătățit prăjitorul, să ne întoarcem și să începem ziua!
    m_Metadata:
      m_Items: []
  - m_Id: 57759218262035
    m_Localized: Acum să începem ziua!
    m_Metadata:
      m_Items: []
  - m_Id: 57759218262036
    m_Localized: Încearcă acest bonus!
    m_Metadata:
      m_Items: []
  - m_Id: 57759218262037
    m_Localized: Când gătești, ai șansa să intri într-o stare specială!
    m_Metadata:
      m_Items: []
  - m_Id: 57759218262038
    m_Localized: Cu fiecare client servit, bara crește! Încearcă să mai servești {0} clienți!
    m_Metadata:
      m_Items: []
  - m_Id: 57759222456320
    m_Localized: Cu fiecare fel servit, bara crește! Încearcă să mai servești {0} feluri!
    m_Metadata:
      m_Items: []
  - m_Id: 57759222456321
    m_Localized: Grozav! În Explozia de arome gătești super eficient. Distracție plăcută!
    m_Metadata:
      m_Items: []
  - m_Id: 57759222456322
    m_Localized: Nu ai destule monede pentru a construi
    m_Metadata:
      m_Items: []
