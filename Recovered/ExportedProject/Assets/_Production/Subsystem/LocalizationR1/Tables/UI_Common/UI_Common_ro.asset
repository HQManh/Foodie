      m_Items: []
  - m_Id: 57759218262023
    m_Localized: Ziua {0} - {1}
    m_Metadata:
      m_Items: []
  - m_Id: 57759218262024
    m_Localized: Treci de ziua {0} a restaurantului anterior pentru a debloca.
    m_Metadata:
      m_Items: []
  - m_Id: 57759218262025
    m_Localized: Greu
    m_Metadata:
      m_Items: []
