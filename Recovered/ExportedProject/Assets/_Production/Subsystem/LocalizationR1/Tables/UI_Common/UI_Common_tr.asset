    m_Metadata:
      m_Items: []
  - m_Id: 5326573631692800
    m_Localized: Altın profil resmi çerçevesi ve altın isim
    m_Metadata:
      m_Items: []
  - m_Id: 5326573631692801
    m_Localized: '<color=yellow>Paketleme Bileti</color> sona erdi! Bonusların artık aktif değil. Yeni <color=yellow>Paketleme Bileti</color> yakında başlayacak!'
