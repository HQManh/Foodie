    m_Localized: Szint MAX
    m_Metadata:
      m_Items: []
  - m_Id: 57759222456324
    m_Localized: '{0}. szint'
    m_Metadata:
      m_Items: []
  - m_Id: 57759222456325
    m_Localized: Nincs elég {0}
    m_Metadata:
      m_Items: []
