    m_Metadata:
      m_Items: []
  - m_Id: 57808354533384
    m_Localized: Gratulálunk a saját gyorséttermedhez!
    m_Metadata:
      m_Items: []
  - m_Id: 57808354533385
    m_Localized: Kezdjük az üzletet!
    m_Metadata:
      m_Items: []
  - m_Id: 57808354533386
    m_Localized: Egy szaftos burgert szeretne
    m_Metadata:
      m_Items: []
