  - m_Id: 5326573593944064
    m_Localized: '<color=#7CF73F>INGYENES</color> JUTALMAK'
    m_Metadata:
      m_Items: []
  - m_Id: 5326573593944065
    m_Localized: Szabad életek
    m_Metadata:
      m_Items: []
  - m_Id: 5326573593944066
