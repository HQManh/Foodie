      m_Items: []
  - m_Id: 57762263326720
    m_Localized: Automata főzés
    m_Metadata:
      m_Items: []
  - m_Id: 57762263326721
    m_Localized: Automatikusan összegyűjti a hozzávalókat és elkészít egy ételt
    m_Metadata:
      m_Items: []
  - m_Id: 57762741477376
    m_Localized: Seprű
    m_Metadata:
      m_Items: []
  - m_Id: 57762741477377
    m_Localized: Eltávolít egy koszos halmot az asztalról
    m_Metadata:
      m_Items: []
  - m_Id: 57763244793856
    m_Localized: Csipesz
    m_Metadata:
      m_Items: []
  - m_Id: 57763244793857
    m_Localized: Válassz szabadon egy hozzávalótányért.
    m_Metadata:
      m_Items: []
  - m_Id: 57763660029952
    m_Localized: Több hely kell?
    m_Metadata:
      m_Items: []
