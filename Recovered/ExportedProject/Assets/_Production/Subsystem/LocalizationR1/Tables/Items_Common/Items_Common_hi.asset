  m_TableData:
  - m_Id: 57744517226496
    m_Localized: असीमित दिल
    m_Metadata:
      m_Items: []
  - m_Id: 57744529809408
    m_Localized: सीमित समय के लिए असीमित दिल देता है।
    m_Metadata:
      m_Items: []
  - m_Id: 57744529809409
    m_Localized: कोई विज्ञापन नहीं
    m_Metadata:
      m_Items: []
  - m_Id: 57744529809410
    m_Localized: अनिवार्य और बैनर विज्ञापन हमेशा के लिए हटाता है।
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772544
    m_Localized: तुरंत अपने आप एक डिश बना देता है।
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772545
    m_Localized: मेज़ से एक गंदा ढेर हटाएं।
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772546
    m_Localized: कोई भी एक सामग्री प्लेट चुनें।
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772547
    m_Localized: ग्राहकों का इंतज़ार समय बहाल करें ताकि वे ज़्यादा देर रुकें।
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772548
    m_Localized: सामग्री की पंक्तियाँ बदलें।
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772549
    m_Localized: दिल में जुनून के बिना कोई शेफ़ खाना नहीं बना सकता
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772550
    m_Localized: "दिखाता है कि लोग आपके रेस्टोरेंट को कितना पसंद करते हैं!\r\nजितनी ज़्यादा प्रसिद्धि, उतने ज़्यादा सरप्राइज़!"
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772551
    m_Localized: ऑटो कुक
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772552
    m_Localized: झाड़ू
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772553
    m_Localized: चिमटा
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772554
    m_Localized: शांत ग्राहक
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772555
    m_Localized: पंक्ति बदलें
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772556
    m_Localized: बर्गर स्टॉल
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772557
    m_Localized: कॉफ़ी और बेकरी
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772558
    m_Localized: हीरे
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772559
    m_Localized: खाना पकाने का जुनून
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772560
    m_Localized: रेस्टोरेंट की प्रसिद्धि
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772561
    m_Localized: सुशी
    m_Metadata:
      m_Items: []
  - m_Id: 5836111170494464
    m_Localized: आइसक्रीम
    m_Metadata:
      m_Items: []
  - m_Id: 5836111191465984
    m_Localized: पास्ता
    m_Metadata:
      m_Items: []
  - m_Id: 5867060067295232
    m_Localized: ब्रॉयलर ओवन
    m_Metadata:
      m_Items: []
  - m_Id: 5867060105043968
    m_Localized: कोयले की ग्रिल
    m_Metadata:
      m_Items: []
  - m_Id: 5867060105043969
    m_Localized: सॉते पैन
    m_Metadata:
      m_Items: []
  - m_Id: 5867060105043970
    m_Localized: सीफ़ूड प्रेप बोर्ड
    m_Metadata:
      m_Items: []
  - m_Id: 5867060105043971
    m_Localized: स्टॉकपॉट
    m_Metadata:
      m_Items: []
  - m_Id: 8095975175348224
    m_Localized: सैंडविच
    m_Metadata:
      m_Items: []
  - m_Id: 8100556793962496
    m_Localized: सीफ़ूड
    m_Metadata:
      m_Items: []
