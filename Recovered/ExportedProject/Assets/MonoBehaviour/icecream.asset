  schemaVersion: 1
  sourceGraphJson: "{\r\n  \"_note\": \"Official WebP artwork restored for the designer-renamed graph. Current node names, labels, IDs, recipe edges, quantities, map settings and layout preserved.\",\r\n  \"_foodOrderableMap\": {\r\n    \"ice cream cone\": [\r\n      \"icecream_cone_icon\"\r\n    ],\r\n    \"ice cream cup\": [\r\n      \"icecream_cup_icon\"\r\n    ],\r\n    \"smoothie\": [\r\n      \"smoothie_icon\"\r\n    ],\r\n    \"milkshake\": [\r\n      \"milkshake_icon\"\r\n    ],\r\n    \"shave ice cream\": [\r\n      \"shave_icecream_icon\"\r\n    ]\r\n  },\r\n  \"_derivation\": [\r\n    {\r\n      \"food\": \"ice cream cone\",\r\n      \"source\": \"User-approved CookOrder production brief\",\r\n      \"decision\": \"Cone Batter is automatically shaped by the Cone Maker. One Ice Cream Base flavor combines with the Waffle Cone; shared toppings are optional.\"\r\n    },\r\n    {\r\n      \"food\": \"ice cream cup\",\r\n      \"source\": \"User-approved CookOrder production brief\",\r\n      \"decision\": \"The Cup is the dish base and combines directly with one Ice Cream Base flavor; shared toppings are optional.\"\r\n    },\r\n    {\r\n      \"food\": \"smoothie\",\r\n      \"source\": \"User-approved CookOrder production brief\",\r\n      \"decision\": \"Fruit (cut first only when needed), Ice Cube and Greek Yogurt are all required in the Blender for each of six smoothie flavors. Fruit and front decorations may coexist; behind decorations and syrups are excluded. Whipping Cream is an optional separate drink topping, so cream, fruit and a front decoration can coexist.\"\r\n    },\r\n    {\r\n      \"food\": \"milkshake\",\r\n      \"source\": \"User-approved CookOrder production brief\",\r\n      \"decision\": \"Milk and one Ice Cream Base flavor are mixed on demand in the Milkshake Mixer, then combined with a Cup. Fruit and front decorations are optional and may appear together; behind decorations and syrups are excluded. Whipping Cream is available as an optional drink topping.\"\r\n    },\r\n    {\r\n      \"food\": \"shave ice cream\",\r\n      \"source\": \"User-approved CookOrder production brief\",\r\n      \"decision\": \"Ice Cube is automatically processed into Shaved Ice, then exactly one dedicated shave-ice syrup is required; behind decorations and either fruit or front decoration remain optional.\"\r\n    }\r\n  ],\r\n  \"_imagePolicy\": {\r\n    \"provider\": \"Bundled official WebP assets\",\r\n    \"assetRoot\": \"src/assets/Map5-ice-cream\",\r\n    \"manifest\": \"docs/official-sandwich-ice-cream-assets.json\",\r\n    \"retainedEnvironmentManifest\": \"docs/preview_asset_manifests/102-ice-cream-combinations.json\"\r\n  },\r\n  \"schemaVersion\": 1,\r\n  \"map\": {\r\n    \"id\": \"icecream\",\r\n    \"name\": \"Ice Cream\",\r\n    \"gridWidth\": 5,\r\n    \"gridHeight\": 2,\r\n    \"dirtyStackHeight\": 5,\r\n    \"visibleRows\": 3,\r\n    \"processSpeedMultiplier\": 1.5,\r\n    \"mergeSpeedMultiplier\": 1\r\n  },\r\n  \"idTable\": {\r\n    \"ingredient\": [\r\n      \"Icon_ConeBatter\",\r\n      \"Icon_IceCreamTrayVanilla\",\r\n      \"Icon_IceCreamTrayStrawberry\",\r\n      \"Icon_ice_cream_tray_chocolate\",\r\n      \"Icon_IceCreamTrayMatcha\",\r\n      \"Icon_ice_cream_tray_grape\",\r\n      \"Icon_IceCreamTrayMango\",\r\n      \"Icon_Milk\",\r\n      \"Icon_Ice\",\r\n      \"Icon_Strawberry\",\r\n      \"Icon_Banana\",\r\n      \"Icon_Kiwi\",\r\n      \"Icon_Biscuits\",\r\n      \"Icon_Pocky\",\r\n      \"Icon_Ingredient_Sprinkles\",\r\n      \"Icon_CherrySyrup\",\r\n      \"Icon_GrapeSyrup\",\r\n      \"Icon_LemonSyrup\",\r\n      \"Icon_Strawberry_cut\",\r\n      \"Icon_Banana_cut\",\r\n      \"Icon_Kiwi_cut\",\r\n      \"Icon_Cone\",\r\n      \"Icon_Milkshake_Vanilla1\",\r\n      \"Icon_Milkshake_Strawberry1\",\r\n      \"Icon_Milkshake_Choco1\",\r\n      \"Icon_Milkshake_Matcha1\",\r\n      \"Icon_Milkshake_Grape1\",\r\n      \"Icon_Milkshake_Mango1\",\r\n      \"Icon_Smoothie_Strawberry\",\r\n      \"Icon_Smoothie_Banana\",\r\n      \"Icon_Smoothie_Coconut\",\r\n      \"Icon_ShaveIce\",\r\n      \"Icon_Blueberry1\",\r\n      \"Icon_Avocado\",\r\n      \"Icon_Orange\",\r\n      \"Icon_Avocado_cut\",\r\n      \"Icon_orange_slice\",\r\n      \"Icon_Smoothie_Blueberry\",\r\n      \"Icon_Smoothie_Avocado\",\r\n      \"Icon_Smoothie_Orange\",\r\n      \"Icon_SyrupTopping1\",\r\n      \"Icon_SyrupTopping2\",\r\n      \"Icon_RainbowJelly\",\r\n      \"Icon_WhiteJelly\",\r\n      \"Icon_Cherry\",\r\n      \"Icon_Coconut\",\r\n      \"Icon_GreenAppleSyrup\",\r\n      \"Icon_GreekYogurt\",\r\n      \"Icon_WhippingCream\",\r\n      \"Icon_Coconut_slice\"\r\n    ],\r\n    \"composite\": [\r\n      \"ice-cream-cone-core\",\r\n      \"icecream_cone_icon\",\r\n      \"icecream_cup_icon\",\r\n      \"smoothie_icon\",\r\n      \"milkshake_icon\",\r\n      \"shave_icecream_icon\",\r\n      \"shave-ice-core\",\r\n      \"milkshake-whipped-cream\",\r\n      \"smoothie-whipped-cream\"\r\n    ],\r\n    \"group\": [\r\n      \"ice-cream-flavor-choice\",\r\n      \"milkshake-flavor-choice\",\r\n      \"smoothie-flavor-choice\",\r\n      \"shave-ice-syrup-choice\",\r\n      \"shared-toppings\",\r\n      \"shave-ice-toppings\",\r\n      \"fruit-topping\",\r\n      \"jelly-choice\",\r\n      \"behind-decor-topping\",\r\n      \"smoothie-decor-topping\",\r\n      \"milkshake-toppings\",\r\n      \"topping-syrup-choice\",\r\n      \"smoothie-toppings\",\r\n      \"cream-finish-choice\",\r\n      \"whipped-cream-extras\"\r\n    ],\r\n    \"tool\": [\r\n      \"Icon_CuttingBoard\",\r\n      \"Icon_ConeMaker_1\",\r\n      \"Icon_Blender_1\",\r\n      \"Icon_IceShaver_1\",\r\n      \"Icon_Milkshaker_1\"\r\n    ],\r\n    \"dirty\": []\r\n  },\r\n  \"vertices\": {\r\n    \"ingredient\": [\r\n      {\r\n        \"name\": \"Icon_Strawberry\",\r\n        \"displayName\": \"Strawberry\",\r\n        \"pickupable\": true,\r\n        \"price\": 5,\r\n        \"stackMin\": 1,\r\n        \"stackMax\