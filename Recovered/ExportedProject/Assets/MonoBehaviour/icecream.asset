        \"emoji\": \"🍏\",\r\n        \"localImage\": \"Map5-ice-cream/Ingredients/Raw Food/ShavedIce_syrup/Icon_GreenAppleSyrup.webp\"\r\n      },\r\n      {\r\n        \"name\": \"Icon_Biscuits\",\r\n        \"displayName\": \"Chocolate Sandwich Biscuits\",\r\n        \"pickupable\": true,\r\n        \"pieceIndex\": \"7\",\r\n        \"localImage\": \"Map5-ice-cream/Ingredients/Raw Food/Icon_Biscuits.webp\",\r\n        \"emoji\": \"🍦\"\r\n      },\r\n      {\r\n        \"name\": \"Icon_Pocky\",\r\n        \"displayName\": \"Pocky\",\r\n        \"pickupable\": true,\r\n        \"pieceIndex\": \"8\",\r\n        \"localImage\": \"Map5-ice-cream/Ingredients/Raw Food/Icon_Pocky.webp\",\r\n        \"emoji\": \"🍦\"\r\n      },\r\n      {\r\n        \"name\": \"Icon_Ingredient_Sprinkles\",\r\n        \"displayName\": \"Sprinkles\",\r\n        \"pickupable\": true,\r\n        \"pieceIndex\": \"9\",\r\n        \"localImage\": \"Map5-ice-cream/Ingredients/Raw Food/Icon_Ingredient_Sprinkles.webp\",\r\n        \"emoji\": \"🍦\"\r\n      },\r\n      {\r\n        \"name\": \"Icon_IceCreamTrayVanilla\",\r\n        \"displayName\": \"Vanilla Ice Cream Base\",\r\n        \"pickupable\": true,\r\n        \"price\": 8,\r\n        \"stackMin\": 1,\r\n        \"stackMax\": 5,\r\n        \"pieceIndex\": \"10\",\r\n        \"emoji\": \"🍨\",\r\n        \"localImage\": \"Map5-ice-cream/Ingredients/Raw Food/IceCreamTray/Icon_IceCreamTrayVanilla.webp\"\r\n      },\r\n      {\r\n        \"name\": \"Icon_IceCreamTrayStrawberry\",\r\n        \"displayName\": \"Strawberry Ice Cream Base\",\r\n        \"pickupable\": true,\r\n        \"price\": 8,\r\n        \"stackMin\": 1,\r\n        \"stackMax\": 5,\r\n        \"pieceIndex\": \"11\",\r\n        \"localImage\": \"Map5-ice-cream/Ingredients/Raw Food/IceCreamTray/Icon_IceCreamTrayStrawberry.webp\",\r\n        \"emoji\": \"🍦\"\r\n      },\r\n      {\r\n        \"name\": \"Icon_ice_cream_tray_chocolate\",\r\n        \"displayName\": \"Chocolate Ice Cream Base\",\r\n        \"pickupable\": true,\r\n        \"price\": 8,\r\n        \"stackMin\": 1,\r\n        \"stackMax\": 5,\r\n        \"pieceIndex\": \"12\",\r\n        \"localImage\": \"Map5-ice-cream/Ingredients/Raw Food/IceCreamTray/Icon_ice_cream_tray_chocolate.webp\",\r\n        \"emoji\": \"🍦\"\r\n      },\r\n      {\r\n        \"name\": \"Icon_IceCreamTrayMatcha\",\r\n        \"displayName\": \"Matcha Ice Cream Base\",\r\n        \"pickupable\": true,\r\n        \"price\": 8,\r\n        \"stackMin\": 1,\r\n        \"stackMax\": 5,\r\n        \"pieceIndex\": \"13\",\r\n        \"localImage\": \"Map5-ice-cream/Ingredients/Raw Food/IceCreamTray/Icon_IceCreamTrayMatcha.webp\",\r\n        \"emoji\": \"🍦\"\r\n      },\r\n      {\r\n        \"name\": \"Icon_ice_cream_tray_grape\",\r\n        \"displayName\": \"Grape Ice Cream Base\",\r\n        \"pickupable\": true,\r\n        \"price\": 8,\r\n        \"stackMin\": 1,\r\n        \"stackMax\": 5,\r\n        \"pieceIndex\": \"14\",\r\n        \"localImage\": \"Map5-ice-cream/Ingredients/Raw Food/IceCreamTray/Icon_ice_cream_tray_grape.webp\",\r\n        \"emoji\": \"🍦\"\r\n      },\r\n      {\r\n        \"name\": \"Icon_IceCreamTrayMango\",\r\n        \"displayName\": \"Mango Ice Cream Base\",\r\n        \"pickupable\": true,\r\n        \"price\": 8,\r\n        \"stackMin\": 1,\r\n        \"stackMax\": 5,\r\n        \"pieceIndex\": \"22\",\r\n        \"localImage\": \"Map5-ice-cream/Ingredients/Raw Food/IceCreamTray/Icon_IceCreamTrayMango.webp\",\r\n        \"emoji\": \"🥭\"\r\n      },\r\n      {\r\n        \"name\": \"Icon_ConeBatter\",\r\n        \"displayName\": \"Cone Batter\",\r\n        \"pickupable\": true,\r\n        \"price\": 4,\r\n        \"stackMin\": 1,\r\n        \"stackMax\": 5,\r\n        \"pieceIndex\": \"16\",\r\n        \"localImage\": \"Map5-ice-cream/Ingredients/Raw Food/Icon_ConeBatter.webp\",\r\n        \"emoji\": \"🍦\"\r\n      },\r\n      {\r\n        \"name\": \"Icon_Milk\",\r\n        \"d