  m_TableData:
  - m_Id: 57799240310784
    m_Localized: बाद में उपलब्ध
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059520
    m_Localized: नीचे
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059521
    m_Localized: बनाएं
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059522
    m_Localized: निर्माण प्रगति
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059523
    m_Localized: "भवन\r\nअपग्रेड"
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059524
    m_Localized: प्राप्त करें
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059525
    m_Localized: प्राप्त किया
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059526
    m_Localized: अनलॉक करने के लिए और प्रसिद्धि जुटाएं
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059527
    m_Localized: जल्द आ रहा है
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059528
    m_Localized: और रसोई उपकरण अनलॉक करने के लिए पिछले मैप के सभी दिन पूरे करें।
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059529
    m_Localized: पूरा हुआ
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059530
    m_Localized: दैनिक उपहार
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059531
    m_Localized: दैनिक इनाम
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059532
    m_Localized: प्रोफ़ाइल संपादित करें
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059533
    m_Localized: मुफ़्त
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059534
    m_Localized: मुफ़्त
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059535
    m_Localized: भरा हुआ
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059536
    m_Localized: इस सहायक को रखें
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059537
    m_Localized: बनाने के लिए दबाए रखें
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059538
    m_Localized: रसोई उपकरण
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059539
    m_Localized: भाषा
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059540
    m_Localized: खेलने के लिए जीवन चाहिए
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059541
    m_Localized: लॉक
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059542
    m_Localized: मैप लॉक है
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059543
    m_Localized: अधिकतम
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059544
    m_Localized: और जीवन
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059545
    m_Localized: संगीत
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059546
    m_Localized: 'नाम:'
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059547
    m_Localized: नई रेसिपी!
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059548
    m_Localized: पालतू जानकारी
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059549
    m_Localized: मुनाफ़ा बूस्ट
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059550
    m_Localized: रेसिपी गाइड
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059551
    m_Localized: 'बाकी उपयोग:'
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059552
    m_Localized: "रेस्टोरेंट\r\nअपग्रेड"
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059553
    m_Localized: खरीदारी बहाल करें
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059554
    m_Localized: सहेजें
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059555
    m_Localized: विवरण देखने के लिए एक सहायक चुनें
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059556
    m_Localized: सेटिंग्स
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059557
    m_Localized: ध्वनि
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059558
    m_Localized: स्टाफ़
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059559
    m_Localized: जारी रखने के लिए टैप करें
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059560
    m_Localized: "बहुत तेज़\r\nबहुत बेरुखी"
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059561
    m_Localized: "उपकरण\r\nअपग्रेड"
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059562
    m_Localized: ऊपर
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059563
    m_Localized: नए सहायक देखने के लिए मैप अनलॉक करें
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059564
    m_Localized: अपग्रेड
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059565
    m_Localized: भवन अपग्रेड करें
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059566
    m_Localized: कंपन
    m_Metadata:
      m_Items: []
  - m_Id: 2945780502487040
    m_Localized: '@उपयोगकर्ता नाम'
    m_Metadata:
      m_Items: []
  - m_Id: 3034646609649664
    m_Localized: देखें
    m_Metadata:
      m_Items: []
  - m_Id: 3313051225808896
    m_Localized: बढ़िया
    m_Metadata:
      m_Items: []
  - m_Id: 8016685305946112
    m_Localized: प्रगति सहेजें
    m_Metadata:
      m_Items: []
