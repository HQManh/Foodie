  m_TableData:
  - m_Id: 57744517226496
    m_Localized: Unbegrenzte Herzen
    m_Metadata:
      m_Items: []
  - m_Id: 57744529809408
    m_Localized: Gewährt für begrenzte Zeit unbegrenzt Herzen.
    m_Metadata:
      m_Items: []
  - m_Id: 57744529809409
    m_Localized: Keine Werbung
    m_Metadata:
      m_Items: []
  - m_Id: 57744529809410
    m_Localized: Entfernt Pflicht- und Bannerwerbung dauerhaft.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772544
    m_Localized: Bereitet sofort automatisch ein Gericht zu.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772545
    m_Localized: Entfernt einen schmutzigen Stapel vom Tisch.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772546
    m_Localized: Wähle einen beliebigen Zutatenteller.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772547
    m_Localized: Stellt die Wartezeit der Gäste wieder her, damit sie länger bleiben.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772548
    m_Localized: Tauscht Zutatenreihen.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772549
    m_Localized: Kein Koch kocht ohne Leidenschaft im Herzen
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772550
    m_Localized: "Zeigt, wie sehr die Leute dein Restaurant lieben!\r\nJe mehr Ruhm, desto mehr Überraschungen!"
    m_Metadata:
      m_Items: []
