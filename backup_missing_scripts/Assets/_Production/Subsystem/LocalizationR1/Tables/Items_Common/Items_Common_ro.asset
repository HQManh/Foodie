  m_TableData:
  - m_Id: 57744517226496
    m_Localized: Inimi nelimitate
    m_Metadata:
      m_Items: []
  - m_Id: 57744529809408
    m_Localized: Oferă inimi nelimitate pentru o perioadă limitată.
    m_Metadata:
      m_Items: []
  - m_Id: 57744529809409
    m_Localized: Fără reclame
    m_Metadata:
      m_Items: []
  - m_Id: 57744529809410
    m_Localized: Elimină definitiv reclamele obligatorii și bannerele.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772544
    m_Localized: Gătește automat și instant un fel de mâncare.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772545
    m_Localized: Îndepărtează un teanc murdar de pe masă.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772546
    m_Localized: Alege liber o farfurie cu ingrediente.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772547
    m_Localized: Refă timpul de așteptare al clienților, ca să rămână mai mult.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772548
    m_Localized: Schimbă rândurile de ingrediente.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772549
    m_Localized: Niciun bucătar nu gătește fără pasiune în suflet
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772550
    m_Localized: "Arată cât de mult iubesc oamenii restaurantul tău!\r\nCu cât ai mai multă faimă, cu atât mai multe surprize!"
    m_Metadata:
      m_Items: []
