  m_SharedData: {fileID: 11400000, guid: 70ba2199d21f4314980f738ed34bd399, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 57789920567296
    m_Localized: Banca de hambúrgueres inicial. Tua desde o início.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927424
    m_Localized: Uma casa de hambúrgueres completa, com fachada maior e mais espaço para decorações.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927425
    m_Localized: Doce como mel e duas vezes mais fofinho quando chegam as batatas.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927426
    m_Localized: Grelhado na perfeição, este hambúrguer está no ponto.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927427
    m_Localized: Mal passado, cru e ansioso pela chapa.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927428
    m_Localized: Pequeno quadro de ementa junto à porta.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927429
    m_Localized: Painel publicitário alto à frente da loja.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927430
    m_Localized: Empilhado, em camadas e absolutamente embalado.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927431
    m_Localized: Frita os ingredientes até ficarem dourados e estaladiços.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927432
    m_Localized: Serve cola gaseificada.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927433
    m_Localized: Corta os ingredientes em pedaços.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927434
    m_Localized: Pão tostado com rabinho de aço.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927435
    m_Localized: Um pão que finalmente se abriu sobre os seus sentimentos.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927436
    m_Localized: Um pão macio ainda na preguiça.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927437
    m_Localized: De onde vêm os ingredientes.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927438
    m_Localized: Letreiro do restaurante montado acima do telhado.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927439
    m_Localized: Descontraído demais para ter pressa, pede sempre com um ronronar no momento certo.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927440
    m_Localized: Patinhas pequenas, apetite enorme e zero vergonha de pedir queijo extra.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927441
    m_Localized: Um bloco de lacticínio com um potencial de ralar.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927442
    m_Localized: Queijo fatiado, pronto para derreter corações.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927443
    m_Localized: Ouro derretido que torna tudo fantástico.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927444
    m_Localized: Peito vestido de farinha, pronto para a estreia estaladiça.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927445
    m_Localized: Simples e pálido, ainda à espera da grande fritura.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927446
    m_Localized: Estaladiço por fora, suculento por dentro, de lamber os dedos.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927447
    m_Localized: Um pequeno nugget com a sua armadura de farinha.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927448
    m_Localized: Pequeno, do tamanho de uma dentada e a sonhar com a fritadeira.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927449
    m_Localized: Coxa com casaco de farinha, bem roliça e pronta.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927450
    m_Localized: O corte mais suculento, ainda a esconder o seu potencial.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927451
    m_Localized: Asas panadas antes de aprenderem a voar.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927452
    m_Localized: Uma asa que ainda não tem nada de estaladiço.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927453
    m_Localized: Pó vermelho que traz o calor, sem calma nenhuma.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927454
    m_Localized: Caules verdes com uma ligeira inveja da cebola.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927455
    m_Localized: Confetes verdes minúsculos para uma festa estaladiça.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927456
    m_Localized: Um copo vazio com sede de propósito.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927457
    m_Localized: Refrigerante escuro a borbulhar de entusiasmo.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927458
    m_Localized: Cola com gelo, servida com muita frieza.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927459
    m_Localized: Montado na hora e melhor comido antes que o pão desista.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927460
    m_Localized: Bolhas geladas que tornam cada dentada no hambúrguer mais animada.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927461
    m_Localized: Dourado por fora, suculento por dentro e desaparece em quatro dentadas.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927462
    m_Localized: Quentes, salgadas e impossíveis de partilhar de forma justa.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927463
    m_Localized: Um pequeno cliente fiel que trata cada hambúrguer como um tesouro de abanar a cauda.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927464
    m_Localized: Frágil, vai rachar sob pressão.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927465
    m_Localized: Estrelado e ovo-timista como nunca.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927466
    m_Localized: Frita a comida até ficar dourada e estaladiça.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927467
    m_Localized: Cobre os ingredientes com uma camada de polme.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927468
    m_Localized: Água que decidiu manter a calma, bem fresca.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927469
    m_Localized: Tudo o que é estaladiço numa caixa, um banquete glorioso.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927470
    m_Localized: 'Folhas verdes estaladiças: que a salada comece!'
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927471
    m_Localized: Folhas cortadas que finalmente deixaram a cabeça.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927472
    m_Localized: Uma alface inteira com a cabeça no lugar.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927473
    m_Localized: Fio de luzes ao longo do lado esquerdo.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927474
    m_Localized: Letreiro do restaurante montado acima do telhado.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927475
    m_Localized: Gere a hora de ponta como uma reunião de administração e exige pickles premium.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927476
    m_Localized: Planta em vaso junto à entrada.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927477
    m_Localized: Uma batata humilde com sonhos de estrela das batatas fritas.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927478
    m_Localized: Cortada em palitos, agora uma batata frita à espera.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927479
    m_Localized: Batatas douradas quentes o suficiente para começar um debate sobre o sal.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927480
    m_Localized: Batatas enterradas em queijo, sem arrependimentos.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927481
    m_Localized: Chega aos saltos cheia de fome e sai com migalhas nas duas bochechas.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927482
    m_Localized: O estafeta de cauda vermelha mais rápido da cidade, a menos que alguém deixe cair uma batata.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927483
    m_Localized: Roxa, pungente e secretamente emotiva.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927484
    m_Localized: Rodelas que fizeram o chef chorar.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927485
    m_Localized: Um hambúrguer gigante decorativo em cima do telhado.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927486
    m_Localized: Placa pendurada no lado direito do edifício.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927487
    m_Localized: Placa pendurada no lado direito do edifício.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927488
    m_Localized: Redondo, vermelho e tecnicamente um fruto.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927489
    m_Localized: Fatias suculentas a que já não falta nada.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927490
    m_Localized: Trepadeiras a cair da beira do telhado.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927491
    m_Localized: Casa maior
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927492
    m_Localized: Urso Abraço de Mel
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927493
    m_Localized: Hambúrguer de novilho
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927494
    m_Localized: Hambúrguer cru
    m_Metadata:
