    m_Items: []
  m_TableData:
  - m_Id: 2207008936681472
    m_Localized: Trattoria kecil yang nyaman tempat kisah pastamu dimulai.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624512
    m_Localized: Menambah lantai atas yang nyaman untuk trattoriamu.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624513
    m_Localized: Membuat saus lembut dalam sekejap.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624514
    m_Localized: Pusaran saus. Tutup sangat disarankan.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624515
    m_Localized: Tomat sudah terpotong dadu sebelum sempat tersipu.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624516
    m_Localized: Memotong begitu cepat, bawang pun tak sempat menangis.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624517
    m_Localized: Meja kotak-kotak dan kursi nyaman untuk makan pasta di udara terbuka.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624518
    m_Localized: Lentera hangat yang bersinar di samping pintu.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624519
    m_Localized: Papan koki kapibara yang bangga menghiasi atap.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624520
    m_Localized: Papan kapur berisi menu pasta spesial hari ini.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624521
    m_Localized: Saus mendesis dua kali lebih cepat.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624522
    m_Localized: Desis ekstra terbuka. Wajan bersinar penuh bangga.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624523
    m_Localized: Tanaman pot segar yang mencerahkan pintu masuk.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013120
    m_Localized: Air mendidih sebelum kamu sempat bilang al dente.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013121
    m_Localized: Legenda mendidih yang memasak pasta secepat kilat.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013122
    m_Localized: Seikat anggur montok yang menghiasi atap.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013123
    m_Localized: Sepiring besar spageti yang digulung tinggi di atas atap!
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013124
    m_Localized: Menuang soda bersoda dalam sekejap.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013125
    m_Localized: Soda melimpah! Air mancur gelembung dan kegembiraan.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013126
    m_Localized: Trattoria Bertingkat
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013127
    m_Localized: Blender Saus
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013128
    m_Localized: Tornado Saus
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013129
    m_Localized: Talenan Kilat
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013130
    m_Localized: Talenan Ninja Pasta
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013131
    m_Localized: Meja Teras
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013132
    m_Localized: Lentera Dinding
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207424
    m_Localized: Papan Koki Capy
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207425
    m_Localized: Menu Kapur
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207426
    m_Localized: Wajan Desis
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207427
    m_Localized: Wajan Membara
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207428
    m_Localized: Kemangi Pot
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207429
    m_Localized: Panci Rebus Kilat
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207430
    m_Localized: Kuali Rebus Mega
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207431
    m_Localized: Anggur Atap
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207432
    m_Localized: Spageti Raksasa
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207433
    m_Localized: Air Mancur Soda
    m_Metadata:
      m_Items: []
  - m_Id: 2207008995401728
    m_Localized: Geiser Soda
    m_Metadata:
      m_Items: []
  - m_Id: 2508025511272448
    m_Localized: Beruang tangguh berjas garis-garis dan topi fedora berhias mawar yang menuntut porsi pasta besar dan rasa hormat mutlak.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243968
    m_Localized: Kucing belang yang modis dengan topi ungu dan gaun serasi, memesan pasta dengan selera sempurna dan dengkuran puas.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243969
    m_Localized: Chinchilla rapi berseragam pos biru yang mengikuti aroma pasta segar di sela pengantaran.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243970
    m_Localized: Ayam jantan yang bangga bertopi tinggi dan berselempang tiga warna, memimpin konter pasta dengan pidato megah.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243971
    m_Localized: Domba lembut berkacamata bulat dan bersyal berlonceng yang menganggap setiap piring pasta sebagai acara istimewa.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243972
    m_Localized: Apel
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243973
