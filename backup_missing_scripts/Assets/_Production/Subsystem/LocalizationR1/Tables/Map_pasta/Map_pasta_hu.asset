  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: Map_pasta_hu
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: hu
  m_SharedData: {fileID: 11400000, guid: b8c57adbeaeeddd48bdbbb34b0659dca, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 2207008936681472
    m_Localized: A hangulatos kis trattoria, ahol a tésztatörténeted kezdődik.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624512
    m_Localized: Hangulatos emeletet ad a trattoriádnak.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624513
    m_Localized: Pillanatok alatt selymes szószt kever.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624514
    m_Localized: Szószforgószél. A fedő erősen ajánlott.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624515
    m_Localized: A paradicsom felkockázódik, mielőtt elpirulna.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624516
    m_Localized: Olyan gyorsan aprít, hogy a hagymának sírni sincs ideje.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624517
    m_Localized: Kockás asztal és kényelmes székek a szabadtéri tésztázáshoz.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624518
    m_Localized: Meleg fényű lámpás világít az ajtó mellett.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624519
    m_Localized: Büszke kapibara séf tábla koronázza a tetőt.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624520
    m_Localized: Krétatábla a mai tésztakülönlegességekkel.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624521
    m_Localized: A szószok kétszer olyan gyorsan sercegnek.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624522
    m_Localized: Extra sercegés feloldva. A serpenyő büszkén izzik.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624523
    m_Localized: Friss cserepes zöldek, amelyek feldobják a bejáratot.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013120
    m_Localized: 'A víz felforr, mielőtt kimondanád: al dente.'
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013121
    m_Localized: Bugyogó legenda, amely fénysebességgel főzi a tésztát.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013122
    m_Localized: Egy dús szőlőfürt díszíti a tetőt.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013123
    m_Localized: Óriási tányér spagetti feltekerve a tető tetején!
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013124
    m_Localized: Egy szempillantás alatt tölti a pezsgő szódát.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013125
    m_Localized: Bődületes pezsgés! Buborékok és öröm szökőkútja.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013126
    m_Localized: Emeletes trattoria
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013127
    m_Localized: Szószos turmix
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013128
    m_Localized: Szósztornádó
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013129
    m_Localized: Gyorsaprító deszka
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013130
    m_Localized: Tészta-nindzsa deszka
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013131
    m_Localized: Teraszasztal
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013132
    m_Localized: Fali lámpás
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207424
    m_Localized: Capy séf tábla
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207425
    m_Localized: Krétás étlap
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207426
    m_Localized: Sercegő serpenyő
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207427
    m_Localized: Lángoló serpenyő
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207428
    m_Localized: Cserepes bazsalikom
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207429
    m_Localized: Gyorsforraló fazék
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207430
    m_Localized: Mega forraló üst
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207431
    m_Localized: Tetőszőlő
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207432
    m_Localized: Óriás spagetti
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207433
    m_Localized: Pezsgő kút
    m_Metadata:
      m_Items: []
  - m_Id: 2207008995401728
    m_Localized: Szódagejzír
    m_Metadata:
      m_Items: []
  - m_Id: 2508025511272448
    m_Localized: Félelmetes medve csíkos öltönyben és rózsás fedorában, aki bőséges tésztaadagot és feltétlen tiszteletet vár.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243968
    m_Localized: Elegáns cirmos lila kalapban és hozzáillő ruhában, aki kifogástalan ízléssel rendel tésztát, elégedett dorombolással.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243969
    m_Localized: Rendes csincsilla kék postásegyenruhában, aki kézbesítések között a friss tészta illatát követi.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243970
    m_Localized: Büszke kakas cilinderben és háromszínű vállszalaggal, aki nagy beszédekkel elnököl a tésztapult felett.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243971
    m_Localized: Szelíd bárány kerek szemüvegben és csengős sálban, akinek minden tányér tészta ünnepi alkalom.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243972
    m_Localized: Alma
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243973
    m_Localized: Szeletelt alma
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243974
    m_Localized: Don Orsino
    m_Metadata:
      m_Items: []
  - m_Id: 2508025536438272
    m_Localized: Grillezett marhasteak
    m_Metadata:
      m_Items: []
  - m_Id: 2508025536438273
