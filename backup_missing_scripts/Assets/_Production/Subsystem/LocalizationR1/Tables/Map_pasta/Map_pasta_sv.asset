  - m_Id: 2508025536438315
    m_Localized: Signor Woolington
    m_Metadata:
      m_Items: []
  - m_Id: 2508025536438316
    m_Localized: Grillade räkor
    m_Metadata:
      m_Items: []
  - m_Id: 2508025536438317
    m_Localized: Råa räkor
    m_Metadata:
      m_Items: []
  - m_Id: 2508025536438318
    m_Localized: Skurna råa räkor
    m_Metadata:
