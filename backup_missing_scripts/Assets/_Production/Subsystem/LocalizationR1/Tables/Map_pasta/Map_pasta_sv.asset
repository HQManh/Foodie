  m_LocaleId:
    m_Code: sv
  m_SharedData: {fileID: 11400000, guid: b8c57adbeaeeddd48bdbbb34b0659dca, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 2207008936681472
    m_Localized: Den mysiga lilla trattorian där din pastahistoria börjar.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624512
    m_Localized: Ger din trattoria en mysig övervåning.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624513
    m_Localized: Mixar silkeslen sås på ett ögonblick.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624514
    m_Localized: En virvelvind av sås. Lock rekommenderas starkt.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624515
    m_Localized: Tomaterna är tärnade innan de hinner rodna.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624516
    m_Localized: Hackar så snabbt att löken inte ens hinner gråta.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624517
    m_Localized: Ett rutigt bord och sköna stolar för pasta i det fria.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624518
    m_Localized: En varm lykta som lyser vid dörren.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624519
    m_Localized: En stolt kapybarakockskylt kröner taket.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624520
    m_Localized: En svart tavla med dagens pastaspecialiteter.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624521
    m_Localized: Såserna fräser dubbelt så snabbt.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624522
    m_Localized: Extra fräsande upplåst. Pannan glöder av stolthet.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624523
    m_Localized: Fräscha krukväxter som lyser upp entrén.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013120
    m_Localized: Vattnet kokar innan du hinner säga al dente.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013121
    m_Localized: En bubblande legend som kokar pasta i ljusets hastighet.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013122
    m_Localized: En fyllig druvklase som pryder taket.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013123
    m_Localized: En jättelik tallrik spagetti uppsnurrad högt på taket!
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013124
    m_Localized: Häller upp bubblig läsk i en handvändning.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013125
    m_Localized: Massor av bubbel! En fontän av bubblor och glädje.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013126
    m_Localized: Trattoria på övervåningen
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013127
    m_Localized: Såsmixer
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013128
    m_Localized: Sås-tornado
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013129
    m_Localized: Snabbhackbräda
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013130
    m_Localized: Pastaninjabräda
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013131
    m_Localized: Uteplatsbord
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013132
    m_Localized: Vägglykta
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207424
    m_Localized: Capy-kockskylt
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207425
    m_Localized: Kritmeny
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207426
    m_Localized: Frasande panna
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207427
    m_Localized: Flammande panna
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207428
    m_Localized: Basilika i kruka
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207429
    m_Localized: Snabbkokgryta
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207430
    m_Localized: Megakokkittel
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207431
    m_Localized: Takdruvor
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207432
    m_Localized: Jättespagetti
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207433
    m_Localized: Bubbelfontän
    m_Metadata:
      m_Items: []
  - m_Id: 2207008995401728
    m_Localized: Läskgejser
    m_Metadata:
      m_Items: []
  - m_Id: 2508025511272448
    m_Localized: En respektingivande björn i kritstrecksrandig kostym och fedora med ros, som väntar sig rejäla pastaportioner och total respekt.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243968
    m_Localized: En stilig tigrerad katt i lila hatt och matchande klänning, som beställer pasta med oklanderlig smak och ett nöjt spinnande.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243969
    m_Localized: En prydlig chinchilla i blå postuniform som följer doften av färsk pasta mellan leveranserna.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243970
    m_Localized: En stolt tupp i cylinderhatt och trefärgat ordensband som presiderar över pastadisken med storslagna tal.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243971
    m_Localized: Ett milt får i runda glasögon och halsduk med bjällra, som ser varje pastatallrik som ett riktigt tillfälle.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243972
    m_Localized: Äpple
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243973
    m_Localized: Skivat äpple
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243974
    m_Localized: Don Orsino
    m_Metadata:
