  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: Map_coffee_ro
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: ro
  m_SharedData: {fileID: 11400000, guid: 2792ae1db3f1fd44c88392405a58a65e, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 57788163153920
    m_Localized: Pentru că fiecare gogoașă merită o petrecere. Vibrații dulci care plutesc.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514048
    m_Localized: Începutul a ceva dulce. Doar făină, apă și multă ambiție.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514049
    m_Localized: Mai multă glazură, mai mult spațiu. Creștem aluatul ca să ridicăm acoperișul.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514050
    m_Localized: Recunoaște o cafea tare mai repede decât cade un copac.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514051
    m_Localized: Livrează cafea cu viteza aripilor, fără să-și murdărească vreo pană.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514052
    m_Localized: Un șef de cafenea rafinat care ia foarte în serios arta pe spumă.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514053
    m_Localized: Relaxează-te și lasă coma de zahăr să te cuprindă încet.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514054
    m_Localized: Boabă mică, planuri mari de a-i trezi pe toți.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514055
    m_Localized: Boabe măcinate de viață.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514056
    m_Localized: Încalcă regulile cafenelei, bea prăjiri tari și nu mugește niciodată încet.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514057
    m_Localized: Nori pufoși care se ridică mereu la înălțime.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514058
    m_Localized: Cremă cu o latură întunecată bogată în cacao.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514059
    m_Localized: Un pahar gol care își păstrează calmul.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514060
    m_Localized: Cafea servită cu o fire răcoroasă.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514061
    m_Localized: Cafea cu gheață gătită ca să se laude.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514062
    m_Localized: Gol acum, dar rezistă la căldură.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514063
    m_Localized: Băutură aburindă cu personalitate puternică.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514064
    m_Localized: Unde cafeaua și laptele își declară, în sfârșit, iubirea.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514065
    m_Localized: O prăjitură mică ce n-a ieșit niciodată din cupa ei.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514066
    m_Localized: O brioșă care se laudă cu toppingurile ei dulci.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514067
    m_Localized: Aluatul e gata, prăjitura asta are nevoie de cuptor.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514068
    m_Localized: Turnată peste gheață pentru clienții care nu încetinesc niciodată.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514069
    m_Localized: Spumat, turnat și servit înainte să se așeze spuma.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514070
    m_Localized: O prăjitură mică cu mult prea multă cremă, intenționat.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514071
    m_Localized: Proaspăt înmuiată, glazura încă se decide încotro să curgă.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514072
    m_Localized: Un inel dulce cu o grămadă de farmec.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514073
    m_Localized: Un inel de aluat care așteaptă să devină marea vedetă.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514074
    m_Localized: O bară de aluat care ridică miza pentru gogoși.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514075
    m_Localized: Aluat care nu trebuie reumplut niciodată.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514076
    m_Localized: Ține ordinea în cafenea cu ochi de vultur și un biscuit în formă de insignă.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514077
    m_Localized: O boabă mică, puțin tristă, dar cu gust grozav.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514078
    m_Localized: Pufos pe dinafară, verde strălucitor înăuntru.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514079
    m_Localized: Kiwi tăiat pe măsură, încă verde strălucitor.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514080
    m_Localized: O dulceață tropicală cu atitudine de aur.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514081
    m_Localized: Felii de ananas gata să ajungă deasupra.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514082
    m_Localized: Roșie, coaptă și greu de rezistat.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514083
    m_Localized: Felii subțiri ca boaba, cu farmec maxim.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514084
    m_Localized: O glazură lucioasă cu un blues răcoros.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514085
    m_Localized: Maro, lucioasă și dependentă de ciocolată fără scuze.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514086
    m_Localized: Frumoasă în roz, dulce la fiecare mușcătură.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514087
    m_Localized: Glazură albă simplă cu profunzime ascunsă de vanilie.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514088
    m_Localized: Cuburi înghețate care țin fiecare băutură rece.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514089
    m_Localized: Arată lumii unde e crema. Glazurat și mândru.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514090
    m_Localized: O listă cu tot ce vindem. Mai ales gogoși. Bine, doar gogoși.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514091
    m_Localized: Pacificatorul alb și cremos al cafelei amare.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514092
    m_Localized: Verdeață adevărată ca să echilibreze glazura artificială. Ornamentele naturii.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514093
    m_Localized: Puțină structură pentru zahăr. Ghivecele astea nu glumesc.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514094
    m_Localized: O gogoașă pe acoperiș atât de mare încât și păsările fac criză de zahăr doar privind-o.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514095
    m_Localized: Ornamente în plus pentru capodopera de pe acoperiș. Glazura nu ajunge.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514096
    m_Localized: Sosește parfumată la modă și transformă fiecare pauză de cafea într-o gală.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514097
    m_Localized: Bucățele colorate care presară bucurie peste tot.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514098
    m_Localized: Poartă ghinde de rezervă și judecă fiecare latte după spumă.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514099
    m_Localized: Înălțimea perfectă pentru a bălăngăni picioarele mâncând ornamente dulci.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514100
    m_Localized: Ornamente în plus pentru capodopera de pe acoperiș. Glazura nu ajunge.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514101
    m_Localized: Un pozna vesel care, cumva, plătește cu frunze și cu suma exactă.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514102
    m_Localized: Transformă fructele într-o supunere catifelată.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514103
    m_Localized: Unde fructele își primesc felia de viață.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514104
    m_Localized: Transformă boabele în motivație de dimineață lichidă.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514105
    m_Localized: Coace aluatul în fericire aurie de prăjitură.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514106
    m_Localized: Prăjește aluatul până devine tigă-tastic.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514107
    m_Localized: Baloane de petrecere
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514108
    m_Localized: Extindere dulce
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514109
    m_Localized: Castorul Brewster
    m_Metadata:
      m_Items: []
