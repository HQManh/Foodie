--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: Notifications_hi
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: hi
  m_SharedData: {fileID: 11400000, guid: aa4f23c3016fe6d4fa68e38c9fc52637, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 5935534694400
    m_Localized: आपके ग्राहक भूखे हैं! वापस आइए और रसोई चालू कीजिए।
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694401
    m_Localized: तवा गरम है और ऑर्डर बढ़ते जा रहे हैं। पकाने का समय है!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694402
    m_Localized: रेस्टोरेंट में एक नया दिन आपका इंतज़ार कर रहा है।
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694403
    m_Localized: आपके जीवन फिर से भर गए। अगली शिफ़्ट के लिए तैयार?
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694404
    m_Localized: भूखे मेहमान बाहर कतार में हैं। उन्हें इंतज़ार मत कराइए!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694405
    m_Localized: आपका दैनिक इनाम तैयार है!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694406
    m_Localized: शेफ़, आपका स्टाफ़ आपको याद कर रहा है! आकर हैलो कहिए।
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694407
    m_Localized: क्या आप अगला दिन 3 स्टार से पूरा कर सकते हैं?
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694408
    m_Localized: ताज़ी सामग्री अभी-अभी आई है। चलो कुछ स्वादिष्ट बनाएं!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694409
    m_Localized: अपना रेस्टोरेंट अपग्रेड करें और पूरे शहर में छा जाएं।
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694410
    m_Localized: बॉस हॉग्सवर्थ पूछ रहे हैं कि शेफ़ कहाँ गया...
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694411
    m_Localized: फ्राइज़ कुरकुरे हैं, बर्गर रसीले हैं। आइए और परोसिए!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694412
    m_Localized: थोड़ा खाना पकाने का ब्रेक? आपकी रसोई तैयार है।
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694413
    m_Localized: आज सिक्के कमाएं और अपने रसोई उपकरणों को चमकदार अपग्रेड दें।
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694414
    m_Localized: लंच की भीड़ शुरू हो रही है। अपना एप्रन पहन लीजिए!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694415
    m_Localized: आपकी प्रसिद्धि बढ़ रही है! नए इनाम अनलॉक करने के लिए परोसते रहिए।
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694416
    m_Localized: नए ग्राहकों ने आपके खाने के बारे में सुना है। आइए, उनसे मिलिए!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694417
    m_Localized: कॉफ़ी बन रही है और डोनट इंतज़ार कर रहे हैं। कैफ़े खोलिए!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694418
    m_Localized: एक और दिन? आपका रेस्टोरेंट बुला रहा है।
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694419
    m_Localized: तेज़ी से परोसिए, खूब कमाइए और हर ग्राहक को मुस्कुराते रखिए!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694420
    m_Localized: शेफ़, रसोई को आपकी ज़रूरत है! पकाना शुरू करने के लिए टैप करें।
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
