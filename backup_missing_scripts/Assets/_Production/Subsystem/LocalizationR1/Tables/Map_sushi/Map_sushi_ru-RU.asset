  - m_Id: 5867053012475971
    m_Localized: Нигири-суши
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475972
    m_Localized: Тарелка сашими
    m_Metadata:
      m_Items: []
  - m_Id: 5867053016670208
