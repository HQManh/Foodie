  m_TableData:
  - m_Id: 47151316996
    m_Localized: Herzhaftes Sandwich
    m_Metadata:
      m_Items: []
  - m_Id: 47134539776
    m_Localized: Getoastetes Brot, belegt mit allem, was der Grill hergeben konnte.
    m_Metadata:
      m_Items: []
  - m_Id: 47151316997
    m_Localized: Obst-Sandwich
    m_Metadata:
      m_Items: []
  - m_Id: 47151316992
    m_Localized: Weiches Brot, darin eine Wolke aus Sahne und leuchtendes Obst.
    m_Metadata:
      m_Items: []
  - m_Id: 47151316998
    m_Localized: Salat
    m_Metadata:
      m_Items: []
  - m_Id: 47151316993
    m_Localized: Eine knackige Schüssel Grünzeug mit einem Klecks Mayo.
    m_Metadata:
      m_Items: []
  - m_Id: 47151316999
    m_Localized: Frischer Saft
    m_Metadata:
      m_Items: []
  - m_Id: 47151316994
    m_Localized: Frisch auf Bestellung gepresst, Eis nach Wunsch.
    m_Metadata:
      m_Items: []
  - m_Id: 47151317000
    m_Localized: Suppe
    m_Metadata:
      m_Items: []
  - m_Id: 47151316995
    m_Localized: Eine warme, cremige Schüssel mit etwas obendrauf.
    m_Metadata:
      m_Items: []
  - m_Id: 881833574129664
    m_Localized: Roher Speck, der auf die Pfanne wartet.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295488
    m_Localized: Ein festes Ei für Sandwiches.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295489
    m_Localized: Röstet Brot warm und goldbraun.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295490
    m_Localized: Weiches Brot in ordentlichen Dreiecken.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295491
    m_Localized: Eine schmelzende Scheibe goldener Käse.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295492
    m_Localized: Rohes Hähnchen, das auf die Panade wartet.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295493
    m_Localized: Gebraten, bis er golden und knusprig ist.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295494
    m_Localized: Eine kühle, knackige Gurke.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295495
    m_Localized: Frische grüne Scheiben mit Biss.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295496
    m_Localized: Schneidet und würfelt jede Füllung.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295497
    m_Localized: Ein frisches Ei mit Frühstücksplänen.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295498
    m_Localized: Sahne und Obst nach Gästewunsch.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295499
    m_Localized: Aus dem Lieblingsobst des Gastes gepresst.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295500
    m_Localized: Eine frische Schüssel, nach Wunsch gemischt.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295501
    m_Localized: Belegt mit dem Lieblingsbelag des Gastes.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295502
    m_Localized: Eine warme Schüssel in der Lieblingssorte.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295503
    m_Localized: Golden und knusprig, innen saftig.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295504
    m_Localized: Ein Spiegelei, bereit zum Stapeln.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295505
    m_Localized: Brät Eier, Speck und Hähnchen.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295506
    m_Localized: Eine Traube süßer lila Beeren.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295507
    m_Localized: Süßer lila Saft, frisch gepresst.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295508
    m_Localized: Eine dünne Scheibe herzhafter Schinken.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295509
    m_Localized: Klirrende Würfel für kalte Getränke.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295510
    m_Localized: Presst Obst zu frischem Saft.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295511
    m_Localized: Eine pelzige Frucht mit leuchtend grünem Herz.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295512
    m_Localized: Spritziger grüner Saft voller Frische.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295513
    m_Localized: Grüne Kiwischeiben mit kleinen Kernen.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295514
    m_Localized: Ein knackiger Kopf frischer Salat.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295515
    m_Localized: Knackige Streifen für jede Schicht.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489792
    m_Localized: Eine goldene Tropenfrucht voller Sonne.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489793
    m_Localized: Dicker goldener Saft mit Tropengeschmack.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489794
    m_Localized: Saftige goldene Scheiben reifer Mango.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489795
    m_Localized: Cremige Soße, die alles zusammenhält.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489796
    m_Localized: Frische kalte Milch für cremige Drinks.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489797
    m_Localized: Ein praller Pilz aus dem Wald.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489798
    m_Localized: Kleine Pilzwürfel für den Topf.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489799
    m_Localized: Cremig und würzig, dampfend heiß serviert.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489800
    m_Localized: Ein frischer Zweig als letzter Schliff.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489801
    m_Localized: Köchelt Suppen, bis sie warm und kräftig sind.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489802
    m_Localized: Ein runder Kürbis, innen süß.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489803
    m_Localized: Orange Würfel, bereit zum Köcheln.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489804
    m_Localized: Samtig, süß und wärmend.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489805
    m_Localized: Weiche weiße Scheiben für jedes Sandwich.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489806
    m_Localized: Eine süße Beere mit grünem Hütchen.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489807
    m_Localized: Süßer rosa Saft, frisch gepresst.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489808
    m_Localized: Saftige Scheiben für süße Sandwiches.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489809
    m_Localized: Goldene Körner mit süßem Biss.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489810
    m_Localized: Warm, golden und knusprig.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489811
    m_Localized: Eine reife rote Tomate, saftig und frisch.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489812
    m_Localized: Saftige Würfel, bereit zum Köcheln.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489813
    m_Localized: Saftige Scheiben für jedes Sandwich.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489814
    m_Localized: Eine kräftige rote Suppe, warm und tröstlich.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489815
    m_Localized: Ein luftiger Tupfen süßer Sahne.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489816
    m_Localized: Speckstreifen
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489817
