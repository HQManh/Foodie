  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: UI_InGame_hi
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: hi
  m_SharedData: {fileID: 11400000, guid: a34c71713b2ebf445aa5dfcbb87e843e, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 57797273182208
    m_Localized: सारे दिल टूट गए
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542336
    m_Localized: हमेशा की तरह बढ़िया
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542337
    m_Localized: जमी हुई सामग्री नहीं उठाई जा सकती। बर्फ़ तोड़ने के लिए पास की चीज़ उठाएं।
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542338
    m_Localized: प्राप्त करें
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542339
    m_Localized: अनलॉक करने के लिए सामग्री की कतारों में कहीं चाबी ढूंढें।
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542340
    m_Localized: स्वाद विस्फोट
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542341
    m_Localized: खाने का बंडल
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542342
    m_Localized: मुफ़्त
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542343
    m_Localized: जमी हुई चीज़
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542344
    m_Localized: समझ गया!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542345
    m_Localized: कठिन दिन!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542346
    m_Localized: नमस्ते, आपसे मिलकर खुशी हुई
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542347
    m_Localized: छिपी चीज़
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542348
    m_Localized: छिपी चीज़ें तभी दिखती हैं जब वे सबसे ऊपर की पंक्ति में पहुंचती हैं।
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542349
    m_Localized: मैप देखने के लिए दबाए रखें
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542350
    m_Localized: देखने के लिए दबाए रखें
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542351
    m_Localized: होम
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542352
    m_Localized: बर्फ़ का टुकड़ा
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542353
    m_Localized: सामग्री खत्म हो गई!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542354
    m_Localized: छोड़ें
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542355
    m_Localized: चलो कारोबार शुरू करें!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542356
    m_Localized: जुड़ी चीज़ें
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542357
    m_Localized: ताला और चाबी
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542358
    m_Localized: संगीत
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542359
    m_Localized: नया बूस्टर
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542360
    m_Localized: नई सामग्री
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542361
    m_Localized: ठीक है
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542362
    m_Localized: उफ़?!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542363
    m_Localized: चालें खत्म
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542364
    m_Localized: धैर्य खत्म
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542365
    m_Localized: स्लॉट खत्म
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542366
    m_Localized: रुका हुआ
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542367
    m_Localized: बेहतरीन
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542368
    m_Localized: जब सभी जुड़े स्लॉट आगे पहुंच जाएं, तो उन्हें एक साथ उठाएं।
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542369
    m_Localized: दिन छोड़ें?
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542370
    m_Localized: फिर से
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542371
    m_Localized: मेज़ पर बर्फ़ का टुकड़ा तोड़ने के लिए कुछ ग्राहकों को परोसें।
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542372
    m_Localized: कुछ गड़बड़ हो गई। फिर से कोशिश करें!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542373
    m_Localized: ध्वनि
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542374
    m_Localized: बहुत कठिन दिन!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542375
    m_Localized: जारी रखने के लिए टैप करें
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542376
    m_Localized: खेलने के लिए टैप करें
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542377
    m_Localized: स्वाद बढ़ रहा है
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542378
    m_Localized: ये खाने साथ चलते हैं और एक ही ब्लॉक की तरह उठाए जाते हैं।
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542379
    m_Localized: चिमटा
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542380
    m_Localized: कंपन
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542381
    m_Localized: देखें
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542382
    m_Localized: आपका 1 दिल कम हो जाएगा!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542383
    m_Localized: बॉस आ गया!
    m_Metadata:
      m_Items: []
  - m_Id: 791119221743616
    m_Localized: बॉस आ गया
    m_Metadata:
      m_Items: []
  - m_Id: 791119234326528
    m_Localized: स्लॉट खत्म!
    m_Metadata:
      m_Items: []
  - m_Id: 5836114773401600
    m_Localized: जमी हुई टाइल
    m_Metadata:
      m_Items: []
  - m_Id: 5836114806956032
    m_Localized: नया फ़ीचर
    m_Metadata:
      m_Items: []
  - m_Id: 5838819617136640
    m_Localized: नया रेस्टोरेंट
    m_Metadata:
      m_Items: []
  - m_Id: 5838819617136641
    m_Localized: एक नया रेस्टोरेंट आ रहा है!
    m_Metadata:
      m_Items: []
  - m_Id: 7340303286525952
    m_Localized: शाबाश!
    m_Metadata:
      m_Items: []
  - m_Id: 7340303307497472
    m_Localized: असफल रहे
    m_Metadata:
      m_Items: []
  - m_Id: 7542428218155008
    m_Localized: कमाल कर दिया!
    m_Metadata:
      m_Items: []
  - m_Id: 7542428239126528
    m_Localized: लाजवाब शेफ!
    m_Metadata:
      m_Items: []
  - m_Id: 7542428243320832
    m_Localized: बहुत मुश्किल!
    m_Metadata:
      m_Items: []
  - m_Id: 7542428243320833
    m_Localized: रसोई में हड़बड़ी!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
