    m_Metadata:
      m_Items: []
  - m_Id: 57797302542344
    m_Localized: Entendi!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542345
    m_Localized: DIA DIFÍCIL!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542346
    m_Localized: Olá, prazer em conhecer você
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542347
    m_Localized: Item oculto
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542348
    m_Localized: Itens ocultos só são revelados quando chegam à fileira de cima.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542349
    m_Localized: Segure para ver o mapa
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542350
    m_Localized: Segure para ver
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542351
    m_Localized: INÍCIO
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542352
    m_Localized: Bloco de gelo
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542353
    m_Localized: Os ingredientes acabaram!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542354
    m_Localized: Sair
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542355
    m_Localized: Vamos abrir o negócio!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542356
    m_Localized: Itens ligados
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542357
