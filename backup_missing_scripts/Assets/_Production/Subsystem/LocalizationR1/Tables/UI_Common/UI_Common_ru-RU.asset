    m_Metadata:
      m_Items: []
  - m_Id: 5326573661052928
    m_Localized: Рекорд башни
    m_Metadata:
      m_Items: []
  - m_Id: 5326573661052929
    m_Localized: Передать лидерство
    m_Metadata:
      m_Items: []
  - m_Id: 5326573661052930
    m_Localized: Вот ваши незабранные награды!
    m_Metadata:
      m_Items: []
