  - m_Id: 57759218262021
    m_Localized: Bản đồ này đang bị khóa. Hãy hoàn thành các bản đồ trước để mở khóa.
    m_Metadata:
      m_Items: []
  - m_Id: 57759218262022
    m_Localized: Ngày này đang bị khóa. Hãy vượt qua các ngày trước để mở khóa.
    m_Metadata:
      m_Items: []
