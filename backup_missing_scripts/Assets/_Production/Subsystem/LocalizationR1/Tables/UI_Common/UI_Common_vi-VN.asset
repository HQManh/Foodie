    m_Localized: '<color=yellow>Vé Mộng Mơ</color> sẽ mang đến cho bạn cơ hội nhận được các phần thưởng đặc biệt!'
    m_Metadata:
      m_Items: []
  - m_Id: 5326573627498499
    m_Localized: Bạn sẽ sở hữu các đặc quyền độc quyền cho đến khi sự kiện kết thúc!
    m_Metadata:
      m_Items: []
  - m_Id: 5326573627498500
    m_Localized: 8 mạng thay vì 5 mạng
    m_Metadata:
      m_Items: []
  - m_Id: 5326573627498501
    m_Localized: Kích hoạt Kho Báu
    m_Metadata:
      m_Items: []
  - m_Id: 5326573631692800
    m_Localized: Khung ảnh đại diện vàng và Tên màu vàng
    m_Metadata:
      m_Items: []
  - m_Id: 5326573631692801
    m_Localized: '<color=yellow>Vé Mộng Mơ</color> đã kết thúc! Các đặc quyền của bạn không còn hiệu lực. <color=yellow>Vé Mộng Mơ</color> mới sẽ sớm bắt đầu!'
    m_Metadata:
      m_Items: []
  - m_Id: 5326573631692802
    m_Localized: Vượt qua các ngày!
    m_Metadata:
      m_Items: []
  - m_Id: 5326573631692803
    m_Localized: Thu thập Chìa khóa!
    m_Metadata:
      m_Items: []
  - m_Id: 5326573631692804
    m_Localized: Mở khóa phần thưởng!
    m_Metadata:
      m_Items: []
  - m_Id: 5326573631692805
    m_Localized: Bạn có thể kích hoạt <color=yellow>Vé Mộng Mơ</color> để nhận thêm phần thưởng độc quyền!
    m_Metadata:
      m_Items: []
  - m_Id: 5326573631692806
    m_Localized: '<color=Yellow>Vé Mộng Mơ</color> mới đã bắt đầu! Vượt qua các ngày và mở khóa <color=Yellow>Vé</color> để nhận phần thưởng giá trị!'
    m_Metadata:
      m_Items: []
