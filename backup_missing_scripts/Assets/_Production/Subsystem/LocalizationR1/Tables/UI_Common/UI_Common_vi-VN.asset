    m_Metadata:
      m_Items: []
  - m_Id: 5326573572972545
    m_Localized: Vé Mộng Mơ
    m_Metadata:
      m_Items: []
  - m_Id: 5326573572972546
    m_Localized: Chào mừng đến với <color=yellow>Vé Mộng Mơ!</color> Đây là phần thưởng đầu tiên của bạn!
    m_Metadata:
      m_Items: []
  - m_Id: 5326573572972547
    m_Localized: Vượt qua các ngày và thu thập <color=yellow>Chìa Khóa</color> để mở khóa phần thưởng. Chạm để biết cách thu thập!
    m_Metadata:
      m_Items: []
  - m_Id: 5326573572972548
    m_Localized: Kích hoạt <color=yellow>Vé Mộng Mơ</color> để nhận các phần thưởng đặc biệt!
    m_Metadata:
      m_Items: []
  - m_Id: 5326573572972549
    m_Localized: Mở khóa chặng này và kích hoạt <color=yellow>Vé Mộng Mơ</color> để nhận phần thưởng này!
    m_Metadata:
      m_Items: []
  - m_Id: 5326573572972550
    m_Localized: Chuỗi Mộng Mơ
    m_Metadata:
      m_Items: []
  - m_Id: 5326573572972551
    m_Localized: Vượt qua các ngày không thất bại để nhận thêm phần thưởng!
    m_Metadata:
      m_Items: []
  - m_Id: 5326573572972552
    m_Localized: Vượt qua các ngày mà không thua!
    m_Metadata:
      m_Items: []
  - m_Id: 5326573572972553
    m_Localized: Tăng hệ số điểm của bạn!
    m_Metadata:
      m_Items: []
  - m_Id: 5326573577166848
    m_Localized: Giành được những phần thưởng tuyệt vời!
    m_Metadata:
      m_Items: []
  - m_Id: 5326573577166849
    m_Localized: Mỗi thất bại sẽ đặt lại hệ số của bạn!
    m_Metadata:
