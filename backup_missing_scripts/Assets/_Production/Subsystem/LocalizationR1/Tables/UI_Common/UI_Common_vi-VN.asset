    m_Metadata:
      m_Items: []
  - m_Id: 5326573640081418
    m_Localized: Bạn đã thua cuộc đua! Hãy thử lại để giành những phần thưởng tuyệt vời!
    m_Metadata:
      m_Items: []
  - m_Id: 5326573644275712
    m_Localized: Chúc mừng! Bạn đã thắng cuộc đua!
    m_Metadata:
      m_Items: []
  - m_Id: 5326573644275713
    m_Localized: Vượt qua <color=yellow>{0} ngày</color> trước người khác để chiến thắng và tiến vào vòng tiếp theo với phần thưởng lớn hơn!
    m_Metadata:
      m_Items: []
  - m_Id: 5326573644275714
    m_Localized: Cách chơi như thế nào?
    m_Metadata:
      m_Items: []
  - m_Id: 5326573644275715
    m_Localized: Vượt qua các ngày trước người khác để về đích!
    m_Metadata:
      m_Items: []
  - m_Id: 5326573644275716
    m_Localized: Hoàn thành cuộc đua trước những người khác!
    m_Metadata:
      m_Items: []
  - m_Id: 5326573644275717
