    m_Metadata:
      m_Items: []
  - m_Id: 5326573648470024
    m_Localized: Thông tin nhóm
    m_Metadata:
      m_Items: []
  - m_Id: 5326573648470025
    m_Localized: 'Huy hiệu đội:'
    m_Metadata:
      m_Items: []
  - m_Id: 5326573652664320
    m_Localized: 'Khi bạn tham gia một đội, bạn sẽ nhận được:'
    m_Metadata:
      m_Items: []
  - m_Id: 5326573652664321
    m_Localized: Thu Hoạch Nhóm
    m_Metadata:
      m_Items: []
  - m_Id: 5326573652664322
    m_Localized: Thu thập Ngô từ các màn chơi!
    m_Metadata:
      m_Items: []
  - m_Id: 5326573652664323
    m_Localized: Đạt Mục Tiêu Cùng Đội Của Bạn!
    m_Metadata:
      m_Items: []
  - m_Id: 5326573652664324
    m_Localized: Nhận Phần Thưởng Tuyệt Vời!
    m_Metadata:
      m_Items: []
  - m_Id: 5326573652664325
    m_Localized: 'Thường: 1 Ngô - Khó: 3 Ngô - Siêu Khó: 5 Ngô'
    m_Metadata:
      m_Items: []
  - m_Id: 5326573652664326
    m_Localized: Thu hoạch Ngô cùng đội của bạn và nhận những phần thưởng tuyệt vời!
    m_Metadata:
      m_Items: []
