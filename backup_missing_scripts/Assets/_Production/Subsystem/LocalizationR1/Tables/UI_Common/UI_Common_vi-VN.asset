    m_Metadata:
      m_Items: []
  - m_Id: 57759218262027
    m_Localized: Bản đồ này sẽ có trong bản cập nhật sau.
    m_Metadata:
      m_Items: []
  - m_Id: 57759218262028
    m_Localized: 'Đã phục vụ: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 57759218262029
    m_Localized: Hãy thử nâng cấp nhà hàng của bạn
    m_Metadata:
      m_Items: []
  - m_Id: 57759218262030
    m_Localized: Đây là những vật phẩm bạn có thể mua
    m_Metadata:
      m_Items: []
  - m_Id: 57759218262031
    m_Localized: Dùng số xu kiếm được hôm qua để nâng cấp thứ gì đó nào!
    m_Metadata:
      m_Items: []
  - m_Id: 57759218262032
    m_Localized: Giờ hãy đến tab nâng cấp dụng cụ nào!
    m_Metadata:
      m_Items: []
  - m_Id: 57759218262033
    m_Localized: Hãy thử nâng cấp chiếc vỉ nướng này!
    m_Metadata:
      m_Items: []
  - m_Id: 57759218262034
    m_Localized: Bạn đã nâng cấp máy nướng bánh, giờ quay lại và bắt đầu ngày mới nào!
    m_Metadata:
      m_Items: []
  - m_Id: 57759218262035
    m_Localized: Giờ hãy bắt đầu ngày mới!
    m_Metadata:
      m_Items: []
  - m_Id: 57759218262036
    m_Localized: Hãy thử dùng trợ lực này!
    m_Metadata:
      m_Items: []
  - m_Id: 57759218262037
    m_Localized: Khi nấu ăn, bạn có cơ hội bước vào trạng thái đặc biệt!
    m_Metadata:
      m_Items: []
  - m_Id: 57759218262038
    m_Localized: Mỗi khách được phục vụ thành công, thanh này sẽ tăng lên! Hãy phục vụ thêm {0} khách nữa!
    m_Metadata:
      m_Items: []
  - m_Id: 57759222456320
    m_Localized: Mỗi món được phục vụ thành công, thanh này sẽ tăng lên! Hãy phục vụ thêm {0} món nữa!
    m_Metadata:
      m_Items: []
  - m_Id: 57759222456321
    m_Localized: Tuyệt! Ở trạng thái Bùng nổ hương vị, bạn nấu ăn cực kỳ hiệu quả. Chơi vui nhé!
    m_Metadata:
      m_Items: []
  - m_Id: 57759222456322
    m_Localized: Không đủ xu để xây
    m_Metadata:
      m_Items: []
