  schemaVersion: 1
  sourceGraphJson: "{\r\n  \"_note\": \"Map 1 (Burger) expressed as a recipe graph, with ONE deliberate design change from the runtime config: the chicken flour-coating step (see _derivation). Validated against schema.json. `idTable` is POSITIONAL — a row's index is the number level strings carry — so reordering a space renumbers it and re-aims every level string that used those indices.\",\r\n  \"_derivation\": [],\r\n  \"schemaVersion\": 1,\r\n  \"map\": {\r\n    \"id\": \"burger\",\r\n    \"name\": \"Burger\",\r\n    \"gridWidth\": 5,\r\n    \"gridHeight\": 2,\r\n    \"dirtyStackHeight\": 5,\r\n    \"visibleRows\": 3,\r\n    \"processSpeedMultiplier\": 1.5,\r\n    \"mergeSpeedMultiplier\": 1.0\r\n  },\r\n  \"idTable\": {\r\n    \"ingredient\": [\r\n      \"bun\",\r\n      \"patty\",\r\n      \"tomato\",\r\n      \"lettuce\",\r\n      \"onion\",\r\n      \"cheese\",\r\n      \"egg\",\r\n      \"cup\",\r\n      \"ice\",\r\n      \"chicken-breast\",\r\n      \"chicken-wing\",\r\n      \"chicken-thigh\",\r\n      \"chicken-nugget\",\r\n      \"potato\",\r\n      \"chili-bowl\",\r\n      \"chive\",\r\n      \"cheese-sauce\",\r\n      \"bun-sliced\",\r\n      \"patty-cooked\",\r\n      \"tomato-sliced\",\r\n      \"lettuce-sliced\",\r\n      \"onion-sliced\",\r\n      \"cheese-sliced\",\r\n      \"egg-cooked\",\r\n      \"soda-cup\",\r\n      \"chicken-breast-fried\",\r\n      \"chicken-wing-fried\",\r\n      \"chicken-thigh-fried\",\r\n      \"chicken-nugget-fried\",\r\n      \"potato-fried\",\r\n      \"chive-sliced\"\r\n    ],\r\n    \"composite\": [\r\n      \"burger\",\r\n      \"soda\",\r\n      \"fried-basket\"\r\n    ],\r\n    \"group\": [\r\n      \"burger-toppings\",\r\n      \"fried-basket-bases\",\r\n      \"fried-basket-sauces\"\r\n    ],\r\n    \"tool\": [\r\n      \"griddle\",\r\n      \"coca-machine\",\r\n      \"cutting-board\",\r\n      \"fryer\",\r\n      \"flour\"\r\n    ],\r\n    \"dirty\": [\r\n      \"dirty-plate\",\r\n      \"dirty-cup\",\r\n      \"dirty-chick-box\"\r\n    ]\r\n  },\r\n  \"vertices\": {\r\n    \"ingredient\": [\r\n      {\r\n        \"name\": \"bun\",\r\n        \"displayName\": \"Bun\",\r\n        \"pickupable\": true,\r\n        \"price\": 4,\r\n        \"code\": \"burger_bun_raw\",\r\n        \"emoji\": \"🍞\",\r\n        \"localImage\": \"Map1-burger/ingredients/burger_bun_raw.png\",\r\n        \"stackMin\": 1,\r\n        \"stackMax\": 5\r\n      },\r\n      {\r\n        \"name\": \"patty\",\r\n        \"displayName\": \"Patty\",\r\n        \"pickupable\": true,\r\n        \"price\": 10,\r\n        \"code\": \"beef_patty_raw\",\r\n        \"emoji\": \"🥩\",\r\n        \"localImage\": \"Map1-burger/ingredients/beef_patty_raw.png\",\r\n        \"stackMin\": 1,\r\n        \"stackMax\": 5\r\n      },\r\n      {\r\n        \"name\": \"tomato\",\r\n        \"displayName\": \"Tomato\",\r\n        \"pickupable\": true,\r\n        \"price\": 5,\r\n        \"code\": \"tomato\",\r\n        \"emoji\": \"🍅\",\r\n        \"localImage\": \"Map1-burger/ingredients/tomato.png\",\r\n        \"stackMin\": 1,\r\n        \"stackMax\": 5\r\n      },\r\n      {\r\n        \"name\": \"lettuce\",\r\n        \"displayName\": \"Lettuce\",\r\n        \"pickupable\": true,\r\n        \"price\": 5,\r\n        \"code\": \"lettuce_raw\",\r\n        \"emoji\": \"🥬\",\r\n        \"localImage\": \"Map1-burger/ingredients/lettuce_raw.png\",\r\n        \"stackMin\": 1,\r\n        \"stackMax\": 5\r\n      },\r\n      {\r\n        \"name\": \"onion\",\r\n        \"displayName\": \"Onion\",\r\n        \"pickupable\": true,\r\n        \"price\": 5,\r\n        \"code\": \"onion\",\r\n        \"emoji\": \"🧅\",\r\n        \"localImage\": \"Map1-burger/ingredients/onion.png\",\r\n        \"stackMin\": 1,\r\n        \"stackMax\": 5\r\n      },\r\n      {\r\n        \"name\": \"cheese\",\r\n        \"displayName\": \"Cheese\",\r\n        \"pickupable\": true,\r\n        \"price\": 6,\r\n        \"code\": \"cheese\",\r\n        \"emo