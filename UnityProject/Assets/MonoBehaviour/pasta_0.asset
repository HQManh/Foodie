  schemaVersion: 1
  sourceGraphJson: "{\n  \"_note\": \"Pasta combination artwork refreshed from current official Graph-4-Pasta; gameplay recipes, quantity limits, IDs and layout preserved.\",\n  \"_foodOrderableMap\": {\n    \"pasta\": [\n      \"pasta\"\n    ],\n    \"salad\": [\n      \"salad\"\n    ],\n    \"meat-food\": [\n      \"meat-food-with-topping\"\n    ],\n    \"soda\": [\n      \"soda\"\n    ]\n  },\n  \"_derivation\": [\n    {\n      \"food\": \"official-pasta-map\",\n      \"source\": \"src/data/config/nodegraph/maps/Graph-10-Pasta.json\",\n      \"decision\": \"User-selected official graph preserved: pan cooks ground meat/chicken/steak; griddler cooks seafood/bread; salad mixer combines lettuce/small tomato/mayonaise; soda takes ice. No recipe, quantity, automatic flag, ID table or layout changes.\"\n    }\n  ],\n  \"_imagePolicy\": {\n    \"provider\": \"Local preview assets with public Google Drive thumbnail fallback\",\n    \"manifest\": \"docs/preview_asset_manifests/55-pasta-combinations.json\",\n    \"driveFolderId\": \"1qqYrygkRHe2gCRf9BSjpKYTvyF03raqe\"\n  },\n  \"schemaVersion\": 1,\n  \"map\": {\n    \"id\": \"pasta\",\n    \"name\": \"Pasta Combinations\",\n    \"gridWidth\": 5,\n    \"gridHeight\": 2,\n    \"dirtyStackHeight\": 5,\n    \"visibleRows\": 3,\n    \"processSpeedMultiplier\": 1.0,\n    \"mergeSpeedMultiplier\": 1.0\n  },\n  \"idTable\": {\n    \"ingredient\": [\n      \"spaghetti-raw\",\n      \"manicotti-raw\",\n      \"farfalle-raw\",\n      \"spaghetti-boiled\",\n      \"manicotti-boiled\",\n      \"farfalle-boiled\",\n      \"tomato-large\",\n      \"spinach\",\n      \"cheese\",\n      \"milk\",\n      \"tomato-large-chopped\",\n      \"spinach-chopped\",\n      \"cheese-chopped\",\n      \"tomato-milk-sauce\",\n      \"spinach-milk-sauce\",\n      \"cheese-milk-sauce\",\n      \"lettuce\",\n      \"lettuce-cut\",\n      \"lemon\",\n      \"lemon-sliced\",\n      \"bread-loaf\",\n      \"octopus-raw\",\n      \"shrimp-raw\",\n      \"clam-raw\",\n      \"beef-steak-raw\",\n      \"chicken-raw\",\n      \"bread-grilled\",\n      \"octopus-grilled\",\n      \"shrimp-grilled\",\n      \"clam-grilled\",\n      \"beef-steak-grilled\",\n      \"chicken-grilled\",\n      \"soda-cup\",\n      \"octopus-raw-cut\",\n      \"mayonaise\",\n      \"ice\",\n      \"ground-meat-cooked\",\n      \"ground-meat-raw\",\n      \"shrimp-raw-cut\",\n      \"clam-raw-cut\",\n      \"apple-cut\",\n      \"apple\",\n      \"cup\"\n    ],\n    \"composite\": [\n      \"pasta\",\n      \"salad\",\n      \"meat-food-with-topping\",\n      \"soda\",\n      \"pasta-with-sauce\",\n      \"pasta-with-meat\",\n      \"salad-base-with-mayo\",\n      \"salad-base\"\n    ],\n    \"group\": [\n      \"pasta-shape-choice\",\n      \"sauce-choice\",\n      \"chick-or-beef\",\n      \"meat-topping\",\n      \"pasta-mix\",\n      \"all-meat-foods\",\n      \"salad-topping\",\n      \"common-topping\",\n      \"salad-base-add\",\n      \"soda-topping\"\n    ],\n    \"tool\": [\n      \"boiler-pot\",\n      \"chopping-board\",\n      \"sauce-blender\",\n      \"pan\",\n      \"soda-machine\"\n    ],\n    \"dirty\": [\n      \"dirty-plate\",\n      \"dirty-bowl\",\n      \"dirty-cup\"\n    ]\n  },\n  \"vertices\": {\n    \"ingredient\": [\n      {\n        \"name\": \"spaghetti-raw\",\n        \"displayName\": \"Raw Spaghetti\",\n        \"pickupable\": true,\n        \"emoji\": \"🍝\",\n        \"usageNum\": 1,\n        \"price\": 1,\n        \"pieceIndex\": \"0\",\n        \"imageURL\": \"/docs/preview_assets/55-pasta-combinations/nodes/spaghetti-raw.png\",\n        \"fileId\": \"1LeJ1rTljGkIfWvTdZeH0C0rZwbNw5TFt\",\n        \"localImage\": \"docs/preview_assets/55-pasta-combinations/nodes/spaghetti-raw.png\"\n      },\n      {\n        \"name\": \"manicotti-raw\",\n        \"displayName\": \"Raw Manicotti\",\n        \"pickupable\": true,\n        \"emoji\": \"🥖\",\n        \"usageNum\": 1,\n        \"price\": 1,\n        \"pieceIndex\": \"