    m_Metadata:
      m_Items: []
  - m_Id: 3223690643759104
    m_Localized: グルメショップ
    m_Metadata:
      m_Items: []
  - m_Id: 3229043783622656
    m_Localized: 道具をアップグレード！
    m_Metadata:
      m_Items: []
  - m_Id: 3229043821371392
    m_Localized: '{0}が速くなりました'
    m_Metadata:
      m_Items: []
  - m_Id: 3229043821371393
    m_Localized: '{0}が最高速度になりました'
    m_Metadata:
      m_Items: []
  - m_Id: 3232415119040512
    m_Localized: エクストラデイを解放
    m_Metadata:
      m_Items: []
  - m_Id: 3257663805710336
    m_Localized: お知らせ
    m_Metadata:
      m_Items: []
  - m_Id: 3257663847653376
    m_Localized: レストランに新しいアップグレードパーツが登場！
    m_Metadata:
      m_Items: []
  - m_Id: 3257663847653377
    m_Localized: '{0}に新しいエクストラデイが追加！'
    m_Metadata:
      m_Items: []
  - m_Id: 3257663847653378
    m_Localized: アップグレード価格を調整しました。払いすぎたゴールドを返却します！
    m_Metadata:
      m_Items: []
  - m_Id: 3313060306477056
