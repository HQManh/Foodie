  - m_Id: 5326573640081417
    m_Localized: ステージレース
    m_Metadata:
      m_Items: []
  - m_Id: 5326573640081418
    m_Localized: "レースに負けました！\nもう一度挑戦して、素晴らしい報酬を獲得しましょう！"
    m_Metadata:
      m_Items: []
  - m_Id: 5326573644275712
    m_Localized: "おめでとうございます！\nレースに勝利しました！"
    m_Metadata:
      m_Items: []
