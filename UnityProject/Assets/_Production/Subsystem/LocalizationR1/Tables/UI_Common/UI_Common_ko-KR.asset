    m_Metadata:
      m_Items: []
  - m_Id: 5326573648470018
    m_Localized: 시작
    m_Metadata:
      m_Items: []
  - m_Id: 5326573648470019
    m_Localized: 데이터 동기화
    m_Metadata:
      m_Items: []
  - m_Id: 5326573648470020
    m_Localized: 탭해서 계속하기!
    m_Metadata:
      m_Items: []
  - m_Id: 5326573648470021
    m_Localized: 탭해서 열기!
    m_Metadata:
      m_Items: []
  - m_Id: 5326573648470022
    m_Localized: 탭해서 받으세요!
    m_Metadata:
      m_Items: []
  - m_Id: 5326573648470023
    m_Localized: 탭하여 닫기!
    m_Metadata:
      m_Items: []
  - m_Id: 5326573648470024
    m_Localized: 팀 정보
    m_Metadata:
      m_Items: []
  - m_Id: 5326573648470025
    m_Localized: '팀 배지:'
    m_Metadata:
