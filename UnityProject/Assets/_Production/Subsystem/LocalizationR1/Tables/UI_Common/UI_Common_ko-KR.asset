    m_Metadata:
      m_Items: []
  - m_Id: 5326573547806721
    m_Localized: 팀이 이미 존재합니다!
    m_Metadata:
      m_Items: []
  - m_Id: 5326573547806722
    m_Localized: 팀이 꽉 찼습니다!
    m_Metadata:
      m_Items: []
