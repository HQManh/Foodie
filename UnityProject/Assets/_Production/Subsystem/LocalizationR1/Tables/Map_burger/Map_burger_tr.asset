  m_LocaleId:
    m_Code: tr
  m_SharedData: {fileID: 11400000, guid: 70ba2199d21f4314980f738ed34bd399, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 57789920567296
    m_Localized: Başlangıç burger tezgâhı. En baştan senin.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927424
    m_Localized: Daha geniş cepheli ve süslemelere daha çok yer açan tam bir burger evi.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927425
    m_Localized: Bal gibi tatlı, patatesler gelince iki kat sevimli.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927426
    m_Localized: Mükemmel ızgara, bu köfte tam kıvamında.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927427
    m_Localized: Az pişmiş, çiğ ve ızgaraya çıkmak için sabırsız.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927428
    m_Localized: Kapının yanında duran küçük menü tahtası.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927429
    m_Localized: Dükkânın önünde duran uzun reklam panosu.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927430
    m_Localized: Kat kat dizilmiş ve tamamen formunda.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927431
    m_Localized: Malzemeleri altın rengi ve çıtır olana dek kızartır.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927432
    m_Localized: Gazlı kola doldurur.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927433
    m_Localized: Malzemeleri parçalara doğrar.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927434
    m_Localized: Çelik gibi sağlam kızarmış ekmek.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927435
    m_Localized: Sonunda içini açan bir ekmek.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927436
    m_Localized: Hâlâ tembellik eden yumuşacık bir ekmek.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927437
    m_Localized: Malzemelerin geldiği yer.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927438
    m_Localized: Çatının üstüne monte edilmiş restoran tabelası.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927439
    m_Localized: Acele etmek için fazla havalı, siparişini hep tam zamanında bir mırlamayla verir.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927440
    m_Localized: Minik patiler, büyük iştah ve ekstra peynirden hiç utanmıyor.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927441
    m_Localized: Rendelenmeye hazır, potansiyeli yüksek bir süt ürünü.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927442
    m_Localized: Dilim peynir, birkaç kalbi eritmeye hazır.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927443
    m_Localized: Her şeyi harika yapan erimiş altın.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927444
    m_Localized: Una bulanmış göğüs, çıtır çıtır sahneye hazır.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927445
    m_Localized: Sade ve solgun, hâlâ büyük kızartma anını bekliyor.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927446
    m_Localized: Dışı çıtır, içi sulu, parmak yedirten lezzet.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927447
    m_Localized: Un zırhını giymiş küçük bir nugget.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927448
    m_Localized: Küçük, lokmalık ve fritözün hayalini kuruyor.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927449
    m_Localized: Un paltolu but, dolgun ve hazır.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927450
    m_Localized: En sulu parça, potansiyelini hâlâ saklıyor.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927451
    m_Localized: Uçmayı öğrenmeden hamura bulanmış kanatlar.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927452
    m_Localized: Henüz hiç çıtırlığı olmayan bir kanat.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927453
    m_Localized: Ateşi getiren kırmızı toz, sakinlik yok.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927454
    m_Localized: Soğanı biraz kıskanan yeşil saplar.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927455
    m_Localized: Çıtır bir kutlama için minik yeşil konfeti.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927456
    m_Localized: Bir amaca susamış boş bir bardak.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927457
    m_Localized: Heyecandan köpüren koyu gazlı içecek.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927458
    m_Localized: Buzlu kola, buz gibi bir tavırla servis edilir.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927459
    m_Localized: Siparişe göre dizilir, ekmek pes etmeden yenmesi en iyisi.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927460
    m_Localized: Her burger lokmasını daha coşkulu yapan buz gibi kabarcıklar.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927461
    m_Localized: Dışı altın rengi, içi sulu ve dört ısırıkta biter.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927462
    m_Localized: Sıcak, tuzlu ve adil paylaşılması imkânsız.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927463
    m_Localized: Her burgeri kuyruk sallatan bir hazine gibi gören sadık küçük müşteri.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927464
    m_Localized: Kırılgandır, baskı altında çatlar.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927465
    m_Localized: Güneşli tarafı yukarıda ve yumurta gibi neşeli.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927466
    m_Localized: Yiyecekleri altın rengi ve çıtır olana dek kızartır.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927467
    m_Localized: Malzemeleri bir kat hamurla kaplar.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927468
    m_Localized: Soğukkanlı olmaya karar veren su.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927469
    m_Localized: Çıtır olan her şey tek kutuda, muhteşem bir tavuk ziyafeti.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927470
    m_Localized: Çıtır yeşil yapraklar, hadi marul marul başlayalım.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927471
    m_Localized: Sonunda baştan ayrılan kıyılmış yeşillikler.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927472
    m_Localized: Aklı başında kocaman bir marul.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927473
    m_Localized: Sol taraf boyunca asılı ip ışıklar.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927474
    m_Localized: Çatının üstüne monte edilmiş restoran tabelası.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927475
    m_Localized: Öğle telaşını yönetim kurulu gibi yönetir ve birinci sınıf turşu ister.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927476
    m_Localized: Girişin yanındaki saksı bitkisi.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927477
    m_Localized: Kızartma yıldızı olmayı hayal eden mütevazı bir patates.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927478
    m_Localized: Çubuk şeklinde doğrandı, artık kızartılmayı bekleyen bir patates.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927479
    m_Localized: Tuz tartışması başlatacak kadar sıcak altın patatesler.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927480
    m_Localized: Peynirin altına gömülmüş patates, hiç pişmanlık yok.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927481
    m_Localized: Aç aç zıplayarak gelir, iki yanağında kırıntılarla gider.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927482
    m_Localized: Şehrin en hızlı kırmızı kuyruklu kuryesi, tabii biri patates düşürmezse.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927483
    m_Localized: Mor, keskin ve gizliden gizliye duygusal.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927484
    m_Localized: Şefi ağlatan halka dilimler.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927485
    m_Localized: Çatının üstünde duran dev bir burger maketi.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927486
    m_Localized: Binanın sağ tarafından sarkan tabela.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927487
    m_Localized: Binanın sağ tarafından sarkan tabela.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927488
    m_Localized: Yuvarlak, kırmızı ve teknik olarak bir meyve.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927489
    m_Localized: Artık hiçbir eksiği kalmamış sulu dilimler.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927490
    m_Localized: Çatı kenarından sarkan sarmaşıklar.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927491
    m_Localized: Daha Büyük Ev
    m_Metadata:
      m_Items: []
