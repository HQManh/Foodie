      m_Items: []
  - m_Id: 8069138441297920
    m_Localized: Marul daha yere düşmeden doğranıyor.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138487435264
    m_Localized: Samuray Doğrayıcı
    m_Metadata:
      m_Items: []
  - m_Id: 8069138491629568
    m_Localized: Öyle keskin ki havayı kesiyor. Domatesler selam duruyor.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138491629569
    m_Localized: Efsanevi Bıçak Tahtası
    m_Metadata:
      m_Items: []
  - m_Id: 8069138491629570
    m_Localized: Köpükle patlıyor. Bardaklar kendiliğinden doluyor.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138491629571
    m_Localized: Kola Yanardağı
    m_Metadata:
      m_Items: []
  - m_Id: 8069138491629572
    m_Localized: Sonsuza dek köpük. Susuzluğun hiç şansı yok.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138491629573
    m_Localized: Sonsuz Köpük Çeşmesi
    m_Metadata:
      m_Items: []
  - m_Id: 8069138491629574
    m_Localized: Siz çıtır diyene kadar nuggetlar kaplanıyor.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138495823872
    m_Localized: Un Tipisi
    m_Metadata:
      m_Items: []
  - m_Id: 8069138495823873
    m_Localized: Her nugget kraliyet ailesi gibi giyinip çıkıyor.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138495823874
    m_Localized: Altın Toz Kâsesi
    m_Metadata:
      m_Items: []
  - m_Id: 8069138495823875
    m_Localized: Patatesler soluk girip altın gibi fırlıyor.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138495823876
    m_Localized: Turbo Fritöz
    m_Metadata:
      m_Items: []
  - m_Id: 8069138495823877
    m_Localized: Işık hızında çıtır.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138495823878
    m_Localized: Efsanevi Kızartma Reaktörü
    m_Metadata:
      m_Items: []
  - m_Id: 8069138495823879
    m_Localized: Köfteler göz açıp kapayana kadar pişiyor. Kaşlarına dikkat.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138495823880
    m_Localized: Yanardağ Izgara
    m_Metadata:
      m_Items: []
  - m_Id: 8069138500018176
    m_Localized: Güneş kadar sıcak, roket kadar hızlı. Burger cenneti.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138500018177
    m_Localized: Efsanevi Güneş Izgarası
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
