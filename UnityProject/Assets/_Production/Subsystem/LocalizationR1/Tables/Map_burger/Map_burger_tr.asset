    m_Metadata:
      m_Items: []
  - m_Id: 57789949927555
    m_Localized: Domates
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927556
    m_Localized: Dilim Domates
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927557
    m_Localized: Sarmaşıklar
    m_Metadata:
      m_Items: []
  - m_Id: 3010520264204288
    m_Localized: Sebzeleri marulun kızarmasından daha hızlı doğrar.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758720
    m_Localized: Dilimle, küp küp doğra, bitti. Soğanların hiç şansı yoktu.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758721
    m_Localized: Gazlı kolayı bir anda doldurur, köpüğüyle birlikte.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758722
    m_Localized: Bol köpük! Gazoz ve neşe fıskiyesi.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758723
    m_Localized: Tavuğu en yüksek hızda una bular. Dağınık ama lezzetli.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758724
    m_Localized: Bir un kar fırtınası. Her nugget rahat bir battaniye alıyor.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758725
    m_Localized: Rekor sürede altın sarısı patates. Çıtırlık garantili.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758726
    m_Localized: Ekstra çıtırlık açıldı. Patatesler gururla parlıyor.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758727
    m_Localized: Köfteler daha hızlı cızırdar. Mideler daha çok guruldar.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758728
    m_Localized: O kadar sıcak ki burgerler kendiliğinden ters dönüyor. Kelimenin tam anlamıyla.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758729
    m_Localized: Hızlı Doğrayıcı
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758730
    m_Localized: Ninja Doğrayıcı
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758731
    m_Localized: Hızlı Gazlı İçecek Makinesi
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758732
