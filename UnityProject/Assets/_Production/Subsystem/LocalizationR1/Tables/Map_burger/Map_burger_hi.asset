  m_SharedData: {fileID: 11400000, guid: 70ba2199d21f4314980f738ed34bd399, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 57789920567296
    m_Localized: शुरुआती बर्गर स्टैंड। शुरुआत से ही आपका।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927424
    m_Localized: चौड़े सामने वाला पूरा बर्गर घर, सजावट के लिए ज़्यादा जगह के साथ।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927425
    m_Localized: शहद जैसा मीठा और फ्राइज़ आने पर दुगना प्यारा।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927426
    m_Localized: एकदम परफ़ेक्ट ग्रिल, इस पैटी ने कमाल कर दिया।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927427
    m_Localized: कच्ची, बिना पकी और तवे पर जाने को बेताब।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927428
    m_Localized: दरवाज़े के पास खड़ा छोटा मेन्यू बोर्ड।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927429
    m_Localized: दुकान के सामने लगा ऊँचा विज्ञापन बोर्ड।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927430
    m_Localized: परतों में सजा और पूरी तरह जोश में।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927431
    m_Localized: सामग्री को सुनहरा और कुरकुरा होने तक तलें।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927432
    m_Localized: झागदार कोला डालता है।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927433
    m_Localized: सामग्री को टुकड़ों में काटता है।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927434
    m_Localized: सिका हुआ बन, फ़ौलादी दमख़म के साथ।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927435
    m_Localized: एक बन जिसने आखिरकार अपना दिल खोल दिया।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927436
    m_Localized: एक नरम बन जो अब भी आराम फरमा रहा है।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927437
    m_Localized: यहीं से सामग्री आती है।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927438
    m_Localized: छत के ऊपर लगा रेस्टोरेंट का बोर्ड।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927439
    m_Localized: जल्दबाज़ी के लिए बहुत कूल, और हमेशा सही वक़्त पर घुरघुराते हुए ऑर्डर करता है।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927440
    m_Localized: नन्हे पंजे, बड़ी भूख और एक्स्ट्रा चीज़ पर ज़रा भी शर्म नहीं।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927441
    m_Localized: कद्दूकस होने को तैयार, कमाल की संभावनाओं वाला डेयरी का टुकड़ा।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927442
    m_Localized: कटा चीज़, कुछ दिल पिघलाने को तैयार।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927443
    m_Localized: पिघला हुआ सोना, जो हर चीज़ को शानदार बना दे।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927444
    m_Localized: आटे में लिपटा ब्रेस्ट, कुरकुरी शुरुआत के लिए तैयार।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927445
    m_Localized: सादा और फीका, अब भी अपने बड़े तलने के पल का इंतज़ार।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927446
    m_Localized: बाहर से कुरकुरा, अंदर से रसीला, उंगलियाँ चाटते रह जाओ।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927447
    m_Localized: आटे का कवच पहने एक छोटा नगेट।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927448
    m_Localized: छोटा सा, एक कौर का और डीप फ्रायर के सपने देखता।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927449
    m_Localized: आटे के कोट में थाई, मोटी-ताज़ी और तैयार।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927450
    m_Localized: सबसे रसीला टुकड़ा, जो अब भी अपनी क्षमता छिपाए है।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927451
    m_Localized: उड़ना सीखने से पहले ही बैटर में लिपटे विंग्स।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927452
    m_Localized: एक विंग जिसमें अभी कोई कुरकुरापन नहीं।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927453
    m_Localized: लाल पाउडर जो गर्मी लाए, ठंडक बिल्कुल नहीं।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927454
    m_Localized: हरी डंडियाँ, जिन्हें प्याज़ से थोड़ी जलन है।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927455
    m_Localized: कुरकुरे जश्न के लिए नन्हा हरा कॉन्फ़ेटी।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927456
    m_Localized: एक खाली कप, जिसे मकसद की प्यास है।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927457
    m_Localized: गहरे रंग का सोडा, उत्साह से बुलबुले छोड़ता।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927458
    m_Localized: बर्फ़ वाला कोला, ठंडी बेरुखी के साथ परोसा गया।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927459
    m_Localized: ऑर्डर पर तैयार, बन के हार मानने से पहले खाना बेहतर।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927460
    m_Localized: बर्फ़ीले बुलबुले, जो बर्गर के हर कौर को और मज़ेदार बनाएं।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927461
    m_Localized: बाहर से सुनहरा, अंदर से रसीला और चार कौर में ख़त्म।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927462
    m_Localized: गरम, नमकीन और बराबर बाँटना नामुमकिन।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927463
    m_Localized: एक वफ़ादार नन्हा ग्राहक जो हर बर्गर को पूंछ हिलाने वाला ख़ज़ाना मानता है।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927464
    m_Localized: नाज़ुक है, दबाव में टूट जाएगा।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927465
    m_Localized: सनी साइड अप और बेहद खुशमिज़ाज।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927466
    m_Localized: खाने को सुनहरा और कुरकुरा होने तक तलता है।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927467
    m_Localized: सामग्री पर बैटर की परत चढ़ाता है।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927468
    m_Localized: वह पानी जिसने ठंडा रहने का फ़ैसला किया।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927469
    m_Localized: सारी कुरकुरी चीज़ें, एक शानदार दावत के डिब्बे में।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927470
    m_Localized: कुरकुरी हरी पत्तियाँ, तो चलो शुरुआत करें।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927471
    m_Localized: कटी हुई हरी पत्तियाँ, जो आख़िरकार सिर से अलग हो गईं।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927472
    m_Localized: ठंडे दिमाग वाला पूरा का पूरा सलाद पत्ता।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927473
    m_Localized: बाईं ओर लगी झालर वाली लाइटें।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927474
    m_Localized: छत के ऊपर लगा रेस्टोरेंट का बोर्ड।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927475
    m_Localized: लंच की भीड़ को बोर्डरूम की तरह चलाता है और बढ़िया अचार माँगता है।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927476
    m_Localized: प्रवेश द्वार के पास रखा गमला।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927477
    m_Localized: फ्राइज़ स्टार बनने का सपना देखने वाला साधारण आलू।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927478
    m_Localized: लंबी फाँकों में कटा, अब तलने की राह देखता फ्राई।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927479
    m_Localized: इतने गरम सुनहरे फ्राइज़ कि नमक पर बहस छिड़ जाए।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927480
    m_Localized: चीज़ के नीचे दबे फ्राइज़, कोई पछतावा नहीं।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927481
    m_Localized: भूखी उछलती हुई आती है और दोनों गालों पर चूरा लगाकर जाती है।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927482
    m_Localized: शहर का सबसे तेज़ लाल पूंछ वाला कूरियर, जब तक कोई फ्राई न गिरा दे।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927483
    m_Localized: बैंगनी, तीखा और चुपके से भावुक।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927484
    m_Localized: कटे छल्ले, जिन्होंने शेफ़ को रुला दिया।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927485
    m_Localized: छत पर रखा एक बड़ा सा बर्गर मॉडल।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927486
    m_Localized: इमारत के दाईं ओर लटकता बोर्ड।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927487
    m_Localized: इमारत के दाईं ओर लटकता बोर्ड।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927488
    m_Localized: गोल, लाल और तकनीकी रूप से एक फल।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927489
    m_Localized: रसीले टुकड़े, जिनमें कोई कमी नहीं।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927490
    m_Localized: छत के किनारे से लटकती बेलें।
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927491
    m_Localized: बड़ा घर
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927492
    m_Localized: हनी हग भालू
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927493
    m_Localized: बीफ़ पैटी
    m_Metadata:
