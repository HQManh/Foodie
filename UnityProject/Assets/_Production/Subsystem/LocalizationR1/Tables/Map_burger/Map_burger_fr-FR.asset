  m_LocaleId:
    m_Code: fr-FR
  m_SharedData: {fileID: 11400000, guid: 70ba2199d21f4314980f738ed34bd399, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 57789920567296
    m_Localized: Le stand de burgers de départ. Il vous appartient dès le début.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927424
    m_Localized: Une vraie maison du burger, avec une façade plus large et plus de place pour la déco.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927425
    m_Localized: Doux comme le miel et deux fois plus câlin quand les frites arrivent.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927426
    m_Localized: Grillé à la perfection, ce steak a bien travaillé.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927427
    m_Localized: Saignant, cru et prêt à en découdre avec la plaque.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927428
    m_Localized: Un petit tableau de menu près de la porte.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927429
    m_Localized: Un grand panneau publicitaire devant la boutique.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927430
    m_Localized: Empilé, étagé et absolument en pleine forme.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927431
    m_Localized: Fait frire les ingrédients jusqu'à ce qu'ils soient dorés et croustillants.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927432
    m_Localized: Verse du cola pétillant.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927433
    m_Localized: Coupe les ingrédients en morceaux.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927434
    m_Localized: Un pain toasté aux fesses d'acier.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927435
    m_Localized: Un pain qui s'est enfin ouvert sur ses sentiments.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927436
    m_Localized: Un pain tout mou qui paresse encore.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927437
    m_Localized: D'où viennent les ingrédients.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927438
    m_Localized: L'enseigne du restaurant, fixée au-dessus du toit.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927439
    m_Localized: Trop cool pour se presser, il commande toujours avec un ronronnement parfaitement placé.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927440
    m_Localized: Petites pattes, gros appétit, et aucune honte à reprendre du fromage.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927441
    m_Localized: Un bloc de laitage au potentiel râpe-ment énorme.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927442
    m_Localized: Du fromage en tranches, prêt à faire fondre les cœurs.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927443
    m_Localized: De l'or fondu qui rend tout meilleur.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927444
    m_Localized: Un blanc habillé de farine, prêt pour ses débuts croustillants.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927445
    m_Localized: Pâle et banal, il attend encore sa grande friture.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927446
    m_Localized: Croustillant dehors, juteux dedans, à s'en lécher les doigts.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927447
    m_Localized: Un petit nugget dans son armure de farine.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927448
    m_Localized: Petit, en bouchée, et qui rêve de la friteuse.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927449
    m_Localized: Une cuisse en manteau de farine, bien dodue et prête.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927450
    m_Localized: Le morceau le plus juteux, qui cache encore son potentiel.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927451
    m_Localized: Des ailes enrobées de pâte avant même d'apprendre à voler.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927452
    m_Localized: Une aile qui n'a encore rien de croustillant.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927453
    m_Localized: Une poudre rouge qui met le feu, zéro calme.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927454
    m_Localized: Des tiges vertes un peu jalouses des oignons.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927455
    m_Localized: Des confettis verts pour une fête croustillante.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927456
    m_Localized: Un gobelet vide assoiffé de sens.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927457
    m_Localized: Un soda sombre qui pétille d'excitation.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927458
    m_Localized: Du cola sur glace, servi avec une froideur calculée.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927459
    m_Localized: Monté à la commande, à dévorer avant que le pain ne cède.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927460
    m_Localized: Des bulles glacées qui rendent chaque bouchée de burger plus bruyante.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927461
    m_Localized: Doré dehors, juteux dedans, et avalé en quatre bouchées.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927462
    m_Localized: Chaud, salé et impossible à partager équitablement.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927463
    m_Localized: Un petit client fidèle qui voit chaque burger comme un trésor à faire remuer la queue.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927464
    m_Localized: Fragile, il craquera sous la pression.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927465
    m_Localized: Au plat, côté soleil, et œuf-tra joyeux.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927466
    m_Localized: Fait frire les aliments jusqu'à ce qu'ils soient dorés et croustillants.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927467
    m_Localized: Enrobe les ingrédients d'une couche de pâte.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927468
    m_Localized: De l'eau qui a décidé de rester cool.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927469
    m_Localized: Tout le croustillant réuni dans un festin glorieux.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927470
    m_Localized: 'Des feuilles vertes croquantes : que la salade commence !'
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927471
    m_Localized: Des feuilles émincées qui ont enfin quitté la tête.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927472
    m_Localized: Une laitue entière qui garde la tête froide.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927473
    m_Localized: Une guirlande lumineuse le long du côté gauche.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927474
    m_Localized: L'enseigne du restaurant, fixée au-dessus du toit.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927475
    m_Localized: Mène le coup de feu du midi comme un conseil d'administration et exige des cornichons haut de gamme.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927476
    m_Localized: Une plante en pot près de l'entrée.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927477
    m_Localized: Une humble patate qui rêve de devenir une star de la frite.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927478
    m_Localized: Coupée en bâtonnets, c'est une frite en devenir.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927479
    m_Localized: Des frites dorées assez chaudes pour lancer un débat sur le sel.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927480
    m_Localized: Des frites ensevelies sous le fromage, aucun regret.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927481
    m_Localized: Arrive en bondissant, affamée, et repart avec des miettes sur les deux joues.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927482
    m_Localized: Le coursier à queue rouge le plus rapide de la ville, sauf si quelqu'un fait tomber une frite.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927483
    m_Localized: Violet, piquant et secrètement émotif.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927484
    m_Localized: Des rondelles qui ont fait pleurer le chef.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927485
    m_Localized: Un burger géant posé sur le toit.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927486
    m_Localized: Une enseigne suspendue sur le côté droit du bâtiment.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927487
    m_Localized: Une enseigne suspendue sur le côté droit du bâtiment.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927488
    m_Localized: Rond, rouge et techniquement un fruit.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927489
    m_Localized: Des tranches juteuses qui n'ont plus rien à rattraper.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927490
    m_Localized: Des lianes qui pendent au bord du toit.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927491
    m_Localized: Maison agrandie
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927492
    m_Localized: Ours Câlin-Miel
    m_Metadata:
      m_Items: []
