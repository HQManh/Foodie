  - m_Id: 8069138495823878
    m_Localized: Legendary Fry Reactor
    m_Metadata:
      m_Items: []
  - m_Id: 8069138495823879
    m_Localized: Patties cook in a blink. Mind your eyebrows.
    m_Metadata:
