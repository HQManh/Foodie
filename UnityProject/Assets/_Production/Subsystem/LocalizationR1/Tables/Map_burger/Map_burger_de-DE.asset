  m_Name: Map_burger_de-DE
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: de-DE
  m_SharedData: {fileID: 11400000, guid: 70ba2199d21f4314980f738ed34bd399, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 57789920567296
    m_Localized: Der erste Burgerstand. Gehört dir von Anfang an.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927424
    m_Localized: Ein komplettes Burgerhaus mit breiterer Front und mehr Platz für Deko.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927425
    m_Localized: Süß wie Honig und doppelt so kuschelig, wenn die Pommes kommen.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927426
    m_Localized: Perfekt gegrillt – dieses Patty hat gut gemacht.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927427
    m_Localized: Roh, ungegart und heiß auf die Grillplatte.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927428
    m_Localized: Kleine Menütafel neben der Tür.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927429
    m_Localized: Hohe Werbetafel vor dem Laden.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927430
    m_Localized: Gestapelt, geschichtet und absolut in Topform.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927431
    m_Localized: Brät die Zutaten goldbraun und knusprig.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927432
    m_Localized: Schenkt sprudelnde Cola ein.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927433
    m_Localized: Schneidet Zutaten in Stücke.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927434
    m_Localized: Getoastetes Brötchen mit Stahl-Po.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927435
    m_Localized: Ein Brötchen, das sich endlich geöffnet hat.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927436
    m_Localized: Ein weiches Brötchen, das noch faulenzt.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927437
    m_Localized: Hier kommen die Zutaten her.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927438
    m_Localized: Restaurantschild über der Dachkante.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927439
    m_Localized: Zu cool zum Eilen und bestellt immer mit perfekt getimtem Schnurren.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927440
    m_Localized: Kleine Pfoten, großer Appetit und null Scham bei Extra-Käse.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927441
    m_Localized: Ein Block Milchprodukt mit reibendem Potenzial.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927442
    m_Localized: Käsescheiben, bereit, Herzen zum Schmelzen zu bringen.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927443
    m_Localized: Flüssiges Gold, das alles großartig macht.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927444
    m_Localized: Brust im Mehlkleid, bereit für ihr knuspriges Debüt.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927445
    m_Localized: Blass und schlicht, wartet noch auf seinen großen Frittier-Moment.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927446
    m_Localized: Außen knusprig, innen saftig – zum Fingerlecken gut.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927447
    m_Localized: Ein kleines Nugget in seiner Mehlrüstung.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927448
    m_Localized: Klein, mundgerecht und träumt von der Fritteuse.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927449
    m_Localized: Keule im Mehlmantel, schön dick und startklar.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927450
    m_Localized: Das saftigste Stück, das sein Potenzial noch versteckt.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927451
    m_Localized: Flügel im Teigmantel, bevor sie fliegen lernen.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927452
    m_Localized: Ein Flügel, der noch keinen Crunch hat.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927453
    m_Localized: Roter Staub, der Hitze bringt – keine Spur von cool.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927454
    m_Localized: Grüne Stängel mit einem leichten Fall von Zwiebelneid.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927455
    m_Localized: Winziges grünes Konfetti für eine knusprige Feier.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927456
    m_Localized: Ein leerer Becher mit Durst nach Sinn.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927457
    m_Localized: Dunkle Limo, die vor Aufregung sprudelt.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927458
    m_Localized: Cola auf Eis, serviert mit der kalten Schulter.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927459
    m_Localized: Frisch geschichtet und am besten gegessen, bevor das Brötchen aufgibt.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927460
    m_Localized: Eiskalte Bläschen, die jeden Burgerbissen lauter machen.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927461
    m_Localized: Außen golden, innen saftig und in vier Bissen weg.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927462
    m_Localized: Heiß, salzig und unmöglich gerecht zu teilen.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927463
    m_Localized: Ein treuer kleiner Gast, für den jeder Burger ein schwanzwedelnder Schatz ist.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927464
    m_Localized: Zerbrechlich – unter Druck knackt es.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927465
    m_Localized: Sonnenseite oben und ei-nfach gut gelaunt.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927466
    m_Localized: Frittiert Speisen goldbraun und knusprig.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927467
    m_Localized: Umhüllt Zutaten mit einer Teigschicht.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927468
    m_Localized: Wasser, das beschlossen hat, cool zu bleiben.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927469
    m_Localized: Alles Knusprige in einer glorreichen Hähnchen-Box vereint.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927470
    m_Localized: Knackige grüne Blätter – lass uns salat-starten.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927471
    m_Localized: Geschnittenes Grün, das endlich den Kopf verlassen hat.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927472
    m_Localized: Ein ganzer Salatkopf, der einen kühlen Kopf bewahrt.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927473
    m_Localized: Lichterkette entlang der linken Seite.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927474
    m_Localized: Restaurantschild über der Dachkante.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927475
    m_Localized: Leitet den Mittagsansturm wie eine Vorstandssitzung und verlangt Premium-Gurken.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927476
    m_Localized: Topfpflanze neben dem Eingang.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927477
    m_Localized: Eine bescheidene Kartoffel mit Pommes-Star-Ambitionen.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927478
    m_Localized: In Stifte geschnitten – jetzt ein Pommes in Wartestellung.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927479
    m_Localized: Goldene Pommes, heiß genug für eine Salzdebatte.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927480
    m_Localized: Pommes unter Käse begraben – ohne jede Reue.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927481
    m_Localized: Hüpft hungrig herein und geht mit Krümeln auf beiden Backen.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927482
    m_Localized: Der schnellste rotschwänzige Kurier der Stadt – außer jemand lässt ein Pommes fallen.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927483
    m_Localized: Lila, scharf und heimlich emotional.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927484
    m_Localized: Geschnittene Ringe, die den Koch zum Weinen brachten.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927485
    m_Localized: Ein riesiger Deko-Burger auf dem Dach.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927486
    m_Localized: Schild an der rechten Seite des Gebäudes.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927487
    m_Localized: Schild an der rechten Seite des Gebäudes.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927488
    m_Localized: Rund, rot und technisch gesehen eine Frucht.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927489
    m_Localized: Saftige Scheiben, denen es an nichts mehr fehlt.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927490
    m_Localized: Hängende Ranken über der Dachkante.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927491
    m_Localized: Größeres Haus
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927492
    m_Localized: Honig-Kuschelbär
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927493
    m_Localized: Rindfleisch-Patty
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927494
    m_Localized: Rohes Patty
    m_Metadata:
