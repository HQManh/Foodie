  - m_Id: 57789949927543
    m_Localized: Blumentopf
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927544
    m_Localized: Kartoffel
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927545
    m_Localized: Geschnittene Kartoffel
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927546
    m_Localized: Pommes
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927547
    m_Localized: Käsepommes
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927548
    m_Localized: Bunbun Bella
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927549
    m_Localized: Roter Ratten-Kurier
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927550
    m_Localized: Rote Zwiebel
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927551
    m_Localized: Geschnittene rote Zwiebel
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927552
    m_Localized: Riesenburger
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927553
    m_Localized: Hängeschild
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927554
    m_Localized: Mastschild
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927555
    m_Localized: Tomate
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927556
    m_Localized: Tomatenscheiben
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927557
    m_Localized: Ranken
    m_Metadata:
      m_Items: []
  - m_Id: 3010520264204288
    m_Localized: Hackt Gemüse schneller, als ein Salatkopf erröten kann.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758720
    m_Localized: Schneiden, würfeln, fertig. Die Zwiebeln hatten keine Chance.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758721
    m_Localized: Schenkt sprudelnde Cola im Nu ein, samt Blubberblasen.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758722
    m_Localized: Jede Menge Sprudel! Eine Fontäne aus Limo und Freude.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758723
    m_Localized: Wendet Hähnchen in Rekordtempo in Mehl. Chaotisch, aber lecker.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758724
    m_Localized: Ein Schneesturm aus Mehl. Jeder Nugget bekommt eine kuschelige Decke.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758725
    m_Localized: Goldene Pommes in Rekordzeit. Knusprig garantiert.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758726
    m_Localized: Extra Knusprigkeit freigeschaltet. Die Pommes strahlen vor Stolz.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758727
    m_Localized: Die Patties brutzeln schneller. Die Mägen knurren lauter.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758728
    m_Localized: So heiß, dass Burger darauf fliegen. Wortwörtlich.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758729
    m_Localized: Flinker Hacker
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758730
    m_Localized: Ninja-Hacker
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758731
    m_Localized: Sprudel-Schnellmaschine
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758732
    m_Localized: Cola-Geysir
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758733
    m_Localized: Flinke Panierschüssel
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758734
    m_Localized: Mehl-Rausch-Schüssel
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758735
    m_Localized: Knusprige Fritteuse
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758736
    m_Localized: Goldene Fritteuse
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758737
    m_Localized: Zisch-Grillplatte
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758738
    m_Localized: Mega-Zisch-Grillplatte
    m_Metadata:
      m_Items: []
  - m_Id: 8069138441297920
    m_Localized: Der Salat ist zerkleinert, bevor er überhaupt landet.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138487435264
    m_Localized: Samurai-Hackbrett
    m_Metadata:
      m_Items: []
  - m_Id: 8069138491629568
    m_Localized: So scharf, dass es die Luft zerschneidet. Die Tomaten salutieren.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138491629569
    m_Localized: Legendäres Klingenbrett
    m_Metadata:
      m_Items: []
  - m_Id: 8069138491629570
    m_Localized: Er bricht mit Sprudel aus. Die Becher füllen sich von selbst.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138491629571
    m_Localized: Cola-Vulkan
    m_Metadata:
      m_Items: []
  - m_Id: 8069138491629572
    m_Localized: Blubbern für immer. Der Durst hat keine Chance.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138491629573
