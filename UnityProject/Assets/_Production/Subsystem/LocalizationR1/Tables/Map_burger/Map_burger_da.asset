  m_Name: Map_burger_da
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: da
  m_SharedData: {fileID: 11400000, guid: 70ba2199d21f4314980f738ed34bd399, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 57789920567296
    m_Localized: Start-burgerbod. Ejet fra begyndelsen.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927424
    m_Localized: Et fuldt burgerhus med bredere facade og mere plads til pynt.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927425
    m_Localized: Sød som honning og dobbelt så nuttet, når pomfritterne kommer.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927426
    m_Localized: Grillet til perfektion – denne bøf har gjort det godt.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927427
    m_Localized: Rå, ustegt og klar til kamp på stegepladen.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927428
    m_Localized: Lille menutavle ved døren.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927429
    m_Localized: Højt reklameskilt foran butikken.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927430
    m_Localized: Stablet, lagdelt og helt oppe at køre.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927431
    m_Localized: Steg ingredienserne gyldne og sprøde.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927432
    m_Localized: Hælder brusende cola op.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927433
    m_Localized: Hakker ingredienser i stykker.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927434
    m_Localized: Ristet bolle med stålsat bagdel.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927435
    m_Localized: En bolle, der endelig har åbnet sig.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927436
    m_Localized: En blød bolle, der stadig driver den af.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927437
    m_Localized: Her kommer ingredienserne fra.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927438
    m_Localized: Restaurantskilt monteret over taglinjen.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927439
    m_Localized: For cool til at skynde sig og bestiller altid med en perfekt timet spinden.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927440
    m_Localized: Små poter, stor appetit og ingen skam over ekstra ost.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927441
    m_Localized: En klump mejeri med revet potentiale.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927442
    m_Localized: Skiveskåret ost, klar til at smelte nogle hjerter.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927443
    m_Localized: Smeltet guld, der gør alt fantastisk.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927444
    m_Localized: Bryst klædt i mel, klar til sin sprøde debut.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927445
    m_Localized: Bleg og almindelig, venter stadig på sin store fritering.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927446
    m_Localized: Sprød udenpå, saftig indeni – så god, at du klukker.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927447
    m_Localized: En lille nugget i sin melrustning.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927448
    m_Localized: Lille, bidstor og drømmer om frituregryden.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927449
    m_Localized: Lår i melfrakke, buttet og klar.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927450
    m_Localized: Det saftigste stykke, der stadig skjuler sit potentiale.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927451
    m_Localized: Vinger overtrukket med dej, før de når at lære at flyve.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927452
    m_Localized: En vinge, der endnu ikke har noget knas.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927453
    m_Localized: Rødt støv, der bringer varmen – ingen kulde her.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927454
    m_Localized: Grønne stilke med et mildt tilfælde af løgmisundelse.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927455
    m_Localized: Lille grøn konfetti til en sprød fest.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927456
    m_Localized: En tom kop, der tørster efter et formål.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927457
    m_Localized: Mørk sodavand, der bobler af begejstring.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927458
    m_Localized: Cola på is, serveret med en kold skulder.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927459
    m_Localized: Stablet efter bestilling og bedst spist, før bollen giver op.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927460
    m_Localized: Iskolde bobler, der gør hver burgerbid højere.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927461
    m_Localized: Gylden udenpå, saftig indeni og væk på fire bid.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927462
    m_Localized: Varm, salt og umulig at dele retfærdigt.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927463
    m_Localized: En trofast lille gæst, der behandler hver burger som en logrende skat.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927464
    m_Localized: Skrøbelig, og den knækker under pres.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927465
    m_Localized: Spejlæg med solsiden op og æg-stremt glad.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927466
    m_Localized: Frituresteger maden gylden og sprød.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927467
    m_Localized: Dækker ingredienser med et lag dej.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927468
    m_Localized: Vand, der har besluttet sig for at holde hovedet koldt.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927469
    m_Localized: Alt det sprøde samlet i én herlig kyllingefest.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927470
    m_Localized: Sprøde grønne blade – så lad os salat-starte.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927471
    m_Localized: Snittede grøntsager, der endelig har forladt hovedet.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927472
    m_Localized: Et helt salathoved, der har hovedet koldt.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927473
    m_Localized: Lyskæde langs venstre side.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927474
    m_Localized: Restaurantskilt monteret over taglinjen.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927475
    m_Localized: Styrer frokostrushet som et bestyrelsesmøde og kræver premium-pickles.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927476
    m_Localized: Potteplante ved indgangen.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927477
    m_Localized: En beskeden kartoffel med pomfrit-stjernedrømme.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927478
    m_Localized: Skåret i stave – nu en pomfrit i venteposition.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927479
    m_Localized: Gyldne pomfritter, varme nok til at starte en saltdebat.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927480
    m_Localized: Pomfritter begravet i ost – ingen fortrydelse overhovedet.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927481
    m_Localized: Hopper sulten ind og går med krummer på begge kinder.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927482
    m_Localized: Byens hurtigste rødhalede bud – medmindre nogen taber en pomfrit.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927483
    m_Localized: Lilla, skarp og hemmeligt følsom.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927484
    m_Localized: Skårne ringe, der fik kokken til at græde.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927485
    m_Localized: En kæmpe burgerfigur oven på taget.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927486
    m_Localized: Skilt, der hænger på bygningens højre side.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927487
    m_Localized: Skilt, der hænger på bygningens højre side.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927488
    m_Localized: Rund, rød og teknisk set en frugt.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927489
    m_Localized: Saftige skiver, som ikke mangler noget.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927490
    m_Localized: Hængende ranker hen over tagkanten.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927491
    m_Localized: Større hus
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927492
    m_Localized: Honningkrammebjørn
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927493
    m_Localized: Bøf
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927494
    m_Localized: Rå bøf
    m_Metadata:
