  - m_Id: 57789949927546
    m_Localized: Pomfritter
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927547
    m_Localized: Ostefritter
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927548
    m_Localized: Bunbun Bella
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927549
    m_Localized: Rotte-budet Røde
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927550
    m_Localized: Rødløg
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927551
    m_Localized: Snittet rødløg
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927552
    m_Localized: Kæmpeburger
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927553
    m_Localized: Hængeskilt
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927554
    m_Localized: Pæleskilt
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927555
    m_Localized: Tomat
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927556
    m_Localized: Tomatskiver
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927557
    m_Localized: Ranker
    m_Metadata:
      m_Items: []
  - m_Id: 3010520264204288
    m_Localized: Hakker grøntsager hurtigere, end en salat kan rødme.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758720
    m_Localized: Skær, tern, færdig. Løgene havde ingen chance.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758721
    m_Localized: Hælder brusende cola på et blink, bobler og det hele.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758722
    m_Localized: Masser af brus! En fontæne af sodavand og glæde.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758723
    m_Localized: Panerer kylling i mel med topfart. Rodet, men lækkert.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758724
    m_Localized: En snestorm af mel. Hver nugget får et lunt tæppe.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758725
    m_Localized: Gyldne pommes frites i rekordtid. Knas garanteret.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758726
    m_Localized: Ekstra sprødhed er låst op. Pommes fritesene stråler af stolthed.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758727
    m_Localized: Bøfferne syder hurtigere. Maverne knurrer højere.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758728
    m_Localized: Så varm, at burgerne vender sig for den. Bogstaveligt talt.
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758729
    m_Localized: Hurtig hakker
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758730
    m_Localized: Ninja-hakker
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758731
    m_Localized: Brusehurtig maskine
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758732
    m_Localized: Cola-gejser
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758733
    m_Localized: Hurtig panérskål
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758734
    m_Localized: Mel-vanvid-skål
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758735
    m_Localized: Sprød friture
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758736
    m_Localized: Guld-friture
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758737
    m_Localized: Sizzle-grill
    m_Metadata:
      m_Items: []
  - m_Id: 3010520297758738
    m_Localized: Mega-sizzle-grill
    m_Metadata:
      m_Items: []
  - m_Id: 8069138441297920
    m_Localized: Salaten er strimlet, før den overhovedet lander.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138487435264
    m_Localized: Samurai-hakker
    m_Metadata:
      m_Items: []
  - m_Id: 8069138491629568
    m_Localized: Så skarp, at den skærer luften. Tomaterne gør honnør.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138491629569
    m_Localized: Legendarisk knivbræt
    m_Metadata:
      m_Items: []
  - m_Id: 8069138491629570
    m_Localized: Den går i udbrud med bobler. Kopperne fylder sig selv.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138491629571
    m_Localized: Cola-vulkan
    m_Metadata:
      m_Items: []
  - m_Id: 8069138491629572
    m_Localized: Bobler for evigt. Tørsten har ingen chance.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138491629573
    m_Localized: Uendelig boblespringvand
    m_Metadata:
      m_Items: []
  - m_Id: 8069138491629574
    m_Localized: Paner nuggets hurtigere, end du kan sige knas.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138495823872
    m_Localized: Melsnestorm
    m_Metadata:
      m_Items: []
  - m_Id: 8069138495823873
    m_Localized: Hver nugget kommer ud klædt som kongelige.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138495823874
    m_Localized: Gylden pulverskål
    m_Metadata:
      m_Items: []
  - m_Id: 8069138495823875
    m_Localized: Fritterne hopper blege i og springer gyldne ud.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138495823876
    m_Localized: Turbofrituregryde
    m_Metadata:
      m_Items: []
  - m_Id: 8069138495823877
    m_Localized: Sprødt med lysets hastighed.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138495823878
    m_Localized: Legendarisk friturereaktor
    m_Metadata:
      m_Items: []
  - m_Id: 8069138495823879
    m_Localized: Bøfferne steges på et øjeblik. Pas på øjenbrynene.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138495823880
    m_Localized: Vulkangrill
    m_Metadata:
      m_Items: []
  - m_Id: 8069138500018176
    m_Localized: Varm som solen, hurtig som en raket. Burgerlykke.
    m_Metadata:
      m_Items: []
  - m_Id: 8069138500018177
    m_Localized: Legendarisk solgrill
    m_Metadata:
