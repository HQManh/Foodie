  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Map_burger_hu
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: hu
  m_SharedData: {fileID: 11400000, guid: 70ba2199d21f4314980f738ed34bd399, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 57789920567296
    m_Localized: A kezdő burgerstand. Kezdettől a tiéd.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927424
    m_Localized: Teljes burgerház szélesebb homlokzattal és több hellyel a díszeknek.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927425
    m_Localized: Édes, mint a méz, és kétszer olyan bújós, ha jön a sült krumpli.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927426
    m_Localized: Tökéletesre sütve – ez a pogácsa jól teljesített.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927427
    m_Localized: Véres, nyers, és alig várja a sütőlapot.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927428
    m_Localized: Kis menütábla az ajtó mellett.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927429
    m_Localized: Magas reklámtábla az üzlet előtt.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927430
    m_Localized: Rétegezve, felhalmozva és abszolút formában.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927431
    m_Localized: Aranybarnára és ropogósra süti a hozzávalókat.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927432
    m_Localized: Pezsgő kólát tölt.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927433
    m_Localized: Darabokra aprítja a hozzávalókat.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927434
    m_Localized: Pirított zsemle acélos fenékkel.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927435
    m_Localized: Egy zsemle, amely végre megnyílt.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927436
    m_Localized: Puha zsemle, ami még mindig lustálkodik.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927437
    m_Localized: Innen érkeznek a hozzávalók.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927438
    m_Localized: A tető fölé szerelt éttermi cégtábla.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927439
    m_Localized: Túl laza ahhoz, hogy siessen, és mindig tökéletes időzítésű dorombolással rendel.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927440
    m_Localized: Apró mancsok, nagy étvágy, és semmi szégyen az extra sajt miatt.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927441
    m_Localized: Egy tömb tejtermék, reszelni való tehetséggel.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927442
    m_Localized: Szeletelt sajt, készen arra, hogy szíveket olvasszon meg.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927443
    m_Localized: Olvadt arany, amitől minden nagyszerű lesz.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927444
    m_Localized: Lisztbe öltözött mell, ropogós bemutatkozásra készen.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927445
    m_Localized: Sápadt és egyszerű, még várja a nagy sütést.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927446
    m_Localized: Kívül ropogós, belül szaftos, ujjnyalogatóan finom.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927447
    m_Localized: Egy kis nuggets a lisztpáncéljában.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927448
    m_Localized: Kicsi, falatnyi, és az olajsütőről álmodik.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927449
    m_Localized: Lisztkabátos comb, jó vaskos és kész.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927450
    m_Localized: A legszaftosabb darab, ami még rejtegeti a tehetségét.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927451
    m_Localized: Szárnyak bundában, mielőtt repülni tanulnának.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927452
    m_Localized: Egy szárny, amiben még nincs semmi ropogós.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927453
    m_Localized: Vörös por, ami hozza a tüzet, nyugalomnak nyoma sincs.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927454
    m_Localized: Zöld szárak enyhe hagymairigységgel.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927455
    m_Localized: Apró zöld konfetti egy ropogós ünnephez.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927456
    m_Localized: Egy üres pohár, amely célra szomjazik.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927457
    m_Localized: Sötét szénsavas üdítő, ami pezseg az izgalomtól.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927458
    m_Localized: Jeges kóla, jéghideg modorral tálalva.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927459
    m_Localized: Rendelésre rétegezve, és legjobb, mielőtt a zsemle feladja.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927460
    m_Localized: Jéghideg buborékok, amelyektől minden burgerharapás hangosabb.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927461
    m_Localized: Kívül aranyló, belül szaftos, és négy harapás alatt eltűnik.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927462
    m_Localized: Forró, sós, és lehetetlen igazságosan elosztani.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927463
    m_Localized: Hűséges kis vendég, akinek minden burger farokcsóválós kincs.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927464
    m_Localized: Törékeny, nyomás alatt megreped.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927465
    m_Localized: Napos oldalával felfelé, és tojás-tra vidám.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927466
    m_Localized: Aranybarnára és ropogósra süti az ételt.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927467
    m_Localized: Tésztabundával vonja be a hozzávalókat.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927468
    m_Localized: Víz, amely úgy döntött, hűvös marad.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927469
    m_Localized: Minden ropogós finomság egy dicsőséges csirkés dobozban.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927470
    m_Localized: Ropogós zöld levelek – kezdődjön a salátaparti!
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927471
    m_Localized: Aprított zöldek, amelyek végre elhagyták a fejet.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927472
    m_Localized: Egy egész fej saláta, ami megőrzi a hidegvérét.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927473
    m_Localized: Fényfüzér a bal oldal mentén.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927474
    m_Localized: A tető fölé szerelt éttermi cégtábla.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927475
    m_Localized: Úgy vezényli az ebédcsúcsot, mint egy igazgatósági ülést, és prémium savanyúságot követel.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927476
    m_Localized: Cserepes növény a bejárat mellett.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927477
    m_Localized: Szerény krumpli, aki sültkrumpli-sztár akar lenni.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927478
    m_Localized: Hasábokra vágva, most már egy leendő sült krumpli.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927479
    m_Localized: Aranyló sült krumpli, olyan forró, hogy sóvitát robbant ki.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927480
    m_Localized: Sajtba temetett sült krumpli, semmi megbánás.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927481
    m_Localized: Éhesen szökell be, és morzsás pofival távozik.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927482
    m_Localized: A város leggyorsabb vörös farkú futára, hacsak valaki el nem ejt egy krumplit.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927483
    m_Localized: Lila, csípős és titokban érzelmes.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927484
    m_Localized: Szeletelt karikák, amelyek megríkatták a séfet.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927485
    m_Localized: Óriási burgerdísz a tetőn.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927486
    m_Localized: Az épület jobb oldalán lógó tábla.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927487
    m_Localized: Az épület jobb oldalán lógó tábla.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927488
    m_Localized: Kerek, piros, és technikailag gyümölcs.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927489
    m_Localized: Szaftos szeletek, amelyeknek már semmi sem hiányzik.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927490
    m_Localized: A tetőszélről lelógó indák.
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927491
    m_Localized: Nagyobb ház
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927492
    m_Localized: Mézes Ölelőmaci
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927493
    m_Localized: Marhapogácsa
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927494
    m_Localized: Nyers marhapogácsa
    m_Metadata:
      m_Items: []
  - m_Id: 57789949927495
    m_Localized: Kis menütábla
    m_Metadata:
      m_Items: []
