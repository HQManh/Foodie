%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: Map_icecream_zh-CN
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: zh-CN
  m_SharedData: {fileID: 11400000, guid: 8cd4b8b9ce827984c95d13566cdf2baf, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 3886976972357635
    m_Localized: 冰淇淋甜筒
    m_Metadata:
      m_Items: []
  - m_Id: 3886976947191808
    m_Localized: 酥脆的华夫甜筒，顶着一球冰凉的冰淇淋。
    m_Metadata:
      m_Items: []
  - m_Id: 3886976972357636
    m_Localized: 杯装冰淇淋
    m_Metadata:
      m_Items: []
  - m_Id: 3886976968163328
    m_Localized: 一球冰淇淋装进杯里，不怕滴到手上。
    m_Metadata:
      m_Items: []
  - m_Id: 3886976972357637
    m_Localized: 冰沙
    m_Metadata:
      m_Items: []
  - m_Id: 3886976972357632
    m_Localized: 新鲜水果加冰一起打，打到它欢快歌唱。
    m_Metadata:
      m_Items: []
  - m_Id: 3886976972357638
    m_Localized: 奶昔
    m_Metadata:
      m_Items: []
  - m_Id: 3886976972357633
    m_Localized: 冰淇淋加牛奶摇一摇，浓浓一口。
    m_Metadata:
      m_Items: []
  - m_Id: 3886976972357639
    m_Localized: 刨冰
    m_Metadata:
      m_Items: []
  - m_Id: 3886976972357634
    m_Localized: 绵软的刨冰浸满鲜艳的糖浆。
    m_Metadata:
      m_Items: []
  - m_Id: 2508023116324868
    m_Localized: 火烈鸟夫人
    m_Metadata:
      m_Items: []
  - m_Id: 2508023086964736
    m_Localized: 一位光彩照人的明星宠物，身披霓虹羽毛长袍，头戴超大宽檐帽，配一副水钻猫眼墨镜，悠闲地躺着。
    m_Metadata:
      m_Items: []
  - m_Id: 2508023116324869
    m_Localized: 水獭奥利
    m_Metadata:
      m_Items: []
  - m_Id: 2508023116324864
    m_Localized: 一只活泼的宠物，穿着宽大的热带冰淇淋印花衬衫，戴着一顶插着扶桑花的小草帽。
    m_Metadata:
      m_Items: []
  - m_Id: 2508023116324870
    m_Localized: 阳光鹦鹉
    m_Metadata:
      m_Items: []
  - m_Id: 2508023116324865
    m_Localized: 一只可爱的宠物，穿着马卡龙色泳衣，搭配咬了一口的甜甜圈泳圈和格子头巾。
    m_Metadata:
      m_Items: []
  - m_Id: 2508023116324871
    m_Localized: 企鹅皮帕
    m_Metadata:
      m_Items: []
  - m_Id: 2508023116324866
    m_Localized: 一只时髦的宠物，穿着亮色荷叶边上衣，戴着超大黄色墨镜，背着插有纸鸡尾酒伞的迷你藤编背包。
    m_Metadata:
      m_Items: []
  - m_Id: 2508023116324872
    m_Localized: 谢尔顿爵士
    m_Metadata:
      m_Items: []
  - m_Id: 2508023116324867
    m_Localized: 一位富有的VIP宠物，身穿奢华丝绸长袍，头戴金线刺绣船长帽，佩戴着粗大的珠宝首饰。
    m_Metadata:
      m_Items: []
  - m_Id: 4376029102596096
    m_Localized: 快手水果砧板
    m_Metadata:
      m_Items: []
  - m_Id: 4376029127761920
    m_Localized: 水果片转眼就堆成小山。
    m_Metadata:
      m_Items: []
  - m_Id: 4376040288804864
    m_Localized: 忍者水果砧板
    m_Metadata:
      m_Items: []
  - m_Id: 4376040288804865
    m_Localized: 这块砧板一出场，猕猴桃都发抖。
    m_Metadata:
      m_Items: []
  - m_Id: 4376050443214848
    m_Localized: 脆皮蛋筒机
    m_Metadata:
      m_Items: []
  - m_Id: 4376050443214849
    m_Localized: 温热酥脆的蛋筒，出得更快了。
    m_Metadata:
      m_Items: []
  - m_Id: 4376060580847616
    m_Localized: 金牌蛋筒机
    m_Metadata:
      m_Items: []
  - m_Id: 4376060580847617
    m_Localized: 金黄蛋筒一个接一个，个个酥脆。
    m_Metadata:
      m_Items: []
  - m_Id: 4376070466822144
    m_Localized: 快速搅拌机
    m_Metadata:
      m_Items: []
  - m_Id: 4376070466822145
    m_Localized: 转几圈，水果就变得顺滑。
    m_Metadata:
      m_Items: []
  - m_Id: 4376080600260608
    m_Localized: 冰沙旋风
    m_Metadata:
      m_Items: []
  - m_Id: 4376080600260609
    m_Localized: 水果旋风来袭，记得盖好盖子！
    m_Metadata:
      m_Items: []
  - m_Id: 4376090578509824
    m_Localized: 霜冻刨冰机
    m_Metadata:
      m_Items: []
  - m_Id: 4376090578509825
    m_Localized: 冰块更快变成绵软雪花。
    m_Metadata:
      m_Items: []
  - m_Id: 4376100359626752
    m_Localized: 雪花刨冰机
    m_Metadata:
      m_Items: []
  - m_Id: 4376100359626753
    m_Localized: 几秒钟，绵软雪花纷纷落下。
    m_Metadata:
      m_Items: []
  - m_Id: 4376110191075328
    m_Localized: 快速奶昔机
    m_Metadata:
      m_Items: []
  - m_Id: 4376110191075329
    m_Localized: 奶昔更快变得浓稠绵密。
    m_Metadata:
      m_Items: []
  - m_Id: 4376120353873920
    m_Localized: 超级奶昔机
    m_Metadata:
      m_Items: []
  - m_Id: 4376120353873921
    m_Localized: 超强漩涡，奶昔绵密顺滑。
    m_Metadata:
      m_Items: []
  - m_Id: 4376130302763008
    m_Localized: 冰淇淋小摊
    m_Metadata:
      m_Items: []
  - m_Id: 4376130302763009
    m_Localized: 在阳光下供应清凉甜点的小摊。
    m_Metadata:
      m_Items: []
  - m_Id: 4376140046131200
    m_Localized: 热带冰淇淋店
    m_Metadata:
      m_Items: []
  - m_Id: 4376140046131201
    m_Localized: 为缤纷冰凉的甜点腾出更多空间。
    m_Metadata:
      m_Items: []
  - m_Id: 4376150624165888
    m_Localized: 水豚冰淇淋招牌
    m_Metadata:
      m_Items: []
  - m_Id: 4376150624165889
    m_Localized: 快乐的水豚欢迎每一位冰淇淋爱好者。
    m_Metadata:
      m_Items: []
  - m_Id: 4376162473074688
    m_Localized: 冰淇淋菜单
    m_Metadata:
      m_Items: []
  - m_Id: 4376162473074689
    m_Localized: 写满清凉甜点的菜单板。
    m_Metadata:
      m_Items: []
  - m_Id: 4376173952884736
    m_Localized: 条纹遮阳篷
    m_Metadata:
      m_Items: []
  - m_Id: 4376173952884737
    m_Localized: 遮阳篷配上醒目的店铺招牌。
    m_Metadata:
      m_Items: []
  - m_Id: 4376183629144064
    m_Localized: 甜品柜台
    m_Metadata:
      m_Items: []
  - m_Id: 4376183629144065
    m_Localized: 水果、甜品机和杯子都已准备就绪。
    m_Metadata:
      m_Items: []
  - m_Id: 4376192844029952
    m_Localized: 店铺门窗
    m_Metadata:
      m_Items: []
  - m_Id: 4376192844029953
    m_Localized: 明亮窗户之间是一扇亲切迎客的门。
    m_Metadata:
      m_Items: []
  - m_Id: 4376202776141824
    m_Localized: 冲浪展示区
    m_Metadata:
      m_Items: []
  - m_Id: 4376202776141825
    m_Localized: 冲浪板、水果箱和海边指示牌。
    m_Metadata:
      m_Items: []
  - m_Id: 4376212494344192
    m_Localized: 甜筒与泳圈
    m_Metadata:
      m_Items: []
  - m_Id: 4376212494344193
    m_Localized: 巨型甜筒和泳圈带来海滩乐趣。
    m_Metadata:
      m_Items: []
  - m_Id: 4376222468399104
    m_Localized: 冰淇淋冷柜
    m_Metadata:
      m_Items: []
  - m_Id: 4376222468399105
    m_Localized: 缤纷的冷柜让每一球冰淇淋保持冰凉。
    m_Metadata:
      m_Items: []
  - m_Id: 4376233121931264
    m_Localized: 屋顶彩虹
    m_Metadata:
      m_Items: []
  - m_Id: 4376233121931265
    m_Localized: 冰淇淋店上方架起一道亮丽的彩虹。
    m_Metadata:
      m_Items: []
  - m_Id: 4376244396220416
    m_Localized: 巨型冰淇淋
    m_Metadata:
      m_Items: []
  - m_Id: 4376244396220417
    m_Localized: 屋顶的巨型冰淇淋为店铺画上完美句号。
    m_Metadata:
      m_Items: []
  - m_Id: 4376254550630400
    m_Localized: 巨型奶昔
    m_Metadata:
      m_Items: []
  - m_Id: 4376254550630401
    m_Localized: 高高的奶昔装饰着屋顶。
    m_Metadata:
      m_Items: []
  - m_Id: 4741118217412608
    m_Localized: 水果进去，冰爽冰沙风暴出来。
    m_Metadata:
      m_Items: []
  - m_Id: 4741118242578432
    m_Localized: 冰沙气旋
    m_Metadata:
      m_Items: []
  - m_Id: 4741118246772736
    m_Localized: 搅得太快，店里都下起了雪。
    m_Metadata:
      m_Items: []
  - m_Id: 4741118246772737
    m_Localized: 传奇暴雪搅拌机
    m_Metadata:
      m_Items: []
  - m_Id: 4741118246772738
    m_Localized: 酥脆蛋筒一个接一个蹦出来。
    m_Metadata:
      m_Items: []
  - m_Id: 4741118246772739
    m_Localized: 涡轮蛋筒机
    m_Metadata:
      m_Items: []
  - m_Id: 4741118246772740
    m_Localized: 破纪录速度的金黄华夫蛋筒。
    m_Metadata:
      m_Items: []
  - m_Id: 4741118246772741
    m_Localized: 传奇华夫锻炉
    m_Metadata:
      m_Items: []
  - m_Id: 4741118246772742
    m_Localized: 草莓还没眨眼就被切好了。
    m_Metadata:
      m_Items: []
  - m_Id: 4741118246772743
    m_Localized: 武士水果砧板
    m_Metadata:
      m_Items: []
  - m_Id: 4741118246772744
    m_Localized: 一刀下去，一整碗配料。
    m_Metadata:
      m_Items: []
  - m_Id: 4741118246772745
    m_Localized: 传奇水果刀锋
    m_Metadata:
      m_Items: []
  - m_Id: 4741118246772746
    m_Localized: 一眨眼就是蓬松的雪，快拿勺子！
    m_Metadata:
      m_Items: []
  - m_Id: 4741118246772747
    m_Localized: 暴风雪刨冰机
    m_Metadata:
      m_Items: []
  - m_Id: 4741118246772748
    m_Localized: 一口气就堆出一座刨冰山。
    m_Metadata:
      m_Items: []
  - m_Id: 4741118246772749
    m_Localized: 传奇冰川刨冰机
    m_Metadata:
      m_Items: []
  - m_Id: 4741118250967040
    m_Localized: 一转眼就是浓稠顺滑的奶昔。
    m_Metadata:
      m_Items: []
  - m_Id: 4741118250967041
    m_Localized: 奶昔龙卷风
    m_Metadata:
      m_Items: []
  - m_Id: 4741118250967042
    m_Localized: 摇得太快，吸管都跳起舞来。
    m_Metadata:
      m_Items: []
  - m_Id: 4741118250967043
    m_Localized: 传奇奶昔引擎
    m_Metadata:
      m_Items: []
  - m_Id: 4769246990032896
    m_Localized: 奶香浓郁的绿色果实，做冰沙超顺滑。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170240
    m_Localized: 软嫩的牛油果片，随时可以打成冰沙。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170241
    m_Localized: 用新鲜牛油果打成的顺滑冰沙。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170242
    m_Localized: 阳光般的香蕉，天然香甜。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170243
    m_Localized: 甜甜的香蕉片，准备打成冰沙。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170244
    m_Localized: 熟香蕉打成的浓稠香甜冰沙。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170245
    m_Localized: 把水果打成顺滑冰沙。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170246
    m_Localized: 小小的浆果，满满的果香。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170247
    m_Localized: 新鲜蓝莓打成的亮紫色冰沙。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170248
    m_Localized: 放在最顶上的亮红樱桃。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170249
    m_Localized: 淋在刨冰上的香甜红色糖浆。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170250
    m_Localized: 浓郁的巧克力球，可可控最爱。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170251
    m_Localized: 巧克力冰淇淋，准备摇成奶昔。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170252
    m_Localized: 浇在顶上的亮泽巧克力酱。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170253
    m_Localized: 毛茸茸的外壳里藏着香甜椰肉。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170254
    m_Localized: 雪白的椰肉块，满满热带风味。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364544
    m_Localized: 一口就像到了海边的椰子冰沙。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364545
    m_Localized: 香甜面糊，即将变成酥脆蛋筒。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364546
    m_Localized: 把面糊烤成酥脆蛋筒。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364547
    m_Localized: 切水果，做配料和冰沙。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364548
    m_Localized: 按客人喜好装点的甜筒。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364549
    m_Localized: 按客人点单装好的杯装冰淇淋。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364550
    m_Localized: 客人最爱口味的浓稠奶昔。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364551
    m_Localized: 淋上客人所选糖浆的绵软刨冰。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364552
    m_Localized: 现点现做的水果冰沙。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364553
    m_Localized: 紫色冰淇淋球，满是多汁葡萄味。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364554
    m_Localized: 葡萄冰淇淋，准备摇成奶昔。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364555
    m_Localized: 淋在刨冰上的香甜紫色糖浆。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364556
    m_Localized: 浓稠微酸的酸奶，让冰沙更顺滑。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364557
    m_Localized: 带着苹果清爽酸味的绿色糖浆。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364558
    m_Localized: 叮当作响，让一切保持冰爽。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364559
    m_Localized: 把冰块刨成绵软雪花。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364560
    m_Localized: 毛茸茸的果子，藏着亮绿果心。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364561
    m_Localized: 点缀着黑籽的绿色猕猴桃片。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364562
    m_Localized: 带点酸劲的清爽黄色糖浆。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364563
    m_Localized: 满满热带芒果香的金黄冰淇淋。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364564
    m_Localized: 芒果冰淇淋，准备摇成奶昔。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364565
    m_Localized: 微甜的抹茶冰淇淋。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364566
    m_Localized: 抹茶冰淇淋，准备摇成奶昔。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364567
    m_Localized: 冰凉新鲜的牛奶，做出绵密饮品。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364568
    m_Localized: 把冰淇淋和牛奶摇成浓稠奶昔。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364569
    m_Localized: 满满阳光味道的多汁橙子。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364570
    m_Localized: 鲜亮的橙瓣，准备打成冰沙。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364571
    m_Localized: 新鲜橙子打成的清爽冰沙。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364572
    m_Localized: 放在冰淇淋顶上的酥脆饼干。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364573
    m_Localized: 裹着巧克力的酥脆饼干棒。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364574
    m_Localized: 七彩缤纷、Q弹晃动的果冻。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247044558848
    m_Localized: 雪花般绵软的碎冰，等着淋糖浆。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247044558849
    m_Localized: 撒在顶上的彩色糖针，像开派对。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247044558850
    m_Localized: 戴着绿叶小帽的香甜草莓。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247044558851
    m_Localized: 真材实料的粉色草莓冰淇淋。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247044558852
    m_Localized: 草莓冰淇淋，准备摇成奶昔。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247044558853
    m_Localized: 多汁的草莓片，准备打成冰沙。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247044558854
    m_Localized: 新鲜草莓打成的粉色冰沙。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247044558855
    m_Localized: 淋在顶上的香甜粉色酱汁。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247044558856
    m_Localized: 人人都爱的经典奶香冰淇淋。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247044558857
    m_Localized: 香草冰淇淋，准备摇成奶昔。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247044558858
    m_Localized: 用来装冰淇淋的酥脆金黄蛋筒。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247044558859
    m_Localized: 一圈绵软香甜的鲜奶油。
    m_Metadata:
      m_Items: []
  - m_Id: 4769247044558860
    m_Localized: 口感柔软、淡淡甜味的果冻块。
    m_Metadata:
      m_Items: []
