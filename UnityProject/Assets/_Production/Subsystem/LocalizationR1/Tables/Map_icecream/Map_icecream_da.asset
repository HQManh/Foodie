  m_TableData:
  - m_Id: 3886976972357635
    m_Localized: Isvaffel
    m_Metadata:
      m_Items: []
  - m_Id: 3886976947191808
    m_Localized: En sprød vaffel kronet med en kold kugle is.
    m_Metadata:
      m_Items: []
  - m_Id: 3886976972357636
    m_Localized: Isbæger
    m_Metadata:
      m_Items: []
  - m_Id: 3886976968163328
    m_Localized: En kugle i et bæger – ingen dryp på fingrene.
    m_Metadata:
      m_Items: []
  - m_Id: 3886976972357637
    m_Localized: Smoothie
    m_Metadata:
      m_Items: []
  - m_Id: 3886976972357632
    m_Localized: Frisk frugt blendet med is, til den synger.
    m_Metadata:
      m_Items: []
  - m_Id: 3886976972357638
    m_Localized: Milkshake
    m_Metadata:
      m_Items: []
  - m_Id: 3886976972357633
    m_Localized: Is og mælk rystet sammen til en tyk tår.
    m_Metadata:
      m_Items: []
  - m_Id: 3886976972357639
    m_Localized: Knust is
    m_Metadata:
      m_Items: []
  - m_Id: 3886976972357634
    m_Localized: Luftig knust is dyppet i farvestrålende sirup.
    m_Metadata:
      m_Items: []
  - m_Id: 2508023116324868
    m_Localized: Madame Flamingo
    m_Metadata:
      m_Items: []
  - m_Id: 2508023086964736
    m_Localized: Et glamourøst diva-kæledyr, der slapper af i en neonfarvet fjerkåbe, en kæmpe bredskygget hat og cat-eye-solbriller med rhinsten.
    m_Metadata:
      m_Items: []
  - m_Id: 2508023116324869
    m_Localized: Ollie Odder
    m_Metadata:
      m_Items: []
  - m_Id: 2508023116324864
    m_Localized: Et legesygt kæledyr i en alt for stor tropisk skjorte med is-print og en lillebitte stråhat med en hibiscusblomst.
    m_Metadata:
      m_Items: []
  - m_Id: 2508023116324870
    m_Localized: Sunny Papegøje
    m_Metadata:
      m_Items: []
  - m_Id: 2508023116324865
    m_Localized: Et sødt kæledyr i pastelfarvet badetøj med en badering formet som en bidt donut og et ternet tørklæde.
    m_Metadata:
      m_Items: []
  - m_Id: 2508023116324871
    m_Localized: Pippa Pingvin
    m_Metadata:
      m_Items: []
  - m_Id: 2508023116324866
    m_Localized: Et trendy kæledyr i en farvestrålende flæsetop, store gule solbriller og en mini-rygsæk i rattan med en lille cocktailparaply af papir.
    m_Metadata:
      m_Items: []
  - m_Id: 2508023116324872
    m_Localized: Sir Shelldon
    m_Metadata:
      m_Items: []
  - m_Id: 2508023116324867
    m_Localized: Et velhavende VIP-kæledyr i en luksuriøs silkekåbe, en guldbroderet kaptajnshue og store, tunge smykker.
    m_Metadata:
      m_Items: []
  - m_Id: 4376029102596096
    m_Localized: Lynhurtigt frugtbræt
    m_Metadata:
      m_Items: []
  - m_Id: 4376029127761920
    m_Localized: Frugtskiver hober sig op på ingen tid.
    m_Metadata:
      m_Items: []
  - m_Id: 4376040288804864
    m_Localized: Ninja-frugtbræt
    m_Metadata:
      m_Items: []
  - m_Id: 4376040288804865
    m_Localized: Kiwierne skælver, når dette bræt kommer frem.
    m_Metadata:
      m_Items: []
  - m_Id: 4376050443214848
    m_Localized: Sprødt vaffeljern
    m_Metadata:
      m_Items: []
  - m_Id: 4376050443214849
    m_Localized: Varme, sprøde vafler lidt hurtigere.
    m_Metadata:
      m_Items: []
  - m_Id: 4376060580847616
    m_Localized: Gylden vaffelpresse
    m_Metadata:
      m_Items: []
  - m_Id: 4376060580847617
    m_Localized: Gyldne vafler ruller ud, sprøde hver gang.
    m_Metadata:
      m_Items: []
  - m_Id: 4376070466822144
    m_Localized: Lynblender
    m_Metadata:
      m_Items: []
  - m_Id: 4376070466822145
    m_Localized: Frugten bliver blød på et par hurtige omgange.
    m_Metadata:
      m_Items: []
