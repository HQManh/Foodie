    m_Metadata:
      m_Items: []
  - m_Id: 4376202776141824
    m_Localized: Surfhjørne
    m_Metadata:
      m_Items: []
  - m_Id: 4376202776141825
    m_Localized: Et surfbræt, frugtkasser og et strandskilt.
    m_Metadata:
      m_Items: []
  - m_Id: 4376212494344192
    m_Localized: Isvaffel og Badering
    m_Metadata:
      m_Items: []
  - m_Id: 4376212494344193
    m_Localized: En kæmpe isvaffel og en badering skaber strandstemning.
    m_Metadata:
      m_Items: []
  - m_Id: 4376222468399104
    m_Localized: Isfryser
    m_Metadata:
      m_Items: []
  - m_Id: 4376222468399105
    m_Localized: En farverig fryser holder isen kold.
    m_Metadata:
      m_Items: []
  - m_Id: 4376233121931264
    m_Localized: Regnbue på Taget
    m_Metadata:
      m_Items: []
  - m_Id: 4376233121931265
    m_Localized: En klar regnbue over isbutikken.
    m_Metadata:
      m_Items: []
  - m_Id: 4376244396220416
    m_Localized: Kæmpeis
    m_Metadata:
      m_Items: []
  - m_Id: 4376244396220417
    m_Localized: En kæmpeis på taget som prikken over i'et.
    m_Metadata:
      m_Items: []
  - m_Id: 4376254550630400
    m_Localized: Kæmpemilkshake
    m_Metadata:
      m_Items: []
  - m_Id: 4376254550630401
    m_Localized: En tårnhøj milkshake pynter taget.
    m_Metadata:
      m_Items: []
  - m_Id: 4741118217412608
    m_Localized: Frugt ind, iskold smoothie-storm ud.
    m_Metadata:
      m_Items: []
  - m_Id: 4741118242578432
    m_Localized: Smoothie-cyklon
    m_Metadata:
      m_Items: []
  - m_Id: 4741118246772736
    m_Localized: Blender så hurtigt, at det sner i butikken.
    m_Metadata:
      m_Items: []
  - m_Id: 4741118246772737
    m_Localized: Legendarisk snestormsblender
    m_Metadata:
      m_Items: []
  - m_Id: 4741118246772738
    m_Localized: Sprøde vafler popper ud den ene efter den anden.
    m_Metadata:
      m_Items: []
  - m_Id: 4741118246772739
    m_Localized: Turbo-vaffelmaskine
    m_Metadata:
      m_Items: []
  - m_Id: 4741118246772740
    m_Localized: Gyldne vaffelkegler i rekordfart.
    m_Metadata:
      m_Items: []
  - m_Id: 4741118246772741
    m_Localized: Legendarisk vaffelsmedje
    m_Metadata:
      m_Items: []
  - m_Id: 4741118246772742
    m_Localized: Jordbærrene er skåret, før de kan blinke.
    m_Metadata:
      m_Items: []
  - m_Id: 4741118246772743
    m_Localized: Samurai-frugtbræt
    m_Metadata:
      m_Items: []
  - m_Id: 4741118246772744
    m_Localized: Ét sving, en hel skål toppings.
    m_Metadata:
      m_Items: []
  - m_Id: 4741118246772745
    m_Localized: Legendarisk frugtkniv
    m_Metadata:
      m_Items: []
  - m_Id: 4741118246772746
    m_Localized: Luftig sne på et øjeblik. Find en ske!
    m_Metadata:
      m_Items: []
  - m_Id: 4741118246772747
    m_Localized: Snestormshøvl
    m_Metadata:
      m_Items: []
  - m_Id: 4741118246772748
    m_Localized: Et bjerg af knust is på et enkelt åndedrag.
    m_Metadata:
      m_Items: []
  - m_Id: 4741118246772749
    m_Localized: Legendarisk gletsjerhøvl
    m_Metadata:
      m_Items: []
  - m_Id: 4741118250967040
    m_Localized: Tykke, cremede shakes i en hvirvel.
    m_Metadata:
      m_Items: []
  - m_Id: 4741118250967041
    m_Localized: Milkshake-tornado
    m_Metadata:
      m_Items: []
  - m_Id: 4741118250967042
    m_Localized: Ryster så hurtigt, at sugerørene begynder at danse.
    m_Metadata:
      m_Items: []
  - m_Id: 4741118250967043
    m_Localized: Legendarisk shake-motor
    m_Metadata:
      m_Items: []
  - m_Id: 4769246990032896
    m_Localized: Cremet grøn frugt til en silkeblød smoothie.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170240
    m_Localized: Bløde grønne skiver klar til blenderen.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170241
    m_Localized: En blød, cremet blanding af frisk avocado.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170242
    m_Localized: En solgul banan fuld af naturlig sødme.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170243
    m_Localized: Søde bananskiver klar til at blive blendet.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170244
    m_Localized: En tyk, sød blanding af moden banan.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170245
    m_Localized: Blender frugt til bløde smoothies.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170246
    m_Localized: Små bær fulde af smag.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170247
    m_Localized: En lilla blanding af friske blåbær.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170248
    m_Localized: Et skinnende rødt kirsebær på toppen.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170249
    m_Localized: Sød rød sirup til knust is.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170250
    m_Localized: Fyldige chokoladekugler til kakaoelskere.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170251
    m_Localized: Chokoladeis klar til at blive rystet.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170252
    m_Localized: Blank chokoladesauce til at dryppe over.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170253
    m_Localized: En håret skal med sødt tropisk frugtkød.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170254
    m_Localized: Snehvide kokosstykker med tropisk smag.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364544
    m_Localized: En cremet blanding, der smager af strand.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364545
    m_Localized: Sød dej, der snart bliver en sprød vaffel.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364546
    m_Localized: Bager dej til sprøde vafler.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364547
    m_Localized: Skærer frugt til toppings og smoothies.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364548
    m_Localized: En isvaffel lige som gæsten vil have den.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364549
    m_Localized: Et bæger med kugler efter ønske.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364550
    m_Localized: En tyk shake med gæstens yndlingssmag.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364551
    m_Localized: Luftig is med gæstens valg af sirup.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364552
    m_Localized: En frugtig blanding lavet på bestilling.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364553
    m_Localized: Lilla kugler med saftig druesmag.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364554
    m_Localized: Drueis klar til at blive rystet.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364555
    m_Localized: Sød lilla sirup til knust is.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364556
    m_Localized: Tyk, syrlig yoghurt til en blødere smoothie.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364557
    m_Localized: Syrlig grøn sirup med æblesmag.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364558
    m_Localized: Klirrende terninger, der holder alt iskoldt.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364559
    m_Localized: Gør isterninger til luftig sne.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364560
    m_Localized: En lodden frugt med et lysegrønt indre.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364561
    m_Localized: Grønne kiwiskiver med små frø.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364562
    m_Localized: Frisk gul sirup med et syrligt spark.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364563
    m_Localized: Gyldne kugler fulde af tropisk mango.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364564
    m_Localized: Mangois klar til at blive rystet.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364565
    m_Localized: Grøn te-kugler med en mild sødme.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364566
    m_Localized: Matchais klar til at blive rystet.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364567
    m_Localized: Frisk kold mælk til cremede drikke.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364568
    m_Localized: Ryster is og mælk, til det er tykt.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364569
    m_Localized: En saftig appelsin fuld af solskin.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364570
    m_Localized: Friske appelsinbåde klar til at blende.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364571
    m_Localized: En frisk blanding af appelsin.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364572
    m_Localized: En sprød kiks på toppen af kuglen.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364573
    m_Localized: En sprød kiksestang dyppet i chokolade.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364574
    m_Localized: Vrikkende gelé i alle regnbuens farver.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247044558848
    m_Localized: Luftig, snebløde is klar til sirup.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247044558849
    m_Localized: Farverigt krymmel til fest på toppen.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247044558850
    m_Localized: Et sødt rødt bær med en grøn hat.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247044558851
    m_Localized: Lyserøde kugler med ægte bærsmag.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247044558852
    m_Localized: Jordbæris klar til at blive rystet.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247044558853
    m_Localized: Saftige røde skiver klar til at blende.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247044558854
    m_Localized: En lyserød blanding af friske jordbær.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247044558855
    m_Localized: Sød lyserød sauce til at dryppe over.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247044558856
    m_Localized: Klassiske cremede kugler, alle elsker.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247044558857
    m_Localized: Vaniljeis klar til at blive rystet.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247044558858
    m_Localized: En sprød gylden vaffel til kuglerne.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247044558859
    m_Localized: En luftig top af sød flødeskum.
    m_Metadata:
