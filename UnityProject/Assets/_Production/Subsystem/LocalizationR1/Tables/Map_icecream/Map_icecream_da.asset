    m_Metadata:
      m_Items: []
  - m_Id: 4376090578509825
    m_Localized: Isen bliver hurtigere til bløde flager.
    m_Metadata:
      m_Items: []
  - m_Id: 4376100359626752
    m_Localized: Snefnug-ishøvl
    m_Metadata:
      m_Items: []
  - m_Id: 4376100359626753
    m_Localized: Bløde snefnug falder på få sekunder.
    m_Metadata:
      m_Items: []
  - m_Id: 4376110191075328
