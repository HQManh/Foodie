    m_Metadata:
      m_Items: []
  - m_Id: 4376173952884736
    m_Localized: Stribet Markise
    m_Metadata:
      m_Items: []
  - m_Id: 4376173952884737
    m_Localized: En skyggefuld markise med et flot butiksskilt.
    m_Metadata:
      m_Items: []
  - m_Id: 4376183629144064
    m_Localized: Dessertdisk
    m_Metadata:
      m_Items: []
  - m_Id: 4376183629144065
    m_Localized: Frugt, en dessertmaskine og bægre klar til servering.
    m_Metadata:
      m_Items: []
