%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: Map_icecream_hu
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: hu
  m_SharedData: {fileID: 11400000, guid: 8cd4b8b9ce827984c95d13566cdf2baf, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 3886976972357635
    m_Localized: Tölcséres fagyi
    m_Metadata:
      m_Items: []
  - m_Id: 3886976947191808
    m_Localized: Ropogós ostyatölcsér egy hideg gombóccal a tetején.
    m_Metadata:
      m_Items: []
  - m_Id: 3886976972357636
    m_Localized: Kelyhes fagyi
    m_Metadata:
      m_Items: []
  - m_Id: 3886976968163328
    m_Localized: Egy gombóc pohárban, nem csöpög az ujjadra.
    m_Metadata:
      m_Items: []
  - m_Id: 3886976972357637
    m_Localized: Turmix
    m_Metadata:
      m_Items: []
  - m_Id: 3886976972357632
    m_Localized: Friss gyümölcs jéggel turmixolva, amíg dalra nem fakad.
    m_Metadata:
      m_Items: []
  - m_Id: 3886976972357638
    m_Localized: Milkshake
    m_Metadata:
      m_Items: []
  - m_Id: 3886976972357633
    m_Localized: Fagyi és tej összerázva egy sűrű kortyba.
    m_Metadata:
      m_Items: []
  - m_Id: 3886976972357639
    m_Localized: Jégkása
    m_Metadata:
      m_Items: []
  - m_Id: 3886976972357634
    m_Localized: Pihe-puha jégkása élénk sziruppal leöntve.
    m_Metadata:
      m_Items: []
  - m_Id: 2508023116324868
    m_Localized: Flamingó Madame
    m_Metadata:
      m_Items: []
  - m_Id: 2508023086964736
    m_Localized: Elbűvölő díva kedvenc, aki neon tollköntösben, óriási széles karimájú kalapban és strasszos macskaszem-napszemüvegben heverészik.
    m_Metadata:
      m_Items: []
  - m_Id: 2508023116324869
    m_Localized: Vidra Ollie
    m_Metadata:
      m_Items: []
  - m_Id: 2508023116324864
    m_Localized: Játékos kedvenc túlméretezett, fagyimintás trópusi ingben és apró szalmakalapban, rajta egy hibiszkuszvirággal.
    m_Metadata:
      m_Items: []
  - m_Id: 2508023116324870
    m_Localized: Papagáj Sunny
    m_Metadata:
      m_Items: []
  - m_Id: 2508023116324865
    m_Localized: Édes kedvenc pasztell fürdőruhában, megharapott fánk alakú úszógumival és kockás kendővel.
    m_Metadata:
      m_Items: []
  - m_Id: 2508023116324871
    m_Localized: Pingvin Pippa
    m_Metadata:
      m_Items: []
  - m_Id: 2508023116324866
    m_Localized: Trendi kedvenc élénk fodros felsőben, óriási sárga napszemüvegben, egy mini rattan hátizsákkal, amiben papír koktélesernyő díszlik.
    m_Metadata:
      m_Items: []
  - m_Id: 2508023116324872
    m_Localized: Sir Shelldon
    m_Metadata:
      m_Items: []
  - m_Id: 2508023116324867
    m_Localized: Gazdag VIP kedvenc fényűző selyemköntösben, aranyhímzéses kapitánysapkában és vaskos ékszerekkel.
    m_Metadata:
      m_Items: []
  - m_Id: 4376029102596096
    m_Localized: Fürge gyümölcsdeszka
    m_Metadata:
      m_Items: []
  - m_Id: 4376029127761920
    m_Localized: A gyümölcsszeletek pillanatok alatt halmozódnak.
    m_Metadata:
      m_Items: []
  - m_Id: 4376040288804864
    m_Localized: Nindzsa gyümölcsdeszka
    m_Metadata:
      m_Items: []
  - m_Id: 4376040288804865
    m_Localized: A kivik reszketnek, ha előkerül ez a deszka.
    m_Metadata:
      m_Items: []
  - m_Id: 4376050443214848
    m_Localized: Ropogós tölcsérsütő
    m_Metadata:
      m_Items: []
  - m_Id: 4376050443214849
    m_Localized: Meleg, ropogós tölcsérek egy kicsit gyorsabban.
    m_Metadata:
      m_Items: []
  - m_Id: 4376060580847616
    m_Localized: Arany tölcsérprés
    m_Metadata:
      m_Items: []
  - m_Id: 4376060580847617
    m_Localized: Aranyló tölcsérek, mindig ropogósan.
    m_Metadata:
      m_Items: []
  - m_Id: 4376070466822144
    m_Localized: Fürge turmixgép
    m_Metadata:
      m_Items: []
  - m_Id: 4376070466822145
    m_Localized: Pár gyors pörgés, és a gyümölcs krémes.
    m_Metadata:
      m_Items: []
  - m_Id: 4376080600260608
    m_Localized: Smoothie-forgószél
    m_Metadata:
      m_Items: []
  - m_Id: 4376080600260609
    m_Localized: Gyümölcsös forgószél. Fedőt rá!
    m_Metadata:
      m_Items: []
  - m_Id: 4376090578509824
    m_Localized: Fagyos jégreszelő
    m_Metadata:
      m_Items: []
  - m_Id: 4376090578509825
    m_Localized: A jég gyorsabban lesz puha pehely.
    m_Metadata:
      m_Items: []
  - m_Id: 4376100359626752
    m_Localized: Hópehely-reszelő
    m_Metadata:
      m_Items: []
  - m_Id: 4376100359626753
    m_Localized: Puha hópelyhek hullanak pillanatok alatt.
    m_Metadata:
      m_Items: []
  - m_Id: 4376110191075328
    m_Localized: Fürge turmixkészítő
    m_Metadata:
      m_Items: []
  - m_Id: 4376110191075329
    m_Localized: A turmix gyorsabban lesz sűrű és krémes.
    m_Metadata:
      m_Items: []
  - m_Id: 4376120353873920
    m_Localized: Szuper turmixkészítő
    m_Metadata:
      m_Items: []
  - m_Id: 4376120353873921
    m_Localized: Krémes turmix szuper örvénnyel.
    m_Metadata:
      m_Items: []
  - m_Id: 4376130302763008
    m_Localized: Fagylaltkioszk
    m_Metadata:
      m_Items: []
  - m_Id: 4376130302763009
    m_Localized: Egy kis kioszk hűs finomságokkal a napsütésben.
    m_Metadata:
      m_Items: []
  - m_Id: 4376140046131200
    m_Localized: Trópusi Fagyizó
    m_Metadata:
      m_Items: []
  - m_Id: 4376140046131201
    m_Localized: Több hely a színes, fagyos finomságoknak.
    m_Metadata:
      m_Items: []
  - m_Id: 4376150624165888
    m_Localized: Capy Cégtábla
    m_Metadata:
      m_Items: []
  - m_Id: 4376150624165889
    m_Localized: Egy vidám kapibara köszönti a fagylaltkedvelőket.
    m_Metadata:
      m_Items: []
  - m_Id: 4376162473074688
    m_Localized: Fagylaltétlap
    m_Metadata:
      m_Items: []
  - m_Id: 4376162473074689
    m_Localized: Egy tábla tele hűs finomságokkal.
    m_Metadata:
      m_Items: []
  - m_Id: 4376173952884736
    m_Localized: Csíkos Napellenző
    m_Metadata:
      m_Items: []
  - m_Id: 4376173952884737
    m_Localized: Árnyékos napellenző élénk cégtáblával.
    m_Metadata:
      m_Items: []
  - m_Id: 4376183629144064
    m_Localized: Desszertpult
    m_Metadata:
      m_Items: []
  - m_Id: 4376183629144065
    m_Localized: Gyümölcsök, desszertgép és tálalásra kész poharak.
    m_Metadata:
      m_Items: []
  - m_Id: 4376192844029952
    m_Localized: Kirakat
    m_Metadata:
      m_Items: []
  - m_Id: 4376192844029953
    m_Localized: Hívogató ajtó világos ablakok között.
    m_Metadata:
      m_Items: []
  - m_Id: 4376202776141824
    m_Localized: Szörfös Sarok
    m_Metadata:
      m_Items: []
  - m_Id: 4376202776141825
    m_Localized: Szörfdeszka, gyümölcsös ládák és strandtábla.
    m_Metadata:
      m_Items: []
  - m_Id: 4376212494344192
    m_Localized: Tölcsér és Úszógumi
    m_Metadata:
      m_Items: []
  - m_Id: 4376212494344193
    m_Localized: Óriástölcsér és úszógumi idézi a strand örömét.
    m_Metadata:
      m_Items: []
  - m_Id: 4376222468399104
    m_Localized: Fagylaltfagyasztó
    m_Metadata:
      m_Items: []
  - m_Id: 4376222468399105
    m_Localized: Színes fagyasztó tartja hidegen a gombócokat.
    m_Metadata:
      m_Items: []
  - m_Id: 4376233121931264
    m_Localized: Tetőszivárvány
    m_Metadata:
      m_Items: []
  - m_Id: 4376233121931265
    m_Localized: Ragyogó szivárvány a fagyizó felett.
    m_Metadata:
      m_Items: []
  - m_Id: 4376244396220416
    m_Localized: Óriásfagylalt
    m_Metadata:
      m_Items: []
  - m_Id: 4376244396220417
    m_Localized: Óriási fagylalt a tetőn a nagy fináléhoz.
    m_Metadata:
      m_Items: []
  - m_Id: 4376254550630400
    m_Localized: Óriásturmix
    m_Metadata:
      m_Items: []
  - m_Id: 4376254550630401
    m_Localized: Égbe nyúló turmix díszíti a tetőt.
    m_Metadata:
      m_Items: []
  - m_Id: 4741118217412608
    m_Localized: Gyümölcs be, jeges turmixvihar ki.
    m_Metadata:
      m_Items: []
  - m_Id: 4741118242578432
    m_Localized: Turmixciklon
    m_Metadata:
      m_Items: []
  - m_Id: 4741118246772736
    m_Localized: Olyan gyorsan turmixol, hogy havazik a boltban.
    m_Metadata:
      m_Items: []
  - m_Id: 4741118246772737
    m_Localized: Legendás hóvihar turmixgép
    m_Metadata:
      m_Items: []
  - m_Id: 4741118246772738
    m_Localized: Ropogós tölcsérek pattannak ki egymás után.
    m_Metadata:
      m_Items: []
  - m_Id: 4741118246772739
    m_Localized: Turbó tölcsérsütő
    m_Metadata:
      m_Items: []
  - m_Id: 4741118246772740
    m_Localized: Aranyszínű gofritölcsérek rekordsebességgel.
    m_Metadata:
      m_Items: []
  - m_Id: 4741118246772741
    m_Localized: Legendás gofrikovácsműhely
    m_Metadata:
      m_Items: []
  - m_Id: 4741118246772742
    m_Localized: Az eprek fel vannak szeletelve, mielőtt pislognának.
    m_Metadata:
      m_Items: []
  - m_Id: 4741118246772743
    m_Localized: Szamuráj gyümölcsdeszka
    m_Metadata:
      m_Items: []
  - m_Id: 4741118246772744
    m_Localized: Egy suhintás, egy egész tál feltét.
    m_Metadata:
      m_Items: []
  - m_Id: 4741118246772745
    m_Localized: Legendás gyümölcspenge
    m_Metadata:
      m_Items: []
  - m_Id: 4741118246772746
    m_Localized: Puha hó egy szempillantás alatt. Fogj egy kanalat!
    m_Metadata:
      m_Items: []
  - m_Id: 4741118246772747
    m_Localized: Hóvihar jéggyalu
    m_Metadata:
      m_Items: []
  - m_Id: 4741118246772748
    m_Localized: Egy hegynyi jégkása egyetlen lélegzet alatt.
    m_Metadata:
      m_Items: []
  - m_Id: 4741118246772749
    m_Localized: Legendás gleccser jéggyalu
    m_Metadata:
      m_Items: []
  - m_Id: 4741118250967040
    m_Localized: Sűrű, krémes turmixok egy pörgéssel.
    m_Metadata:
      m_Items: []
  - m_Id: 4741118250967041
    m_Localized: Turmix-tornádó
    m_Metadata:
      m_Items: []
  - m_Id: 4741118250967042
    m_Localized: Olyan gyorsan ráz, hogy a szívószálak táncra perdülnek.
    m_Metadata:
      m_Items: []
  - m_Id: 4741118250967043
    m_Localized: Legendás turmixmotor
    m_Metadata:
      m_Items: []
  - m_Id: 4769246990032896
    m_Localized: Krémes zöld gyümölcs a selymes smoothie-hoz.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170240
    m_Localized: Puha zöld szeletek a turmixgépbe.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170241
    m_Localized: Friss avokádóból kevert krémes ital.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170242
    m_Localized: Napsárga banán, tele természetes édességgel.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170243
    m_Localized: Édes banánkarikák turmixoláshoz.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170244
    m_Localized: Érett banánból kevert sűrű, édes ital.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170245
    m_Localized: Gyümölcsből krémes smoothie-t kever.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170246
    m_Localized: Apró bogyók, tele ízzel.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170247
    m_Localized: Friss áfonyából kevert lila ital.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170248
    m_Localized: Fényes piros cseresznye a tetejére.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170249
    m_Localized: Édes piros szirup a jégkásához.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170250
    m_Localized: Gazdag csokigombócok kakaórajongóknak.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170251
    m_Localized: Csokoládéfagylalt, turmixolásra készen.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170252
    m_Localized: Fényes csokiöntet a tetejére.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170253
    m_Localized: Szőrös héj, édes trópusi belsővel.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247036170254
    m_Localized: Hófehér kókuszdarabok trópusi ízzel.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364544
    m_Localized: Krémes ital, olyan, mint egy nap a strandon.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364545
    m_Localized: Édes tészta, ami ropogós tölcsér lesz.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364546
    m_Localized: Ropogós tölcsért süt a tésztából.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364547
    m_Localized: Gyümölcsöt szel feltétnek és smoothie-nak.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364548
    m_Localized: Fagyitölcsér a vendég ízlése szerint.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364549
    m_Localized: Pohár fagyi a vendég kérése szerint.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364550
    m_Localized: Sűrű turmix a vendég kedvenc ízével.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364551
    m_Localized: Pihe-puha jég a választott sziruppal.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364552
    m_Localized: Rendelésre kevert gyümölcsös ital.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364553
    m_Localized: Lila gombócok lédús szőlőízzel.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364554
    m_Localized: Szőlőfagylalt, turmixolásra készen.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364555
    m_Localized: Édes lila szirup a jégkásához.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364556
    m_Localized: Sűrű, savanykás joghurt a krémesebb italhoz.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364557
    m_Localized: Savanykás zöld szirup almaízzel.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364558
    m_Localized: Csilingelő kockák, hogy minden jéghideg legyen.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364559
    m_Localized: A jégkockából pihe-puha havat varázsol.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364560
    m_Localized: Szőrös gyümölcs élénkzöld belsővel.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364561
    m_Localized: Zöld kivikarikák apró magokkal.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364562
    m_Localized: Üde sárga szirup savanykás ízzel.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364563
    m_Localized: Aranyló gombócok trópusi mangóval.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364564
    m_Localized: Mangófagylalt, turmixolásra készen.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364565
    m_Localized: Zöld teás gombócok enyhe édességgel.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364566
    m_Localized: Matchafagylalt, turmixolásra készen.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364567
    m_Localized: Friss, hideg tej a krémes italokhoz.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364568
    m_Localized: Fagyit és tejet kever sűrűre.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364569
    m_Localized: Lédús narancs, tele napfénnyel.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364570
    m_Localized: Élénk narancsgerezdek turmixoláshoz.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364571
    m_Localized: Friss narancsból kevert üdítő ital.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364572
    m_Localized: Ropogós keksz a gombóc tetejére.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364573
    m_Localized: Csokiba mártott ropogós pálcika.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247040364574
    m_Localized: Remegő zselé a szivárvány minden színében.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247044558848
    m_Localized: Hópuha jég, várja a szirupot.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247044558849
    m_Localized: Színes szórás, hogy buli legyen a tetején.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247044558850
    m_Localized: Édes piros bogyó levélkalappal.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247044558851
    m_Localized: Rózsaszín gombócok igazi eperízzel.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247044558852
    m_Localized: Eperfagylalt, turmixolásra készen.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247044558853
    m_Localized: Lédús piros szeletek turmixoláshoz.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247044558854
    m_Localized: Friss eperből kevert rózsaszín ital.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247044558855
    m_Localized: Édes rózsaszín öntet a tetejére.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247044558856
    m_Localized: Klasszikus krémes gombócok, amiket mindenki szeret.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247044558857
    m_Localized: Vaníliafagylalt, turmixolásra készen.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247044558858
    m_Localized: Ropogós, aranyló tölcsér a gombócoknak.
    m_Metadata:
      m_Items: []
  - m_Id: 4769247044558859
    m_Localized: Egy pihe-puha adag édes tejszínhab.
    m_Metadata:
