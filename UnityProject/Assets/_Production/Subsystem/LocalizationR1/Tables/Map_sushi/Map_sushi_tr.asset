--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Map_sushi_tr
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: tr
  m_SharedData: {fileID: 11400000, guid: 6661c9f2ba46546428a729e8cde76aa0, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 57786321854464
    m_Localized: Rengârenk balonlar her suşi servisini bayram havasına sokar.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214592
    m_Localized: Orijinal suşi restoranı.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214593
    m_Localized: Daha fazla suşi yükseltmesine hazır, daha büyük bir restoran.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214594
    m_Localized: Düzgünce budanmış, sakin bir yeşillik katan bonsai.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214595
    m_Localized: Dükkân önü için sevimli bir kapibara tabelası.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214596
    m_Localized: Müşterileri içeri el sallayarak çağıran misafirperver bir kedi.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214597
    m_Localized: Restoranın en iyi yemeklerini sergileyen dolu bir tezgâh.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214598
    m_Localized: Çatıda, suşi ve rulolarla dolu bir kesme tahtası.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214599
    m_Localized: Rengârenk bayraklar ve tenteler restoranın cephesini süsler.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214600
    m_Localized: Suşiyi tiyatral bir zarafetle sipariş eden zarif bir kitsune misafir.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214601
    m_Localized: Bu mavi keçi matchayı sever ve neşeli sofra adabı pratiği yapar.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214602
    m_Localized: Menüyü özenle inceler ama yine de öğle yemeğini okaliptüsle takas eder.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214603
    m_Localized: Her suşi ruloyu düelloya davet eden cesur küçük bir shishi.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214604
    m_Localized: Restorana bir kat daha kazandıran geleneksel bir çatı.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214605
    m_Localized: Her suşi tabağını şampiyonluk maçı gibi gören bir shiba yokozuna.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214606
    m_Localized: Suşi misafirleri için rahat tabureler.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214607
    m_Localized: Kurt oyabun yumuşak konuşur ve suşi tezgâhını tek bakışla yönetir.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214608
    m_Localized: Festival Balonları
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214609
    m_Localized: Suşi Genişlemesi
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214610
    m_Localized: Bonsai Bahçesi
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214611
    m_Localized: Kapibara Tabelası
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214612
    m_Localized: Şans Kedisi
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214613
    m_Localized: Vitrin Tezgâhı
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214614
    m_Localized: Suşi Kesme Tahtası
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214615
    m_Localized: Suşi Bayrakları
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214616
    m_Localized: Kitsune Ojou
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214617
    m_Localized: Aoi Yagi
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214618
    m_Localized: Koala Senpai
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214619
    m_Localized: Shishi-kun
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214620
    m_Localized: İkinci Kat Çatısı
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214621
    m_Localized: Shiba Yokozuna
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214622
    m_Localized: Suşi Tabureleri
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214623
    m_Localized: Ookami Oyabun
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214624
    m_Localized: Nigiri Suşi
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214625
    m_Localized: Elle şekillendirilmiş pirinç, üstünde minik bir battaniye gibi bir dilim balık.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214626
    m_Localized: Maki Rulo
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214627
    m_Localized: Yosuna sıkıca sarılıp kimse içine göz atamadan dilimlenir.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214628
    m_Localized: Gunkan Suşi
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214629
    m_Localized: Ağzına kadar malzemeyle dolu küçük bir yosun teknesi.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214630
    m_Localized: Saşimi Tabağı
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214631
    m_Localized: İnce dilimlenmiş taze balık, saklanacak hiçbir yeri yok.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214632
    m_Localized: Yeşil Çay
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214633
    m_Localized: Sıcak ve sakin, wasabinin acısını gidermek için.
    m_Metadata:
      m_Items: []
  - m_Id: 2945767655333888
    m_Localized: Müşterileri içeri el sallayarak çağıran misafirperver bir kedi.
    m_Metadata:
      m_Items: []
  - m_Id: 2945767667916800
    m_Localized: Suşi misafirleri için rahat tabureler.
    m_Metadata:
      m_Items: []
  - m_Id: 2945767667916801
    m_Localized: Restoranı aydınlatan parıltılı kâğıt fenerler.
    m_Metadata:
      m_Items: []
  - m_Id: 2945767667916802
    m_Localized: Dükkân önü için sevimli bir kapibara tabelası.
    m_Metadata:
      m_Items: []
  - m_Id: 2945767667916803
    m_Localized: Dükkân önü için sevimli bir kapibara tabelası.
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111104
    m_Localized: Çatıda oturan dev bir ton balığı, günün taze avını gururla sergiliyor.
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111105
    m_Localized: Çatıda, suşi ve rulolarla dolu bir kesme tahtası.
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111106
    m_Localized: Şans Kedisi
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111107
    m_Localized: Suşi Tabureleri
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111108
    m_Localized: Kâğıt Fenerler
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111109
    m_Localized: Kapibara Tabelası
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111110
    m_Localized: Kapibara Tabelası
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111111
    m_Localized: Dev Ton Balığı
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111112
    m_Localized: Suşi Kesme Tahtası
    m_Metadata:
      m_Items: []
  - m_Id: 3010516803903488
    m_Localized: Sebzeler göz açıp kapayıncaya kadar doğranır.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069312
    m_Localized: Bıçaklar o kadar hızlı ki salatalıklar daha baştan pes eder.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069313
    m_Localized: Çiğ balığı ekstra sashimi yumuşaklığında dilimler.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069314
    m_Localized: Her kesim bir sanat eseri. Balıklar kendini onurlu hissediyor.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069315
    m_Localized: Kabarık pilav göz açıp kapayıncaya kadar hazır. Taneler pişmek için sıraya giriyor.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069316
    m_Localized: O kadar mükemmel pilav ki ayakta alkışı hak ediyor.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069318
    m_Localized: Wasabiyi şimşek hızıyla rendeler. Gözyaşları isteğe bağlı.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069319
    m_Localized: O kadar hızlı rendeler ki wasabi ne olduğunu anlamaz.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069322
    m_Localized: “Umami” demenizden önce lezzeti kaynatır.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069323
    m_Localized: Warp hızında pişiren köpüren bir efsane.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263617
    m_Localized: Sıcak çay hemen hazır. Müşteriler sakin kalıp yudumlar.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263618
    m_Localized: Mükemmel çayı ve iç huzuru tek seferde döker.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263619
    m_Localized: Çevik Kesme Tahtası
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263620
    m_Localized: Ninja Kesme Tahtası
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263621
    m_Localized: Keskin Balık Tahtası
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263622
    m_Localized: Sashimi Ustası Tahtası
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263623
    m_Localized: Turbo Pilav Makinesi
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263624
    m_Localized: Mega Pilav Makinesi
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263626
    m_Localized: Çevik Rende
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263627
    m_Localized: Wasabi Kasırgası
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263630
    m_Localized: Hızlı Kaynatma Tenceresi
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263631
    m_Localized: Umami Kazanı
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263633
    m_Localized: Hızlı Demleme Çaydanlığı
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263634
    m_Localized: Zen Ustası Çaydanlığı
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069317
    m_Localized: Her aç gözün dikkatini çeken parlak mavi bir suşi bayrağı.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069320
    m_Localized: Girişin üzerinde usulca sallanan serin mavi bir noren perde.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069321
    m_Localized: Kapıda aç misafirleri karşılayan canlı kırmızı bir noren perde.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263616
    m_Localized: Tapınak huzuru getiren yosunlu bir taş fener.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263625
    m_Localized: Suşi Bayrağı
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263628
    m_Localized: Mavi Noren
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263629
    m_Localized: Kırmızı Noren
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263632
    m_Localized: Taş Tapınak
    m_Metadata:
      m_Items: []
  - m_Id: 5836103830462464
    m_Localized: Taze balığı ipeksi saşimi şeritlerine dilimler.
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433984
    m_Localized: Çıtır sebzeleri düzgün küçük çubuklara dönüştürür.
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433985
    m_Localized: Wasabiyi acı, yeşil bir sürprize rendeler.
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433986
    m_Localized: Et suyunu kaynatıp içini ısıtan bir kâse yapar.
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433987
    m_Localized: Pirinci kabarık, yapışkan bir suşi altınına dönüştürür.
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433988
    m_Localized: Yeşil çay demler, her yudumda huzur.
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433989
    m_Localized: Rende
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433990
    m_Localized: Tencere
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433991
    m_Localized: Pilav Pişirici
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433992
    m_Localized: Demlik
    m_Metadata:
      m_Items: []
  - m_Id: 5867052983115776
    m_Localized: Batının suşiye en sevilen hediyesi, kremsi avokado.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053008281600
    m_Localized: Rulo için hazır yumuşak yeşil küpler.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053008281601
    m_Localized: Pirincin üstüne kimono gibi dökülen ipeksi dilimler.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475904
    m_Localized: Sakince dökülecek çayı bekleyen boş bir fincan.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475905
    m_Localized: Kyoto bahçesi kadar dingin, çırpılmış yeşil çay.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475906
    m_Localized: Tatlı omletten minik altın küpler.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475907
    m_Localized: Sabırla katmanlanmış tatlı bir rulo omlet.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475908
    m_Localized: Tatlı ve yumuşak, altın sarısı rulo yumurta dilimleri.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475909
    m_Localized: Suşi ustalarının gözdesi yassı beyaz bir balık.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475910
    m_Localized: Hafif bir lokma için yumuşak kalkan küpleri.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475911
    m_Localized: Neredeyse şeffaf, narin beyaz dilimler.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475912
    m_Localized: Okyanus lezzetiyle dolu parlak gümüş bir balık.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475913
    m_Localized: Rulo için hazır lokmalık uskumru.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475914
    m_Localized: Cesur, zengin tadıyla parlak dilimler.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475915
    m_Localized: Doğruca soğuk sulardan gelen parlak turuncu bir fileto.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475916
    m_Localized: Küçük bir teknenin üstüne konmaya hazır somon küpleri.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475917
    m_Localized: Dilde eriyen tereyağı kıvamında somon dilimleri.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475918
    m_Localized: Balık pazarının kralı, koyu kırmızı ton balığı.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475919
    m_Localized: Cesur ve etli bir lokma için ton balığı küpleri.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475920
    m_Localized: Usta bıçağıyla kesilmiş yakut renkli dilimler.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475921
    m_Localized: Misafir ne dilerse onunla doldurulmuş bir yosun teknesi.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475922
    m_Localized: Tam misafirin sevdiği gibi yapılmış bir rulo.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475923
    m_Localized: Elde şekillenmiş pirinç, misafirin favorisiyle.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475924
    m_Localized: Siparişe göre seçilmiş taze dilimlerden bir tabak.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475925
    m_Localized: Her lokmayı uyandıran parlak bir limon.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475926
    m_Localized: Balığı canlandıran ince limon dilimleri.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475927
    m_Localized: Hafif ekşilikte kremalı Japon mayonezi.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475928
    m_Localized: Çiğ bir ahtapot, kol çok ama plan yok.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475929
    m_Localized: Pembe ve yumuşacık haşlandı, bıçağa hazır.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475930
    m_Localized: Topu olmayan takoyaki gibi minik ahtapot lokmaları.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475931
    m_Localized: Çiğnemelik çekiciliğiyle ince tako dilimleri.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475932
    m_Localized: Kısa taneli, cilalı ve banyosunu bekleyen pirinç.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475933
    m_Localized: Her suşinin ruhu, kabarık sirkeli pirinç.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475934
    m_Localized: Her lokmada patlayan minik turuncu inciler.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475935
    m_Localized: Mücevher gibi parıldayan çıtır uçan balık yumurtası.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475936
    m_Localized: Denizin tadıyla patlayan iri, parlak somon yumurtası.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475937
    m_Localized: Kızartılmış, sarmaya hazır çıtır yosun yaprakları.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475938
    m_Localized: Ferah, naneli bir dokunuş katan kokulu bir yaprak.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475939
    m_Localized: Küçük bir soru işareti gibi kıvrılmış çiğ bir karides.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475940
    m_Localized: Pembe ve gururlu haşlandı, pirince hazır.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475941
    m_Localized: Rulo için hazır lokmalık karides.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475942
    m_Localized: Kusursuz nigiri için yelpaze gibi açıldı.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475943
    m_Localized: Sisli yamaçlardan toplanmış yeşil çay yaprakları.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475944
    m_Localized: Meşhur sert mizacıyla boğumlu bir kök.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475945
    m_Localized: Burnu açan yeşil bir tutam acılık.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475946
