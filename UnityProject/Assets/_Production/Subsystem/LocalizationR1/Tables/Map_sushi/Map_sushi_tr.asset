    m_Localized: Çay Yaprakları
    m_Metadata:
      m_Items: []
  - m_Id: 5867053016670227
    m_Localized: Vasabi
    m_Metadata:
      m_Items: []
  - m_Id: 5867053016670228
    m_Localized: Rendelenmiş Vasabi
    m_Metadata:
      m_Items: []
  - m_Id: 5867053016670229
    m_Localized: Su
    m_Metadata:
      m_Items: []
  - m_Id: 8069165779771392
    m_Localized: Salatalıklar farkına varmadan dilimleniyor.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165817520128
    m_Localized: Samuray Dilimleme Tahtası
    m_Metadata:
      m_Items: []
  - m_Id: 8069165821714432
    m_Localized: Tek vuruş, kusursuz bir rulo için sebze.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165825908736
    m_Localized: Efsanevi Katana Tahtası
    m_Metadata:
      m_Items: []
  - m_Id: 8069165834297344
    m_Localized: Göz açıp kapayana kadar ipeksi dilimler. Balıklar onaylıyor.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165880434688
    m_Localized: Büyük Saşimi Tahtası
    m_Metadata:
      m_Items: []
  - m_Id: 8069165884628992
    m_Localized: Kesimler o kadar hassas ki şef bile şaşkına dönüyor.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165888823296
    m_Localized: Efsanevi Saşimi Sunağı
    m_Metadata:
      m_Items: []
  - m_Id: 8069165897211904
    m_Localized: Kase konmadan kabarık pilav hazır.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165901406208
    m_Localized: Turbo Pilav Pişirici
    m_Metadata:
      m_Items: []
  - m_Id: 8069165905600512
    m_Localized: Her tane mükemmel. Her seferinde.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165913989120
    m_Localized: Efsanevi Pirinç Tapınağı
    m_Metadata:
      m_Items: []
  - m_Id: 8069165918183424
    m_Localized: Acı yeşil bulutlar, bir saniyede hazır.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165922377728
    m_Localized: Vasabi Tayfunu
    m_Metadata:
      m_Items: []
  - m_Id: 8069165922377729
    m_Localized: O kadar hızlı ki odanın öbür ucundan burnun sızlıyor.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165930766336
    m_Localized: Efsanevi Vasabi Fırtınası
    m_Metadata:
      m_Items: []
  - m_Id: 8069165934960640
    m_Localized: Et suyu bir anda lezzetle fokurduyor.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165934960641
    m_Localized: Umami Yanardağı
    m_Metadata:
      m_Items: []
  - m_Id: 8069166039818240
    m_Localized: Kasabanın en lezzetli çorbası, şimşek hızında servis ediliyor.
    m_Metadata:
      m_Items: []
  - m_Id: 8069166039818241
    m_Localized: Efsanevi Umami Tenceresi
    m_Metadata:
      m_Items: []
  - m_Id: 8069166044012544
    m_Localized: Huzuru ve yeşil çayı her zamankinden hızlı demliyor.
    m_Metadata:
      m_Items: []
  - m_Id: 8069166044012545
    m_Localized: Aydınlanmış Demlik
    m_Metadata:
      m_Items: []
  - m_Id: 8069166044012546
    m_Localized: Derin bir nefes almadan mükemmel çay hazır.
    m_Metadata:
      m_Items: []
  - m_Id: 8069166044012547
    m_Localized: Efsanevi Zen Demliği
    m_Metadata:
      m_Items: []
