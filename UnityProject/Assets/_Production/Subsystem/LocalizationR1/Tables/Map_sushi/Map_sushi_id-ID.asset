  - m_Id: 5867053016670229
    m_Localized: Air
    m_Metadata:
      m_Items: []
  - m_Id: 8069165779771392
    m_Localized: Mentimun sudah teriris sebelum sadar.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165817520128
    m_Localized: Talenan Iris Samurai
    m_Metadata:
      m_Items: []
  - m_Id: 8069165821714432
    m_Localized: Satu ayunan, sayuran cukup untuk satu gulungan sempurna.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165825908736
    m_Localized: Talenan Katana Legendaris
    m_Metadata:
      m_Items: []
  - m_Id: 8069165834297344
    m_Localized: Irisan selembut sutra dalam sekejap. Ikan pun setuju.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165880434688
    m_Localized: Talenan Sashimi Agung
    m_Metadata:
      m_Items: []
  - m_Id: 8069165884628992
    m_Localized: Potongan begitu presisi, koki pun terkesiap.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165888823296
    m_Localized: Altar Sashimi Legendaris
    m_Metadata:
      m_Items: []
  - m_Id: 8069165897211904
    m_Localized: Nasi pulen, siap sebelum mangkuk disiapkan.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165901406208
    m_Localized: Penanak Nasi Turbo
    m_Metadata:
      m_Items: []
  - m_Id: 8069165905600512
    m_Localized: Setiap butir sempurna. Setiap saat.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165913989120
    m_Localized: Kuil Nasi Legendaris
    m_Metadata:
      m_Items: []
  - m_Id: 8069165918183424
    m_Localized: Awan hijau pedas, siap dalam sedetik.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165922377728
    m_Localized: Topan Wasabi
    m_Metadata:
      m_Items: []
  - m_Id: 8069165922377729
    m_Localized: Begitu cepat sampai hidungmu geli dari seberang ruangan.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165930766336
    m_Localized: Badai Wasabi Legendaris
    m_Metadata:
      m_Items: []
  - m_Id: 8069165934960640
    m_Localized: Kaldu mendidih penuh rasa dalam sekejap.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165934960641
    m_Localized: Gunung Berapi Umami
    m_Metadata:
      m_Items: []
  - m_Id: 8069166039818240
    m_Localized: Sup terlezat di kota, disajikan secepat kilat.
    m_Metadata:
      m_Items: []
  - m_Id: 8069166039818241
    m_Localized: Panci Umami Legendaris
    m_Metadata:
      m_Items: []
  - m_Id: 8069166044012544
    m_Localized: Menyeduh ketenangan dan teh hijau lebih cepat dari sebelumnya.
    m_Metadata:
      m_Items: []
  - m_Id: 8069166044012545
    m_Localized: Teko Tercerahkan
    m_Metadata:
      m_Items: []
  - m_Id: 8069166044012546
    m_Localized: Teh sempurna bahkan sebelum kamu menarik napas dalam.
    m_Metadata:
      m_Items: []
  - m_Id: 8069166044012547
    m_Localized: Teko Zen Legendaris
    m_Metadata:
      m_Items: []
