  m_TableData:
  - m_Id: 57786321854464
    m_Localized: Balon cerah membuat setiap layanan sushi terasa meriah.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214592
    m_Localized: Restoran sushi yang asli.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214593
    m_Localized: Restoran lebih besar yang siap untuk peningkatan sushi lainnya.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214594
    m_Localized: Bonsai yang dipangkas rapi dan menambahkan sentuhan hijau yang menenangkan.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214595
    m_Localized: Papan kapibara yang ramah untuk bagian depan toko.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214596
    m_Localized: Kucing penyambut yang melambai mengajak pelanggan masuk.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214597
    m_Localized: Konter penuh yang memajang hidangan terbaik restoran.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214598
    m_Localized: Talenan di atap penuh sushi dan gulungan.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214599
    m_Localized: Bendera dan kanopi warna-warni menghiasi fasad restoran.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214600
    m_Localized: Tamu kitsune anggun yang memesan sushi dengan gaya teatrikal.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214601
    m_Localized: Kambing biru ini suka matcha dan berlatih tata krama makan yang ceria.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214602
    m_Localized: Mempelajari menu dengan tekun, tapi tetap menukar makan siang dengan kayu putih.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214603
    m_Localized: Shishi kecil pemberani yang menantang setiap gulungan sushi berduel.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214604
    m_Localized: Atap tradisional yang memberi restoran satu lantai lagi.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214605
    m_Localized: Shiba yokozuna yang memperlakukan setiap piring sushi seperti pertandingan juara.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214606
    m_Localized: Bangku nyaman untuk tamu sushi.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214607
    m_Localized: Oyabun serigala berbicara pelan dan menguasai konter sushi dengan satu tatapan.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214608
    m_Localized: Balon Festival
    m_Metadata:
      m_Items: []
