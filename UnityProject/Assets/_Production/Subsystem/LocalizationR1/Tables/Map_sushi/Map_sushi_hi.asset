    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475971
    m_Localized: निगिरी सुशी
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475972
    m_Localized: साशिमी प्लेट
    m_Metadata:
      m_Items: []
  - m_Id: 5867053016670208
    m_Localized: नींबू
    m_Metadata:
      m_Items: []
  - m_Id: 5867053016670209
    m_Localized: कटा नींबू
    m_Metadata:
      m_Items: []
  - m_Id: 5867053016670210
    m_Localized: मेयोनीज़
    m_Metadata:
      m_Items: []
  - m_Id: 5867053016670211
    m_Localized: ऑक्टोपस
    m_Metadata:
      m_Items: []
  - m_Id: 5867053016670212
    m_Localized: उबला ऑक्टोपस
    m_Metadata:
      m_Items: []
  - m_Id: 5867053016670213
    m_Localized: ऑक्टोपस के टुकड़े
    m_Metadata:
      m_Items: []
  - m_Id: 5867053016670214
    m_Localized: कटा ऑक्टोपस
    m_Metadata:
      m_Items: []
  - m_Id: 5867053016670215
    m_Localized: चावल
    m_Metadata:
      m_Items: []
  - m_Id: 5867053016670216
    m_Localized: सुशी चावल
    m_Metadata:
      m_Items: []
  - m_Id: 5867053016670217
    m_Localized: कैपेलिन रो
    m_Metadata:
      m_Items: []
  - m_Id: 5867053016670218
    m_Localized: टोबिको
    m_Metadata:
      m_Items: []
  - m_Id: 5867053016670219
    m_Localized: इकुरा
    m_Metadata:
      m_Items: []
  - m_Id: 5867053016670220
    m_Localized: नोरी
    m_Metadata:
      m_Items: []
  - m_Id: 5867053016670221
    m_Localized: शिसो पत्ता
    m_Metadata:
      m_Items: []
  - m_Id: 5867053016670222
    m_Localized: झींगा
    m_Metadata:
      m_Items: []
  - m_Id: 5867053016670223
    m_Localized: उबला झींगा
    m_Metadata:
      m_Items: []
  - m_Id: 5867053016670224
    m_Localized: झींगा के टुकड़े
    m_Metadata:
      m_Items: []
  - m_Id: 5867053016670225
    m_Localized: बटरफ़्लाई झींगा
    m_Metadata:
      m_Items: []
  - m_Id: 5867053016670226
    m_Localized: चाय की पत्तियाँ
    m_Metadata:
      m_Items: []
  - m_Id: 5867053016670227
    m_Localized: वसाबी
    m_Metadata:
      m_Items: []
  - m_Id: 5867053016670228
    m_Localized: कद्दूकस वसाबी
    m_Metadata:
      m_Items: []
  - m_Id: 5867053016670229
    m_Localized: पानी
    m_Metadata:
      m_Items: []
  - m_Id: 8069165779771392
    m_Localized: खीरे को पता चलने से पहले ही वह कट जाता है।
    m_Metadata:
      m_Items: []
  - m_Id: 8069165817520128
    m_Localized: समुराई स्लाइसर बोर्ड
    m_Metadata:
      m_Items: []
  - m_Id: 8069165821714432
    m_Localized: एक वार, एक परफ़ेक्ट रोल जितनी सब्ज़ियाँ।
    m_Metadata:
      m_Items: []
  - m_Id: 8069165825908736
    m_Localized: लीजेंडरी कटाना बोर्ड
    m_Metadata:
      m_Items: []
  - m_Id: 8069165834297344
    m_Localized: पल भर में रेशमी स्लाइस। मछलियाँ भी मानती हैं।
    m_Metadata:
      m_Items: []
  - m_Id: 8069165880434688
    m_Localized: ग्रैंड साशिमी बोर्ड
    m_Metadata:
      m_Items: []
  - m_Id: 8069165884628992
    m_Localized: इतनी सटीक कटिंग कि शेफ़ भी दंग रह जाए।
    m_Metadata:
      m_Items: []
  - m_Id: 8069165888823296
    m_Localized: लीजेंडरी साशिमी वेदी
    m_Metadata:
      m_Items: []
  - m_Id: 8069165897211904
    m_Localized: कटोरा रखने से पहले ही मुलायम चावल तैयार।
    m_Metadata:
      m_Items: []
  - m_Id: 8069165901406208
    m_Localized: टर्बो राइस कुकर
    m_Metadata:
      m_Items: []
  - m_Id: 8069165905600512
    m_Localized: हर दाना परफ़ेक्ट। हर बार।
    m_Metadata:
      m_Items: []
  - m_Id: 8069165913989120
    m_Localized: लीजेंडरी राइस मंदिर
    m_Metadata:
      m_Items: []
  - m_Id: 8069165918183424
    m_Localized: तीखे हरे बादल, एक सेकंड में तैयार।
    m_Metadata:
      m_Items: []
  - m_Id: 8069165922377728
    m_Localized: वसाबी टाइफ़ून
    m_Metadata:
      m_Items: []
  - m_Id: 8069165922377729
    m_Localized: इतना तेज़ कि कमरे के उस पार से नाक में झनझनाहट हो।
    m_Metadata:
      m_Items: []
  - m_Id: 8069165930766336
    m_Localized: लीजेंडरी वसाबी तूफ़ान
    m_Metadata:
      m_Items: []
  - m_Id: 8069165934960640
    m_Localized: शोरबा पल भर में स्वाद से भरकर उबलने लगता है।
    m_Metadata:
      m_Items: []
  - m_Id: 8069165934960641
    m_Localized: उमामी ज्वालामुखी
    m_Metadata:
      m_Items: []
  - m_Id: 8069166039818240
    m_Localized: शहर का सबसे लज़ीज़ सूप, बिजली की रफ़्तार से।
    m_Metadata:
      m_Items: []
  - m_Id: 8069166039818241
    m_Localized: लीजेंडरी उमामी पॉट
    m_Metadata:
      m_Items: []
  - m_Id: 8069166044012544
    m_Localized: पहले से कहीं तेज़ शांति और ग्रीन टी बनाता है।
    m_Metadata:
      m_Items: []
  - m_Id: 8069166044012545
    m_Localized: प्रबुद्ध टीपॉट
    m_Metadata:
      m_Items: []
  - m_Id: 8069166044012546
    m_Localized: गहरी साँस लेने से पहले ही परफ़ेक्ट चाय।
    m_Metadata:
      m_Items: []
  - m_Id: 8069166044012547
    m_Localized: लीजेंडरी ज़ेन टीपॉट
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
