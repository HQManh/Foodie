    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475967
    m_Localized: टूना के टुकड़े
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475968
    m_Localized: कटा टूना
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475969
    m_Localized: गुनकान सुशी
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475970
