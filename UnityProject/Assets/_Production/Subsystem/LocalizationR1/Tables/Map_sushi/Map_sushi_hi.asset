    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475964
    m_Localized: सैल्मन के टुकड़े
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475965
    m_Localized: कटा सैल्मन
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475966
