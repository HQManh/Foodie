  m_TableData:
  - m_Id: 57786321854464
    m_Localized: Balões coloridos deixam cada serviço de sushi festivo.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214592
    m_Localized: O restaurante de sushi original.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214593
    m_Localized: Um restaurante maior, pronto para mais melhorias de sushi.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214594
    m_Localized: Um bonsai bem aparado que adiciona um toque calmo de verde.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214595
    m_Localized: Uma placa simpática de capivara para a fachada.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214596
    m_Localized: Um gato acolhedor que acena chamando os clientes.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214597
    m_Localized: Um balcão cheio exibindo os melhores pratos do restaurante.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214598
    m_Localized: Uma tábua de corte no telhado cheia de sushis e rolinhos.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214599
    m_Localized: Bandeiras e toldos coloridos enfeitam a fachada do restaurante.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214600
    m_Localized: Uma graciosa cliente kitsune que pede sushi com elegância teatral.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214601
    m_Localized: Esta cabra azul ama matcha e pratica boas maneiras à mesa com alegria.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214602
    m_Localized: Estuda o cardápio com dedicação, mas ainda troca o almoço por eucalipto.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214603
    m_Localized: Um pequeno shishi corajoso que desafia cada sushi para um duelo.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214604
    m_Localized: Um telhado tradicional que dá mais um andar ao restaurante.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214605
    m_Localized: Um shiba yokozuna que encara cada travessa de sushi como uma luta pelo título.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214606
    m_Localized: Banquinhos confortáveis para os clientes do sushi.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214607
    m_Localized: O oyabun lobo fala baixinho e controla o balcão de sushi com um só olhar.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214608
    m_Localized: Balões de festival
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214609
    m_Localized: Expansão do sushi
    m_Metadata:
      m_Items: []
