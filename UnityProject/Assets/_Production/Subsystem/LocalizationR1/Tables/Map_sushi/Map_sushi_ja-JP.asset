    m_Metadata:
      m_Items: []
  - m_Id: 5867053016670226
    m_Localized: 茶葉
    m_Metadata:
      m_Items: []
  - m_Id: 5867053016670227
    m_Localized: わさび
    m_Metadata:
      m_Items: []
  - m_Id: 5867053016670228
    m_Localized: すりおろしわさび
    m_Metadata:
      m_Items: []
  - m_Id: 5867053016670229
    m_Localized: 水
    m_Metadata:
      m_Items: []
  - m_Id: 8069165779771392
    m_Localized: キュウリは気づく前にスライス済み。
    m_Metadata:
      m_Items: []
  - m_Id: 8069165817520128
    m_Localized: サムライスライサーまな板
    m_Metadata:
      m_Items: []
  - m_Id: 8069165821714432
    m_Localized: ひと振りで完璧な巻き寿司一本分の野菜。
    m_Metadata:
      m_Items: []
  - m_Id: 8069165825908736
    m_Localized: 伝説の刀まな板
    m_Metadata:
      m_Items: []
  - m_Id: 8069165834297344
    m_Localized: 一瞬でシルクのような切り身。魚もお墨付き。
    m_Metadata:
      m_Items: []
  - m_Id: 8069165880434688
    m_Localized: グランド刺身まな板
    m_Metadata:
      m_Items: []
  - m_Id: 8069165884628992
    m_Localized: シェフも息をのむほど精密な切れ味。
    m_Metadata:
      m_Items: []
  - m_Id: 8069165888823296
    m_Localized: 伝説の刺身祭壇
    m_Metadata:
      m_Items: []
  - m_Id: 8069165897211904
    m_Localized: お茶碗を並べる前にふっくらご飯が完成。
    m_Metadata:
      m_Items: []
  - m_Id: 8069165901406208
    m_Localized: ターボ炊飯器
    m_Metadata:
      m_Items: []
  - m_Id: 8069165905600512
    m_Localized: 一粒一粒が完璧。毎回必ず。
    m_Metadata:
      m_Items: []
  - m_Id: 8069165913989120
    m_Localized: 伝説の米の社
    m_Metadata:
      m_Items: []
  - m_Id: 8069165918183424
    m_Localized: ピリッと辛い緑の雲が一瞬で完成。
    m_Metadata:
      m_Items: []
  - m_Id: 8069165922377728
    m_Localized: わさび台風
    m_Metadata:
      m_Items: []
  - m_Id: 8069165922377729
    m_Localized: 部屋の反対側でも鼻がツーンとする速さ。
    m_Metadata:
      m_Items: []
  - m_Id: 8069165930766336
    m_Localized: 伝説のわさびストーム
    m_Metadata:
      m_Items: []
  - m_Id: 8069165934960640
    m_Localized: あっという間に旨みたっぷりのだしがぐつぐつ。
    m_Metadata:
      m_Items: []
  - m_Id: 8069165934960641
    m_Localized: うま味火山
    m_Metadata:
      m_Items: []
  - m_Id: 8069166039818240
    m_Localized: 町一番のおいしいスープを稲妻の速さで。
    m_Metadata:
      m_Items: []
  - m_Id: 8069166039818241
    m_Localized: 伝説のうま味鍋
    m_Metadata:
      m_Items: []
  - m_Id: 8069166044012544
    m_Localized: かつてない速さで、心の平穏と緑茶を淹れる。
    m_Metadata:
      m_Items: []
  - m_Id: 8069166044012545
    m_Localized: 悟りのティーポット
    m_Metadata:
      m_Items: []
  - m_Id: 8069166044012546
    m_Localized: 深呼吸する前に完璧なお茶が完成。
    m_Metadata:
      m_Items: []
  - m_Id: 8069166044012547
    m_Localized: 伝説の禅ティーポット
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
