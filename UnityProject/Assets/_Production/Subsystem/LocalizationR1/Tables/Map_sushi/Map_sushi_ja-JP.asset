%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: Map_sushi_ja-JP
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: ja-JP
  m_SharedData: {fileID: 11400000, guid: 6661c9f2ba46546428a729e8cde76aa0, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 57786321854464
    m_Localized: 明るい風船で、寿司の営業がいつもお祭り気分に。
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214592
    m_Localized: 元祖の寿司店。
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214593
    m_Localized: さらなる寿司の強化に備えた、大きくなったレストラン。
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214594
    m_Localized: きれいに整えられた盆栽が、穏やかな緑を添える。
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214595
    m_Localized: 店先を飾る、人懐っこいカピバラの看板。
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214596
    m_Localized: お客さんを手招きして迎える招き猫。
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214597
    m_Localized: お店自慢の料理がずらりと並ぶカウンター。
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214598
    m_Localized: 寿司と巻物がどっさり乗った屋根の上のまな板。
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214599
    m_Localized: 色とりどりの旗と日よけが店の外観を彩ります。
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214600
    m_Localized: 芝居がかった優雅さで寿司を注文する、麗しい狐の客。
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214601
    m_Localized: 抹茶が大好きな青ヤギは、明るいテーブルマナーを練習中。
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214602
    m_Localized: メニューを熱心に研究するのに、結局ランチをユーカリと交換しちゃう。
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214603
    m_Localized: どの巻き寿司にも決闘を挑む、勇敢な小さな獅子。
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214604
    m_Localized: お店にもう一段の格を与える伝統的な屋根。
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214605
    m_Localized: どの寿司盛りも優勝決定戦のように挑む、柴犬の横綱。
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214606
    m_Localized: 寿司のお客さん向けの座り心地のいいスツール。
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214607
    m_Localized: 狼の親分は静かに語り、ひとにらみで寿司カウンターを仕切る。
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214608
    m_Localized: お祭りバルーン
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214609
    m_Localized: 寿司店の増築
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214610
    m_Localized: 盆栽の庭
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214611
    m_Localized: カピバラ看板
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214612
    m_Localized: 招き猫
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214613
    m_Localized: ショーケースカウンター
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214614
    m_Localized: 寿司のまな板
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214615
    m_Localized: 寿司ののぼり
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214616
    m_Localized: 狐のお嬢
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214617
    m_Localized: 青ヤギのアオイ
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214618
    m_Localized: コアラ先輩
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214619
    m_Localized: 獅子くん
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214620
    m_Localized: 2階の屋根
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214621
    m_Localized: 柴犬横綱
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214622
    m_Localized: 寿司スツール
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214623
    m_Localized: 狼の親分
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214624
    m_Localized: 握り寿司
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214625
    m_Localized: 手で握ったシャリに、小さな毛布のように魚をひと切れ。
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214626
    m_Localized: 巻き寿司
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214627
    m_Localized: 海苔でしっかり巻いて、中をのぞかれる前に切り分け。
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214628
    m_Localized: 軍艦巻き
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214629
    m_Localized: 小さな海苔の船に、ネタをあふれるほど山盛り。
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214630
    m_Localized: 刺身盛り合わせ
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214631
    m_Localized: 薄く切った新鮮な魚。隠れる場所はどこにもない。
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214632
    m_Localized: 緑茶
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214633
    m_Localized: あたたかくて穏やか。わさびの辛さを流してくれる。
    m_Metadata:
      m_Items: []
  - m_Id: 2945767655333888
    m_Localized: お客さんを手招きして迎える招き猫。
    m_Metadata:
      m_Items: []
  - m_Id: 2945767667916800
    m_Localized: 寿司のお客さん向けの座り心地のいいスツール。
    m_Metadata:
      m_Items: []
  - m_Id: 2945767667916801
    m_Localized: お店を明るく照らす、やさしい光の提灯。
    m_Metadata:
      m_Items: []
  - m_Id: 2945767667916802
    m_Localized: 店先を飾る、人懐っこいカピバラの看板。
    m_Metadata:
      m_Items: []
  - m_Id: 2945767667916803
    m_Localized: 店先を飾る、人懐っこいカピバラの看板。
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111104
    m_Localized: 屋根にどっかり乗った巨大マグロが、今日の新鮮な獲物を自慢げにアピール。
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111105
    m_Localized: 寿司と巻物がどっさり乗った屋根の上のまな板。
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111106
    m_Localized: 招き猫
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111107
    m_Localized: 寿司スツール
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111108
    m_Localized: 提灯
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111109
    m_Localized: カピバラ看板
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111110
    m_Localized: カピバラ看板
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111111
    m_Localized: 巨大マグロ
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111112
    m_Localized: 寿司のまな板
    m_Metadata:
      m_Items: []
  - m_Id: 3010516803903488
    m_Localized: 野菜はまばたきする間に切れてしまう。
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069312
    m_Localized: 刃が速すぎて、キュウリは先に降参する。
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069313
    m_Localized: 生魚を、さらになめらかな刺身の舌ざわりに切り分ける。
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069314
    m_Localized: 一切れ一切れが芸術品。魚も光栄に感じている。
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069315
    m_Localized: ふっくらご飯がたちまち完成。お米たちは行列して炊かれるのを待っている。
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069316
    m_Localized: 完璧すぎるご飯にスタンディングオベーションを。
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069318
    m_Localized: わさびを稲妻の速さですりおろす。涙はお好みで。
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069319
    m_Localized: 速すぎて、わさびは気づく間もない。
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069322
    m_Localized: 「うま味」と言う前に美味しさが煮えている。
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069323
    m_Localized: ぐつぐつ煮える伝説。ワープ速度で調理する。
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263617
    m_Localized: 熱いお茶がすぐ完成。お客さんは落ち着いてひと口。
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263618
    m_Localized: 完璧なお茶と心の平穏を一度に注ぐ。
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263619
    m_Localized: スイフト野菜まないた
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263620
    m_Localized: ニンジャ野菜まないた
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263621
    m_Localized: 切れ味アップ魚まないた
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263622
    m_Localized: 刺身名人のまないた
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263623
    m_Localized: ターボ炊飯器
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263624
    m_Localized: メガ炊飯器
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263626
    m_Localized: スイスイおろし器
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263627
    m_Localized: わさびの旋風
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263630
    m_Localized: スピード煮込み鍋
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263631
    m_Localized: うま味の大釜
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263633
    m_Localized: クイック急須
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263634
    m_Localized: 禅マスターの急須
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069317
    m_Localized: 鮮やかな青い寿司のぼりが、空腹の視線をひとり占め。
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069320
    m_Localized: 涼しげな青いのれんが、入口でゆらゆら揺れている。
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069321
    m_Localized: 鮮やかな赤いのれんが、お腹ぺこぺこのお客さんを入口でお出迎え。
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263616
    m_Localized: 苔むした石灯籠が、お寺のような静けさをもたらす。
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263625
    m_Localized: 寿司のぼり
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263628
    m_Localized: 青いのれん
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263629
    m_Localized: 赤いのれん
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263632
    m_Localized: 石の祠
    m_Metadata:
      m_Items: []
  - m_Id: 5836103830462464
    m_Localized: 新鮮な魚をなめらかな刺身に切り分けます。
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433984
    m_Localized: シャキシャキ野菜をきれいなスティックに切ります。
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433985
    m_Localized: わさびをすりおろして、ピリッと緑のサプライズに。
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433986
    m_Localized: だしをコトコト煮て、心温まる一杯に。
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433987
    m_Localized: ご飯をふっくらもちもちの寿司ゴールドに炊き上げます。
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433988
    m_Localized: 緑茶を淹れて、ひと口ごとにほっこり。
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433989
    m_Localized: おろし金
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433990
    m_Localized: 鍋
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433991
    m_Localized: 炊飯器
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433992
    m_Localized: 急須
    m_Metadata:
      m_Items: []
  - m_Id: 5867052983115776
    m_Localized: 西洋から寿司への人気の贈り物、クリーミーなアボカド。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053008281600
    m_Localized: 巻き寿司にぴったりの、やわらか緑キューブ。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053008281601
    m_Localized: 着物のようにご飯をふわりと包む、なめらかスライス。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475904
    m_Localized: 静かにお茶が注がれるのを待つ、空の湯のみ。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475905
    m_Localized: 京都の庭のように落ち着く、点てた抹茶。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475906
    m_Localized: 甘い卵焼きの小さな黄金キューブ。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475907
    m_Localized: 根気よく層を重ねた、甘い卵焼き。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475908
    m_Localized: 甘くてふわふわ、黄金色の卵焼きスライス。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475909
    m_Localized: 寿司職人が重宝する、平たい白身魚。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475910
    m_Localized: 軽いひと口にぴったりの、やわらかヒラメ。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475911
    m_Localized: 透き通るほど繊細な、白い切り身。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475912
    m_Localized: 海の旨みたっぷり、ピカピカの銀色の魚。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475913
    m_Localized: 巻き寿司にぴったり、ひと口サイズのサバ。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475914
    m_Localized: 大胆で濃厚な味わいの、つやつや切り身。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475915
    m_Localized: 冷たい海から届いた、鮮やかなオレンジの切り身。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475916
    m_Localized: 小さな軍艦にのせるサーモンキューブ。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475917
    m_Localized: 舌の上でとろける、バターのようなサーモン。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475918
    m_Localized: 魚市場の王様、深紅のマグロ。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475919
    m_Localized: しっかり食べごたえのあるマグロキューブ。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475920
    m_Localized: 職人の包丁で引いた、ルビー色の切り身。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475921
    m_Localized: お客様のお望みのままに盛った、海苔の小舟。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475922
    m_Localized: お客様の好みどおりに巻いた一本。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475923
    m_Localized: お客様の好きなネタをのせた、手で握ったシャリ。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475924
    m_Localized: ご注文に合わせて選んだ、新鮮な切り身の盛り合わせ。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475925
    m_Localized: ひと口ごとに目を覚まさせる、爽やかレモン。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475926
    m_Localized: 魚を引き立てる、薄切りレモン。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475927
    m_Localized: ほんのり酸味のクリーミーな和風マヨ。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475928
    m_Localized: 生のタコ、腕はたくさん、予定はなし。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475929
    m_Localized: ピンク色にやわらかく茹で上がり、包丁を待つばかり。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475930
    m_Localized: たこ焼きの玉なし版みたいな、小さなタコ。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475931
    m_Localized: 噛むほどに魅力的な、薄切りのタコ。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475932
    m_Localized: 磨かれた短粒米、お風呂(研ぎ)を待っています。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475933
    m_Localized: ふっくら酢飯、すべての寿司の魂。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475934
    m_Localized: ひと口ごとにプチっとはじける、小さなオレンジの粒。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475935
    m_Localized: 宝石のようにきらめく、プチプチのとびこ。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475936
    m_Localized: 海の味がはじける、大粒でつやつやのいくら。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475937
    m_Localized: パリッと焼いた海苔、巻く準備はばっちり。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475938
    m_Localized: 爽やかなミントのような風味を添える、香り高い葉。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475939
    m_Localized: 小さなはてなマークのように丸まった生エビ。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475940
    m_Localized: ピンクに茹で上がって誇らしげ、シャリを待っています。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475941
    m_Localized: 巻き寿司にぴったり、ひと口サイズのエビ。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475942
    m_Localized: 扇子のように開いて、完璧な握りに。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475943
    m_Localized: 霧の立ちこめる丘で摘まれた緑茶の葉。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475944
    m_Localized: ゴツゴツした根っこ、ツンとくる性格で有名。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475945
    m_Localized: 鼻にツーンと抜ける、緑のひとさじ。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475946
    m_Localized: お茶になるのを待つ、きれいな水。
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475947
    m_Localized: アボカド
    m_Metadata:
      m_Items: []
