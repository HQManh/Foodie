      m_Items: []
  - m_Id: 8069165779771392
    m_Localized: Les concombres sont tranchés avant de s'en rendre compte.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165817520128
    m_Localized: Planche à trancher samouraï
    m_Metadata:
      m_Items: []
  - m_Id: 8069165821714432
    m_Localized: Un seul coup, de quoi garnir un rouleau parfait.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165825908736
    m_Localized: Planche katana légendaire
    m_Metadata:
      m_Items: []
  - m_Id: 8069165834297344
    m_Localized: Des tranches soyeuses en un éclair. Les poissons approuvent.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165880434688
    m_Localized: Grande planche à sashimi
    m_Metadata:
      m_Items: []
  - m_Id: 8069165884628992
    m_Localized: Des coupes si précises que même le chef en reste bouche bée.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165888823296
    m_Localized: Autel à sashimi légendaire
    m_Metadata:
      m_Items: []
  - m_Id: 8069165897211904
    m_Localized: Du riz moelleux, prêt avant que le bol soit posé.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165901406208
    m_Localized: Cuiseur à riz turbo
    m_Metadata:
      m_Items: []
  - m_Id: 8069165905600512
    m_Localized: Chaque grain est parfait. À chaque fois.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165913989120
    m_Localized: Sanctuaire du riz légendaire
    m_Metadata:
      m_Items: []
  - m_Id: 8069165918183424
    m_Localized: Des nuages verts épicés, prêts en une seconde.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165922377728
    m_Localized: Typhon de wasabi
    m_Metadata:
      m_Items: []
  - m_Id: 8069165922377729
    m_Localized: Si rapide que votre nez picote depuis l'autre bout de la pièce.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165930766336
    m_Localized: Tempête de wasabi légendaire
    m_Metadata:
      m_Items: []
  - m_Id: 8069165934960640
    m_Localized: Le bouillon bouillonne plein de saveur en un rien de temps.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165934960641
    m_Localized: Volcan umami
    m_Metadata:
      m_Items: []
  - m_Id: 8069166039818240
    m_Localized: La soupe la plus délicieuse de la ville, servie à la vitesse de l'éclair.
    m_Metadata:
      m_Items: []
  - m_Id: 8069166039818241
    m_Localized: Marmite umami légendaire
    m_Metadata:
      m_Items: []
  - m_Id: 8069166044012544
    m_Localized: Infuse le calme et le thé vert plus vite que jamais.
    m_Metadata:
      m_Items: []
  - m_Id: 8069166044012545
    m_Localized: Théière éclairée
    m_Metadata:
      m_Items: []
  - m_Id: 8069166044012546
    m_Localized: Un thé parfait avant même de prendre une grande inspiration.
    m_Metadata:
      m_Items: []
  - m_Id: 8069166044012547
    m_Localized: Théière zen légendaire
    m_Metadata:
      m_Items: []
