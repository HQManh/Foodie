  - m_Id: 5867053016670228
    m_Localized: Wasabi mài
    m_Metadata:
      m_Items: []
  - m_Id: 5867053016670229
    m_Localized: Nước
    m_Metadata:
      m_Items: []
  - m_Id: 8069165779771392
    m_Localized: Dưa leo bị thái lát trước khi kịp nhận ra.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165817520128
    m_Localized: Thớt Thái Samurai
    m_Metadata:
      m_Items: []
  - m_Id: 8069165821714432
    m_Localized: Một nhát chém, đủ rau cho một cuộn sushi hoàn hảo.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165825908736
    m_Localized: Thớt Katana Huyền Thoại
    m_Metadata:
      m_Items: []
  - m_Id: 8069165834297344
    m_Localized: Lát cá mượt như lụa trong chớp mắt. Cá cũng gật gù.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165880434688
    m_Localized: Thớt Sashimi Đại Sư
    m_Metadata:
      m_Items: []
  - m_Id: 8069165884628992
    m_Localized: Từng nhát cắt chuẩn đến mức đầu bếp cũng phải trầm trồ.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165888823296
    m_Localized: Bàn Thờ Sashimi Huyền Thoại
    m_Metadata:
      m_Items: []
  - m_Id: 8069165897211904
    m_Localized: Cơm dẻo thơm, chín trước khi kịp bày bát.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165901406208
    m_Localized: Nồi Cơm Turbo
    m_Metadata:
      m_Items: []
  - m_Id: 8069165905600512
    m_Localized: Từng hạt đều hoàn hảo. Lần nào cũng vậy.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165913989120
    m_Localized: Đền Gạo Huyền Thoại
    m_Metadata:
      m_Items: []
  - m_Id: 8069165918183424
    m_Localized: Những đám mây xanh cay xè, xong trong một giây.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165922377728
    m_Localized: Bão Wasabi
    m_Metadata:
      m_Items: []
  - m_Id: 8069165922377729
    m_Localized: Nhanh đến mức đứng bên kia phòng cũng cay mũi.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165930766336
    m_Localized: Cơn Bão Wasabi Huyền Thoại
    m_Metadata:
      m_Items: []
  - m_Id: 8069165934960640
    m_Localized: Nước dùng sôi sùng sục đậm đà trong chớp mắt.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165934960641
    m_Localized: Núi Lửa Umami
    m_Metadata:
      m_Items: []
  - m_Id: 8069166039818240
    m_Localized: Món súp ngon nhất phố, dọn ra nhanh như chớp.
    m_Metadata:
      m_Items: []
  - m_Id: 8069166039818241
    m_Localized: Nồi Umami Huyền Thoại
    m_Metadata:
      m_Items: []
  - m_Id: 8069166044012544
    m_Localized: Pha sự bình yên và trà xanh nhanh hơn bao giờ hết.
    m_Metadata:
      m_Items: []
  - m_Id: 8069166044012545
    m_Localized: Ấm Trà Giác Ngộ
    m_Metadata:
      m_Items: []
  - m_Id: 8069166044012546
    m_Localized: Trà hoàn hảo trước cả khi bạn kịp hít một hơi sâu.
    m_Metadata:
      m_Items: []
  - m_Id: 8069166044012547
    m_Localized: Ấm Trà Thiền Huyền Thoại
    m_Metadata:
      m_Items: []
