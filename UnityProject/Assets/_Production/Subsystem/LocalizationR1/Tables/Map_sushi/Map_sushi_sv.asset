  m_TableData:
  - m_Id: 57786321854464
    m_Localized: Färgglada ballonger gör varje sushiservering festlig.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214592
    m_Localized: Den ursprungliga sushirestaurangen.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214593
    m_Localized: En större restaurang redo för fler sushiuppgraderingar.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214594
    m_Localized: En prydligt trimmad bonsai som ger en lugn grön touch.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214595
    m_Localized: En vänlig kapybaraskylt till butiksfasaden.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214596
    m_Localized: En välkomnande katt som vinkar in gästerna.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214597
    m_Localized: En full disk med restaurangens bästa rätter.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214598
    m_Localized: En skärbräda på taket fylld med sushi och rullar.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214599
    m_Localized: Färgglada flaggor och markiser pryder restaurangens fasad.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214600
    m_Localized: En graciös kitsune-gäst som beställer sushi med teatralisk elegans.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214601
    m_Localized: Den här blå geten älskar matcha och övar glada bordsmanér.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214602
    m_Localized: Studerar menyn flitigt men byter ändå bort lunchen mot eukalyptus.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214603
    m_Localized: En modig liten shishi som utmanar varje sushirulle på duell.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214604
    m_Localized: Ett traditionellt tak som ger restaurangen en våning till.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214605
    m_Localized: En shiba-yokozuna som ser varje sushifat som en mästerskapsmatch.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214606
    m_Localized: Bekväma pallar för sushigäster.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214607
    m_Localized: Varg-oyabunen talar mjukt och styr sushidisken med en enda blick.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214608
    m_Localized: Festivalballonger
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214609
    m_Localized: Sushiutbyggnad
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214610
    m_Localized: Bonsaiträdgård
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214611
    m_Localized: Kapybaraskylt
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214612
    m_Localized: Lyckokatt
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214613
    m_Localized: Monterdisk
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214614
    m_Localized: Sushiskärbräda
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214615
    m_Localized: Sushiflaggor
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214616
    m_Localized: Kitsune Ojou
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214617
    m_Localized: Aoi Yagi
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214618
    m_Localized: Koala Senpai
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214619
    m_Localized: Shishi-kun
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214620
    m_Localized: Tak till andra våningen
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214621
    m_Localized: Shiba Yokozuna
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214622
    m_Localized: Sushipallar
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214623
    m_Localized: Ookami Oyabun
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214624
    m_Localized: Nigiri-sushi
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214625
    m_Localized: Handformat ris med en skiva fisk som en liten filt.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214626
    m_Localized: Maki-rulle
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214627
    m_Localized: Hårt rullad i sjögräs och skivad innan någon hinner kika in.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214628
    m_Localized: Gunkan-sushi
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214629
    m_Localized: En liten sjögräsbåt lastad med topping ända upp till kanten.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214630
    m_Localized: Sashimi-tallrik
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214631
    m_Localized: Färsk fisk skivad tunt utan något att gömma sig bakom.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214632
    m_Localized: Grönt te
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214633
    m_Localized: Varmt och lugnt, serverat för att skölja bort wasabin.
    m_Metadata:
      m_Items: []
  - m_Id: 2945767655333888
    m_Localized: En välkomnande katt som vinkar in gästerna.
    m_Metadata:
      m_Items: []
  - m_Id: 2945767667916800
    m_Localized: Bekväma pallar för sushigäster.
    m_Metadata:
      m_Items: []
  - m_Id: 2945767667916801
    m_Localized: Lysande papperslyktor som lyser upp restaurangen.
    m_Metadata:
      m_Items: []
  - m_Id: 2945767667916802
    m_Localized: En vänlig kapybaraskylt till butiksfasaden.
    m_Metadata:
      m_Items: []
  - m_Id: 2945767667916803
    m_Localized: En vänlig kapybaraskylt till butiksfasaden.
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111104
    m_Localized: En enorm tonfisk på taket som stolt visar upp dagens färska fångst.
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111105
    m_Localized: En skärbräda på taket fylld med sushi och rullar.
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111106
    m_Localized: Lyckokatt
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111107
    m_Localized: Sushipallar
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111108
    m_Localized: Papperslyktor
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111109
    m_Localized: Kapybaraskylt
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111110
    m_Localized: Kapybaraskylt
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111111
    m_Localized: Jättetonfisk
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111112
    m_Localized: Sushiskärbräda
    m_Metadata:
      m_Items: []
  - m_Id: 3010516803903488
    m_Localized: Grönsakerna är hackade innan de hinner blinka.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069312
    m_Localized: Knivarna är så snabba att gurkorna ger upp i förväg.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069313
    m_Localized: Skär rå fisk med extra sashimi-len mjukhet.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069314
    m_Localized: Varje snitt är ett konstverk. Fiskarna känner sig hedrade.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069315
    m_Localized: Fluffigt ris på ett ögonblick. Kornen står i kö för att få bli kokta.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069316
    m_Localized: Ris så perfekt att det förtjänar stående ovationer.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069318
    m_Localized: River wasabi i blixtfart. Tårar är valfria.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069319
    m_Localized: River så snabbt att wasabin aldrig såg det komma.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069322
    m_Localized: Kokar upp godhet snabbare än du hinner säga umami.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069323
    m_Localized: En bubblande legend som lagar mat i warp-hastighet.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263617
    m_Localized: Varmt te på nolltid. Kunderna håller sig lugna och smuttar.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263618
    m_Localized: Häller upp perfekt te och inre frid i ett svep.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263619
    m_Localized: Snabbt skärbräde
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263620
    m_Localized: Ninja-skärbräde
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263621
    m_Localized: Skarpare fiskbräde
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263622
    m_Localized: Sashimi-mästarens bräde
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263623
    m_Localized: Turbo-riskokare
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263624
    m_Localized: Mega-riskokare
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263626
    m_Localized: Snabbt rivjärn
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263627
    m_Localized: Wasabi-virvelvind
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263630
    m_Localized: Snabb sjudgryta
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263631
    m_Localized: Umami-kitteln
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263633
    m_Localized: Snabbryggande tekanna
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263634
    m_Localized: Zenmästarens tekanna
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069317
    m_Localized: En klarblå sushi-banderoll som fångar varje hungrig blick.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069320
    m_Localized: En sval blå noren-ridå som svajar mjukt över ingången.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069321
    m_Localized: En kraftigt röd noren-ridå som välkomnar hungriga gäster vid dörren.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263616
    m_Localized: En mossig stenlykta som ger en känsla av tempelro.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263625
    m_Localized: Sushi-banderoll
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263628
    m_Localized: Blå noren
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263629
    m_Localized: Rött noren
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263632
    m_Localized: Stenhelgedom
    m_Metadata:
      m_Items: []
  - m_Id: 5836103830462464
    m_Localized: Skär färsk fisk i silkeslena sashimiremsor.
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433984
    m_Localized: Gör krispiga grönsaker till prydliga små stavar.
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433985
    m_Localized: River wasabi till en stark grön överraskning.
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433986
    m_Localized: Puttrar buljong till en varm skål av välbehag.
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433987
    m_Localized: Ångkokar ris till fluffigt, klibbigt sushiguld.
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433988
    m_Localized: Bryggar grönt te, lugn i varje klunk.
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433989
    m_Localized: Rivjärn
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433990
    m_Localized: Gryta
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433991
    m_Localized: Riskokare
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433992
    m_Localized: Tekanna
    m_Metadata:
      m_Items: []
  - m_Id: 5867052983115776
    m_Localized: En krämig avokado, Västerlandets favoritgåva till sushi.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053008281600
    m_Localized: Mjuka gröna kuber redo för en rulle.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053008281601
    m_Localized: Silkeslena skivor som draperar riset som en kimono.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475904
    m_Localized: En tom kopp som väntar på ett lugnt slag te.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475905
    m_Localized: Vispat grönt te, lugnt som en trädgård i Kyoto.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475906
    m_Localized: Små gyllene kuber av söt omelett.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475907
    m_Localized: En söt rullad omelett, lagd i lager med tålamod.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475908
    m_Localized: Gyllene skivor av rullat ägg, söta och mjuka.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475909
    m_Localized: En platt vit fisk som sushimästare håller högt.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475910
    m_Localized: Möra flundrakuber för en lätt tugga.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475911
    m_Localized: Fina vita skivor, nästan genomskinliga.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475912
    m_Localized: En glänsande silverfisk full av havets smak.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475913
    m_Localized: Makrill i munsbitar redo för en rulle.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475914
    m_Localized: Blanka skivor med en djärv, fyllig smak.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475915
    m_Localized: En klart orange filé direkt från kalla vatten.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475916
    m_Localized: Laxkuber redo att toppa en liten båt.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475917
    m_Localized: Smöriga laxskivor som smälter på tungan.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475918
    m_Localized: Djupröd tonfisk, fiskmarknadens kung.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475919
    m_Localized: Tonfiskkuber för en djärv, köttig tugga.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475920
    m_Localized: Rubinröda skivor skurna med en mästares kniv.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475921
    m_Localized: En sjögräsbåt fylld med vad gästen än önskar.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475922
    m_Localized: En rulle gjord precis som gästen vill ha den.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475923
    m_Localized: Handpressat ris toppat med gästens favorit.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475924
    m_Localized: En tallrik färska skivor valda efter beställning.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475925
    m_Localized: En klar citron som väcker varje tugga.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475926
    m_Localized: Tunna citronskivor som lyfter fisken.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475927
    m_Localized: Krämig japansk majonnäs med mild syrlighet.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475928
    m_Localized: En rå bläckfisk, bara armar och inga planer.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475929
    m_Localized: Kokt rosa och mör, redo för kniven.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475930
    m_Localized: Små bläckfiskbitar, som takoyaki utan bollen.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475931
    m_Localized: Tunna tako-skivor med seg charm.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475932
    m_Localized: Rundkornigt ris, polerat och redo för sitt bad.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475933
    m_Localized: Fluffigt vinägerris, själen i varje sushi.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475934
    m_Localized: Små orange pärlor som poppar vid varje tugga.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475935
    m_Localized: Krispig flygfiskrom som gnistrar som juveler.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475936
    m_Localized: Stor glänsande laxrom som spricker av havets smak.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475937
    m_Localized: Krispiga rostade sjögräsark, redo att rulla.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475938
    m_Localized: Ett doftande blad som ger en frisk, myntig kick.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475939
    m_Localized: En rå räka ihoprullad som ett litet frågetecken.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475940
    m_Localized: Kokt rosa och stolt, redo för riset.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475941
    m_Localized: Räkor i munsbitar redo för en rulle.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475942
    m_Localized: Uppfläkt som en solfjäder för den perfekta nigirin.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475943
    m_Localized: Gröna teblad plockade på dimmiga sluttningar.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475944
    m_Localized: En knotig rot med ett berömt skarpt humör.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475945
    m_Localized: En grön klick hetta som rensar näsan.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475946
    m_Localized: Färskt vatten, redo att bli te.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475947
    m_Localized: Avokado
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475948
    m_Localized: Tärnad avokado
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475949
    m_Localized: Skivad avokado
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475950
    m_Localized: Kopp
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475951
    m_Localized: Matcha
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475952
    m_Localized: Fiskbräda
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475953
    m_Localized: Grönsaksbräda
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475954
    m_Localized: Tärnad tamagoyaki
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475955
    m_Localized: Tamagoyaki
    m_Metadata:
