  - m_Id: 5867053016670229
    m_Localized: Air
    m_Metadata:
      m_Items: []
  - m_Id: 8069165779771392
    m_Localized: Timun sudah dihiris sebelum ia sedar.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165817520128
    m_Localized: Papan Hiris Samurai
    m_Metadata:
      m_Items: []
  - m_Id: 8069165821714432
    m_Localized: Satu hayunan, sayur cukup untuk satu gulung sempurna.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165825908736
    m_Localized: Papan Katana Legenda
    m_Metadata:
      m_Items: []
  - m_Id: 8069165834297344
    m_Localized: Hirisan selembut sutera sekelip mata. Ikan pun setuju.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165880434688
    m_Localized: Papan Sashimi Agung
    m_Metadata:
      m_Items: []
  - m_Id: 8069165884628992
    m_Localized: Potongan begitu tepat, tukang masak pun terkejut.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165888823296
    m_Localized: Altar Sashimi Legenda
    m_Metadata:
      m_Items: []
  - m_Id: 8069165897211904
    m_Localized: Nasi gebu, siap sebelum mangkuk diletakkan.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165901406208
    m_Localized: Periuk Nasi Turbo
    m_Metadata:
      m_Items: []
  - m_Id: 8069165905600512
    m_Localized: Setiap butir sempurna. Setiap masa.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165913989120
    m_Localized: Kuil Nasi Legenda
    m_Metadata:
      m_Items: []
  - m_Id: 8069165918183424
    m_Localized: Awan hijau pedas, siap dalam sesaat.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165922377728
    m_Localized: Taufan Wasabi
    m_Metadata:
      m_Items: []
  - m_Id: 8069165922377729
    m_Localized: Begitu laju hingga hidung anda gatal dari seberang bilik.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165930766336
    m_Localized: Ribut Wasabi Legenda
    m_Metadata:
      m_Items: []
  - m_Id: 8069165934960640
    m_Localized: Sup mendidih penuh rasa dalam sekelip mata.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165934960641
    m_Localized: Gunung Berapi Umami
    m_Metadata:
      m_Items: []
  - m_Id: 8069166039818240
    m_Localized: Sup paling sedap di bandar, dihidang sepantas kilat.
    m_Metadata:
      m_Items: []
  - m_Id: 8069166039818241
    m_Localized: Periuk Umami Legenda
    m_Metadata:
      m_Items: []
  - m_Id: 8069166044012544
    m_Localized: Membancuh ketenangan dan teh hijau lebih laju daripada sebelumnya.
    m_Metadata:
      m_Items: []
  - m_Id: 8069166044012545
    m_Localized: Teko Tercerah
    m_Metadata:
      m_Items: []
  - m_Id: 8069166044012546
    m_Localized: Teh sempurna sebelum anda sempat menarik nafas dalam.
    m_Metadata:
      m_Items: []
  - m_Id: 8069166044012547
    m_Localized: Teko Zen Legenda
    m_Metadata:
      m_Items: []
