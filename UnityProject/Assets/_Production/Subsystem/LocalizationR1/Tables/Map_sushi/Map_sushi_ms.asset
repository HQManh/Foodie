  m_TableData:
  - m_Id: 57786321854464
    m_Localized: Belon terang menjadikan setiap perkhidmatan sushi terasa meriah.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214592
    m_Localized: Restoran sushi yang asal.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214593
    m_Localized: Restoran lebih besar yang sedia untuk lebih banyak naik taraf sushi.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214594
    m_Localized: Bonsai yang dipangkas kemas dan menambah sentuhan hijau yang menenangkan.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214595
    m_Localized: Papan tanda kapibara yang mesra untuk hadapan kedai.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214596
    m_Localized: Kucing penyambut yang melambai pelanggan masuk.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214597
    m_Localized: Kaunter penuh yang mempamerkan hidangan terbaik restoran.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214598
    m_Localized: Papan pemotong di atas bumbung penuh dengan sushi dan gulungan.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214599
    m_Localized: Bendera dan kanopi berwarna-warni menghiasi fasad restoran.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214600
    m_Localized: Tetamu kitsune yang anggun, memesan sushi dengan gaya teater.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214601
    m_Localized: Kambing biru ini suka matcha dan berlatih adab makan yang ceria.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214602
    m_Localized: Tekun mempelajari menu tetapi tetap menukar makan tengah hari dengan kayu putih.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214603
    m_Localized: Shishi kecil yang berani, mencabar setiap gulungan sushi untuk berlawan.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214604
    m_Localized: Bumbung tradisional yang memberi restoran satu tingkat lagi.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214605
    m_Localized: Shiba yokozuna yang menganggap setiap pinggan sushi seperti perlawanan kejuaraan.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214606
    m_Localized: Bangku selesa untuk tetamu sushi.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214607
    m_Localized: Oyabun serigala bercakap perlahan dan menguasai kaunter sushi dengan satu renungan.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214608
    m_Localized: Belon Pesta
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214609
    m_Localized: Perluasan Sushi
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214610
    m_Localized: Taman Bonsai
    m_Metadata:
      m_Items: []
