  - m_Id: 5867053016670228
    m_Localized: Revet wasabi
    m_Metadata:
      m_Items: []
  - m_Id: 5867053016670229
    m_Localized: Vand
    m_Metadata:
      m_Items: []
  - m_Id: 8069165779771392
    m_Localized: Agurkerne er skåret, før de opdager det.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165817520128
    m_Localized: Samurai-skærebræt
    m_Metadata:
      m_Items: []
  - m_Id: 8069165821714432
    m_Localized: Ét enkelt sving, grøntsager nok til en perfekt rulle.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165825908736
    m_Localized: Legendarisk katanabræt
    m_Metadata:
      m_Items: []
  - m_Id: 8069165834297344
    m_Localized: Silkebløde skiver på et øjeblik. Fiskene godkender.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165880434688
    m_Localized: Stort sashimibræt
    m_Metadata:
      m_Items: []
  - m_Id: 8069165884628992
    m_Localized: Så præcise snit, at selv kokken gisper.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165888823296
    m_Localized: Legendarisk sashimialter
    m_Metadata:
      m_Items: []
  - m_Id: 8069165897211904
    m_Localized: Luftig ris, klar før skålen er sat frem.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165901406208
    m_Localized: Turbo-riskoger
    m_Metadata:
      m_Items: []
  - m_Id: 8069165905600512
    m_Localized: Hvert korn er perfekt. Hver gang.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165913989120
    m_Localized: Legendarisk risalter
    m_Metadata:
      m_Items: []
  - m_Id: 8069165918183424
    m_Localized: Stærke grønne skyer, klar på et sekund.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165922377728
    m_Localized: Wasabi-tyfon
    m_Metadata:
      m_Items: []
  - m_Id: 8069165922377729
    m_Localized: Så hurtig, at næsen kribler helt fra den anden side af rummet.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165930766336
    m_Localized: Legendarisk wasabistorm
    m_Metadata:
      m_Items: []
  - m_Id: 8069165934960640
    m_Localized: Bouillonen bobler op, fuld af smag, på ingen tid.
    m_Metadata:
      m_Items: []
  - m_Id: 8069165934960641
    m_Localized: Umami-vulkan
    m_Metadata:
      m_Items: []
  - m_Id: 8069166039818240
    m_Localized: Byens lækreste suppe, serveret lynhurtigt.
    m_Metadata:
      m_Items: []
  - m_Id: 8069166039818241
    m_Localized: Legendarisk umamigryde
    m_Metadata:
      m_Items: []
  - m_Id: 8069166044012544
    m_Localized: Brygger ro og grøn te hurtigere end nogensinde.
    m_Metadata:
      m_Items: []
  - m_Id: 8069166044012545
    m_Localized: Oplyst tekande
    m_Metadata:
      m_Items: []
  - m_Id: 8069166044012546
    m_Localized: Perfekt te, før du overhovedet har trukket vejret dybt.
    m_Metadata:
      m_Items: []
  - m_Id: 8069166044012547
    m_Localized: Legendarisk zen-tekande
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
