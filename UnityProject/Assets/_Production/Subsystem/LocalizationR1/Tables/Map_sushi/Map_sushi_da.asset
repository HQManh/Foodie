    m_Localized: Shishi-kun
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214620
    m_Localized: Tag på 1. sal
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214621
    m_Localized: Shiba Yokozuna
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214622
    m_Localized: Sushiskamler
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214623
    m_Localized: Ookami Oyabun
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214624
    m_Localized: Nigiri-sushi
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214625
    m_Localized: Håndformet ris med et stykke fisk som et lille tæppe.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214626
    m_Localized: Maki-rulle
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214627
    m_Localized: Rullet stramt i tang og skåret før nogen når at kigge ind.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214628
    m_Localized: Gunkan-sushi
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214629
    m_Localized: En lille tangbåd fyldt med topping helt til kanten.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214630
    m_Localized: Sashimi-tallerken
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214631
    m_Localized: Frisk fisk skåret tyndt uden noget at gemme sig bag.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214632
    m_Localized: Grøn te
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214633
    m_Localized: Varm og rolig og skænket for at skylle wasabien væk.
    m_Metadata:
      m_Items: []
  - m_Id: 2945767655333888
    m_Localized: En imødekommende kat, der vinker kunderne indenfor.
    m_Metadata:
      m_Items: []
  - m_Id: 2945767667916800
    m_Localized: Behagelige skamler til sushigæster.
    m_Metadata:
      m_Items: []
  - m_Id: 2945767667916801
    m_Localized: Lysende papirlygter, der oplyser restauranten.
    m_Metadata:
      m_Items: []
  - m_Id: 2945767667916802
    m_Localized: Et venligt kapivar-skilt til facaden.
    m_Metadata:
      m_Items: []
  - m_Id: 2945767667916803
    m_Localized: Et venligt kapivar-skilt til facaden.
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111104
    m_Localized: En kæmpe tunfisk på taget, der stolt viser dagens friske fangst frem.
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111105
    m_Localized: Et skærebræt på taget fyldt med sushi og ruller.
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111106
    m_Localized: Lykkekat
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111107
    m_Localized: Sushiskamler
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111108
    m_Localized: Papirlygter
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111109
    m_Localized: Kapivar-skilt
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111110
    m_Localized: Kapivar-skilt
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111111
    m_Localized: Kæmpetun
    m_Metadata:
      m_Items: []
  - m_Id: 2945767672111112
    m_Localized: Sushi-skærebræt
    m_Metadata:
      m_Items: []
  - m_Id: 3010516803903488
    m_Localized: Grøntsagerne er hakket, før de når at blinke.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069312
    m_Localized: Knivene er så hurtige, at agurkerne overgiver sig på forhånd.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069313
    m_Localized: Skærer rå fisk med ekstra sashimi-glathed.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069314
    m_Localized: Hvert snit er et kunstværk. Fiskene føler sig beærede.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069315
    m_Localized: Luftigt ris på et øjeblik. Kornene står i kø for at blive kogt.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069316
    m_Localized: Ris så perfekt, at det fortjener stående applaus.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069318
    m_Localized: River wasabi med lynets hast. Tårer er valgfrie.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069319
    m_Localized: River så hurtigt, at wasabien aldrig så det komme.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069322
    m_Localized: Koger godhed hurtigere, end du kan sige umami.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069323
    m_Localized: En boblende legende, der koger i lysets hast.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263617
    m_Localized: Varm te på et øjeblik. Kunderne bevarer roen og nipper.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263618
    m_Localized: Hælder perfekt te og indre fred i ét hug.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263619
    m_Localized: Hurtigt skærebræt
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263620
    m_Localized: Ninja-skærebræt
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263621
    m_Localized: Skarpere fiskebræt
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263622
    m_Localized: Sashimi-mesterbræt
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263623
    m_Localized: Turbo-riskoger
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263624
    m_Localized: Mega-riskoger
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263626
    m_Localized: Hurtigt rivejern
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263627
    m_Localized: Wasabi-hvirvelvind
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263630
    m_Localized: Hurtig kogegryde
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263631
    m_Localized: Umami-kedel
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263633
    m_Localized: Hurtigbryg-tekande
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263634
    m_Localized: Zen-mester-tekande
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069317
    m_Localized: Et klart blåt sushi-banner, der fanger alle sultne øjne.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069320
    m_Localized: Et sejt blåt noren-gardin vajer blidt over indgangen.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516829069321
    m_Localized: Et flot rødt noren-gardin byder sultne gæster velkommen ved døren.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263616
    m_Localized: En mosbevokset stenlanterne, der bringer et strejf af tempelro.
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263625
    m_Localized: Sushi-banner
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263628
    m_Localized: Blåt noren
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263629
    m_Localized: Rødt noren
    m_Metadata:
      m_Items: []
  - m_Id: 3010516833263632
    m_Localized: Stenhelligdom
    m_Metadata:
      m_Items: []
  - m_Id: 5836103830462464
    m_Localized: Skærer frisk fisk i silkebløde sashimi-strimler.
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433984
    m_Localized: Forvandler sprøde grøntsager til pæne små stave.
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433985
    m_Localized: River wasabi til en stærk grøn overraskelse.
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433986
    m_Localized: Simrer bouillon til en varm skål fuld af hygge.
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433987
    m_Localized: Damper ris til luftigt, klæbrigt sushiguld.
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433988
    m_Localized: Brygger grøn te med ro i hver tår.
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433989
    m_Localized: Rivejern
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433990
    m_Localized: Gryde
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433991
    m_Localized: Riskoger
    m_Metadata:
      m_Items: []
  - m_Id: 5836103851433992
    m_Localized: Tekande
    m_Metadata:
      m_Items: []
  - m_Id: 5867052983115776
    m_Localized: En cremet avocado, Vestens yndlingsgave til sushi.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053008281600
    m_Localized: Bløde grønne tern klar til en rulle.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053008281601
    m_Localized: Silkebløde skiver, der ligger over risen som en kimono.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475904
    m_Localized: En tom kop, der venter på en rolig skænk te.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475905
    m_Localized: Pisket grøn te, rolig som en have i Kyoto.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475906
    m_Localized: Små gyldne tern af sød omelet.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475907
    m_Localized: En sød rullet omelet, lagt i lag med tålmodighed.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475908
    m_Localized: Gyldne skiver af rullet æg, søde og bløde.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475909
    m_Localized: En flad hvid fisk, som sushimestre sætter højt.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475910
    m_Localized: Møre terninger af hellefisk til en let bid.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475911
    m_Localized: Fine hvide skiver, næsten gennemsigtige.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475912
    m_Localized: En skinnende sølvfisk fuld af havets smag.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475913
    m_Localized: Mundrette stykker makrel klar til en rulle.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475914
    m_Localized: Blanke skiver med en kraftig, fyldig smag.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475915
    m_Localized: En lysende orange filet direkte fra kolde vande.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475916
    m_Localized: Laksetern klar til at pynte en lille båd.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475917
    m_Localized: Smørbløde lakseskiver, der smelter på tungen.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475918
    m_Localized: Dybrød tun, kongen af fiskemarkedet.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475919
    m_Localized: Tunterninger til en kraftig, kødfuld bid.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475920
    m_Localized: Rubinrøde skiver skåret med en mesters kniv.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475921
    m_Localized: En tangbåd fyldt med lige det, gæsten ønsker.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475922
    m_Localized: En rulle lavet præcis, som gæsten kan lide den.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475923
    m_Localized: Håndpresset ris toppet med gæstens favorit.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475924
    m_Localized: En tallerken friske skiver valgt efter bestilling.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475925
    m_Localized: En frisk citron, der vækker hver bid.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475926
    m_Localized: Tynde citronskiver, der løfter fisken.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475927
    m_Localized: Cremet japansk mayo med en mild syrlighed.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475928
    m_Localized: En rå blæksprutte, masser af arme og ingen planer.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475929
    m_Localized: Kogt lyserød og mør, klar til kniven.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475930
    m_Localized: Små blækspruttebidder, som takoyaki uden kuglen.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475931
    m_Localized: Tynde tako-skiver med en sej charme.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475932
    m_Localized: Kortkornet ris, poleret og klar til sit bad.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475933
    m_Localized: Luftig ris med eddike, sjælen i al sushi.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475934
    m_Localized: Små orange perler, der popper ved hver bid.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475935
    m_Localized: Sprød flyvefiskerogn, der funkler som juveler.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475936
    m_Localized: Store skinnende lakserogn, der springer med havets smag.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475937
    m_Localized: Sprøde ark af tang, ristede og klar til at rulle.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475938
    m_Localized: Et duftende blad, der giver et frisk, mynteagtigt kick.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475939
    m_Localized: En rå reje krøllet sammen som et lille spørgsmålstegn.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475940
    m_Localized: Kogt lyserød og stolt, klar til risen.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475941
    m_Localized: Mundrette rejer klar til en rulle.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475942
    m_Localized: Åbnet fladt som en vifte til den perfekte nigiri.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475943
    m_Localized: Grønne teblade plukket på tågede bjergskråninger.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475944
    m_Localized: En knortet rod med et berømt skarpt temperament.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475945
    m_Localized: En grøn klat varme, der renser næsen.
    m_Metadata:
      m_Items: []
  - m_Id: 5867053012475946
    m_Localized: Frisk vand, klar til at blive til te.
    m_Metadata:
      m_Items: []
