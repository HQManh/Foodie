  m_TableData:
  - m_Id: 57786321854464
    m_Localized: Farverige balloner gør hver sushiservering festlig.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214592
    m_Localized: Den oprindelige sushirestaurant.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214593
    m_Localized: En større restaurant klar til flere sushi-opgraderinger.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214594
    m_Localized: En pænt beskåret bonsai, der tilfører et roligt grønt strejf.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214595
    m_Localized: Et venligt kapivar-skilt til facaden.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214596
    m_Localized: En imødekommende kat, der vinker kunderne indenfor.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214597
    m_Localized: En fyldt disk, der viser restaurantens bedste retter.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214598
    m_Localized: Et skærebræt på taget fyldt med sushi og ruller.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214599
    m_Localized: Farverige flag og markiser pynter restaurantens facade.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214600
    m_Localized: En yndefuld kitsune-gæst, der bestiller sushi med teatralsk elegance.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214601
    m_Localized: Denne blå ged elsker matcha og øver sig i muntre bordmanerer.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214602
    m_Localized: Studerer menuen flittigt, men bytter stadig frokosten væk for eukalyptus.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214603
    m_Localized: En modig lille shishi, der udfordrer hver sushirulle til duel.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214604
    m_Localized: Et traditionelt tag, der giver restauranten en etage mere.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214605
    m_Localized: En shiba-yokozuna, der behandler hvert sushifad som en mesterskabskamp.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214606
    m_Localized: Behagelige skamler til sushigæster.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214607
    m_Localized: Ulve-oyabunen taler blødt og styrer sushidisken med et enkelt blik.
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214608
    m_Localized: Festivalballoner
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214609
    m_Localized: Sushi-udvidelse
    m_Metadata:
      m_Items: []
  - m_Id: 57786351214610
