  m_LocaleId:
    m_Code: hi
  m_SharedData: {fileID: 11400000, guid: f98ead670a214fa419c82916a68f9bfa, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 47151316996
    m_Localized: नमकीन सैंडविच
    m_Metadata:
      m_Items: []
  - m_Id: 47134539776
    m_Localized: टोस्ट ब्रेड, जिस पर ग्रिल से जो भी बचा, सब चढ़ा दिया।
    m_Metadata:
      m_Items: []
  - m_Id: 47151316997
    m_Localized: फ्रूट सैंडविच
    m_Metadata:
      m_Items: []
  - m_Id: 47151316992
    m_Localized: नरम ब्रेड, अंदर क्रीम का बादल और रंग-बिरंगे फल।
    m_Metadata:
      m_Items: []
  - m_Id: 47151316998
    m_Localized: सलाद
    m_Metadata:
      m_Items: []
  - m_Id: 47151316993
    m_Localized: कुरकुरी हरी सब्ज़ियों का कटोरा, थोड़ी-सी मेयो के साथ।
    m_Metadata:
      m_Items: []
  - m_Id: 47151316999
    m_Localized: ताज़ा जूस
    m_Metadata:
      m_Items: []
  - m_Id: 47151316994
    m_Localized: ऑर्डर पर ताज़ा निचोड़ा, बर्फ़ आपकी मर्ज़ी।
    m_Metadata:
      m_Items: []
  - m_Id: 47151317000
    m_Localized: सूप
    m_Metadata:
      m_Items: []
  - m_Id: 47151316995
    m_Localized: गरम, मलाईदार कटोरा, ऊपर से कुछ ख़ास।
    m_Metadata:
      m_Items: []
  - m_Id: 881833574129664
    m_Localized: पैन का इंतज़ार करती कच्ची बेकन स्ट्रिप।
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295488
    m_Localized: सैंडविच के लिए तैयार सख़्त अंडा।
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295489
    m_Localized: ब्रेड को गर्म और सुनहरा सेंकता है।
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295490
    m_Localized: करीने से त्रिकोण में कटी मुलायम ब्रेड।
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295491
    m_Localized: पिघलने वाला सुनहरा चीज़ स्लाइस।
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295492
    m_Localized: कुरकुरी परत का इंतज़ार करता कच्चा चिकन।
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295493
    m_Localized: सुनहरा और कुरकुरा होने तक तला।
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295494
    m_Localized: ठंडा, कुरकुरा हरा खीरा।
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295495
    m_Localized: ताज़े हरे गोल टुकड़े, कुरकुरे बाइट के लिए।
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295496
    m_Localized: हर भराई को काटता और टुकड़े करता है।
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295497
    m_Localized: नाश्ते के लिए तैयार ताज़ा अंडा।
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295498
    m_Localized: मेहमान की पसंद की क्रीम और फल।
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295499
    m_Localized: मेहमान के पसंदीदा फल से निचोड़ा गया।
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295500
    m_Localized: ऑर्डर पर मिलाया ताज़ा सलाद।
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295501
    m_Localized: मेहमान की पसंदीदा भराई से भरा।
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295502
    m_Localized: मेहमान के पसंदीदा स्वाद का गर्म कटोरा।
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295503
    m_Localized: बाहर से सुनहरा कुरकुरा, अंदर से रसीला।
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295504
    m_Localized: सनी साइड अप, परतों के लिए तैयार।
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295505
    m_Localized: अंडे, बेकन और चिकन तलता है।
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295506
    m_Localized: मीठे बैंगनी अंगूरों का गुच्छा।
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295507
    m_Localized: ताज़ा निचोड़ा मीठा बैंगनी जूस।
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295508
    m_Localized: नमकीन हैम का पतला टुकड़ा।
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295509
    m_Localized: खनकती बर्फ़ जो पेय ठंडा रखे।
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295510
    m_Localized: फलों से ताज़ा जूस निकालता है।
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295511
    m_Localized: रोएँदार फल, अंदर से चमकीला हरा।
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295512
    m_Localized: ताज़गी से भरा खट्टा-मीठा हरा जूस।
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295513
    m_Localized: बीजों से सजे हरे कीवी के टुकड़े।
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295514
    m_Localized: ताज़ा कुरकुरा लेट्यूस।
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295515
    m_Localized: हर परत के लिए कुरकुरी हरी पत्तियाँ।
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489792
    m_Localized: धूप से भरा सुनहरा उष्णकटिबंधीय फल।
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489793
    m_Localized: उष्णकटिबंधीय स्वाद वाला गाढ़ा सुनहरा जूस।
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489794
    m_Localized: पके आम के रसीले सुनहरे टुकड़े।
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489795
    m_Localized: मलाईदार सॉस जो सब कुछ जोड़े रखे।
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489796
    m_Localized: मलाईदार पेय के लिए ताज़ा ठंडा दूध।
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489797
    m_Localized: जंगल से आया मोटा-ताज़ा मशरूम।
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489798
    m_Localized: बर्तन के लिए तैयार छोटे मशरूम टुकड़े।
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489799
    m_Localized: मलाईदार और सोंधा, गरमागरम परोसा।
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489800
    m_Localized: डिश को सजाने के लिए ताज़ी हरी टहनी।
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489801
    m_Localized: सूप को गर्म और गाढ़ा होने तक पकाता है।
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489802
    m_Localized: गोल नारंगी कद्दू, अंदर से मीठा।
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489803
    m_Localized: धीमी आँच पर पकने को तैयार नारंगी टुकड़े।
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489804
    m_Localized: मुलायम, मीठा और गर्माहट भरा।
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489805
    m_Localized: हर सैंडविच के लिए मुलायम सफ़ेद स्लाइस।
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489806
    m_Localized: पत्तों की टोपी वाली मीठी लाल बेरी।
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489807
    m_Localized: ताज़ा निचोड़ा मीठा गुलाबी जूस।
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489808
    m_Localized: मीठे सैंडविच के लिए रसीले लाल टुकड़े।
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489809
    m_Localized: मीठे कुरकुरेपन वाले सुनहरे दाने।
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489810
    m_Localized: गर्म, सुनहरी और कुरकुरी।
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489811
    m_Localized: पका लाल टमाटर, रसीला और चमकीला।
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489812
    m_Localized: धीमी आँच पर पकने को तैयार रसीले टुकड़े।
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489813
    m_Localized: हर सैंडविच के लिए रसीले लाल टुकड़े।
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489814
    m_Localized: गाढ़ा लाल सूप, गर्म और सुकून भरा।
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489815
    m_Localized: मीठी क्रीम का हल्का-फुल्का घुमाव।
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489816
    m_Localized: बेकन स्ट्रिप
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489817
    m_Localized: उबला अंडा
    m_Metadata:
      m_Items: []
