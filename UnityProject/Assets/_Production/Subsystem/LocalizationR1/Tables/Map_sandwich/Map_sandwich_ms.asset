  m_LocaleId:
    m_Code: ms
  m_SharedData: {fileID: 11400000, guid: f98ead670a214fa419c82916a68f9bfa, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 47151316996
    m_Localized: Sandwic Masin
    m_Metadata:
      m_Items: []
  - m_Id: 47134539776
    m_Localized: Roti bakar disusun dengan apa sahaja yang ada di gril.
    m_Metadata:
      m_Items: []
  - m_Id: 47151316997
    m_Localized: Sandwic Buah
    m_Metadata:
      m_Items: []
  - m_Id: 47151316992
    m_Localized: Roti lembut berisi awan krim dan buah-buahan berwarna-warni.
    m_Metadata:
      m_Items: []
  - m_Id: 47151316998
    m_Localized: Salad
    m_Metadata:
      m_Items: []
  - m_Id: 47151316993
    m_Localized: Semangkuk sayur rangup dengan sedikit mayones.
    m_Metadata:
      m_Items: []
  - m_Id: 47151316999
    m_Localized: Jus Segar
    m_Metadata:
      m_Items: []
  - m_Id: 47151316994
    m_Localized: Diperah ikut pesanan, ais pilihan.
    m_Metadata:
      m_Items: []
  - m_Id: 47151317000
    m_Localized: Sup
    m_Metadata:
      m_Items: []
  - m_Id: 47151316995
    m_Localized: Semangkuk hangat berkrim dengan sesuatu di atasnya.
    m_Metadata:
      m_Items: []
  - m_Id: 881833574129664
    m_Localized: Bakon mentah menunggu kuali.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295488
    m_Localized: Telur keras sedia untuk sandwic.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295489
    m_Localized: Membakar roti hangat dan keemasan.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295490
    m_Localized: Roti lembut dipotong segi tiga kemas.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295491
    m_Localized: Sekeping keju keemasan yang cair.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295492
    m_Localized: Ayam mentah menunggu salutan rangup.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295493
    m_Localized: Digoreng hingga keemasan dan rangup.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295494
    m_Localized: Timun hijau yang sejuk dan rangup.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295495
    m_Localized: Hirisan hijau segar yang rangup.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295496
    m_Localized: Menghiris dan memotong semua inti.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295497
    m_Localized: Telur segar sedia untuk sarapan.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295498
    m_Localized: Krim dan buah pilihan pelanggan.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295499
    m_Localized: Diperah daripada buah kegemaran pelanggan.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295500
    m_Localized: Semangkuk salad segar ikut pesanan.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295501
    m_Localized: Diisi inti kegemaran pelanggan.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295502
    m_Localized: Semangkuk sup panas perisa kegemaran.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295503
    m_Localized: Rangup keemasan, berjus di dalam.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295504
    m_Localized: Telur mata kerbau sedia disusun.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295505
    m_Localized: Menggoreng telur, bakon dan ayam.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295506
    m_Localized: Setangkai anggur ungu yang manis.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295507
    m_Localized: Jus ungu manis, baru diperah.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295508
    m_Localized: Sekeping nipis ham yang enak.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295509
    m_Localized: Ketulan ais yang menyejukkan minuman.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295510
    m_Localized: Memerah buah menjadi jus segar.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295511
    m_Localized: Buah berbulu dengan isi hijau terang.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295512
    m_Localized: Jus hijau masam manis yang menyegarkan.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295513
    m_Localized: Hirisan kiwi hijau berbintik biji.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295514
    m_Localized: Sebiji salad segar yang rangup.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295515
    m_Localized: Hirisan hijau rangup untuk setiap lapisan.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489792
    m_Localized: Buah tropika keemasan penuh cahaya matahari.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489793
    m_Localized: Jus pekat keemasan berperisa tropika.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489794
    m_Localized: Hirisan mangga masak yang berjus.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489795
    m_Localized: Sos berkrim yang menyatukan semuanya.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489796
    m_Localized: Susu sejuk segar untuk minuman berkrim.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489797
    m_Localized: Cendawan gemuk dari hutan.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489798
    m_Localized: Kiub cendawan kecil sedia untuk periuk.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489799
    m_Localized: Berkrim dan enak, dihidang panas-panas.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489800
    m_Localized: Setangkai daun segar untuk sentuhan akhir.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489801
    m_Localized: Merenih sup hingga panas dan berkhasiat.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489802
    m_Localized: Labu oren bulat yang manis di dalam.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489803
    m_Localized: Kiub oren sedia direneh.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489804
    m_Localized: Lembut, manis dan menghangatkan.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489805
    m_Localized: Kepingan roti putih lembut untuk semua sandwic.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489806
    m_Localized: Beri merah manis bertopi daun.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489807
    m_Localized: Jus merah jambu manis, baru diperah.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489808
    m_Localized: Hirisan merah berjus untuk sandwic manis.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489809
    m_Localized: Biji keemasan yang manis dan rangup.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489810
    m_Localized: Panas, keemasan dan rangup.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489811
    m_Localized: Tomato merah masak yang berjus.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489812
    m_Localized: Kiub merah berjus sedia direneh.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489813
    m_Localized: Hirisan merah berjus untuk setiap sandwic.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489814
    m_Localized: Sup merah pekat yang hangat dan menenangkan.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489815
    m_Localized: Pusaran krim manis yang gebu.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489816
    m_Localized: Jalur Bakon
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489817
    m_Localized: Telur Rebus
    m_Metadata:
      m_Items: []
