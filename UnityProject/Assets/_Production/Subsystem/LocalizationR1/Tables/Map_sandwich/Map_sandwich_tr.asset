  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: Map_sandwich_tr
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: tr
  m_SharedData: {fileID: 11400000, guid: f98ead670a214fa419c82916a68f9bfa, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 47151316996
    m_Localized: Tuzlu sandviç
    m_Metadata:
      m_Items: []
  - m_Id: 47134539776
    m_Localized: Izgaranın verebildiği her şeyle doldurulmuş kızarmış ekmek.
    m_Metadata:
      m_Items: []
  - m_Id: 47151316997
    m_Localized: Meyveli sandviç
    m_Metadata:
      m_Items: []
  - m_Id: 47151316992
    m_Localized: İçinde bir bulut krema ve rengârenk meyveler olan yumuşak ekmek.
    m_Metadata:
      m_Items: []
  - m_Id: 47151316998
    m_Localized: Salata
    m_Metadata:
      m_Items: []
  - m_Id: 47151316993
    m_Localized: Bir parça mayonezli, çıtır yeşilliklerle dolu bir kase.
    m_Metadata:
      m_Items: []
  - m_Id: 47151316999
    m_Localized: Taze meyve suyu
    m_Metadata:
      m_Items: []
  - m_Id: 47151316994
    m_Localized: Siparişe göre sıkılır, buz isteğe bağlı.
    m_Metadata:
      m_Items: []
  - m_Id: 47151317000
    m_Localized: Çorba
    m_Metadata:
      m_Items: []
  - m_Id: 47151316995
    m_Localized: Üstünde bir sürprizle sıcacık, kremalı bir kase.
    m_Metadata:
      m_Items: []
  - m_Id: 881833574129664
    m_Localized: Tavayı bekleyen çiğ pastırma.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295488
    m_Localized: Sandviç için hazır katı yumurta.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295489
    m_Localized: Ekmeği sıcacık ve altın rengi kızartır.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295490
    m_Localized: Düzgün üçgenler halinde yumuşak ekmek.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295491
    m_Localized: Eriyen altın sarısı peynir dilimi.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295492
    m_Localized: Çıtır kaplamasını bekleyen çiğ tavuk.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295493
    m_Localized: Altın rengi ve çıtır olana dek kızartıldı.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295494
    m_Localized: Serin ve çıtır yeşil salatalık.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295495
    m_Localized: Çıtır bir ısırık için taze yeşil dilimler.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295496
    m_Localized: Her malzemeyi dilimler ve doğrar.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295497
    m_Localized: Kahvaltı planları olan taze bir yumurta.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295498
    m_Localized: Misafirin seçtiği krema ve meyve.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295499
    m_Localized: Misafirin en sevdiği meyveden sıkıldı.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295500
    m_Localized: Siparişe göre karıştırılmış taze bir kâse.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295501
    m_Localized: Misafirin sevdiği malzemelerle dolu.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295502
    m_Localized: Misafirin sevdiği tatta sıcak bir kâse.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295503
    m_Localized: Dışı altın sarısı ve çıtır, içi sulu.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295504
    m_Localized: Üst üste koymaya hazır sahanda yumurta.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295505
    m_Localized: Yumurta, pastırma ve tavuk kızartır.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295506
    m_Localized: Bir salkım tatlı mor üzüm.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295507
    m_Localized: Tatlı mor meyve suyu, taze sıkılmış.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295508
    m_Localized: İnce bir dilim lezzetli jambon.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295509
    m_Localized: İçecekleri soğuk tutan şıngırdayan küpler.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295510
    m_Localized: Meyveleri taze suya dönüştürür.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295511
    m_Localized: İçi parlak yeşil, tüylü bir meyve.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295512
    m_Localized: Ferahlık dolu ekşimsi yeşil meyve suyu.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295513
    m_Localized: Çekirdekli yeşil kivi dilimleri.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295514
    m_Localized: Taze ve çıtır bir marul.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295515
    m_Localized: Her kat için çıtır yeşil şeritler.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489792
    m_Localized: Güneş dolu altın sarısı tropik meyve.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489793
    m_Localized: Tropik tatlı koyu, altın sarısı meyve suyu.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489794
    m_Localized: Olgun mangonun sulu dilimleri.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489795
    m_Localized: Her şeyi bir arada tutan kremsi sos.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489796
    m_Localized: Kremsi içecekler için taze soğuk süt.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489797
    m_Localized: Ormandan gelen tombul bir mantar.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489798
    m_Localized: Tencereye hazır küçük mantar küpleri.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489799
    m_Localized: Kremsi ve aromalı, sıcacık servis edilir.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489800
    m_Localized: Yemeği tamamlamak için taze bir dal.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489801
    m_Localized: Çorbaları sıcak ve doyurucu olana dek pişirir.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489802
    m_Localized: İçi tatlı, yuvarlak turuncu balkabağı.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489803
    m_Localized: Pişmeye hazır turuncu küpler.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489804
    m_Localized: Pürüzsüz, tatlı ve içinizi ısıtan.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489805
    m_Localized: Her sandviç için yumuşak beyaz dilimler.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489806
    m_Localized: Yaprak şapkalı tatlı kırmızı çilek.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489807
    m_Localized: Tatlı pembe meyve suyu, taze sıkılmış.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489808
    m_Localized: Tatlı sandviçler için sulu kırmızı dilimler.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489809
    m_Localized: Tatlı bir çıtırlıkla altın taneler.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489810
    m_Localized: Sıcacık, altın rengi ve çıtır.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489811
    m_Localized: Olgun kırmızı domates, sulu ve parlak.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489812
    m_Localized: Pişmeye hazır sulu kırmızı küpler.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489813
    m_Localized: Her sandviç için sulu kırmızı dilimler.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489814
    m_Localized: Yoğun kırmızı çorba, sıcak ve içinizi rahatlatan.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489815
    m_Localized: Yumuşacık bir tatlı krema kıvrımı.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489816
    m_Localized: Pastırma dilimi
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489817
    m_Localized: Haşlanmış yumurta
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489818
    m_Localized: Ekmek kızartma makinesi
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489819
    m_Localized: Üçgen ekmek
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489820
    m_Localized: Peynir dilimi
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489821
