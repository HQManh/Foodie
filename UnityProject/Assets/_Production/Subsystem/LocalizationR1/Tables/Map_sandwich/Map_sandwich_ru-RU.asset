  m_LocaleId:
    m_Code: ru-RU
  m_SharedData: {fileID: 11400000, guid: f98ead670a214fa419c82916a68f9bfa, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 47151316996
    m_Localized: Сытный сэндвич
    m_Metadata:
      m_Items: []
  - m_Id: 47134539776
    m_Localized: Поджаренный хлеб со всем, чем только смог поделиться гриль.
    m_Metadata:
      m_Items: []
  - m_Id: 47151316997
    m_Localized: Фруктовый сэндвич
    m_Metadata:
      m_Items: []
  - m_Id: 47151316992
    m_Localized: Мягкий хлеб, а внутри облако крема и яркие фрукты.
    m_Metadata:
      m_Items: []
  - m_Id: 47151316998
    m_Localized: Салат
    m_Metadata:
      m_Items: []
  - m_Id: 47151316993
    m_Localized: Хрустящая миска зелени с капелькой майонеза.
    m_Metadata:
      m_Items: []
  - m_Id: 47151316999
    m_Localized: Свежевыжатый сок
    m_Metadata:
      m_Items: []
  - m_Id: 47151316994
    m_Localized: Выжат по заказу, лёд по желанию.
    m_Metadata:
      m_Items: []
  - m_Id: 47151317000
    m_Localized: Суп
    m_Metadata:
      m_Items: []
  - m_Id: 47151316995
    m_Localized: Тёплый сливочный суп с чем-то вкусным сверху.
    m_Metadata:
      m_Items: []
  - m_Id: 881833574129664
    m_Localized: Сырой бекон ждёт сковородку.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295488
    m_Localized: Крутое яйцо для сэндвичей.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295489
    m_Localized: Поджаривает хлеб до золотистой корочки.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295490
    m_Localized: Мягкий хлеб, нарезанный треугольниками.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295491
    m_Localized: Тающий ломтик золотистого сыра.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295492
    m_Localized: Сырая курица ждёт хрустящей панировки.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295493
    m_Localized: Обжарен до золотистой хрустящей корочки.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295494
    m_Localized: Прохладный хрустящий огурец.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295495
    m_Localized: Свежие хрустящие кружочки.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295496
    m_Localized: Режет и шинкует любую начинку.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295497
    m_Localized: Свежее яйцо с планами на завтрак.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295498
    m_Localized: Сливки и фрукты на выбор гостя.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295499
    m_Localized: Выжат из любимого фрукта гостя.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295500
    m_Localized: Свежий салат, смешанный на заказ.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295501
    m_Localized: С любимой начинкой гостя.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295502
    m_Localized: Горячая тарелка любимого супа гостя.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295503
    m_Localized: Хрустящая снаружи, сочная внутри.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295504
    m_Localized: Глазунья, готовая в бутерброд.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295505
    m_Localized: Жарит яйца, бекон и курицу.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295506
    m_Localized: Гроздь сладкого фиолетового винограда.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295507
    m_Localized: Сладкий фиолетовый сок, только выжатый.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295508
    m_Localized: Тонкий ломтик ароматной ветчины.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295509
    m_Localized: Звонкие кубики для холодных напитков.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295510
    m_Localized: Выжимает из фруктов свежий сок.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295511
    m_Localized: Пушистый фрукт с ярко-зелёной серединкой.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295512
    m_Localized: Кисло-сладкий зелёный сок, полный бодрости.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295513
    m_Localized: Зелёные кружочки киви с семечками.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295514
    m_Localized: Хрустящий кочан свежего салата.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295515
    m_Localized: Хрустящие полоски для каждого слоя.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489792
    m_Localized: Золотистый тропический фрукт, полный солнца.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489793
    m_Localized: Густой золотистый сок с тропическим вкусом.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489794
    m_Localized: Сочные ломтики спелого манго.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489795
    m_Localized: Нежный соус, который всё объединяет.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489796
    m_Localized: Свежее холодное молоко для сливочных напитков.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489797
    m_Localized: Пухлый гриб из леса.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489798
    m_Localized: Мелкие кубики грибов для кастрюли.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489799
    m_Localized: Сливочный и ароматный, подаётся горячим.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489800
    m_Localized: Свежая веточка, чтобы украсить блюдо.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489801
    m_Localized: Варит супы до сытной густоты.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489802
    m_Localized: Круглая оранжевая тыква, сладкая внутри.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489803
    m_Localized: Оранжевые кубики, готовые к варке.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489804
    m_Localized: Нежный, сладкий и согревающий.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489805
    m_Localized: Мягкие белые ломтики для любого сэндвича.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489806
    m_Localized: Сладкая ягода в зелёной шапочке.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489807
    m_Localized: Сладкий розовый сок, только выжатый.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489808
    m_Localized: Сочные ломтики для сладких сэндвичей.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489809
    m_Localized: Золотистые зёрна со сладким хрустом.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489810
    m_Localized: Тёплый, золотистый и хрустящий.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489811
    m_Localized: Спелый красный помидор, сочный и яркий.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489812
    m_Localized: Сочные кубики, готовые к варке.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489813
    m_Localized: Сочные кружочки для любого сэндвича.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489814
    m_Localized: Насыщенный красный суп, тёплый и уютный.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489815
    m_Localized: Пышный завиток сладких сливок.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489816
    m_Localized: Ломтик бекона
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489817
    m_Localized: Варёное яйцо
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489818
    m_Localized: Тостер
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489819
    m_Localized: Хлебный треугольник
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489820
    m_Localized: Ломтик сыра
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489821
    m_Localized: Куриная грудка
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489822
    m_Localized: Хрустящий бекон
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489823
    m_Localized: Огурец
    m_Metadata:
