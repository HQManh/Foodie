  m_SharedData: {fileID: 11400000, guid: f98ead670a214fa419c82916a68f9bfa, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 47151316996
    m_Localized: Sandviș sărat
    m_Metadata:
      m_Items: []
  - m_Id: 47134539776
    m_Localized: Pâine prăjită încărcată cu tot ce a putut oferi grătarul.
    m_Metadata:
      m_Items: []
  - m_Id: 47151316997
    m_Localized: Sandviș cu fructe
    m_Metadata:
      m_Items: []
  - m_Id: 47151316992
    m_Localized: Pâine moale, cu un nor de frișcă și fructe colorate înăuntru.
    m_Metadata:
      m_Items: []
  - m_Id: 47151316998
    m_Localized: Salată
    m_Metadata:
      m_Items: []
  - m_Id: 47151316993
    m_Localized: Un bol de verdețuri crocante cu un strop de maioneză.
    m_Metadata:
      m_Items: []
  - m_Id: 47151316999
    m_Localized: Suc proaspăt
    m_Metadata:
      m_Items: []
  - m_Id: 47151316994
    m_Localized: Stors la comandă, gheața e opțională.
    m_Metadata:
      m_Items: []
  - m_Id: 47151317000
    m_Localized: Supă
    m_Metadata:
      m_Items: []
  - m_Id: 47151316995
    m_Localized: Un bol cald și cremos, cu ceva deasupra.
    m_Metadata:
      m_Items: []
  - m_Id: 881833574129664
    m_Localized: Bacon crud care așteaptă tigaia.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295488
    m_Localized: Un ou tare, gata de sandviș.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295489
    m_Localized: Prăjește pâinea caldă și aurie.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295490
    m_Localized: Pâine moale tăiată în triunghiuri.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295491
    m_Localized: O felie de brânză aurie care se topește.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295492
    m_Localized: Pui crud care așteaptă crusta crocantă.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295493
    m_Localized: Prăjit până devine auriu și crocant.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295494
    m_Localized: Un castravete răcoros și crocant.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295495
    m_Localized: Rondele verzi proaspete și crocante.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295496
    m_Localized: Taie felii și cubulețe orice umplutură.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295497
    m_Localized: Un ou proaspăt, gata pentru micul dejun.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295498
    m_Localized: Frișcă și fructe alese de client.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295499
    m_Localized: Stors din fructul preferat al clientului.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295500
    m_Localized: Un bol proaspăt amestecat la comandă.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295501
    m_Localized: Umplut cu ingredientele preferate.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295502
    m_Localized: Un bol cald cu aroma preferată.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295503
    m_Localized: Auriu și crocant, suculent înăuntru.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295504
    m_Localized: Un ou ochi gata de pus în sandviș.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295505
    m_Localized: Prăjește ouă, bacon și pui.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295506
    m_Localized: Un ciorchine de struguri dulci.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295507
    m_Localized: Suc violet și dulce, proaspăt stors.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295508
    m_Localized: O felie subțire de șuncă gustoasă.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295509
    m_Localized: Cuburi care țin băuturile reci.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295510
    m_Localized: Stoarce fructele în suc proaspăt.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295511
    m_Localized: Un fruct pufos cu miez verde aprins.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295512
    m_Localized: Suc verde acrișor plin de energie.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295513
    m_Localized: Rondele verzi presărate cu semințe.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295514
    m_Localized: O salată verde proaspătă și crocantă.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295515
    m_Localized: Fâșii crocante pentru fiecare strat.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489792
    m_Localized: Un fruct tropical auriu, plin de soare.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489793
    m_Localized: Suc auriu și dens cu gust tropical.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489794
    m_Localized: Felii zemoase de mango copt.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489795
    m_Localized: Sos cremos care le leagă pe toate.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489796
    m_Localized: Lapte proaspăt pentru băuturi cremoase.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489797
    m_Localized: O ciupercă dolofană din pădure.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489798
    m_Localized: Cubulețe de ciuperci gata de oală.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489799
    m_Localized: Cremoasă și aromată, servită fierbinte.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489800
    m_Localized: O crenguță verde pentru final.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489801
    m_Localized: Fierbe supe calde și consistente.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489802
    m_Localized: Un dovleac rotund, dulce pe dinăuntru.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489803
    m_Localized: Cubulețe portocalii gata de fiert.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489804
    m_Localized: Catifelată, dulce și încălzitoare.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489805
    m_Localized: Felii albe și moi pentru orice sandviș.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489806
    m_Localized: O căpșună dulce cu pălărie de frunze.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489807
    m_Localized: Suc roz și dulce, proaspăt stors.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489808
    m_Localized: Felii zemoase pentru sandvișuri dulci.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489809
    m_Localized: Boabe aurii, dulci și crocante.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489810
    m_Localized: Cald, auriu și crocant.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489811
    m_Localized: O roșie coaptă, zemoasă și lucioasă.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489812
    m_Localized: Cubulețe zemoase gata de fiert.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489813
    m_Localized: Rondele zemoase pentru orice sandviș.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489814
    m_Localized: Supă roșie, caldă și reconfortantă.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489815
    m_Localized: Un vârtej pufos de frișcă dulce.
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489816
    m_Localized: Felie de bacon
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489817
    m_Localized: Ou fiert
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489818
    m_Localized: Prăjitor de pâine
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489819
    m_Localized: Triunghi de pâine
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489820
    m_Localized: Felie de brânză
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489821
    m_Localized: Piept de pui
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489822
    m_Localized: Bacon crocant
    m_Metadata:
