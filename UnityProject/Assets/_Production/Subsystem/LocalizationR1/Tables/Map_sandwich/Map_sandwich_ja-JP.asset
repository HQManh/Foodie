  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Map_sandwich_ja-JP
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: ja-JP
  m_SharedData: {fileID: 11400000, guid: f98ead670a214fa419c82916a68f9bfa, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 47151316996
    m_Localized: おかずサンド
    m_Metadata:
      m_Items: []
  - m_Id: 47134539776
    m_Localized: トーストしたパンに、グリルで焼けたものをどっさり挟んで。
    m_Metadata:
      m_Items: []
  - m_Id: 47151316997
    m_Localized: フルーツサンド
    m_Metadata:
      m_Items: []
  - m_Id: 47151316992
    m_Localized: ふわふわのパンに、雲みたいなクリームと色鮮やかなフルーツ。
    m_Metadata:
      m_Items: []
  - m_Id: 47151316998
    m_Localized: サラダ
    m_Metadata:
      m_Items: []
  - m_Id: 47151316993
    m_Localized: シャキシャキの葉野菜に、マヨをちょこんと。
    m_Metadata:
      m_Items: []
  - m_Id: 47151316999
    m_Localized: フレッシュジュース
    m_Metadata:
      m_Items: []
  - m_Id: 47151316994
    m_Localized: 注文を受けてから搾りたて。氷はお好みで。
    m_Metadata:
      m_Items: []
  - m_Id: 47151317000
    m_Localized: スープ
    m_Metadata:
      m_Items: []
  - m_Id: 47151316995
    m_Localized: あったかクリーミーな一杯に、ちょっとしたトッピングを。
    m_Metadata:
      m_Items: []
  - m_Id: 881833574129664
    m_Localized: フライパンを待つ生ベーコン。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295488
    m_Localized: サンドイッチ用のしっかりゆで卵。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295489
    m_Localized: パンをあったかきつね色に焼き上げ。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295490
    m_Localized: きれいな三角に切ったふんわりパン。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295491
    m_Localized: とろけるきつね色のチーズ。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295492
    m_Localized: サクサク衣を待つ生の鶏肉。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295493
    m_Localized: きつね色でカリカリに焼き上げ。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295494
    m_Localized: ひんやりパリッとしたきゅうり。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295495
    m_Localized: パリッと食感のフレッシュな輪切り。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295496
    m_Localized: 具材をスライスも角切りもおまかせ。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295497
    m_Localized: 朝ごはんを夢見る新鮮な卵。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295498
    m_Localized: クリームとフルーツはお客さんのお好みで。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295499
    m_Localized: お客さんの好きなフルーツをしぼって。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295500
    m_Localized: 注文を受けて和えるフレッシュサラダ。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295501
    m_Localized: お客さんの好きな具材をたっぷり挟んで。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295502
    m_Localized: お客さんの好きな味のあったかスープ。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295503
    m_Localized: 外はカリッと、中はジューシー。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295504
    m_Localized: 重ねる準備OKの目玉焼き。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295505
    m_Localized: 卵もベーコンもチキンも焼き上げ。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295506
    m_Localized: 甘い紫ぶどうのひと房。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295507
    m_Localized: しぼりたての甘い紫ジュース。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295508
    m_Localized: うま味たっぷりの薄切りハム。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295509
    m_Localized: カランと鳴ってドリンクひんやり。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295510
    m_Localized: フルーツをしぼってフレッシュジュースに。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295511
    m_Localized: 中は鮮やかな緑のふわふわ果実。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295512
    m_Localized: 甘酸っぱくて元気が出る緑のジュース。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295513
    m_Localized: 種のつぶつぶが並ぶ緑の輪切り。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295514
    m_Localized: シャキシャキの新鮮レタス。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295515
    m_Localized: どの層にも欠かせないシャキシャキ千切り。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489792
    m_Localized: 太陽をいっぱい浴びた黄金の南国フルーツ。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489793
    m_Localized: 南国の味がする濃厚な黄金ジュース。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489794
    m_Localized: 完熟マンゴーのジューシーなスライス。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489795
    m_Localized: 全部をまとめるクリーミーなソース。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489796
    m_Localized: クリーミーなドリンク用の冷たい牛乳。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489797
    m_Localized: 森から来たぷっくりきのこ。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489798
    m_Localized: 鍋に入れる準備OKの角切りきのこ。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489799
    m_Localized: クリーミーで香り高い、熱々スープ。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489800
    m_Localized: 仕上げに添えるフレッシュな緑。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489801
    m_Localized: スープをコトコト、ほっこり濃厚に。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489802
    m_Localized: 中まで甘いまんまるかぼちゃ。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489803
    m_Localized: コトコト煮込む準備OKのかぼちゃ。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489804
    m_Localized: なめらかで甘く、心まで温まる。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489805
    m_Localized: どんなサンドにも合うふわふわ食パン。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489806
    m_Localized: 葉っぱの帽子をかぶった甘いいちご。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489807
    m_Localized: しぼりたての甘いピンクジュース。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489808
    m_Localized: 甘いサンド用のジューシーないちご。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489809
    m_Localized: 甘くてプチッとはじける黄金のつぶ。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489810
    m_Localized: あったかくてきつね色、サクサク。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489811
    m_Localized: 真っ赤に熟したジューシーなトマト。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489812
    m_Localized: コトコト煮込む準備OKの角切りトマト。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489813
    m_Localized: どのサンドにも合うジューシーな輪切り。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489814
    m_Localized: コクのある赤いスープ、ほっとする味。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489815
    m_Localized: ふわふわの甘いホイップ。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489816
    m_Localized: ベーコン
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489817
    m_Localized: ゆで卵
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489818
    m_Localized: トースター
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489819
    m_Localized: 三角パン
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489820
    m_Localized: スライスチーズ
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489821
    m_Localized: 鶏むね肉
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489822
    m_Localized: カリカリベーコン
    m_Metadata:
