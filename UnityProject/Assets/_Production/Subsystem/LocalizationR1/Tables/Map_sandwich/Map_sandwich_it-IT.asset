    m_Metadata:
      m_Items: []
  - m_Id: 47151317000
    m_Localized: Zuppa
    m_Metadata:
      m_Items: []
  - m_Id: 47151316995
    m_Localized: Una ciotola calda e cremosa con qualcosa sopra.
    m_Metadata:
      m_Items: []
  - m_Id: 881833574129664
    m_Localized: Bacon crudo in attesa della padella.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295488
    m_Localized: Un uovo sodo pronto per i panini.
    m_Metadata:
      m_Items: []
