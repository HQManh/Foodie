    m_Localized: Panna e frutta scelte dal cliente.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295499
    m_Localized: Spremuto dal frutto preferito del cliente.
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295500
    m_Localized: Una ciotola fresca condita al momento.
    m_Metadata:
      m_Items: []
