    m_Localized: Pane morbido con una nuvola di panna e frutta colorata.
    m_Metadata:
      m_Items: []
  - m_Id: 47151316998
    m_Localized: Insalata
    m_Metadata:
      m_Items: []
  - m_Id: 47151316993
    m_Localized: Una ciotola di verdure croccanti con un tocco di maionese.
    m_Metadata:
      m_Items: []
  - m_Id: 47151316999
    m_Localized: Succo fresco
    m_Metadata:
      m_Items: []
