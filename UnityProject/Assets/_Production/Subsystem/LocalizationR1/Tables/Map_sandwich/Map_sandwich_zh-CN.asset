  m_Name: Map_sandwich_zh-CN
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: zh-CN
  m_SharedData: {fileID: 11400000, guid: f98ead670a214fa419c82916a68f9bfa, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 47151316996
    m_Localized: 咸味三明治
    m_Metadata:
      m_Items: []
  - m_Id: 47134539776
    m_Localized: 烤面包里叠满了烤架上剩下的好料。
    m_Metadata:
      m_Items: []
  - m_Id: 47151316997
    m_Localized: 水果三明治
    m_Metadata:
      m_Items: []
  - m_Id: 47151316992
    m_Localized: 松软的面包，夹着云朵般的奶油和鲜亮的水果。
    m_Metadata:
      m_Items: []
  - m_Id: 47151316998
    m_Localized: 沙拉
    m_Metadata:
      m_Items: []
  - m_Id: 47151316993
    m_Localized: 一碗爽脆的青菜，点上一抹蛋黄酱。
    m_Metadata:
      m_Items: []
  - m_Id: 47151316999
    m_Localized: 鲜榨果汁
    m_Metadata:
      m_Items: []
  - m_Id: 47151316994
    m_Localized: 现点现榨，加不加冰随你。
    m_Metadata:
      m_Items: []
  - m_Id: 47151317000
    m_Localized: 汤
    m_Metadata:
      m_Items: []
  - m_Id: 47151316995
    m_Localized: 一碗温热浓稠的汤，上面还点缀着小惊喜。
    m_Metadata:
      m_Items: []
  - m_Id: 881833574129664
    m_Localized: 等着下锅的生培根条。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295488
    m_Localized: 煮得刚好的鸡蛋，夹进三明治。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295489
    m_Localized: 把面包烤得温热金黄。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295490
    m_Localized: 切成整齐三角形的松软面包。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295491
    m_Localized: 一片会融化的金黄芝士。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295492
    m_Localized: 等着裹上脆衣的生鸡肉。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295493
    m_Localized: 煎到金黄酥脆的培根。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295494
    m_Localized: 清凉爽脆的绿黄瓜。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295495
    m_Localized: 新鲜的绿色黄瓜片，口感爽脆。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295496
    m_Localized: 切片切丁，所有馅料都靠它。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295497
    m_Localized: 准备好做早餐的新鲜鸡蛋。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295498
    m_Localized: 奶油和水果都由客人挑选。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295499
    m_Localized: 用客人最爱的水果现榨。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295500
    m_Localized: 按客人点单现拌的新鲜沙拉。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295501
    m_Localized: 夹满客人最爱馅料的三明治。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295502
    m_Localized: 客人最爱口味的一碗热汤。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295503
    m_Localized: 外皮金黄酥脆，里面鲜嫩多汁。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295504
    m_Localized: 单面煎的荷包蛋，准备叠上去。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295505
    m_Localized: 煎蛋、煎培根、炸鸡都靠它。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295506
    m_Localized: 一串香甜的紫葡萄。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295507
    m_Localized: 现榨的香甜紫色葡萄汁。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295508
    m_Localized: 一片薄薄的咸香火腿。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295509
    m_Localized: 叮当作响，让饮料保持冰凉。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295510
    m_Localized: 把水果榨成新鲜果汁。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295511
    m_Localized: 毛茸茸的果子，藏着亮绿果心。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295512
    m_Localized: 酸酸甜甜、充满活力的绿色果汁。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295513
    m_Localized: 点缀着黑籽的绿色猕猴桃片。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295514
    m_Localized: 一颗新鲜爽脆的生菜。
    m_Metadata:
      m_Items: []
  - m_Id: 881833599295515
    m_Localized: 每一层都少不了的爽脆生菜丝。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489792
    m_Localized: 充满阳光的金黄热带水果。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489793
    m_Localized: 浓郁的金黄热带芒果汁。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489794
    m_Localized: 熟透多汁的金黄芒果片。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489795
    m_Localized: 把一切都粘在一起的顺滑酱。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489796
    m_Localized: 冰凉新鲜的牛奶，做出绵密饮品。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489797
    m_Localized: 来自森林的肥嫩蘑菇。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489798
    m_Localized: 切成小丁的蘑菇，准备下锅。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489799
    m_Localized: 香浓绵滑，热气腾腾。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489800
    m_Localized: 一小枝新鲜欧芹，为菜品收尾。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489801
    m_Localized: 把汤慢慢炖到暖心又浓郁。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489802
    m_Localized: 圆滚滚的橙色南瓜，里面甜甜的。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489803
    m_Localized: 准备慢炖的南瓜丁。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489804
    m_Localized: 顺滑香甜，暖到心里。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489805
    m_Localized: 适合做任何三明治的松软白面包片。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489806
    m_Localized: 戴着绿叶小帽的香甜草莓。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489807
    m_Localized: 现榨的香甜粉色草莓汁。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489808
    m_Localized: 夹进甜味三明治的多汁草莓片。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489809
    m_Localized: 金黄香甜、颗颗脆口的玉米粒。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489810
    m_Localized: 温热金黄，咬一口咔嚓脆。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489811
    m_Localized: 熟透鲜红、多汁亮眼的番茄。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489812
    m_Localized: 准备慢炖的多汁番茄丁。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489813
    m_Localized: 每个三明治都少不了的番茄片。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489814
    m_Localized: 浓郁温暖，满满幸福感。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489815
    m_Localized: 一圈绵软香甜的鲜奶油。
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489816
    m_Localized: 培根条
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489817
    m_Localized: 水煮蛋
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489818
    m_Localized: 烤面包机
    m_Metadata:
      m_Items: []
  - m_Id: 881833603489819
    m_Localized: 三角面包
    m_Metadata:
      m_Items: []
