  m_TableData:
  - m_Id: 57797273182208
    m_Localized: Todos los corazones rotos
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542336
    m_Localized: Tan bueno como siempre
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542337
    m_Localized: No se pueden coger ingredientes congelados. Coge un objeto cercano para romper el hielo.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542338
    m_Localized: Reclamar
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542339
    m_Localized: Encuentra la llave en las filas de ingredientes para desbloquear.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542340
