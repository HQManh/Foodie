      m_Items: []
  - m_Id: 57797302542367
    m_Localized: Perfecto
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542368
    m_Localized: Coge juntos los espacios vinculados cuando todos lleguen al frente.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542369
    m_Localized: ¿Salir del día?
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542370
    m_Localized: REINTENTAR
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542371
    m_Localized: Atiende a varios clientes para romper el bloque de hielo de la mesa.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542372
    m_Localized: Algo salió mal. ¡Inténtalo de nuevo!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542373
    m_Localized: Sonido
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542374
    m_Localized: ¡DÍA SUPERDIFÍCIL!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542375
