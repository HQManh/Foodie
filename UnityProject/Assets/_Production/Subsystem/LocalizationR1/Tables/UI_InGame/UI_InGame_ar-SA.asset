MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: UI_InGame_ar-SA
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: ar-SA
  m_SharedData: {fileID: 11400000, guid: a34c71713b2ebf445aa5dfcbb87e843e, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 57797273182208
    m_Localized: تحطمت كل القلوب
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542336
    m_Localized: جيد كالعادة
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542337
    m_Localized: لا يمكن التقاط المكونات المجمدة. التقط عنصرًا مجاورًا لكسر الجليد.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542338
    m_Localized: استلام
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542339
    m_Localized: ابحث عن المفتاح في صفوف المكونات لفتح القفل.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542340
    m_Localized: انفجار النكهة
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542341
    m_Localized: حزمة طعام
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542342
    m_Localized: مجانًا
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542343
    m_Localized: عنصر مجمد
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542344
    m_Localized: فهمت!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542345
    m_Localized: يوم صعب!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542346
    m_Localized: مرحبًا، سعيد بلقائك
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542347
    m_Localized: عنصر مخفي
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542348
    m_Localized: لا تنكشف العناصر المخفية إلا عند وصولها إلى الصف العلوي.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542349
    m_Localized: اضغط مطولًا لرؤية الخريطة
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542350
    m_Localized: اضغط مطولًا للعرض
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542351
    m_Localized: الرئيسية
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542352
    m_Localized: كتلة جليد
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542353
    m_Localized: نفدت المكونات!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542354
    m_Localized: مغادرة
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542355
    m_Localized: لنبدأ العمل!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542356
    m_Localized: عناصر مرتبطة
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542357
    m_Localized: القفل والمفتاح
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542358
    m_Localized: الموسيقى
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542359
    m_Localized: معزز جديد
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542360
    m_Localized: مكوّن جديد
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542361
    m_Localized: حسنًا
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542362
    m_Localized: عذرًا؟!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542363
    m_Localized: نفدت الحركات
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542364
    m_Localized: نفد الصبر
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542365
    m_Localized: لا خانات متبقية
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542366
    m_Localized: متوقف مؤقتًا
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542367
    m_Localized: ممتاز
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542368
    m_Localized: التقط الخانات المرتبطة معًا عندما تصل جميعها إلى المقدمة.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542369
    m_Localized: الخروج من اليوم؟
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542370
    m_Localized: إعادة
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542371
    m_Localized: اخدم عددًا من الزبائن لكسر كتلة الجليد على الطاولة.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542372
    m_Localized: حدث خطأ ما. حاول مرة أخرى!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542373
    m_Localized: الصوت
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542374
    m_Localized: يوم صعب جدًا!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542375
    m_Localized: انقر للمتابعة
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542376
    m_Localized: انقر للعب
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542377
    m_Localized: النكهة تتصاعد
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542378
    m_Localized: هذه الأطعمة تتحرك وتُلتقط معًا ككتلة واحدة.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542379
    m_Localized: ملقط
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542380
    m_Localized: الاهتزاز
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542381
    m_Localized: مشاهدة
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542382
    m_Localized: ستخسر قلبًا واحدًا!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542383
    m_Localized: ظهر الزعيم!
    m_Metadata:
      m_Items: []
  - m_Id: 791119221743616
    m_Localized: ظهر الزعيم
    m_Metadata:
      m_Items: []
  - m_Id: 791119234326528
    m_Localized: لا خانات متبقية!
    m_Metadata:
      m_Items: []
  - m_Id: 5836114773401600
    m_Localized: مربع متجمد
    m_Metadata:
      m_Items: []
  - m_Id: 5836114806956032
    m_Localized: ميزة جديدة
    m_Metadata:
      m_Items: []
  - m_Id: 5838819617136640
    m_Localized: مطعم جديد
    m_Metadata:
      m_Items: []
  - m_Id: 5838819617136641
    m_Localized: مطعم جديد قادم قريبًا!
    m_Metadata:
      m_Items: []
  - m_Id: 7340303286525952
    m_Localized: أحسنت!
    m_Metadata:
      m_Items: []
  - m_Id: 7340303307497472
    m_Localized: لم تنجح!
    m_Metadata:
      m_Items: []
  - m_Id: 7542428218155008
    m_Localized: عمل مذهل!
    m_Metadata:
      m_Items: []
  - m_Id: 7542428239126528
    m_Localized: أسطوري!
    m_Metadata:
      m_Items: []
  - m_Id: 7542428243320832
    m_Localized: صعبة جدًا!
    m_Metadata:
      m_Items: []
  - m_Id: 7542428243320833
    m_Localized: فوضى في المطبخ!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
