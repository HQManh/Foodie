  m_SharedData: {fileID: 11400000, guid: a34c71713b2ebf445aa5dfcbb87e843e, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 57797273182208
    m_Localized: Minden szív összetört
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542336
    m_Localized: Jó, mint mindig
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542337
    m_Localized: Fagyott hozzávalót nem vehetsz fel. Vegyél fel egy mellette lévő elemet a jég feltöréséhez.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542338
    m_Localized: Átvétel
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542339
    m_Localized: Keresd meg a kulcsot valahol a hozzávalósorokban a nyitáshoz.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542340
    m_Localized: Ízrobbanás
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542341
    m_Localized: Ételcsomag
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542342
    m_Localized: INGYEN
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542343
    m_Localized: Fagyott elem
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542344
    m_Localized: Értem!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542345
    m_Localized: NEHÉZ NAP!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542346
    m_Localized: Szia, örülök, hogy megismerhetlek
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542347
    m_Localized: Rejtett elem
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542348
    m_Localized: A rejtett elemek csak a felső sorba érve látszanak.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542349
    m_Localized: Tartsd a térkép megtekintéséhez
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542350
    m_Localized: Tartsd a megtekintéshez
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542351
    m_Localized: KEZDŐLAP
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542352
    m_Localized: Jégtömb
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542353
    m_Localized: Elfogytak a hozzávalók!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542354
    m_Localized: Kilépés
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542355
    m_Localized: Kezdjük az üzletet!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542356
    m_Localized: Összekapcsolt elemek
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542357
    m_Localized: Zár és kulcs
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542358
    m_Localized: Zene
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542359
    m_Localized: Új erősítő
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542360
    m_Localized: Új hozzávaló
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542361
    m_Localized: OK
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542362
    m_Localized: Hoppá?!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542363
    m_Localized: Elfogytak a lépések
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542364
    m_Localized: Elfogyott a türelem
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542365
    m_Localized: Nincs több hely
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542366
    m_Localized: Szünet
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542367
    m_Localized: Tökéletes
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542368
    m_Localized: Az összekapcsolt helyeket együtt vedd fel, amikor mind előre értek.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542369
    m_Localized: Kilépsz a napból?
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542370
    m_Localized: ÚJRA
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542371
    m_Localized: Szolgálj ki néhány vendéget, hogy feltörd a jégtömböt az asztalon.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542372
    m_Localized: Valami hiba történt. Próbáld újra!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542373
    m_Localized: Hang
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542374
    m_Localized: SZUPER NEHÉZ NAP!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542375
    m_Localized: Koppints a folytatáshoz
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542376
    m_Localized: Koppints a játékhoz
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542377
    m_Localized: Nő az íz
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542378
    m_Localized: Ezek az ételek együtt mozognak, és egy blokként veheted fel őket.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542379
    m_Localized: Csipesz
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542380
    m_Localized: Rezgés
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542381
    m_Localized: MEGNÉZEM
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542382
    m_Localized: Elveszítesz 1 szívet!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542383
    m_Localized: MEGJELENT A FŐNÖK!
    m_Metadata:
      m_Items: []
  - m_Id: 791119221743616
    m_Localized: MEGJELENT A FŐNÖK
    m_Metadata:
      m_Items: []
  - m_Id: 791119234326528
    m_Localized: Nincs több hely!
    m_Metadata:
      m_Items: []
  - m_Id: 5836114773401600
    m_Localized: Fagyott mező
    m_Metadata:
      m_Items: []
  - m_Id: 5836114806956032
    m_Localized: Új funkció
    m_Metadata:
      m_Items: []
  - m_Id: 5838819617136640
    m_Localized: Új étterem
    m_Metadata:
      m_Items: []
  - m_Id: 5838819617136641
    m_Localized: Hamarosan új étterem nyílik!
    m_Metadata:
      m_Items: []
  - m_Id: 7340303286525952
    m_Localized: Szép munka!
    m_Metadata:
      m_Items: []
  - m_Id: 7340303307497472
    m_Localized: Nem sikerült
    m_Metadata:
      m_Items: []
  - m_Id: 7542428218155008
    m_Localized: Mesteri!
    m_Metadata:
      m_Items: []
  - m_Id: 7542428239126528
    m_Localized: Legendás!
    m_Metadata:
      m_Items: []
  - m_Id: 7542428243320832
    m_Localized: Kemény dió!
    m_Metadata:
      m_Items: []
  - m_Id: 7542428243320833
    m_Localized: Konyhai káosz!
    m_Metadata:
      m_Items: []
