  m_TableData:
  - m_Id: 57797273182208
    m_Localized: Toate inimile frânte
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542336
    m_Localized: Bun ca de obicei
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542337
    m_Localized: Ingredientele înghețate nu pot fi luate. Ia un obiect de alături ca să spargi gheața.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542338
    m_Localized: Revendică
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542339
    m_Localized: Găsește cheia undeva în șirurile de ingrediente pentru a debloca.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542340
    m_Localized: Explozie de arome
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542341
    m_Localized: Pachet de mâncare
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542342
    m_Localized: GRATUIT
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542343
    m_Localized: Obiect înghețat
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542344
    m_Localized: Am înțeles!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542345
    m_Localized: ZI GREA!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542346
    m_Localized: Salut, încântat de cunoștință
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542347
    m_Localized: Obiect ascuns
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542348
    m_Localized: Obiectele ascunse sunt dezvăluite doar când ajung pe rândul de sus.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542349
    m_Localized: Ține apăsat pentru a vedea harta
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542350
    m_Localized: Ține apăsat pentru a vedea
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542351
    m_Localized: ACASĂ
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542352
    m_Localized: Bloc de gheață
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542353
    m_Localized: S-au terminat ingredientele!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542354
    m_Localized: Ieși
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542355
    m_Localized: Să deschidem afacerea!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542356
    m_Localized: Obiecte legate
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542357
    m_Localized: Lacăt și cheie
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542358
    m_Localized: Muzică
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542359
    m_Localized: Bonus nou
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542360
    m_Localized: Ingredient nou
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542361
    m_Localized: OK
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542362
    m_Localized: Hopa?!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542363
    m_Localized: Fără mutări
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542364
    m_Localized: Fără răbdare
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542365
    m_Localized: Fără locuri libere
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542366
    m_Localized: Pauză
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542367
    m_Localized: Perfect
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542368
    m_Localized: Ia locurile legate împreună când toate au ajuns în față.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542369
    m_Localized: Părăsești ziua?
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542370
    m_Localized: REÎNCEARCĂ
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542371
    m_Localized: Servește un număr de clienți ca să spargi blocul de gheață de pe masă.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542372
    m_Localized: Ceva n-a mers. Încearcă din nou!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542373
    m_Localized: Sunet
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542374
    m_Localized: ZI FOARTE GREA!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542375
    m_Localized: Atinge pentru a continua
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542376
    m_Localized: Atinge pentru a juca
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542377
    m_Localized: Gustul crește
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542378
    m_Localized: Aceste mâncăruri se mișcă și se iau împreună, ca un singur bloc.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542379
    m_Localized: Clește
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542380
    m_Localized: Vibrații
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542381
    m_Localized: VIZIONEAZĂ
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542382
    m_Localized: Vei pierde 1 inimă!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542383
    m_Localized: APARE ȘEFUL!
    m_Metadata:
      m_Items: []
  - m_Id: 791119221743616
    m_Localized: APARE ȘEFUL
    m_Metadata:
      m_Items: []
  - m_Id: 791119234326528
    m_Localized: Fără locuri libere!
    m_Metadata:
      m_Items: []
  - m_Id: 5836114773401600
    m_Localized: Pătrat înghețat
    m_Metadata:
      m_Items: []
  - m_Id: 5836114806956032
    m_Localized: Funcție nouă
    m_Metadata:
      m_Items: []
  - m_Id: 5838819617136640
    m_Localized: Restaurant nou
    m_Metadata:
      m_Items: []
  - m_Id: 5838819617136641
    m_Localized: Un restaurant nou se deschide în curând!
    m_Metadata:
      m_Items: []
  - m_Id: 7340303286525952
    m_Localized: Bravo!
    m_Metadata:
      m_Items: []
  - m_Id: 7340303307497472
    m_Localized: Ai pierdut!
    m_Metadata:
      m_Items: []
  - m_Id: 7542428218155008
    m_Localized: Senzațional!
    m_Metadata:
      m_Items: []
  - m_Id: 7542428239126528
    m_Localized: Legendar!
    m_Metadata:
      m_Items: []
  - m_Id: 7542428243320832
    m_Localized: Greu de tot!
    m_Metadata:
      m_Items: []
  - m_Id: 7542428243320833
    m_Localized: Haos în bucătărie!
    m_Metadata:
      m_Items: []
