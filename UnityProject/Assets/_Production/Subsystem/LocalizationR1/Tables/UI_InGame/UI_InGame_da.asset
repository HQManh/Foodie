  m_SharedData: {fileID: 11400000, guid: a34c71713b2ebf445aa5dfcbb87e843e, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 57797273182208
    m_Localized: Alle hjerter er knust
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542336
    m_Localized: Lige så god som altid
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542337
    m_Localized: Frosne ingredienser kan ikke tages. Tag en genstand ved siden af for at bryde isen.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542338
    m_Localized: Hent
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542339
    m_Localized: Find nøglen et sted i ingredienskøerne for at låse op.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542340
    m_Localized: Smagseksplosion
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542341
    m_Localized: Madbundt
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542342
    m_Localized: GRATIS
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542343
    m_Localized: Frossen genstand
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542344
    m_Localized: Forstået!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542345
    m_Localized: SVÆR DAG!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542346
    m_Localized: Hej, dejligt at møde dig
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542347
    m_Localized: Skjult genstand
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542348
    m_Localized: Skjulte genstande afsløres først, når de når den øverste række.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542349
    m_Localized: Hold for at se kortet
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542350
    m_Localized: Hold for at se
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542351
    m_Localized: HJEM
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542352
    m_Localized: Isblok
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542353
    m_Localized: Ingredienserne er sluppet op!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542354
    m_Localized: Forlad
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542355
    m_Localized: Lad os åbne forretningen!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542356
    m_Localized: Sammenkædede genstande
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542357
    m_Localized: Lås og nøgle
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542358
    m_Localized: Musik
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542359
    m_Localized: Ny booster
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542360
    m_Localized: Ny ingrediens
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542361
    m_Localized: OK
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542362
    m_Localized: Ups?!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542363
    m_Localized: Ikke flere træk
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542364
    m_Localized: Tålmodigheden er sluppet op
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542365
    m_Localized: Ingen flere pladser
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542366
    m_Localized: Pause
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542367
    m_Localized: Perfekt
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542368
    m_Localized: Tag sammenkædede pladser samtidig, når de alle er nået helt frem.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542369
    m_Localized: Forlad dagen?
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542370
    m_Localized: PRØV IGEN
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542371
    m_Localized: Server et antal kunder for at bryde isblokken på bordet.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542372
    m_Localized: Noget gik galt. Prøv igen!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542373
    m_Localized: Lyd
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542374
    m_Localized: MEGET SVÆR DAG!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542375
    m_Localized: Tryk for at fortsætte
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542376
    m_Localized: Tryk for at spille
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542377
    m_Localized: Smagen vokser
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542378
    m_Localized: Disse retter flytter sig og tages sammen som én blok.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542379
    m_Localized: Tang
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542380
    m_Localized: Vibration
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542381
    m_Localized: SE
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542382
    m_Localized: Du mister 1 hjerte!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542383
    m_Localized: BOSSEN DUKKER OP!
    m_Metadata:
      m_Items: []
  - m_Id: 791119221743616
    m_Localized: BOSSEN DUKKER OP
    m_Metadata:
      m_Items: []
  - m_Id: 791119234326528
    m_Localized: Ingen flere pladser!
    m_Metadata:
      m_Items: []
  - m_Id: 5836114773401600
    m_Localized: Frossen felt
    m_Metadata:
      m_Items: []
  - m_Id: 5836114806956032
    m_Localized: Ny funktion
    m_Metadata:
      m_Items: []
  - m_Id: 5838819617136640
    m_Localized: Ny restaurant
    m_Metadata:
      m_Items: []
  - m_Id: 5838819617136641
    m_Localized: En ny restaurant er på vej!
    m_Metadata:
      m_Items: []
  - m_Id: 7340303286525952
    m_Localized: Flot klaret!
    m_Metadata:
      m_Items: []
  - m_Id: 7340303307497472
    m_Localized: Øv, tabt!
    m_Metadata:
      m_Items: []
  - m_Id: 7542428218155008
    m_Localized: Mesterligt!
    m_Metadata:
      m_Items: []
  - m_Id: 7542428239126528
    m_Localized: Køkkenlegende!
    m_Metadata:
      m_Items: []
  - m_Id: 7542428243320832
    m_Localized: Hårdt!
    m_Metadata:
      m_Items: []
  - m_Id: 7542428243320833
    m_Localized: Kaos i køkkenet!
