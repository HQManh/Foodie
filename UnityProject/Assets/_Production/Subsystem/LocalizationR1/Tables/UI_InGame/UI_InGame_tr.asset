  m_TableData:
  - m_Id: 57797273182208
    m_Localized: Tüm Kalpler Kırıldı
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542336
    m_Localized: Her zamanki gibi iyi
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542337
    m_Localized: Donmuş malzemeler alınamaz. Buzu kırmak için yanındaki bir öğeyi al.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542338
    m_Localized: Al
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542339
    m_Localized: Kilidi açmak için malzeme sıralarında anahtarı bul.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542340
    m_Localized: Lezzet Patlaması
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542341
    m_Localized: Yemek Paketi
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542342
    m_Localized: ÜCRETSİZ
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542343
    m_Localized: Donmuş Öğe
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542344
    m_Localized: Anladım!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542345
    m_Localized: ZOR GÜN!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542346
    m_Localized: Merhaba, tanıştığıma memnun oldum
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542347
    m_Localized: Gizli Öğe
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542348
    m_Localized: Gizli öğeler yalnızca en üst sıraya ulaştığında görünür.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542349
    m_Localized: Haritayı görmek için basılı tut
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542350
    m_Localized: Görmek için basılı tut
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542351
    m_Localized: ANA SAYFA
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542352
    m_Localized: Buz Bloğu
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542353
    m_Localized: Malzemeler Bitti!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542354
    m_Localized: Ayrıl
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542355
    m_Localized: Hadi işe başlayalım!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542356
    m_Localized: Bağlı Öğeler
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542357
    m_Localized: Kilit ve Anahtar
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542358
    m_Localized: Müzik
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542359
    m_Localized: Yeni Güçlendirici
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542360
    m_Localized: Yeni Malzeme
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542361
    m_Localized: Tamam
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542362
    m_Localized: Hay aksi?!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542363
    m_Localized: Hamle Kalmadı
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542364
    m_Localized: Sabır Tükendi
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542365
    m_Localized: Yuva Kalmadı
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542366
    m_Localized: Duraklatıldı
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542367
    m_Localized: Mükemmel
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542368
    m_Localized: Tüm bağlı yuvalar öne ulaştığında onları birlikte al.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542369
    m_Localized: Günden Çık?
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542370
    m_Localized: TEKRAR
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542371
    m_Localized: Masadaki buz bloğunu kırmak için belirli sayıda müşteriye servis yap.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542372
    m_Localized: Bir şeyler ters gitti. Tekrar dene!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542373
    m_Localized: Ses
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542374
    m_Localized: ÇOK ZOR GÜN!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542375
    m_Localized: Devam etmek için dokun
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542376
    m_Localized: Oynamak için dokun
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542377
    m_Localized: Lezzet Artıyor
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542378
    m_Localized: Bu yiyecekler birlikte hareket eder ve tek blok olarak alınır.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542379
    m_Localized: Maşa
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542380
    m_Localized: Titreşim
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542381
    m_Localized: İZLE
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542382
    m_Localized: 1 kalp kaybedeceksin!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542383
    m_Localized: PATRON GELDİ!
    m_Metadata:
      m_Items: []
  - m_Id: 791119221743616
    m_Localized: PATRON GELDİ
    m_Metadata:
      m_Items: []
  - m_Id: 791119234326528
    m_Localized: Yuva Kalmadı!
    m_Metadata:
      m_Items: []
  - m_Id: 5836114773401600
    m_Localized: Donmuş Kare
    m_Metadata:
      m_Items: []
  - m_Id: 5836114806956032
    m_Localized: Yeni Özellik
    m_Metadata:
      m_Items: []
  - m_Id: 5838819617136640
    m_Localized: Yeni Restoran
    m_Metadata:
      m_Items: []
  - m_Id: 5838819617136641
    m_Localized: Yeni bir restoran geliyor!
    m_Metadata:
      m_Items: []
  - m_Id: 7340303286525952
    m_Localized: Harika iş!
    m_Metadata:
      m_Items: []
  - m_Id: 7340303307497472
    m_Localized: Olmadı!
    m_Metadata:
      m_Items: []
  - m_Id: 7542428218155008
    m_Localized: Ustaca!
    m_Metadata:
      m_Items: []
  - m_Id: 7542428239126528
    m_Localized: Efsane!
    m_Metadata:
      m_Items: []
  - m_Id: 7542428243320832
    m_Localized: Zorlu!
    m_Metadata:
      m_Items: []
  - m_Id: 7542428243320833
    m_Localized: Mutfak karıştı!
