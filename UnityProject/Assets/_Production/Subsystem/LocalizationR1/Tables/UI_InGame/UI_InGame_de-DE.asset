  m_TableData:
  - m_Id: 57797273182208
    m_Localized: Alle Herzen gebrochen
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542336
    m_Localized: So gut wie immer
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542337
    m_Localized: Gefrorene Zutaten kann man nicht nehmen. Nimm ein Teil daneben, um das Eis zu brechen.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542338
    m_Localized: Abholen
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542339
    m_Localized: Finde den Schlüssel irgendwo in den Zutatenreihen, um aufzuschließen.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542340
    m_Localized: Geschmacksexplosion
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542341
    m_Localized: Essenspaket
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542342
    m_Localized: GRATIS
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542343
    m_Localized: Gefrorenes Teil
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542344
    m_Localized: Verstanden!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542345
    m_Localized: SCHWERER TAG!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542346
    m_Localized: Hallo, schön dich kennenzulernen
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542347
    m_Localized: Verstecktes Teil
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542348
    m_Localized: Versteckte Teile werden erst sichtbar, wenn sie die oberste Reihe erreichen.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542349
    m_Localized: Halten, um die Karte zu sehen
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542350
    m_Localized: Halten zum Ansehen
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542351
    m_Localized: START
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542352
    m_Localized: Eisblock
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542353
    m_Localized: Zutaten aufgebraucht!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542354
    m_Localized: Verlassen
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542355
    m_Localized: Lass uns das Geschäft eröffnen!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542356
    m_Localized: Verbundene Teile
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542357
    m_Localized: Schloss & Schlüssel
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542358
    m_Localized: Musik
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542359
    m_Localized: Neuer Booster
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542360
    m_Localized: Neue Zutat
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542361
    m_Localized: OK
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542362
    m_Localized: Hoppla?!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542363
    m_Localized: Keine Züge mehr
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542364
    m_Localized: Keine Geduld mehr
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542365
    m_Localized: Keine Plätze mehr
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542366
    m_Localized: Pausiert
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542367
    m_Localized: Perfekt
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542368
    m_Localized: Nimm verbundene Plätze zusammen, sobald alle vorne angekommen sind.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542369
    m_Localized: Tag verlassen?
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542370
    m_Localized: NOCHMAL
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542371
    m_Localized: Bediene eine Anzahl Gäste, um den Eisblock auf dem Tisch zu brechen.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542372
    m_Localized: Etwas ist schiefgelaufen. Versuch es nochmal!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542373
    m_Localized: Sound
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542374
