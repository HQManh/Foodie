    m_Metadata:
      m_Items: []
  - m_Id: 57797302542376
    m_Localized: Tippen zum Spielen
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542377
    m_Localized: Geschmack wächst
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542378
    m_Localized: Diese Speisen bewegen sich und werden zusammen als ein Block genommen.
    m_Metadata:
      m_Items: []
