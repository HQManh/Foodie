  m_TableData:
  - m_Id: 57797273182208
    m_Localized: Tim đã vỡ hết
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542336
    m_Localized: Ngon như mọi khi
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542337
    m_Localized: Không thể lấy nguyên liệu bị đóng băng. Hãy lấy vật phẩm bên cạnh để phá băng.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542338
    m_Localized: Nhận
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542339
    m_Localized: Tìm chìa khóa đâu đó trong hàng nguyên liệu để mở khóa.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542340
    m_Localized: Bùng nổ hương vị
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542341
    m_Localized: Gói đồ ăn
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542342
    m_Localized: MIỄN PHÍ
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542343
    m_Localized: Vật phẩm đóng băng
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542344
    m_Localized: Đã hiểu!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542345
    m_Localized: NGÀY KHÓ!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542346
    m_Localized: Xin chào, rất vui được gặp bạn
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542347
    m_Localized: Vật phẩm ẩn
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542348
    m_Localized: Vật phẩm ẩn chỉ lộ diện khi lên đến hàng trên cùng.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542349
    m_Localized: Giữ để xem bản đồ
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542350
    m_Localized: Giữ để xem
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542351
    m_Localized: TRANG CHỦ
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542352
    m_Localized: Khối băng
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542353
    m_Localized: Hết nguyên liệu!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542354
    m_Localized: Rời đi
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542355
    m_Localized: Bắt đầu kinh doanh nào!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542356
    m_Localized: Vật phẩm liên kết
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542357
    m_Localized: Ổ khóa & Chìa khóa
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542358
    m_Localized: Nhạc
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542359
    m_Localized: Trợ lực mới
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542360
    m_Localized: Nguyên liệu mới
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542361
    m_Localized: OK
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542362
    m_Localized: Ối?!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542363
    m_Localized: Hết lượt đi
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542364
    m_Localized: Hết kiên nhẫn
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542365
    m_Localized: Hết ô chứa
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542366
    m_Localized: Tạm dừng
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542367
    m_Localized: Hoàn hảo
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542368
    m_Localized: Lấy các ô liên kết cùng lúc khi tất cả đã lên đến phía trước.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542369
    m_Localized: Rời ngày này?
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542370
    m_Localized: THỬ LẠI
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542371
    m_Localized: Phục vụ đủ số khách để phá khối băng trên bàn.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542372
    m_Localized: Có gì đó không ổn. Thử lại nhé!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542373
    m_Localized: Âm thanh
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542374
    m_Localized: NGÀY SIÊU KHÓ!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542375
    m_Localized: Chạm để tiếp tục
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542376
    m_Localized: Chạm để chơi
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542377
    m_Localized: Hương vị tăng dần
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542378
    m_Localized: Những món này di chuyển và được lấy cùng nhau như một khối.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542379
    m_Localized: Kẹp gắp
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542380
    m_Localized: Rung
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542381
    m_Localized: XEM
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542382
    m_Localized: Bạn sẽ mất 1 tim!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542383
    m_Localized: BOSS XUẤT HIỆN!
    m_Metadata:
      m_Items: []
