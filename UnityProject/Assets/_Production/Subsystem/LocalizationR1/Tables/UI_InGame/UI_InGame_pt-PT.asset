    m_Metadata:
      m_Items: []
  - m_Id: 57797302542344
    m_Localized: Percebi!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542345
    m_Localized: DIA DIFÍCIL!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542346
    m_Localized: Olá, muito prazer
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542347
    m_Localized: Item oculto
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542348
    m_Localized: Os itens ocultos só são revelados quando chegam à fila de cima.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542349
    m_Localized: Mantém para ver o mapa
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542350
    m_Localized: Mantém para ver
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542351
    m_Localized: INÍCIO
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542352
    m_Localized: Bloco de gelo
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542353
    m_Localized: Os ingredientes acabaram!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542354
    m_Localized: Sair
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542355
