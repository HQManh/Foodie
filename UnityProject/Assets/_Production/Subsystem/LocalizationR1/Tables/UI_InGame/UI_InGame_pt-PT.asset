    m_Metadata:
      m_Items: []
  - m_Id: 57797302542361
    m_Localized: OK
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542362
    m_Localized: Ups?!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542363
    m_Localized: Sem jogadas
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542364
