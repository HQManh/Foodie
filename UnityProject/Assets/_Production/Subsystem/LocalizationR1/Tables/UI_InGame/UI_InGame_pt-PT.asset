  m_TableData:
  - m_Id: 57797273182208
    m_Localized: Todos os corações partidos
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542336
    m_Localized: Bom como sempre
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542337
    m_Localized: Não é possível apanhar ingredientes congelados. Apanha um item ao lado para partir o gelo.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542338
    m_Localized: Resgatar
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542339
    m_Localized: Encontra a chave numa das filas de ingredientes para desbloquear.
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542340
    m_Localized: Explosão de Sabor
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542341
    m_Localized: Pacote de comida
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542342
    m_Localized: GRÁTIS
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542343
