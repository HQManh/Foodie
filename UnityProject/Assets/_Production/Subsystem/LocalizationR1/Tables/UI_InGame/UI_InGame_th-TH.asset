  m_LocaleId:
    m_Code: th-TH
  m_SharedData: {fileID: 11400000, guid: a34c71713b2ebf445aa5dfcbb87e843e, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 57797273182208
    m_Localized: หัวใจ​แตก​หมด​แล้ว
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542336
    m_Localized: อร่อย​เหมือน​เคย
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542337
    m_Localized: หยิบ​วัตถุดิบ​ที่​แช่​แข็ง​ไม่​ได้ หยิบ​ของ​ที่​อยู่​ใกล้ ๆ เพื่อ​ทำลาย​น้ำ​แข็ง
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542338
    m_Localized: รับ
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542339
    m_Localized: หา​กุญแจ​ใน​แถว​วัตถุดิบ​เพื่อ​ปลด​ล็อก
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542340
    m_Localized: ระเบิด​รสชาติ
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542341
    m_Localized: ชุด​อาหาร
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542342
    m_Localized: ฟรี
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542343
    m_Localized: ไอ​เทม​แช่​แข็ง
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542344
    m_Localized: เข้าใจ​แล้ว!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542345
    m_Localized: วัน​ยาก!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542346
    m_Localized: สวัสดี ยินดี​ที่​ได้​รู้จัก
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542347
    m_Localized: ไอ​เทม​ซ่อน​อยู่
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542348
    m_Localized: ไอ​เท​ม​ที่​ซ่อน​อยู่​จะ​เผย​เมื่อ​ขึ้น​ถึง​แถว​บน​สุด​เท่านั้น
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542349
    m_Localized: กด​ค้าง​เพื่อ​ดู​แผนที่
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542350
    m_Localized: กด​ค้าง​เพื่อ​ดู
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542351
    m_Localized: หน้า​หลัก
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542352
    m_Localized: ก้อน​น้ำ​แข็ง
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542353
    m_Localized: วัตถุดิบ​หมด​แล้ว!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542354
    m_Localized: ออก
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542355
    m_Localized: มา​เริ่ม​เปิด​ร้าน​กัน​เถอะ!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542356
    m_Localized: ไอ​เท​ม​เชื่อม​กัน
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542357
    m_Localized: แม่กุญแจ​และ​กุญแจ
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542358
    m_Localized: เพลง
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542359
    m_Localized: บูส​เตอร์​ใหม่
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542360
    m_Localized: วัตถุดิบ​ใหม่
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542361
    m_Localized: ตกลง
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542362
    m_Localized: อุ๊ย?!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542363
    m_Localized: หมด​ตา​เดิน​แล้ว
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542364
    m_Localized: หมด​ความ​อดทน​แล้ว
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542365
    m_Localized: ช่อง​เต็ม​แล้ว
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542366
    m_Localized: หยุด​ชั่วคราว
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542367
    m_Localized: สมบูรณ์​แบบ
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542368
    m_Localized: หยิบ​ช่อง​ที่​เชื่อม​กัน​พร้อม​กัน​เมื่อ​ทุก​ช่อง​มา​ถึง​ด้าน​หน้า​แล้ว
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542369
    m_Localized: ออก​จาก​วัน​นี้​ไหม?
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542370
    m_Localized: ลอง​ใหม่
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542371
    m_Localized: เสิร์ฟ​ลูกค้า​ให้​ครบ​จำนวน​เพื่อ​ทำลาย​ก้อน​น้ำ​แข็ง​บน​โต๊ะ
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542372
    m_Localized: มี​บาง​อย่าง​ผิด​พลาด ลอง​อีก​ครั้ง!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542373
    m_Localized: เสียง
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542374
    m_Localized: วัน​ยาก​มาก!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542375
    m_Localized: แตะ​เพื่อ​ไป​ต่อ
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542376
    m_Localized: แตะ​เพื่อ​เล่น
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542377
    m_Localized: รสชาติ​กำลัง​เพิ่ม​ขึ้น
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542378
    m_Localized: อาหาร​เหล่า​นี้​เคลื่อนที่​และ​ถูก​หยิบ​ไป​พร้อม​กัน​เป็น​ก้อน​เดียว
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542379
    m_Localized: ที่​คีบ
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542380
    m_Localized: การ​สั่น
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542381
    m_Localized: ดู
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542382
    m_Localized: คุณ​จะ​เสีย​หัวใจ 1 ดวง!
    m_Metadata:
      m_Items: []
  - m_Id: 57797302542383
    m_Localized: บอส​ปรากฏ​ตัว!
    m_Metadata:
      m_Items: []
  - m_Id: 791119221743616
    m_Localized: บอส​ปรากฏ​ตัว
    m_Metadata:
      m_Items: []
  - m_Id: 791119234326528
    m_Localized: ช่อง​เต็ม​แล้ว!
    m_Metadata:
      m_Items: []
  - m_Id: 5836114773401600
    m_Localized: ช่อง​น้ำ​แข็ง
    m_Metadata:
      m_Items: []
  - m_Id: 5836114806956032
    m_Localized: ฟีเจอร์​ใหม่
    m_Metadata:
      m_Items: []
  - m_Id: 5838819617136640
    m_Localized: ร้าน​อาหาร​ใหม่
    m_Metadata:
      m_Items: []
  - m_Id: 5838819617136641
    m_Localized: ร้าน​อาหาร​ใหม่​กำลัง​จะ​มา!
    m_Metadata:
      m_Items: []
  - m_Id: 7340303286525952
    m_Localized: เยี่ยม​เลย!
    m_Metadata:
      m_Items: []
  - m_Id: 7340303307497472
    m_Localized: ไม่​ผ่าน!
    m_Metadata:
      m_Items: []
  - m_Id: 7542428218155008
    m_Localized: สุด​ยอด​เชฟ!
    m_Metadata:
      m_Items: []
  - m_Id: 7542428239126528
    m_Localized: ระดับ​ตำนาน!
    m_Metadata:
      m_Items: []
  - m_Id: 7542428243320832
    m_Localized: ยาก​จัง!
    m_Metadata:
      m_Items: []
  - m_Id: 7542428243320833
    m_Localized: ครัว​วุ่นวาย!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
