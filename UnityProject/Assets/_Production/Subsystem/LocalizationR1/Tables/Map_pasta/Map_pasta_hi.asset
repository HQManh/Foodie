  m_LocaleId:
    m_Code: hi
  m_SharedData: {fileID: 11400000, guid: b8c57adbeaeeddd48bdbbb34b0659dca, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 2207008936681472
    m_Localized: छोटा-सा आरामदायक ट्रैटोरिया, जहाँ से आपकी पास्ता कहानी शुरू होती है।
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624512
    m_Localized: आपके ट्रैटोरिया में एक आरामदायक ऊपरी मंज़िल जोड़ता है।
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624513
    m_Localized: पल भर में मुलायम सॉस तैयार।
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624514
    m_Localized: सॉस का बवंडर। ढक्कन लगाना बेहद ज़रूरी।
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624515
    m_Localized: टमाटर शर्म से लाल होने से पहले ही कट जाते हैं।
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624516
    m_Localized: इतनी तेज़ी से काटता है कि प्याज़ को रोने का मौका ही नहीं मिलता।
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624517
    m_Localized: खुले आसमान तले पास्ता के लिए चेक वाली मेज़ और आरामदायक कुर्सियाँ।
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624518
    m_Localized: दरवाज़े के पास जगमगाती गर्माहट भरी लालटेन।
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624519
    m_Localized: छत की शान बढ़ाता कैपीबारा शेफ़ का गर्वीला बोर्ड।
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624520
    m_Localized: आज के ख़ास पास्ता बताता चॉकबोर्ड।
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624521
    m_Localized: सॉस दोगुनी तेज़ी से छनछनाते हैं।
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624522
    m_Localized: एक्स्ट्रा छनछनाहट अनलॉक। कड़ाही गर्व से दमक रही है।
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624523
    m_Localized: ताज़ी गमले वाली हरियाली, जो दरवाज़े को रौनक देती है।
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013120
    m_Localized: आप अल डेंटे कहें, उससे पहले ही पानी उबल जाता है।
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013121
    m_Localized: उबलता हुआ दिग्गज, जो पास्ता बिजली की रफ़्तार से पकाता है।
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013122
    m_Localized: छत को सजाता अंगूरों का भरा-पूरा गुच्छा।
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013123
    m_Localized: छत पर ऊँचाई तक लिपटी स्पेगेटी की एक विशाल प्लेट!
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013124
    m_Localized: चुटकियों में बुलबुलेदार सोडा भरता है।
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013125
    m_Localized: ज़बरदस्त फ़िज़! बुलबुलों और ख़ुशियों का फ़व्वारा।
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013126
    m_Localized: ट्रैटोरिया की ऊपरी मंज़िल
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013127
    m_Localized: सॉसी ब्लेंडर
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013128
    m_Localized: सॉस बवंडर
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013129
    m_Localized: झटपट कटिंग बोर्ड
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013130
    m_Localized: पास्ता निंजा बोर्ड
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013131
    m_Localized: आँगन की मेज़
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013132
    m_Localized: दीवार लालटेन
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207424
    m_Localized: कैपी शेफ़ बोर्ड
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207425
    m_Localized: चॉक मेन्यू
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207426
    m_Localized: छनछनाती कड़ाही
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207427
    m_Localized: धधकती कड़ाही
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207428
    m_Localized: गमले में तुलसी
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207429
    m_Localized: तेज़ उबाल पतीला
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207430
    m_Localized: मेगा उबाल कड़ाह
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207431
    m_Localized: छत के अंगूर
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207432
    m_Localized: विशाल स्पेगेटी
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207433
    m_Localized: फ़िज़ फ़व्वारा
    m_Metadata:
      m_Items: []
  - m_Id: 2207008995401728
    m_Localized: सोडा गीज़र
    m_Metadata:
      m_Items: []
  - m_Id: 2508025511272448
    m_Localized: पिनस्ट्राइप सूट और गुलाब सजी फ़ेडोरा टोपी में एक रौबदार भालू, जो भरपूर पास्ता और पूरा सम्मान चाहता है।
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243968
    m_Localized: बैंगनी टोपी और मैचिंग ड्रेस में एक स्टाइलिश धारीदार बिल्ली, जो बेहतरीन पसंद से पास्ता मँगाती है और संतोष से घुरघुराती है।
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243969
    m_Localized: नीली डाक वर्दी में एक सलीकेदार चिनचिला, जो डिलीवरी के बीच ताज़े पास्ता की खुशबू के पीछे चला आता है।
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243970
    m_Localized: टॉप हैट और तिरंगी पट्टी में एक गर्वीला मुर्गा, जो लंबे-चौड़े भाषणों के साथ पास्ता काउंटर की अध्यक्षता करता है।
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243971
    m_Localized: गोल चश्मे और घंटी बंधे स्कार्फ़ में एक सौम्य भेड़, जो पास्ता की हर प्लेट को एक ख़ास मौक़ा मानती है।
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243972
    m_Localized: सेब
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243973
