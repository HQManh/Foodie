  m_SharedData: {fileID: 11400000, guid: b8c57adbeaeeddd48bdbbb34b0659dca, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 2207008936681472
    m_Localized: Makarna hikâyenin başladığı şirin küçük trattoria.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624512
    m_Localized: Trattoria'na şirin bir üst kat ekler.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624513
    m_Localized: Göz açıp kapayıncaya kadar ipeksi sos hazırlar.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624514
    m_Localized: Bir sos kasırgası. Kapak kesinlikle önerilir.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624515
    m_Localized: Domatesler kızaramadan küp küp doğranır.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624516
    m_Localized: O kadar hızlı doğrar ki soğanlar ağlamaya bile fırsat bulamaz.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624517
    m_Localized: Açık havada makarna için kareli masa ve rahat sandalyeler.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624518
    m_Localized: Kapının yanında parlayan sıcacık bir fener.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624519
    m_Localized: Çatıyı süsleyen gururlu kapibara şef tabelası.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624520
    m_Localized: Günün özel makarnalarını gösteren kara tahta.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624521
    m_Localized: Soslar iki kat hızlı cızırdar.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624522
    m_Localized: Ekstra cızırtı açıldı. Tava gururla parlıyor.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624523
    m_Localized: Kapıyı şenlendiren taze saksı bitkileri.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013120
    m_Localized: Daha al dente diyemeden su kaynar.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013121
    m_Localized: Makarnayı ışık hızında pişiren fokur fokur bir efsane.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013122
    m_Localized: Çatıyı süsleyen dolgun bir üzüm salkımı.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013123
    m_Localized: Çatının tepesinde sarılmış dev bir tabak spagetti!
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013124
    m_Localized: Köpüklü gazozu bir çırpıda doldurur.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013125
    m_Localized: Bol köpük! Kabarcık ve neşe fıskiyesi.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013126
    m_Localized: Üst Katlı Trattoria
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013127
    m_Localized: Sos Blenderi
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013128
    m_Localized: Sos Kasırgası
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013129
    m_Localized: Hızlı Doğrama Tahtası
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013130
    m_Localized: Makarna Ninja Tahtası
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013131
    m_Localized: Bahçe Masası
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013132
    m_Localized: Duvar Feneri
    m_Metadata:
      m_Items: []
