  m_SharedData: {fileID: 11400000, guid: b8c57adbeaeeddd48bdbbb34b0659dca, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 2207008936681472
    m_Localized: パスタ物語が始まる、こぢんまりとした居心地のいいトラットリア。
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624512
    m_Localized: トラットリアに居心地のいい2階を増築。
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624513
    m_Localized: あっという間になめらかソースが完成。
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624514
    m_Localized: ソースの大旋風。フタは絶対に忘れずに。
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624515
    m_Localized: トマトは赤面する前にさいの目切り。
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624516
    m_Localized: 速すぎて玉ねぎが泣くひまもない。
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624517
    m_Localized: チェック柄のテーブルと心地よいイスで、外でパスタを。
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624518
    m_Localized: ドアの横で温かく灯るランタン。
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624519
    m_Localized: 屋根に誇らしげに輝く、カピバラシェフの看板。
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624520
    m_Localized: 本日のおすすめパスタを書いた黒板。
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624521
    m_Localized: ソースが2倍速でジュージュー。
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624522
    m_Localized: ジュージュー度アップ。パンが誇らしげに輝く。
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624523
    m_Localized: 入口を明るくする、みずみずしい鉢植えの緑。
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013120
    m_Localized: 「アルデンテ」と言う前にお湯が沸騰。
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013121
    m_Localized: パスタを光速でゆで上げる、ぐつぐつの伝説。
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013122
    m_Localized: 屋根を彩る、たわわなブドウの房。
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013123
    m_Localized: 屋根の上で高々と巻かれた巨大なスパゲッティ！
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013124
    m_Localized: シュワシュワのソーダをあっという間に注ぐ。
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013125
    m_Localized: シュワシュワたっぷり！泡と喜びの噴水。
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013126
    m_Localized: トラットリア2階
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013127
    m_Localized: ソースミキサー
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013128
    m_Localized: ソーストルネード
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013129
    m_Localized: スピード包丁まないた
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013130
    m_Localized: パスタ忍者まないた
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013131
    m_Localized: テラス席
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013132
    m_Localized: 壁掛けランタン
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207424
    m_Localized: カピシェフ看板
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207425
    m_Localized: 黒板メニュー
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207426
    m_Localized: ジュージューパン
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207427
    m_Localized: 灼熱パン
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207428
    m_Localized: 鉢植えバジル
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207429
    m_Localized: 速沸ポット
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207430
    m_Localized: メガ沸騰大鍋
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207431
    m_Localized: 屋根のブドウ
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207432
    m_Localized: 巨大スパゲッティ
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207433
    m_Localized: シュワシュワサーバー
    m_Metadata:
      m_Items: []
  - m_Id: 2207008995401728
    m_Localized: ソーダ間欠泉
    m_Metadata:
      m_Items: []
  - m_Id: 2508025511272448
    m_Localized: ストライプスーツにバラ飾りのフェドーラ帽をかぶった貫禄あるクマ。パスタは大盛り、敬意は絶対。
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243968
    m_Localized: 紫の帽子とおそろいのドレスがおしゃれなトラ猫。完璧なセンスでパスタを注文し、満足げにゴロゴロ。
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243969
    m_Localized: 青い郵便制服をきちんと着たチンチラ。配達の合間に、できたてパスタの香りをたどってやって来ます。
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243970
    m_Localized: シルクハットに三色のたすきをかけた誇り高きニワトリ。パスタカウンターで堂々と演説します。
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243971
    m_Localized: 丸メガネに鈴付きスカーフの穏やかなヒツジ。パスタの一皿一皿を、きちんとした特別な場と考えています。
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243972
    m_Localized: りんご
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243973
    m_Localized: カットりんご
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243974
    m_Localized: ドン・オルシーノ
    m_Metadata:
      m_Items: []
  - m_Id: 2508025536438272
    m_Localized: 焼いたビーフステーキ
    m_Metadata:
      m_Items: []
  - m_Id: 2508025536438273
    m_Localized: 生ビーフステーキ
    m_Metadata:
      m_Items: []
  - m_Id: 2508025536438274
    m_Localized: ゆで鍋
    m_Metadata:
      m_Items: []
  - m_Id: 2508025536438275
