  - m_Id: 2508025536438323
    m_Localized: Spinat
    m_Metadata:
      m_Items: []
  - m_Id: 2508025536438324
    m_Localized: Gehackter Spinat
    m_Metadata:
      m_Items: []
  - m_Id: 2508025536438325
    m_Localized: Spinat-Milch-Soße
    m_Metadata:
      m_Items: []
  - m_Id: 2508025536438326
    m_Localized: Große Tomate
    m_Metadata:
      m_Items: []
  - m_Id: 2508025536438327
    m_Localized: Gehackte Tomate
    m_Metadata:
      m_Items: []
  - m_Id: 2508025536438328
    m_Localized: Tomaten-Milch-Soße
    m_Metadata:
      m_Items: []
  - m_Id: 2538974605205504
    m_Localized: Ein knackiger Apfel hält den Arzt und langweilige Salate fern.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974630371328
    m_Localized: In knackige Spalten geschnitten, bereit zum Untermischen.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974630371329
    m_Localized: Auf dem Grill gebraten, bis es bellissimo flüstert.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974630371330
    m_Localized: Ein dickes Stück Rind mit großen Florentiner Träumen.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974630371331
    m_Localized: Kocht Pasta, bis sie perfekt al dente ist.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974630371332
    m_Localized: Goldenes Bruschetta-Brot mit herrlichem Knusper.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565632
    m_Localized: Ein rustikales italienisches Brot, außen knusprig, innen weich.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565633
    m_Localized: Ein Käselaib, gereift für Drama und Geschmack.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565634
    m_Localized: Käseschneeflocken, die auf die Pasta rieseln wollen.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565635
    m_Localized: Cremig, käsig und so glatt, dass sie jeden Streit gewinnt.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565636
    m_Localized: Saftiges Grillhähnchen mit ordentlichen Grillstreifen.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565637
    m_Localized: Blasses Hähnchen, das auf seinen großen Grillmoment wartet.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565638
    m_Localized: Hackt Gemüse schneller, als du ciao sagen kannst.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565639
    m_Localized: Gebratene Jakobsmuscheln, süß wie ein venezianischer Sonnenuntergang.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565640
    m_Localized: Eine Jakobsmuschel, die ihre Schale noch fest verschlossen hält.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565641
    m_Localized: Geputzt, pariert und nicht mehr verschlossen.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565642
    m_Localized: Ein leerer Becher wartet auf etwas Sprudelndes.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565643
    m_Localized: Aufgewickelt, mit Soße und italienischem Flair serviert. Mamma mia!
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565644
    m_Localized: Knackig, frisch und angemacht wie ein echter italienischer Garten.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565645
    m_Localized: Vom Grill und aus dem Meer, ein Festmahl wie sonntags in Neapel.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565646
    m_Localized: Sprudelnd, kalt und der perfekte Begleiter zu jedem Teller Pasta.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565647
    m_Localized: Weiche Fliegen, fein herausgeputzt fürs Abendessen.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565648
    m_Localized: Kleine Nudelschmetterlinge, die noch nicht fliegen können.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565649
    m_Localized: Angebraten und saftig, genau wie bei Nonna.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565650
    m_Localized: Hackfleisch auf dem Weg zum klassischen Ragù.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565651
    m_Localized: Kalte Würfel halten jede Limo schön kühl.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565652
    m_Localized: Eine sonnige Amalfi-Zitrone mit spritziger Persönlichkeit.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565653
    m_Localized: Frische Zitronenscheiben lassen jeden Schluck funkeln.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565654
    m_Localized: Ein knackiger Salatkopf, frisch aus dem Garten.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565655
    m_Localized: Geschnittene Blätter, bereit für ordentliches Durchmischen.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565656
    m_Localized: Zarte Röhren, gekocht und bereit zum Füllen.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565657
    m_Localized: Große Nudelröhren mit viel Platz für Füllung.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565658
    m_Localized: Das cremige Dressing, das jeden Salat zusammenhält.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565659
    m_Localized: Grill trifft Meer auf einem großzügigen Teller.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565660
    m_Localized: Frische Milch, das Geheimnis jeder cremigen Soße.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565661
    m_Localized: Gegrillter Oktopus, ein echter Geschmack des Mittelmeers.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565662
    m_Localized: Acht Arme und keine Ahnung, was kommt.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565663
    m_Localized: Tentakel zurechtgeschnitten und bereit für die Hitze.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565664
    m_Localized: Brutzelt Fleisch und Soßen zu goldener Perfektion.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565665
    m_Localized: Ein dampfender Teller Pasta, al dente und stolz darauf.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565666
    m_Localized: Frisches Grün, auf italienische Art angemacht.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565667
    m_Localized: Mixt seidige Soßen in einem cremigen Wirbel.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565668
    m_Localized: Brutzelnde Garnelen, von den Flammen geküsst.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565669
    m_Localized: Kleine Garnelen, eingerollt und ganz schüchtern.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565670
    m_Localized: Geschält und vorbereitet, keine Schale mehr zum Verstecken.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565671
    m_Localized: Ein Becher voller Bläschen, eiskalt serviert.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565672
    m_Localized: Ein Becher, bereit für eine sprudelnde Nachfüllung.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565673
    m_Localized: Gießt sprudelnde Limo über jede Menge Eis.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565674
    m_Localized: Perfekt al dente und bereit zum Aufwickeln.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565675
    m_Localized: Lang, trocken und steif wie ein Grissini.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565676
    m_Localized: Grüne Blätter mit Matrosenkraft.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565677
    m_Localized: Fein gehacktes Grün, bereit für die Soße.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565678
    m_Localized: Grün, cremig und heimlich gesund.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565679
    m_Localized: Eine pralle Tomate, gereift unter der Sonne der Toskana.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565680
    m_Localized: Gewürfelte Tomate, das schlagende Herz jeder roten Soße.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565681
    m_Localized: Rosig, cremig und pink wie ein römischer Sonnenuntergang.
    m_Metadata:
      m_Items: []
  - m_Id: 2538974634565682
    m_Localized: Becher
    m_Metadata:
      m_Items: []
  - m_Id: 2538974638759936
    m_Localized: Limonadenautomat
    m_Metadata:
      m_Items: []
  - m_Id: 4376267120959488
    m_Localized: Gemütliche Trattoria
    m_Metadata:
      m_Items: []
  - m_Id: 4741103310856192
    m_Localized: Tomaten sind gehackt, bevor sie erröten können.
    m_Metadata:
      m_Items: []
  - m_Id: 4741103344410624
    m_Localized: Samurai-Pastabrett
    m_Metadata:
      m_Items: []
  - m_Id: 4741103344410625
    m_Localized: Ein Schwung, ein ganzer Salat. Chef's Kiss.
    m_Metadata:
      m_Items: []
  - m_Id: 4741103348604928
    m_Localized: Legendäre Pastaklinge
    m_Metadata:
      m_Items: []
  - m_Id: 4741103348604929
    m_Localized: Cremige Soße im Wirbel. Servietten empfohlen.
    m_Metadata:
      m_Items: []
  - m_Id: 4741103348604930
    m_Localized: Soßen-Hurrikan
    m_Metadata:
      m_Items: []
  - m_Id: 4741103348604931
    m_Localized: Seidige Soße in einer Umdrehung.
    m_Metadata:
      m_Items: []
  - m_Id: 4741103352799232
    m_Localized: Legendärer Soßenwirbel
    m_Metadata:
      m_Items: []
  - m_Id: 4741103352799233
    m_Localized: Steaks brutzeln im Handumdrehen. Hör dir das an!
    m_Metadata:
      m_Items: []
  - m_Id: 4741103356993536
    m_Localized: Inferno-Pfanne
    m_Metadata:
      m_Items: []
  - m_Id: 4741103356993537
    m_Localized: Perfekt gegrillt, bevor du bellissimo sagen kannst.
    m_Metadata:
      m_Items: []
  - m_Id: 4741103356993538
    m_Localized: Legendäre Brutzelpfanne
    m_Metadata:
      m_Items: []
  - m_Id: 4741103356993539
    m_Localized: Die Pasta ist im Nu al dente.
    m_Metadata:
      m_Items: []
  - m_Id: 4741103356993540
    m_Localized: Vulkan-Kochtopf
    m_Metadata:
      m_Items: []
  - m_Id: 4741103361187840
    m_Localized: Kocht so schnell, dass das Wasser es kaum merkt.
    m_Metadata:
      m_Items: []
  - m_Id: 4741103361187841
    m_Localized: Legendärer Pastakessel
    m_Metadata:
      m_Items: []
  - m_Id: 4741103361187842
    m_Localized: Er bricht mit Sprudel aus. Die Becher füllen sich von selbst.
    m_Metadata:
      m_Items: []
  - m_Id: 4741103361187843
    m_Localized: Limo-Vulkan
    m_Metadata:
      m_Items: []
  - m_Id: 4741103361187844
    m_Localized: Blubbern für immer. Der Durst hat keine Chance.
    m_Metadata:
      m_Items: []
  - m_Id: 4741103361187845
    m_Localized: Unendlicher Limo-Brunnen
    m_Metadata:
      m_Items: []
