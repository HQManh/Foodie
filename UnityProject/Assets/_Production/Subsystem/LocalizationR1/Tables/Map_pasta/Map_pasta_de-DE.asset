  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Map_pasta_de-DE
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: de-DE
  m_SharedData: {fileID: 11400000, guid: b8c57adbeaeeddd48bdbbb34b0659dca, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 2207008936681472
    m_Localized: Die gemütliche kleine Trattoria, in der deine Pasta-Geschichte beginnt.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624512
    m_Localized: Gibt deiner Trattoria ein gemütliches Obergeschoss.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624513
    m_Localized: Zaubert im Nu eine seidige Soße.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624514
    m_Localized: Ein Wirbelsturm aus Soße. Deckel dringend empfohlen.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624515
    m_Localized: Die Tomaten sind gewürfelt, bevor sie rot werden können.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624516
    m_Localized: Hackt so schnell, dass die Zwiebeln nicht mal weinen können.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624517
    m_Localized: Ein karierter Tisch und bequeme Stühle für Pasta unter freiem Himmel.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624518
    m_Localized: Eine warme Laterne leuchtet neben der Tür.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624519
    m_Localized: Ein stolzes Capybara-Koch-Schild krönt das Dach.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624520
    m_Localized: Eine Kreidetafel mit den Pasta-Spezialitäten des Tages.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624521
    m_Localized: Soßen brutzeln doppelt so schnell.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624522
    m_Localized: Extra Brutzeln freigeschaltet. Die Pfanne glüht vor Stolz.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624523
    m_Localized: Frische Topfpflanzen, die den Eingang aufhellen.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013120
    m_Localized: Das Wasser kocht, bevor du al dente sagen kannst.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013121
    m_Localized: Eine brodelnde Legende, die Pasta in Warp-Geschwindigkeit kocht.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013122
    m_Localized: Eine pralle Weintraube schmückt das Dach.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013123
    m_Localized: Ein riesiger Teller Spaghetti, hoch oben auf dem Dach aufgewickelt!
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013124
    m_Localized: Zapft sprudelnde Limo im Handumdrehen.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013125
    m_Localized: Jede Menge Sprudel! Ein Brunnen voller Blubber und Freude.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013126
    m_Localized: Trattoria mit Obergeschoss
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013127
    m_Localized: Soßenmixer
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013128
    m_Localized: Soßentornado
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013129
    m_Localized: Flinkes Hackbrett
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013130
    m_Localized: Pasta-Ninja-Brett
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013131
    m_Localized: Terrassentisch
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013132
    m_Localized: Wandlaterne
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207424
    m_Localized: Capy-Koch-Schild
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207425
    m_Localized: Kreidetafel-Menü
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207426
    m_Localized: Brutzelpfanne
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207427
    m_Localized: Lodernde Pfanne
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207428
    m_Localized: Basilikum im Topf
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207429
    m_Localized: Schnellkochtopf
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207430
    m_Localized: Mega-Kochkessel
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207431
    m_Localized: Dachtrauben
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207432
    m_Localized: Riesenspaghetti
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207433
    m_Localized: Sprudelbrunnen
    m_Metadata:
      m_Items: []
  - m_Id: 2207008995401728
    m_Localized: Limo-Geysir
    m_Metadata:
      m_Items: []
  - m_Id: 2508025511272448
    m_Localized: Ein respekteinflößender Bär in Nadelstreifenanzug und Fedora mit Rosenband, der großzügige Pastaportionen und absoluten Respekt erwartet.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243968
    m_Localized: Eine stilvolle Tigerkatze mit lila Hut und passendem Kleid, die Pasta mit tadellosem Geschmack und zufriedenem Schnurren bestellt.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243969
    m_Localized: Ein ordentliches Chinchilla in blauer Postuniform, das zwischen den Zustellungen dem Duft frischer Pasta folgt.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243970
    m_Localized: Ein stolzer Hahn mit Zylinder und dreifarbiger Schärpe, der mit großen Reden über die Pastatheke wacht.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243971
    m_Localized: Ein sanftes Schaf mit runder Brille und Glöckchenschal, für das jeder Teller Pasta ein besonderer Anlass ist.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243972
    m_Localized: Apfel
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243973
