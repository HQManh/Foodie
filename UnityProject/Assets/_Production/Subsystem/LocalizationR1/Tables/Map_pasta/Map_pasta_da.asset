  m_Name: Map_pasta_da
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: da
  m_SharedData: {fileID: 11400000, guid: b8c57adbeaeeddd48bdbbb34b0659dca, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 2207008936681472
    m_Localized: Den hyggelige lille trattoria, hvor din pastahistorie begynder.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624512
    m_Localized: Giver din trattoria en hyggelig ovenpå-etage.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624513
    m_Localized: Pisker silkeblød sauce på et øjeblik.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624514
    m_Localized: En hvirvelvind af sauce. Låg kan varmt anbefales.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624515
    m_Localized: Tomaterne er skåret i tern, før de når at rødme.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624516
    m_Localized: Hakker så hurtigt, at løgene ikke engang når at græde.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624517
    m_Localized: Et ternet bord og bløde stole til pasta under åben himmel.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624518
    m_Localized: En varm lygte, der gløder ved døren.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624519
    m_Localized: Et stolt capybara-kokkeskilt, der kroner taget.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624520
    m_Localized: En kridttavle med dagens pastaretter.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624521
    m_Localized: Saucerne syder dobbelt så hurtigt.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624522
    m_Localized: Ekstra syden låst op. Panden gløder af stolthed.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624523
    m_Localized: Friske potteplanter, der lyser indgangen op.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013120
    m_Localized: Vandet koger, før du kan nå at sige al dente.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013121
    m_Localized: En boblende legende, der koger pasta med lynets hast.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013122
    m_Localized: En fyldig drueklase pynter taget.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013123
    m_Localized: En kæmpe tallerken spaghetti snoet højt oppe på taget!
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013124
    m_Localized: Hælder boblende sodavand op på et øjeblik.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013125
    m_Localized: Masser af brus! En fontæne af bobler og glæde.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013126
    m_Localized: Trattoria ovenpå
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013127
    m_Localized: Saucemixer
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013128
    m_Localized: Saucetornado
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013129
    m_Localized: Hurtighakkebræt
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013130
    m_Localized: Pasta-ninjabræt
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013131
    m_Localized: Terrassebord
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013132
    m_Localized: Væglygte
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207424
    m_Localized: Capy-kokkeskilt
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207425
    m_Localized: Kridttavle-menu
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207426
    m_Localized: Sydende pande
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207427
    m_Localized: Flammende pande
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207428
    m_Localized: Basilikum i potte
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207429
    m_Localized: Lynkoge-gryde
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207430
    m_Localized: Mega-kogekedel
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207431
    m_Localized: Tagdruer
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207432
    m_Localized: Kæmpe spaghetti
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207433
    m_Localized: Brusefontæne
    m_Metadata:
      m_Items: []
  - m_Id: 2207008995401728
    m_Localized: Sodavandsgejser
    m_Metadata:
      m_Items: []
  - m_Id: 2508025511272448
    m_Localized: En frygtindgydende bjørn i nålestribet jakkesæt og fedora med roser, som forventer store portioner pasta og absolut respekt.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243968
    m_Localized: En stilfuld stribet kat i lilla hat og matchende kjole, der bestiller pasta med upåklagelig smag og en tilfreds spinden.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243969
    m_Localized: En velordnet chinchilla i blå postuniform, der følger duften af frisk pasta mellem leveringerne.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243970
    m_Localized: En stolt hane i høj hat og trefarvet skærf, der præsiderer over pastadisken med store taler.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243971
    m_Localized: Et blidt får med runde briller og et halstørklæde med klokke, som betragter hver pastatallerken som en festlig lejlighed.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243972
    m_Localized: Æble
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243973
