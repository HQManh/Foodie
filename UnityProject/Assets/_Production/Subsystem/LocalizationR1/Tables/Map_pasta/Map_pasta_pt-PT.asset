  m_LocaleId:
    m_Code: pt-PT
  m_SharedData: {fileID: 11400000, guid: b8c57adbeaeeddd48bdbbb34b0659dca, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 2207008936681472
    m_Localized: A pequena trattoria acolhedora onde a sua história de massas começa.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624512
    m_Localized: Acrescenta um andar de cima acolhedor à sua trattoria.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624513
    m_Localized: Prepara um molho aveludado num instante.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624514
    m_Localized: Um remoinho de molho. Tampa vivamente recomendada.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624515
    m_Localized: Os tomates ficam em cubos antes de corarem.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624516
    m_Localized: Corta tão depressa que as cebolas nem têm tempo de chorar.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624517
    m_Localized: Uma mesa aos quadrados e cadeiras confortáveis para massa ao ar livre.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624518
    m_Localized: Uma lanterna acolhedora que brilha junto à porta.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624519
    m_Localized: Uma orgulhosa placa de capivara chef a coroar o telhado.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624520
    m_Localized: Um quadro de giz com as massas especiais do dia.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624521
    m_Localized: Os molhos crepitam duas vezes mais depressa.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624522
    m_Localized: Chiado extra desbloqueado. A frigideira brilha de orgulho.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624523
    m_Localized: Plantas frescas em vasos que alegram a entrada.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013120
    m_Localized: A água ferve antes de conseguir dizer al dente.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013121
    m_Localized: Uma lenda borbulhante que coze massa à velocidade da luz.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013122
    m_Localized: Um cacho de uvas bem cheio a enfeitar o telhado.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013123
    m_Localized: Um prato gigante de esparguete enrolado no alto do telhado!
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013124
    m_Localized: Serve refrigerante borbulhante num instante.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013125
    m_Localized: Muito gás! Uma fonte de bolhas e alegria.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013126
    m_Localized: Trattoria com Andar de Cima
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013127
    m_Localized: Liquidificadora de Molho
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013128
    m_Localized: Tornado de Molho
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013129
    m_Localized: Tábua Corta-Rápido
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013130
    m_Localized: Tábua Ninja da Massa
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013131
    m_Localized: Mesa de Esplanada
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013132
    m_Localized: Lanterna de Parede
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207424
    m_Localized: Placa Capy Chef
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207425
    m_Localized: Menu de Giz
    m_Metadata:
      m_Items: []
