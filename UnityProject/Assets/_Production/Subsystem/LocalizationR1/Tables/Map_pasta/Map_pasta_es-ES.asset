  m_LocaleId:
    m_Code: es-ES
  m_SharedData: {fileID: 11400000, guid: b8c57adbeaeeddd48bdbbb34b0659dca, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 2207008936681472
    m_Localized: La pequeña y acogedora trattoria donde empieza tu historia de pasta.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624512
    m_Localized: Añade una acogedora planta alta a tu trattoria.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624513
    m_Localized: Prepara una salsa sedosa en un instante.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624514
    m_Localized: Un torbellino de salsa. Tapa muy recomendada.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624515
    m_Localized: Los tomates se cortan en dados antes de que puedan sonrojarse.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624516
    m_Localized: Corta tan rápido que las cebollas ni siquiera llegan a llorar.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624517
    m_Localized: Una mesa de cuadros y sillas cómodas para comer pasta al aire libre.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624518
    m_Localized: Un farol cálido que brilla junto a la puerta.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624519
    m_Localized: Un orgulloso letrero de capibara chef corona el tejado.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624520
    m_Localized: Una pizarra con las pastas especiales del día.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624521
    m_Localized: Las salsas chisporrotean el doble de rápido.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624522
    m_Localized: Chisporroteo extra desbloqueado. La sartén brilla de orgullo.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624523
    m_Localized: Plantas frescas en macetas que alegran la entrada.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013120
    m_Localized: El agua hierve antes de que digas al dente.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013121
    m_Localized: Una leyenda burbujeante que cuece la pasta a la velocidad de la luz.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013122
    m_Localized: Un racimo de uvas bien lleno que adorna el tejado.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013123
    m_Localized: ¡Un plato gigante de espaguetis enrollados en lo alto del tejado!
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013124
    m_Localized: Sirve refresco burbujeante en un santiamén.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013125
    m_Localized: ¡Qué efervescencia! Una fuente de burbujas y alegría.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013126
    m_Localized: Trattoria con Planta Alta
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013127
    m_Localized: Licuadora Salsera
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013128
    m_Localized: Tornado de Salsa
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013129
    m_Localized: Tabla Corte Rápido
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013130
    m_Localized: Tabla Ninja de Pasta
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013131
    m_Localized: Mesa de Terraza
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013132
    m_Localized: Farol de Pared
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207424
    m_Localized: Letrero Capy Chef
    m_Metadata:
      m_Items: []
