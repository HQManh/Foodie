  m_LocaleId:
    m_Code: vi-VN
  m_SharedData: {fileID: 11400000, guid: b8c57adbeaeeddd48bdbbb34b0659dca, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 2207008936681472
    m_Localized: Quán trattoria nhỏ ấm cúng, nơi câu chuyện pasta của bạn bắt đầu.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624512
    m_Localized: Thêm một tầng trên ấm cúng cho quán trattoria của bạn.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624513
    m_Localized: Xay sốt mịn mượt chỉ trong chớp mắt.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624514
    m_Localized: Một cơn lốc nước sốt. Rất nên đậy nắp.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624515
    m_Localized: Cà chua được thái hạt lựu trước khi kịp đỏ mặt.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624516
    m_Localized: Băm nhanh đến mức hành tây chẳng kịp khóc.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624517
    m_Localized: Bàn khăn caro và ghế êm ái để thưởng thức pasta ngoài trời.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624518
    m_Localized: Chiếc đèn lồng ấm áp tỏa sáng cạnh cửa.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624519
    m_Localized: Biển capybara bếp trưởng kiêu hãnh trên mái nhà.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624520
    m_Localized: Bảng phấn ghi các món pasta đặc biệt hôm nay.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624521
    m_Localized: Nước sốt xèo xèo nhanh gấp đôi.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624522
    m_Localized: Mở khóa tiếng xèo xèo vượt trội. Chiếc chảo tự hào tỏa sáng.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624523
    m_Localized: Chậu cây xanh tươi làm bừng sáng lối vào.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013120
    m_Localized: Nước sôi trước khi bạn kịp nói al dente.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013121
    m_Localized: Huyền thoại sôi sùng sục luộc pasta nhanh như chớp.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013122
    m_Localized: Chùm nho căng mọng trang trí trên mái nhà.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013123
    m_Localized: Đĩa mì spaghetti khổng lồ cuộn cao trên mái nhà!
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013124
    m_Localized: Rót soda sủi tăm trong nháy mắt.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013125
    m_Localized: Ga sủi tưng bừng! Đài phun bong bóng và niềm vui.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013126
    m_Localized: Tầng Trên Trattoria
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013127
    m_Localized: Máy Xay Sốt
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013128
    m_Localized: Lốc Xoáy Sốt
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013129
    m_Localized: Thớt Băm Nhanh
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013130
    m_Localized: Thớt Ninja Pasta
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013131
    m_Localized: Bàn Hiên Ngoài
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013132
    m_Localized: Đèn Lồng Treo Tường
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207424
    m_Localized: Biển Bếp Trưởng Capy
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207425
    m_Localized: Bảng Menu Phấn
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207426
    m_Localized: Chảo Xèo Xèo
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207427
    m_Localized: Chảo Rực Lửa
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207428
    m_Localized: Chậu Húng Quế
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207429
    m_Localized: Nồi Luộc Thần Tốc
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207430
    m_Localized: Vạc Luộc Siêu Tốc
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207431
    m_Localized: Chùm Nho Mái Nhà
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207432
    m_Localized: Mì Spaghetti Khổng Lồ
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207433
    m_Localized: Vòi Soda Sủi Bọt
    m_Metadata:
      m_Items: []
  - m_Id: 2207008995401728
    m_Localized: Mạch Phun Soda
    m_Metadata:
      m_Items: []
  - m_Id: 2508025511272448
    m_Localized: Chú gấu oai vệ trong bộ vest sọc và mũ phớt cài hoa hồng, luôn muốn phần mì thật đầy và sự tôn trọng tuyệt đối.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243968
    m_Localized: Cô mèo mướp sành điệu với mũ tím và váy cùng màu, gọi mì với gu thưởng thức hoàn hảo cùng tiếng rừ rừ mãn nguyện.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243969
    m_Localized: Chú chinchilla gọn gàng trong bộ đồng phục bưu tá màu xanh, tranh thủ giữa các chuyến giao hàng để lần theo mùi mì tươi.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243970
    m_Localized: Chú gà trống kiêu hãnh đội mũ chóp cao, đeo dải băng ba màu, chủ trì quầy mì bằng những bài diễn văn hoành tráng.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243971
    m_Localized: Chú cừu hiền lành đeo kính tròn và khăn quàng có chuông, coi mỗi đĩa mì là một dịp trang trọng.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243972
    m_Localized: Táo
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243973
    m_Localized: Táo cắt
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243974
