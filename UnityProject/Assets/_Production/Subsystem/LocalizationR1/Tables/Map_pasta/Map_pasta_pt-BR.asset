  m_Name: Map_pasta_pt-BR
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: pt-BR
  m_SharedData: {fileID: 11400000, guid: b8c57adbeaeeddd48bdbbb34b0659dca, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 2207008936681472
    m_Localized: A pequena trattoria aconchegante onde sua história com massas começa.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624512
    m_Localized: Adiciona um andar de cima aconchegante à sua trattoria.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624513
    m_Localized: Prepara um molho sedoso num piscar de olhos.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624514
    m_Localized: Um redemoinho de molho. Tampa altamente recomendada.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624515
    m_Localized: Os tomates são picados antes mesmo de corar.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624516
    m_Localized: Corta tão rápido que as cebolas nem têm tempo de chorar.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624517
    m_Localized: Uma mesa xadrez e cadeiras confortáveis para comer massa ao ar livre.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624518
    m_Localized: Uma lanterna aconchegante que brilha ao lado da porta.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624519
    m_Localized: Uma orgulhosa placa de capivara chef no alto do telhado.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624520
    m_Localized: Um quadro de giz com as massas especiais do dia.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624521
    m_Localized: Os molhos chiam duas vezes mais rápido.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624522
    m_Localized: Chiado extra desbloqueado. A frigideira brilha de orgulho.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624523
    m_Localized: Plantas frescas em vasos que alegram a entrada.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013120
    m_Localized: A água ferve antes de você dizer al dente.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013121
    m_Localized: Uma lenda borbulhante que cozinha massa na velocidade da luz.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013122
    m_Localized: Um cacho de uvas bem cheio enfeitando o telhado.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013123
    m_Localized: Um prato gigante de espaguete enrolado no alto do telhado!
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013124
    m_Localized: Serve refri borbulhante num instante.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013125
    m_Localized: Muito gás! Uma fonte de bolhas e alegria.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013126
    m_Localized: Trattoria com Andar de Cima
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013127
    m_Localized: Liquidificador de Molho
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013128
    m_Localized: Tornado de Molho
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013129
    m_Localized: Tábua Corta-Rápido
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013130
    m_Localized: Tábua Ninja da Massa
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013131
    m_Localized: Mesa na Varanda
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013132
    m_Localized: Lanterna de Parede
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207424
    m_Localized: Placa Capy Chef
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207425
    m_Localized: Cardápio de Giz
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207426
    m_Localized: Frigideira Chiante
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207427
    m_Localized: Frigideira Flamejante
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207428
    m_Localized: Manjericão no Vaso
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207429
    m_Localized: Panela Ferve-Rápido
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207430
    m_Localized: Caldeirão Mega Fervura
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207431
    m_Localized: Uvas no Telhado
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207432
    m_Localized: Espaguete Gigante
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207433
    m_Localized: Fonte Borbulhante
    m_Metadata:
      m_Items: []
  - m_Id: 2207008995401728
    m_Localized: Gêiser de Refri
    m_Metadata:
      m_Items: []
  - m_Id: 2508025511272448
    m_Localized: Um urso imponente de terno risca de giz e chapéu fedora com rosa, que espera porções generosas de massa e respeito absoluto.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243968
    m_Localized: Uma gata malhada elegante, de chapéu roxo e vestido combinando, que pede massa com gosto impecável e um ronronar satisfeito.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243969
    m_Localized: Uma chinchila caprichada, de uniforme azul dos correios, que segue o aroma de massa fresca entre uma entrega e outra.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243970
    m_Localized: Um galo orgulhoso de cartola e faixa tricolor, que comanda o balcão de massas com grandes discursos.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243971
    m_Localized: Uma ovelha gentil de óculos redondos e cachecol com sininho, que trata cada prato de massa como uma ocasião especial.
    m_Metadata:
      m_Items: []
