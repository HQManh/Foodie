  m_Name: Map_pasta_ms
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: ms
  m_SharedData: {fileID: 11400000, guid: b8c57adbeaeeddd48bdbbb34b0659dca, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 2207008936681472
    m_Localized: Trattoria kecil yang selesa tempat kisah pasta anda bermula.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624512
    m_Localized: Menambah tingkat atas yang selesa untuk trattoria anda.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624513
    m_Localized: Membancuh sos lembut sekelip mata.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624514
    m_Localized: Pusaran sos. Penutup sangat disyorkan.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624515
    m_Localized: Tomato didadu sebelum sempat tersipu.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624516
    m_Localized: Mencincang begitu pantas, bawang pun tak sempat menangis.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624517
    m_Localized: Meja berkotak dan kerusi selesa untuk menikmati pasta di luar.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624518
    m_Localized: Tanglung hangat yang bersinar di sisi pintu.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624519
    m_Localized: Papan tanda cef kapibara yang megah menghiasi bumbung.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624520
    m_Localized: Papan kapur yang menyenaraikan pasta istimewa hari ini.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624521
    m_Localized: Sos berdesis dua kali lebih pantas.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624522
    m_Localized: Desis ekstra dibuka. Kuali bersinar penuh bangga.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624523
    m_Localized: Tumbuhan pasu segar yang menceriakan pintu masuk.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013120
    m_Localized: Air mendidih sebelum sempat anda sebut al dente.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013121
    m_Localized: Legenda menggelegak yang memasak pasta sepantas kilat.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013122
    m_Localized: Setandan anggur montok yang menghiasi bumbung.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013123
    m_Localized: Sepinggan besar spageti yang digulung tinggi di atas bumbung!
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013124
    m_Localized: Menuang soda berbuih dalam sekelip mata.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013125
    m_Localized: Buih melimpah! Pancutan gelembung dan keceriaan.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013126
    m_Localized: Trattoria Bertingkat
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013127
    m_Localized: Pengisar Sos
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013128
    m_Localized: Puting Beliung Sos
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013129
    m_Localized: Papan Cincang Pantas
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013130
    m_Localized: Papan Ninja Pasta
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013131
    m_Localized: Meja Laman
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013132
    m_Localized: Tanglung Dinding
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207424
    m_Localized: Papan Tanda Cef Capy
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207425
    m_Localized: Menu Kapur
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207426
    m_Localized: Kuali Berdesis
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207427
    m_Localized: Kuali Membara
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207428
    m_Localized: Selasih Pasu
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207429
    m_Localized: Periuk Rebus Pantas
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207430
    m_Localized: Kawah Rebus Mega
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207431
    m_Localized: Anggur Bumbung
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207432
    m_Localized: Spageti Gergasi
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207433
    m_Localized: Pancutan Berbuih
    m_Metadata:
      m_Items: []
  - m_Id: 2207008995401728
    m_Localized: Geiser Soda
    m_Metadata:
      m_Items: []
  - m_Id: 2508025511272448
    m_Localized: Beruang yang digeruni berpakaian sut berjalur dan topi fedora berhias mawar, yang mahukan hidangan pasta yang banyak dan rasa hormat mutlak.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243968
    m_Localized: Kucing belang yang bergaya dengan topi ungu dan gaun sepadan, memesan pasta dengan citarasa sempurna dan dengkuran puas.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243969
    m_Localized: Chinchilla yang kemas berpakaian seragam pos biru, mengikut aroma pasta segar di antara penghantaran.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243970
    m_Localized: Ayam jantan yang bangga bertopi tinggi dan berselempang tiga warna, mengetuai kaunter pasta dengan ucapan hebat.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243971
    m_Localized: Biri-biri yang lembut berkaca mata bulat dan berselendang loceng, yang menganggap setiap pinggan pasta satu majlis istimewa.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243972
    m_Localized: Epal
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243973
    m_Localized: Epal Dihiris
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243974
    m_Localized: Don Orsino
    m_Metadata:
