  m_Name: Map_pasta_it-IT
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: it-IT
  m_SharedData: {fileID: 11400000, guid: b8c57adbeaeeddd48bdbbb34b0659dca, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 2207008936681472
    m_Localized: La piccola trattoria accogliente dove inizia la tua storia di pasta.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624512
    m_Localized: Aggiunge un accogliente piano superiore alla tua trattoria.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624513
    m_Localized: Prepara un sugo vellutato in un lampo.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624514
    m_Localized: Un vortice di sugo. Coperchio vivamente consigliato.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624515
    m_Localized: I pomodori sono a cubetti prima ancora di arrossire.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624516
    m_Localized: Taglia così in fretta che le cipolle non fanno in tempo a piangere.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624517
    m_Localized: Un tavolo a quadretti e sedie comode per la pasta all'aperto.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624518
    m_Localized: Una lanterna calda che brilla accanto alla porta.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624519
    m_Localized: Una fiera insegna con il capibara chef in cima al tetto.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624520
    m_Localized: Una lavagna con le paste speciali del giorno.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624521
    m_Localized: I sughi sfrigolano due volte più in fretta.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624522
    m_Localized: Sfrigolio extra sbloccato. La padella brilla d'orgoglio.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624523
    m_Localized: Piante fresche in vaso che illuminano l'ingresso.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013120
    m_Localized: L'acqua bolle prima che tu possa dire al dente.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013121
    m_Localized: Una leggenda ribollente che cuoce la pasta a velocità supersonica.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013122
    m_Localized: Un bel grappolo d'uva che decora il tetto.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013123
    m_Localized: Un piatto gigante di spaghetti arrotolati in cima al tetto!
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013124
    m_Localized: Versa soda frizzante in un attimo.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013125
    m_Localized: Frizzante alla grande! Una fontana di bollicine e gioia.
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013126
    m_Localized: Trattoria al piano di sopra
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013127
    m_Localized: Frullatore Sugoso
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013128
    m_Localized: Tornado di Sugo
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013129
    m_Localized: Tagliere Svelto
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013130
    m_Localized: Tagliere Ninja della Pasta
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013131
    m_Localized: Tavolo all'aperto
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013132
    m_Localized: Lanterna da parete
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207424
    m_Localized: Insegna Capy Chef
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207425
    m_Localized: Menù sulla lavagna
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207426
    m_Localized: Padella Sfrigolante
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207427
    m_Localized: Padella Ardente
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207428
    m_Localized: Basilico in vaso
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207429
    m_Localized: Pentola Ebollizione Rapida
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207430
    m_Localized: Calderone Mega Bollore
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207431
    m_Localized: Uva sul tetto
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207432
    m_Localized: Spaghetti giganti
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207433
    m_Localized: Fontana Frizzante
    m_Metadata:
      m_Items: []
  - m_Id: 2207008995401728
    m_Localized: Geyser di Soda
    m_Metadata:
      m_Items: []
  - m_Id: 2508025511272448
    m_Localized: Un orso temibile in gessato e fedora con la rosa, che pretende porzioni di pasta generose e rispetto assoluto.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243968
    m_Localized: Un'elegante gatta tigrata con cappello viola e abito coordinato, che ordina la pasta con gusto impeccabile e fusa soddisfatte.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243969
    m_Localized: Un cincillà ordinato in divisa blu da postino, che tra una consegna e l'altra segue il profumo della pasta fresca.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243970
    m_Localized: Un gallo orgoglioso con cilindro e fascia tricolore, che presiede il bancone della pasta con grandi discorsi.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243971
    m_Localized: Una pecora gentile con occhiali tondi e sciarpa con campanella, per cui ogni piatto di pasta è un'occasione speciale.
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243972
    m_Localized: Mela
    m_Metadata:
