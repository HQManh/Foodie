  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: Map_pasta_zh-CN
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: zh-CN
  m_SharedData: {fileID: 11400000, guid: b8c57adbeaeeddd48bdbbb34b0659dca, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 2207008936681472
    m_Localized: 温馨的小意式餐馆，你的意面故事从这里开始。
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624512
    m_Localized: 为你的意式餐馆加盖一层温馨的二楼。
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624513
    m_Localized: 眨眼间就打出丝滑酱汁。
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624514
    m_Localized: 酱汁旋风来袭，强烈建议盖好盖子。
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624515
    m_Localized: 番茄还没来得及脸红就被切成丁了。
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624516
    m_Localized: 切得太快，洋葱都来不及哭。
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624517
    m_Localized: 铺着格子桌布的餐桌和舒适的椅子，在户外享用意面。
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624518
    m_Localized: 门边亮着一盏温暖的灯笼。
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624519
    m_Localized: 自豪的卡皮巴拉厨师招牌高挂屋顶。
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624520
    m_Localized: 写着今日特色意面的黑板。
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624521
    m_Localized: 酱汁滋滋作响，速度快一倍。
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624522
    m_Localized: 解锁更响的滋滋声。平底锅骄傲地发光。
    m_Metadata:
      m_Items: []
  - m_Id: 2207008978624523
    m_Localized: 新鲜的盆栽绿植，让门口更明亮。
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013120
    m_Localized: 还没来得及说“弹牙”，水就开了。
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013121
    m_Localized: 沸腾的传奇，以光速煮好意面。
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013122
    m_Localized: 一串饱满的葡萄装点着屋顶。
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013123
    m_Localized: 一大盘意大利面高高卷在屋顶上！
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013124
    m_Localized: 转眼就倒出冒泡的汽水。
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013125
    m_Localized: 气泡十足！泡泡与欢乐的喷泉。
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013126
    m_Localized: 意式餐馆二楼
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013127
    m_Localized: 酱汁搅拌机
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013128
    m_Localized: 酱汁龙卷风
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013129
    m_Localized: 快切砧板
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013130
    m_Localized: 意面忍者砧板
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013131
    m_Localized: 露台餐桌
    m_Metadata:
      m_Items: []
  - m_Id: 2207008987013132
    m_Localized: 壁灯
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207424
    m_Localized: 卡皮巴拉厨师招牌
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207425
    m_Localized: 粉笔菜单
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207426
    m_Localized: 滋滋平底锅
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207427
    m_Localized: 烈焰平底锅
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207428
    m_Localized: 盆栽罗勒
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207429
    m_Localized: 速沸煮锅
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207430
    m_Localized: 超级沸腾大锅
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207431
    m_Localized: 屋顶葡萄
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207432
    m_Localized: 巨型意大利面
    m_Metadata:
      m_Items: []
  - m_Id: 2207008991207433
    m_Localized: 气泡饮料机
    m_Metadata:
      m_Items: []
  - m_Id: 2207008995401728
    m_Localized: 汽水喷泉
    m_Metadata:
      m_Items: []
  - m_Id: 2508025511272448
    m_Localized: 一只身穿细条纹西装、头戴玫瑰饰边软呢帽的威严大熊，要的是满满的意面和绝对的尊重。
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243968
    m_Localized: 一只头戴紫色帽子、身穿同色连衣裙的时髦虎斑猫，点意面时品味无可挑剔，还会满足地呼噜。
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243969
    m_Localized: 一只穿着蓝色邮差制服的整洁龙猫，在送件间隙循着新鲜意面的香味而来。
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243970
    m_Localized: 一只头戴高礼帽、身披三色绶带的骄傲公鸡，在意面柜台前发表着宏伟的演说。
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243971
    m_Localized: 一只戴着圆框眼镜、系着铃铛围巾的温和绵羊，把每一盘意面都当作郑重的场合。
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243972
    m_Localized: 苹果
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243973
    m_Localized: 苹果块
    m_Metadata:
      m_Items: []
  - m_Id: 2508025532243974
    m_Localized: 奥尔西诺老大
    m_Metadata:
      m_Items: []
  - m_Id: 2508025536438272
    m_Localized: 烤牛排
    m_Metadata:
      m_Items: []
  - m_Id: 2508025536438273
    m_Localized: 生牛排
    m_Metadata:
      m_Items: []
  - m_Id: 2508025536438274
    m_Localized: 煮锅
    m_Metadata:
      m_Items: []
  - m_Id: 2508025536438275
    m_Localized: 烤面包
    m_Metadata:
      m_Items: []
  - m_Id: 2508025536438276
    m_Localized: 面包
    m_Metadata:
      m_Items: []
  - m_Id: 2508025536438277
    m_Localized: 卡特琳娜伯爵夫人
    m_Metadata:
      m_Items: []
  - m_Id: 2508025536438278
