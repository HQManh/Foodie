  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: Notifications_it-IT
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: it-IT
  m_SharedData: {fileID: 11400000, guid: aa4f23c3016fe6d4fa68e38c9fc52637, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 5935534694400
    m_Localized: I tuoi clienti hanno fame! Torna ad accendere i fornelli.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694401
    m_Localized: La piastra è calda e gli ordini si accumulano. È ora di cucinare!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694402
    m_Localized: Una nuova giornata al ristorante ti aspetta.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694403
    m_Localized: Le tue vite sono di nuovo piene. Pronto per un altro turno?
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694404
    m_Localized: Clienti affamati sono in fila fuori. Non farli aspettare!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694405
    m_Localized: La tua ricompensa giornaliera ti aspetta!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694406
    m_Localized: Il tuo staff sente la tua mancanza, chef! Passa a salutare.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694407
    m_Localized: Riesci a completare il prossimo giorno con 3 stelle?
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694408
    m_Localized: Sono appena arrivati ingredienti freschi. Cuciniamo qualcosa di buono!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694409
    m_Localized: Migliora il tuo ristorante e fallo diventare il più chiacchierato in città.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694410
    m_Localized: Boss Hogsworth chiede dove sia finito lo chef...
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694411
    m_Localized: Patatine croccanti, burger succosi. Vieni a servirli!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694412
    m_Localized: Una pausa ai fornelli? La tua cucina è pronta quando vuoi.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694413
    m_Localized: Guadagna monete oggi e regala ai tuoi utensili un bel miglioramento.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694414
    m_Localized: Sta iniziando l'ora di punta del pranzo. Prendi il grembiule!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694415
    m_Localized: La tua fama cresce! Continua a servire per sbloccare nuove ricompense.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694416
    m_Localized: Nuovi clienti hanno sentito parlare della tua cucina. Vieni a conoscerli!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694417
    m_Localized: Il caffè è pronto e le ciambelle aspettano. Apri il bar!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694418
    m_Localized: Un altro giorno? Il tuo ristorante ti chiama.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694419
    m_Localized: Servi in fretta, guadagna tanto e fai sorridere ogni cliente!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694420
    m_Localized: Chef, la cucina ha bisogno di te! Tocca per iniziare a cucinare.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
