  m_Name: Notifications_de-DE
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: de-DE
  m_SharedData: {fileID: 11400000, guid: aa4f23c3016fe6d4fa68e38c9fc52637, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 5935534694400
    m_Localized: Deine Gäste haben Hunger! Komm zurück und heiz die Küche an.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694401
    m_Localized: Die Grillplatte ist heiß und die Bestellungen stapeln sich. Zeit zu kochen!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694402
    m_Localized: Ein neuer Tag im Restaurant wartet auf dich.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694403
    m_Localized: Deine Leben sind wieder voll. Bereit für die nächste Schicht?
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694404
    m_Localized: Hungrige Gäste stehen Schlange. Lass sie nicht warten!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694405
    m_Localized: Deine tägliche Belohnung wartet!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694406
    m_Localized: Dein Team vermisst dich, Chef! Komm vorbei.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694407
    m_Localized: Schaffst du den nächsten Tag mit 3 Sternen?
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694408
    m_Localized: Frische Zutaten sind da. Lass uns etwas Leckeres kochen!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694409
    m_Localized: Verbessere dein Restaurant und werde Stadtgespräch.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694410
    m_Localized: Boss Hogsworth fragt, wo der Chef steckt...
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694411
    m_Localized: Die Pommes sind knusprig, die Burger saftig. Komm und servier sie!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694412
    m_Localized: Lust auf eine kleine Kochpause? Deine Küche ist bereit.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694413
    m_Localized: Verdiene heute Münzen und gönn deinen Küchengeräten ein glänzendes Upgrade.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694414
    m_Localized: Der Mittagsansturm beginnt. Schnapp dir deine Schürze!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694415
    m_Localized: Dein Ruhm wächst! Serviere weiter, um neue Belohnungen freizuschalten.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694416
    m_Localized: Neue Gäste haben von deiner Küche gehört. Komm und lern sie kennen!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694417
    m_Localized: Der Kaffee brüht und die Donuts warten. Öffne das Café!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694418
    m_Localized: Noch ein Tag? Dein Restaurant ruft.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694419
    m_Localized: Schnell servieren, groß verdienen und jeden Gast zum Lächeln bringen!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694420
    m_Localized: Chef, die Küche braucht dich! Tippe, um loszukochen.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
