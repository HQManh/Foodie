  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: Notifications_sv
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: sv
  m_SharedData: {fileID: 11400000, guid: aa4f23c3016fe6d4fa68e38c9fc52637, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 5935534694400
    m_Localized: Dina gäster är hungriga! Kom tillbaka och värm upp köket.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694401
    m_Localized: Stekhällen är het och beställningarna staplas. Dags att laga mat!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694402
    m_Localized: En ny dag på restaurangen väntar på dig.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694403
    m_Localized: Dina liv är fulla igen. Redo för ett nytt pass?
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694404
    m_Localized: Hungriga gäster köar utanför. Låt dem inte vänta!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694405
    m_Localized: Din dagliga belöning väntar!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694406
    m_Localized: Din personal saknar dig, chef! Kom och säg hej.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694407
    m_Localized: Klarar du nästa dag med 3 stjärnor?
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694408
    m_Localized: Färska ingredienser har precis kommit. Nu lagar vi något gott!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694409
    m_Localized: Uppgradera din restaurang och bli hela stadens samtalsämne.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694410
    m_Localized: Boss Hogsworth undrar vart kocken tog vägen...
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694411
    m_Localized: Pommes fritesen är krispiga och burgarna saftiga. Kom och servera!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694412
    m_Localized: Sugen på en matlagningspaus? Ditt kök är redo när du är.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694413
    m_Localized: Tjäna mynt i dag och ge dina köksredskap en glänsande uppgradering.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694414
    m_Localized: Lunchrusningen börjar. Ta på dig förklädet!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694415
    m_Localized: Din berömmelse växer! Fortsätt servera för att låsa upp nya belöningar.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694416
    m_Localized: Nya gäster har hört om din mat. Kom och träffa dem!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694417
    m_Localized: Kaffet bryggs och munkarna väntar. Öppna kaféet!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694418
    m_Localized: En dag till? Din restaurang kallar.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694419
    m_Localized: Servera snabbt, tjäna stort och håll varje gäst glad!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694420
    m_Localized: Kocken, köket behöver dig! Tryck för att börja laga mat.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
