MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Notifications_ja-JP
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: ja-JP
  m_SharedData: {fileID: 11400000, guid: aa4f23c3016fe6d4fa68e38c9fc52637, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 5935534694400
    m_Localized: お客さんがお腹を空かせています！キッチンに戻ってきて！
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694401
    m_Localized: 鉄板はアツアツ、注文は山積み。調理の時間です！
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694402
    m_Localized: レストランの新しい1日が待っています。
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694403
    m_Localized: ライフが満タンになりました。次のシフトの準備はいい？
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694404
    m_Localized: お腹ペコペコのお客さんが外で行列中。待たせないで！
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694405
    m_Localized: デイリー報酬を受け取れます！
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694406
    m_Localized: シェフ、スタッフが会いたがっています！顔を見せてあげて。
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694407
    m_Localized: 次の日を星3つでクリアできるかな？
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694408
    m_Localized: 新鮮な食材が届きました。おいしいものを作ろう！
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694409
    m_Localized: レストランを強化して、街の話題の店にしよう。
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694410
    m_Localized: ボス・ホグズワースが「シェフはどこだ」と言っています…
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694411
    m_Localized: ポテトはカリカリ、バーガーはジューシー。さあ出しに来て！
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694412
    m_Localized: ちょっと料理で息抜き？キッチンはいつでも準備OK。
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694413
    m_Localized: 今日コインを稼いで、キッチン道具をピカピカに強化しよう。
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694414
    m_Localized: ランチラッシュが始まるよ。エプロンを着けて！
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694415
    m_Localized: 名声が高まっています！料理を出し続けて新しい報酬を解放しよう。
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694416
    m_Localized: 新しいお客さんがあなたの料理のうわさを聞きつけたよ。会いに来て！
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694417
    m_Localized: コーヒーは抽出中、ドーナツもお待ちかね。カフェを開けよう！
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694418
    m_Localized: もう1日どう？レストランが呼んでいます。
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694419
    m_Localized: 素早く出して、たっぷり稼いで、お客さん全員を笑顔に！
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694420
    m_Localized: シェフ、キッチンが呼んでいます！タップして調理開始。
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
