  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: Notifications_es-ES
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: es-ES
  m_SharedData: {fileID: 11400000, guid: aa4f23c3016fe6d4fa68e38c9fc52637, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 5935534694400
    m_Localized: ¡Tus clientes tienen hambre! Vuelve y enciende la cocina.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694401
    m_Localized: La plancha está caliente y los pedidos se acumulan. ¡Hora de cocinar!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694402
    m_Localized: Un nuevo día en el restaurante te espera.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694403
    m_Localized: Tus vidas están llenas otra vez. ¿Listo para otro turno?
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694404
    m_Localized: Hay clientes hambrientos haciendo cola fuera. ¡No los hagas esperar!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694405
    m_Localized: ¡Tu recompensa diaria está lista!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694406
    m_Localized: ¡Tu equipo te echa de menos, chef! Ven a saludar.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694407
    m_Localized: ¿Puedes superar el siguiente día con 3 estrellas?
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694408
    m_Localized: Acaban de llegar ingredientes frescos. ¡Cocinemos algo rico!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694409
    m_Localized: Mejora tu restaurante y conviértelo en la sensación de la ciudad.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694410
    m_Localized: El jefe Hogsworth pregunta dónde se ha metido el chef...
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694411
    m_Localized: Las patatas están crujientes y las hamburguesas jugosas. ¡Ven a servirlas!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694412
    m_Localized: ¿Un descanso para cocinar? Tu cocina está lista cuando tú lo estés.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694413
    m_Localized: Gana monedas hoy y dales a tus utensilios una mejora reluciente.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694414
    m_Localized: Empieza la hora punta del almuerzo. ¡Ponte el delantal!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694415
    m_Localized: ¡Tu fama crece! Sigue sirviendo para desbloquear nuevas recompensas.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694416
    m_Localized: Nuevos clientes han oído hablar de tu cocina. ¡Ven a conocerlos!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694417
    m_Localized: El café se está haciendo y los dónuts esperan. ¡Abre la cafetería!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694418
    m_Localized: ¿Un día más? Tu restaurante te llama.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694419
    m_Localized: ¡Sirve rápido, gana mucho y haz sonreír a todos tus clientes!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694420
    m_Localized: ¡Chef, la cocina te necesita! Toca para empezar a cocinar.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
