  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: Notifications_hu
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: hu
  m_SharedData: {fileID: 11400000, guid: aa4f23c3016fe6d4fa68e38c9fc52637, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 5935534694400
    m_Localized: Éhesek a vendégeid! Gyere vissza, és indítsd be a konyhát.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694401
    m_Localized: Forró a sütőlap, és gyűlnek a rendelések. Ideje főzni!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694402
    m_Localized: Új nap vár rád az étteremben.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694403
    m_Localized: Ismét tele vannak az életeid. Jöhet a következő műszak?
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694404
    m_Localized: Éhes vendégek sorakoznak odakint. Ne várakoztasd őket!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694405
    m_Localized: A napi jutalmad átvehető!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694406
    m_Localized: Hiányzol a személyzetnek, séf! Gyere, köszönj be.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694407
    m_Localized: Meg tudod csinálni a következő napot 3 csillaggal?
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694408
    m_Localized: Friss hozzávalók érkeztek. Főzzünk valami finomat!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694409
    m_Localized: Fejleszd az éttermed, és legyen a város szóbeszéde.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694410
    m_Localized: Hogsworth főnök azt kérdezi, hová tűnt a séf...
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694411
    m_Localized: Ropogós a sült krumpli, szaftos a burger. Gyere, és szolgáld fel őket!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694412
    m_Localized: Egy kis főzős szünet? A konyhád készen áll.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694413
    m_Localized: Szerezz ma érméket, és fejleszd fel a konyhai eszközeidet.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694414
    m_Localized: Kezdődik az ebédcsúcs. Fel a kötényt!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694415
    m_Localized: Nő a hírneved! Szolgálj fel tovább, hogy új jutalmakat oldj fel.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694416
    m_Localized: Új vendégek hallottak a főztödről. Gyere, ismerd meg őket!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694417
    m_Localized: Fő a kávé, és várnak a fánkok. Nyisd ki a kávézót!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694418
    m_Localized: Még egy nap? Hív az éttermed.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694419
    m_Localized: Szolgálj fel gyorsan, keress sokat, és minden vendég mosolyogjon!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694420
    m_Localized: Séf, szükség van rád a konyhában! Koppints, és kezdd a főzést.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
