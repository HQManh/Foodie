  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Notifications_ms
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: ms
  m_SharedData: {fileID: 11400000, guid: aa4f23c3016fe6d4fa68e38c9fc52637, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 5935534694400
    m_Localized: Pelanggan anda lapar! Kembali dan hidupkan dapur.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694401
    m_Localized: Plat pemanggang sudah panas dan pesanan bertimbun. Masa untuk memasak!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694402
    m_Localized: Hari baharu di restoran sedang menanti anda.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694403
    m_Localized: Nyawa anda penuh semula. Sedia untuk syif seterusnya?
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694404
    m_Localized: Tetamu yang lapar sedang beratur di luar. Jangan biar mereka menunggu!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694405
    m_Localized: Ganjaran harian anda sedia dituntut!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694406
    m_Localized: Kakitangan anda rindukan anda, cef! Datang dan tegur mereka.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694407
    m_Localized: Bolehkah anda menamatkan hari seterusnya dengan 3 bintang?
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694408
    m_Localized: Bahan segar baru tiba. Jom masak sesuatu yang sedap!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694409
    m_Localized: Naik taraf restoran anda dan jadikannya buah mulut orang ramai.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694410
    m_Localized: Bos Hogsworth bertanya ke mana cef pergi...
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694411
    m_Localized: Kentang goreng rangup, burger berjus. Mari hidangkan!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694412
    m_Localized: Rehat seketika dengan memasak? Dapur anda sedia bila-bila masa.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694413
    m_Localized: Kumpul syiling hari ini dan beri peralatan dapur anda naik taraf berkilat.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694414
    m_Localized: Waktu puncak makan tengah hari bermula. Pakai apron anda!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694415
    m_Localized: Kemasyhuran anda semakin meningkat! Terus hidang untuk membuka ganjaran baharu.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694416
    m_Localized: Pelanggan baharu dengar tentang masakan anda. Mari berjumpa mereka!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694417
    m_Localized: Kopi sedang dibancuh dan donat menanti. Buka kafe!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694418
    m_Localized: Satu hari lagi? Restoran anda memanggil.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694419
    m_Localized: Hidang pantas, raih untung besar dan buat semua pelanggan tersenyum!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694420
    m_Localized: Cef, dapur memerlukan anda! Ketik untuk mula memasak.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
