  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Notifications_pt-BR
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: pt-BR
  m_SharedData: {fileID: 11400000, guid: aa4f23c3016fe6d4fa68e38c9fc52637, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 5935534694400
    m_Localized: Seus clientes estão com fome! Volte e acenda a cozinha.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694401
    m_Localized: A chapa está quente e os pedidos estão acumulando. Hora de cozinhar!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694402
    m_Localized: Um novo dia no restaurante espera por você.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694403
    m_Localized: Suas vidas estão cheias de novo. Pronto para mais um turno?
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694404
    m_Localized: Clientes famintos estão fazendo fila lá fora. Não os deixe esperando!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694405
    m_Localized: Sua recompensa diária está pronta para resgate!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694406
    m_Localized: Sua equipe está com saudade, chef! Venha dar um oi.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694407
    m_Localized: Consegue concluir o próximo dia com 3 estrelas?
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694408
    m_Localized: Ingredientes frescos acabaram de chegar. Vamos cozinhar algo gostoso!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694409
    m_Localized: Melhore seu restaurante e faça dele o assunto da cidade.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694410
    m_Localized: O Chefão Hogsworth está perguntando onde o chef foi parar...
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694411
    m_Localized: As batatas estão crocantes e os hambúrgueres suculentos. Venha servir!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694412
    m_Localized: Que tal uma pausa para cozinhar? Sua cozinha está pronta quando você quiser.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694413
    m_Localized: Ganhe moedas hoje e dê uma melhoria brilhante aos seus utensílios.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694414
    m_Localized: O movimento do almoço está começando. Pegue seu avental!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694415
    m_Localized: Sua fama está crescendo! Continue servindo para desbloquear novas recompensas.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694416
    m_Localized: Novos clientes ouviram falar da sua comida. Venha conhecê-los!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694417
    m_Localized: O café está passando e os donuts estão esperando. Abra o café!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694418
    m_Localized: Mais um dia? Seu restaurante está chamando.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694419
    m_Localized: Sirva rápido, ganhe muito e mantenha todos os clientes sorrindo!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694420
    m_Localized: Chef, a cozinha precisa de você! Toque para começar a cozinhar.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
