  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Notifications_id-ID
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: id-ID
  m_SharedData: {fileID: 11400000, guid: aa4f23c3016fe6d4fa68e38c9fc52637, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 5935534694400
    m_Localized: Pelangganmu lapar! Ayo kembali dan nyalakan dapur.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694401
    m_Localized: Panggangan sudah panas dan pesanan menumpuk. Waktunya memasak!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694402
    m_Localized: Hari baru di restoran menantimu.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694403
    m_Localized: Nyawamu sudah penuh lagi. Siap untuk shift berikutnya?
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694404
    m_Localized: Tamu yang lapar sudah antre di luar. Jangan biarkan mereka menunggu!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694405
    m_Localized: Hadiah harianmu siap diklaim!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694406
    m_Localized: Stafmu rindu padamu, chef! Ayo mampir.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694407
    m_Localized: Bisakah kamu menuntaskan hari berikutnya dengan 3 bintang?
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694408
    m_Localized: Bahan segar baru tiba. Ayo masak sesuatu yang lezat!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694409
    m_Localized: Tingkatkan restoranmu dan jadikan buah bibir kota.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694410
    m_Localized: Bos Hogsworth bertanya ke mana sang koki pergi...
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694411
    m_Localized: Kentang goreng renyah, burger juicy. Ayo sajikan!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694412
    m_Localized: Rehat sejenak dengan memasak? Dapurmu siap kapan saja.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694413
    m_Localized: Kumpulkan koin hari ini dan beri alat dapurmu peningkatan yang berkilau.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694414
    m_Localized: Jam sibuk makan siang dimulai. Pakai celemekmu!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694415
    m_Localized: Ketenaranmu makin besar! Terus sajikan untuk membuka hadiah baru.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694416
    m_Localized: Pelanggan baru mendengar tentang masakanmu. Ayo temui mereka!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694417
    m_Localized: Kopi sedang diseduh dan donat menunggu. Buka kafenya!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694418
    m_Localized: Satu hari lagi? Restoranmu memanggil.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694419
    m_Localized: Sajikan dengan cepat, raih untung besar, dan buat semua pelanggan tersenyum!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694420
    m_Localized: Chef, dapur membutuhkanmu! Ketuk untuk mulai memasak.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
