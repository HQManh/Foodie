  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Notifications_vi-VN
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: vi-VN
  m_SharedData: {fileID: 11400000, guid: aa4f23c3016fe6d4fa68e38c9fc52637, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 5935534694400
    m_Localized: Khách đang đói rồi! Quay lại và nhóm bếp thôi.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694401
    m_Localized: Vỉ nướng đã nóng, đơn hàng chất đống. Vào bếp thôi!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694402
    m_Localized: Một ngày mới ở nhà hàng đang chờ bạn.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694403
    m_Localized: Mạng đã đầy trở lại. Sẵn sàng cho ca tiếp theo chưa?
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694404
    m_Localized: Khách đói đang xếp hàng bên ngoài. Đừng để họ chờ!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694405
    m_Localized: Phần thưởng hằng ngày đã sẵn sàng!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694406
    m_Localized: Bếp trưởng ơi, nhân viên nhớ bạn lắm! Ghé chào nhé.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694407
    m_Localized: Bạn có thể vượt qua ngày tiếp theo với 3 sao không?
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694408
    m_Localized: Nguyên liệu tươi vừa về. Cùng nấu món gì ngon nào!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694409
    m_Localized: Nâng cấp nhà hàng để cả thành phố bàn tán.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694410
    m_Localized: Sếp Hogsworth đang hỏi bếp trưởng đi đâu rồi...
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694411
    m_Localized: Khoai chiên giòn rụm, burger mọng nước. Mau đến phục vụ nào!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694412
    m_Localized: Nghỉ ngơi bằng chút nấu nướng nhé? Bếp luôn sẵn sàng.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694413
    m_Localized: Kiếm xu hôm nay và nâng cấp dụng cụ bếp thật sáng bóng.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694414
    m_Localized: Giờ cao điểm bữa trưa bắt đầu rồi. Mặc tạp dề vào thôi!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694415
    m_Localized: Danh tiếng của bạn đang tăng! Tiếp tục phục vụ để mở khóa phần thưởng mới.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694416
    m_Localized: Khách mới đã nghe danh tài nấu nướng của bạn. Đến gặp họ nào!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694417
    m_Localized: Cà phê đang pha, bánh donut đang chờ. Mở quán thôi!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694418
    m_Localized: Thêm một ngày nữa nhé? Nhà hàng đang gọi bạn.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694419
    m_Localized: Phục vụ nhanh, kiếm thật nhiều và giữ nụ cười cho mọi thực khách!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694420
    m_Localized: Bếp trưởng ơi, căn bếp cần bạn! Chạm để bắt đầu nấu.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
