  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: Notifications_zh-CN
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: zh-CN
  m_SharedData: {fileID: 11400000, guid: aa4f23c3016fe6d4fa68e38c9fc52637, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 5935534694400
    m_Localized: 顾客们饿坏了！快回来开火做饭吧。
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694401
    m_Localized: 煎板已经热好，订单越堆越多。该做饭啦！
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694402
    m_Localized: 餐厅新的一天正等着你。
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694403
    m_Localized: 爱心已经回满。准备好再上一班了吗？
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694404
    m_Localized: 饥肠辘辘的客人在门外排起了长队，别让他们久等！
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694405
    m_Localized: 每日奖励已可领取！
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694406
    m_Localized: 大厨，员工们想你了！快来打个招呼吧。
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694407
    m_Localized: 你能三星完成下一天吗？
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694408
    m_Localized: 新鲜食材刚刚到货。来做点好吃的吧！
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694409
    m_Localized: 升级你的餐厅，让它成为全城热议的焦点。
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694410
    m_Localized: 猪老板正在问大厨去哪儿了……
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694411
    m_Localized: 薯条酥脆，汉堡多汁。快来上菜吧！
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694412
    m_Localized: 想做饭放松一下吗？厨房随时等你。
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694413
    m_Localized: 今天多赚点金币，给厨具来个闪亮升级吧。
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694414
    m_Localized: 午餐高峰开始了。快系上围裙！
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694415
    m_Localized: 你的名气越来越大！继续上菜解锁新奖励吧。
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694416
    m_Localized: 新顾客听说了你的手艺，快来见见他们吧！
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694417
    m_Localized: 咖啡正在冲煮，甜甜圈也等着你。开张咖啡馆吧！
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694418
    m_Localized: 再来一天？你的餐厅在呼唤你。
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694419
    m_Localized: 上菜要快，赚得要多，让每位顾客都笑逐颜开！
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694420
    m_Localized: 大厨，厨房需要你！点击开始烹饪。
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
