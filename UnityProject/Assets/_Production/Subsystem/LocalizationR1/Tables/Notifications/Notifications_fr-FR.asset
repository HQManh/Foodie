  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: Notifications_fr-FR
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: fr-FR
  m_SharedData: {fileID: 11400000, guid: aa4f23c3016fe6d4fa68e38c9fc52637, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 5935534694400
    m_Localized: Vos clients ont faim ! Revenez allumer les fourneaux.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694401
    m_Localized: La plaque est chaude et les commandes s'accumulent. À vos fourneaux !
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694402
    m_Localized: Une nouvelle journée au restaurant vous attend.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694403
    m_Localized: Vos vies sont rechargées. Prêt pour un nouveau service ?
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694404
    m_Localized: Des clients affamés font la queue dehors. Ne les faites pas attendre !
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694405
    m_Localized: Votre récompense quotidienne est prête !
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694406
    m_Localized: Votre équipe vous manque, chef ! Venez dire bonjour.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694407
    m_Localized: Pouvez-vous finir le jour suivant avec 3 étoiles ?
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694408
    m_Localized: Des ingrédients frais viennent d'arriver. Cuisinons quelque chose de bon !
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694409
    m_Localized: Améliorez votre restaurant et faites-en la star du quartier.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694410
    m_Localized: Boss Hogsworth demande où est passé le chef...
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694411
    m_Localized: Les frites sont croustillantes, les burgers juteux. Venez les servir !
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694412
    m_Localized: Une petite pause cuisine ? Votre cuisine vous attend.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694413
    m_Localized: Gagnez des pièces aujourd'hui et offrez une belle amélioration à vos ustensiles.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694414
    m_Localized: Le coup de feu du midi commence. Enfilez votre tablier !
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694415
    m_Localized: Votre renommée grandit ! Continuez à servir pour débloquer de nouvelles récompenses.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694416
    m_Localized: De nouveaux clients ont entendu parler de votre cuisine. Venez les rencontrer !
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694417
    m_Localized: Le café infuse et les donuts attendent. Ouvrez le café !
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694418
    m_Localized: Encore une journée ? Votre restaurant vous appelle.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694419
    m_Localized: Servez vite, gagnez gros et gardez tous vos clients souriants !
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694420
    m_Localized: Chef, la cuisine a besoin de vous ! Touchez pour cuisiner.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
