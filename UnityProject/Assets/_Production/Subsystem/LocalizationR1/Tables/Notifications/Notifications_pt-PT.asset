  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Notifications_pt-PT
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: pt-PT
  m_SharedData: {fileID: 11400000, guid: aa4f23c3016fe6d4fa68e38c9fc52637, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 5935534694400
    m_Localized: Os teus clientes têm fome! Volta e acende a cozinha.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694401
    m_Localized: A chapa está quente e os pedidos acumulam-se. Hora de cozinhar!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694402
    m_Localized: Um novo dia no restaurante está à tua espera.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694403
    m_Localized: As tuas vidas estão cheias outra vez. Pronto para mais um turno?
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694404
    m_Localized: Clientes esfomeados fazem fila lá fora. Não os deixes à espera!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694405
    m_Localized: A tua recompensa diária está pronta!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694406
    m_Localized: A tua equipa tem saudades, chef! Vem dizer olá.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694407
    m_Localized: Consegues concluir o próximo dia com 3 estrelas?
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694408
    m_Localized: Acabaram de chegar ingredientes frescos. Vamos cozinhar algo saboroso!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694409
    m_Localized: Melhora o teu restaurante e torna-o o assunto da cidade.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694410
    m_Localized: O Chefe Hogsworth pergunta onde se meteu o chef...
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694411
    m_Localized: As batatas estão estaladiças e os hambúrgueres suculentos. Vem servi-los!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694412
    m_Localized: Uma pausa para cozinhar? A tua cozinha está pronta quando quiseres.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694413
    m_Localized: Ganha moedas hoje e dá uma melhoria brilhante aos teus utensílios.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694414
    m_Localized: A hora de ponta do almoço está a começar. Veste o avental!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694415
    m_Localized: A tua fama está a crescer! Continua a servir para desbloquear novas recompensas.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694416
    m_Localized: Novos clientes ouviram falar da tua comida. Vem conhecê-los!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694417
    m_Localized: O café está a fazer-se e os donuts estão à espera. Abre o café!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694418
    m_Localized: Mais um dia? O teu restaurante está a chamar.
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694419
    m_Localized: Serve depressa, ganha muito e mantém todos os clientes a sorrir!
    m_Metadata:
      m_Items: []
  - m_Id: 5935534694420
    m_Localized: Chef, a cozinha precisa de ti! Toca para começar a cozinhar.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
