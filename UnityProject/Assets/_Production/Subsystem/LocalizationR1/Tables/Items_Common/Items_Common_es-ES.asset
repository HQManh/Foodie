  m_TableData:
  - m_Id: 57744517226496
    m_Localized: Corazones ilimitados
    m_Metadata:
      m_Items: []
  - m_Id: 57744529809408
    m_Localized: Proporciona corazones ilimitados durante un tiempo limitado.
    m_Metadata:
      m_Items: []
  - m_Id: 57744529809409
    m_Localized: Sin anuncios
    m_Metadata:
      m_Items: []
  - m_Id: 57744529809410
    m_Localized: Elimina para siempre los anuncios obligatorios y los banners.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772544
    m_Localized: Cocina un plato automáticamente al instante.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772545
    m_Localized: Retira una pila sucia de la mesa.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772546
    m_Localized: Elige libremente un plato de ingredientes.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772547
    m_Localized: Restaura el tiempo de espera de los clientes para que se queden más.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772548
    m_Localized: Intercambia las filas de ingredientes.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772549
    m_Localized: Ningún chef cocina sin pasión en el corazón
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772550
    m_Localized: "¡Muestra cuánto adora la gente tu restaurante!\r\n¡Cuanta más fama, más sorpresas descubrirás!"
    m_Metadata:
      m_Items: []
