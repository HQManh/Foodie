  m_TableData:
  - m_Id: 57744517226496
    m_Localized: Tim vô hạn
    m_Metadata:
      m_Items: []
  - m_Id: 57744529809408
    m_Localized: Cung cấp tim không giới hạn trong thời gian có hạn.
    m_Metadata:
      m_Items: []
  - m_Id: 57744529809409
    m_Localized: Không quảng cáo
    m_Metadata:
      m_Items: []
  - m_Id: 57744529809410
    m_Localized: Xóa vĩnh viễn quảng cáo bắt buộc và quảng cáo biểu ngữ.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772544
    m_Localized: Tự động nấu xong một món ngay lập tức.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772545
    m_Localized: Dọn một chồng bẩn trên bàn.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772546
    m_Localized: Tự do chọn một đĩa nguyên liệu.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772547
    m_Localized: Hồi lại thời gian chờ để khách ở lại lâu hơn.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772548
    m_Localized: Đổi các hàng nguyên liệu.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772549
    m_Localized: Không đầu bếp nào nấu ăn được mà thiếu đam mê
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772550
    m_Localized: "Cho thấy mọi người yêu nhà hàng của bạn đến mức nào!\r\nDanh tiếng càng cao, bất ngờ càng nhiều!"
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772551
    m_Localized: Tự nấu
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772552
    m_Localized: Chổi quét
    m_Metadata:
      m_Items: []
