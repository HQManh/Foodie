  m_TableData:
  - m_Id: 57744517226496
    m_Localized: Sınırsız Kalp
    m_Metadata:
      m_Items: []
  - m_Id: 57744529809408
    m_Localized: Sınırlı bir süre boyunca sınırsız kalp sağlar.
    m_Metadata:
      m_Items: []
  - m_Id: 57744529809409
    m_Localized: Reklamsız
    m_Metadata:
      m_Items: []
  - m_Id: 57744529809410
    m_Localized: Zorunlu ve banner reklamları kalıcı olarak kaldırır.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772544
    m_Localized: Bir yemeği anında otomatik pişirir.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772545
    m_Localized: Masadaki kirli bir yığını kaldırır.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772546
    m_Localized: Dilediğin bir malzeme tabağını seç.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772547
    m_Localized: Müşterilerin bekleme süresini yenileyerek daha uzun kalmalarını sağlar.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772548
    m_Localized: Malzeme sıralarını değiştirir.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772549
    m_Localized: Hiçbir şef yüreğinde tutku olmadan yemek yapamaz
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772550
    m_Localized: "İnsanların restoranını ne kadar sevdiğini gösterir!\r\nŞöhretin arttıkça daha çok sürpriz keşfedersin!"
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772551
