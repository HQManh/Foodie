  m_TableData:
  - m_Id: 57744517226496
    m_Localized: Hati Tanpa Had
    m_Metadata:
      m_Items: []
  - m_Id: 57744529809408
    m_Localized: Memberi hati tanpa had untuk masa terhad.
    m_Metadata:
      m_Items: []
  - m_Id: 57744529809409
    m_Localized: Tanpa Iklan
    m_Metadata:
      m_Items: []
  - m_Id: 57744529809410
    m_Localized: Membuang iklan wajib dan iklan sepanduk secara kekal.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772544
    m_Localized: Memasak satu hidangan secara automatik dengan serta-merta.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772545
    m_Localized: Buang satu timbunan kotor di atas meja.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772546
    m_Localized: Pilih mana-mana satu pinggan bahan.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772547
    m_Localized: Pulihkan masa menunggu pelanggan supaya mereka tinggal lebih lama.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772548
    m_Localized: Tukar baris bahan.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772549
    m_Localized: Tiada cef boleh memasak tanpa semangat di hati
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772550
    m_Localized: "Menunjukkan betapa orang sayang restoran anda!\nLebih tinggi kemasyhuran, lebih banyak kejutan!"
    m_Metadata:
      m_Items: []
