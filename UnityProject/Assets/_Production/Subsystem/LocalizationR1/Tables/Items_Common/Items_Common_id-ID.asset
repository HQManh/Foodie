  m_TableData:
  - m_Id: 57744517226496
    m_Localized: Hati Tanpa Batas
    m_Metadata:
      m_Items: []
  - m_Id: 57744529809408
    m_Localized: Memberikan hati tanpa batas untuk waktu terbatas.
    m_Metadata:
      m_Items: []
  - m_Id: 57744529809409
    m_Localized: Tanpa Iklan
    m_Metadata:
      m_Items: []
  - m_Id: 57744529809410
    m_Localized: Menghapus iklan wajib dan banner secara permanen.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772544
    m_Localized: Memasak satu hidangan secara otomatis dan instan.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772545
    m_Localized: Singkirkan satu tumpukan kotor di meja.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772546
    m_Localized: Pilih satu piring bahan sesukamu.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772547
    m_Localized: Pulihkan waktu tunggu pelanggan agar mereka bertahan lebih lama.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772548
    m_Localized: Tukar baris bahan.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772549
    m_Localized: Tak ada koki yang bisa memasak tanpa semangat di hati
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772550
    m_Localized: "Menunjukkan seberapa besar orang menyukai restoranmu!\nMakin tinggi ketenaranmu, makin banyak kejutan!"
    m_Metadata:
      m_Items: []
