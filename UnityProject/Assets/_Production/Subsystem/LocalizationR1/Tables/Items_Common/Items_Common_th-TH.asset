  m_SharedData: {fileID: 11400000, guid: 783f61c07b0942044a0937e31a5230d8, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 57744517226496
    m_Localized: หัวใจ​ไม่​จำกัด
    m_Metadata:
      m_Items: []
  - m_Id: 57744529809408
    m_Localized: ได้​รับ​หัวใจ​ไม่​จำกัด​ใน​ช่วง​เวลา​หนึ่ง
    m_Metadata:
      m_Items: []
  - m_Id: 57744529809409
    m_Localized: ไม่มี​โฆษณา
    m_Metadata:
      m_Items: []
  - m_Id: 57744529809410
    m_Localized: ลบ​โฆษณา​บังคับ​และ​แบนเนอร์​อย่าง​ถาวร
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772544
    m_Localized: ทำ​อาหาร​หนึ่ง​จาน​ให้​อัตโนมัติ​ทันที
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772545
    m_Localized: เก็บ​กอง​จาน​สกปรก​บน​โต๊ะ​หนึ่ง​กอง
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772546
    m_Localized: เลือก​จาน​วัตถุดิบ​ได้​อิสระ​หนึ่ง​จาน
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772547
    m_Localized: ฟื้น​เวลา​รอ​ของ​ลูกค้า​ให้​พวก​เขา​อยู่​นาน​ขึ้น
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772548
    m_Localized: สลับ​แถว​วัตถุดิบ
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772549
    m_Localized: ไม่มี​เชฟ​คน​ไหน​ทำ​อาหาร​ได้​โดย​ไม่มี​ใจ​รัก
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772550
    m_Localized: "บอก​ว่า​ผู้คน​รัก​ร้าน​ของ​คุณ​มาก​แค่​ไหน!\r\nยิ่ง​มีชื่อ​เสียง ยิ่ง​เจอ​เซอร์ไพรส์​มาก​ขึ้น!"
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772551
    m_Localized: ทำ​อาหาร​อัตโนมัติ
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772552
    m_Localized: ไม้กวาด
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772553
    m_Localized: ที่​คีบ
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772554
    m_Localized: ลูกค้า​ใจเย็น
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772555
    m_Localized: สลับ​แถว
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772556
    m_Localized: ร้าน​เบอร์​เกอร์
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772557
    m_Localized: กาแฟ​และ​เบ​เก​อรี่
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772558
    m_Localized: เพชร
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772559
    m_Localized: ความ​หลงใหล​ใน​การ​ทำ​อาหาร
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772560
    m_Localized: ชื่อ​เสียง​ร้าน​อาหาร
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772561
    m_Localized: ซูชิ
    m_Metadata:
      m_Items: []
  - m_Id: 5836111170494464
    m_Localized: ไอศกรีม
    m_Metadata:
      m_Items: []
  - m_Id: 5836111191465984
    m_Localized: พาส​ต้า
    m_Metadata:
      m_Items: []
  - m_Id: 5867060067295232
    m_Localized: เตา​อบ​บร​อย​เลอ​ร์
    m_Metadata:
      m_Items: []
  - m_Id: 5867060105043968
    m_Localized: เตา​ย่าง​ถ่าน
    m_Metadata:
      m_Items: []
  - m_Id: 5867060105043969
    m_Localized: กระทะ​ผัด
    m_Metadata:
      m_Items: []
  - m_Id: 5867060105043970
    m_Localized: เขียง​เตรียม​ซี​ฟู้ด
    m_Metadata:
      m_Items: []
  - m_Id: 5867060105043971
    m_Localized: หม้อ​สต็​อก
    m_Metadata:
      m_Items: []
  - m_Id: 8095975175348224
    m_Localized: แซนด์วิช
    m_Metadata:
      m_Items: []
  - m_Id: 8100556793962496
    m_Localized: ซี​ฟู้ด
    m_Metadata:
      m_Items: []
