  m_TableData:
  - m_Id: 57744517226496
    m_Localized: Cuori illimitati
    m_Metadata:
      m_Items: []
  - m_Id: 57744529809408
    m_Localized: Fornisce cuori illimitati per un tempo limitato.
    m_Metadata:
      m_Items: []
  - m_Id: 57744529809409
    m_Localized: Niente pubblicità
    m_Metadata:
      m_Items: []
  - m_Id: 57744529809410
    m_Localized: Rimuove per sempre le pubblicità obbligatorie e i banner.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772544
    m_Localized: Cucina all'istante un piatto in automatico.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772545
    m_Localized: Rimuove una pila sporca dal tavolo.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772546
    m_Localized: Scegli liberamente un piatto di ingredienti.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772547
    m_Localized: Ripristina il tempo di attesa dei clienti così restano più a lungo.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772548
    m_Localized: Scambia le file di ingredienti.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772549
    m_Localized: Nessuno chef può cucinare senza passione nel cuore
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772550
    m_Localized: "Mostra quanto la gente ama il tuo ristorante!\r\nPiù fama hai, più sorprese scoprirai!"
    m_Metadata:
      m_Items: []
