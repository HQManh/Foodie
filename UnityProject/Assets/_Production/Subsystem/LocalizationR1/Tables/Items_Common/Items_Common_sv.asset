  m_TableData:
  - m_Id: 57744517226496
    m_Localized: Obegränsade hjärtan
    m_Metadata:
      m_Items: []
  - m_Id: 57744529809408
    m_Localized: Ger obegränsat med hjärtan under en begränsad tid.
    m_Metadata:
      m_Items: []
  - m_Id: 57744529809409
    m_Localized: Inga annonser
    m_Metadata:
      m_Items: []
  - m_Id: 57744529809410
    m_Localized: Tar bort tvingande annonser och bannerannonser för alltid.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772544
    m_Localized: Lagar en rätt automatiskt direkt.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772545
    m_Localized: Tar bort en smutsig trave från bordet.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772546
    m_Localized: Välj fritt en ingredienstallrik.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772547
    m_Localized: Återställer gästernas väntetid så att de stannar längre.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772548
    m_Localized: Byter plats på ingrediensrader.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772549
    m_Localized: Ingen kock kan laga mat utan passion i hjärtat
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772550
    m_Localized: "Visar hur mycket folk älskar din restaurang!\r\nJu mer berömmelse, desto fler överraskningar!"
    m_Metadata:
      m_Items: []
