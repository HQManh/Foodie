  m_TableData:
  - m_Id: 57744517226496
    m_Localized: Ubegrænsede hjerter
    m_Metadata:
      m_Items: []
  - m_Id: 57744529809408
    m_Localized: Giver ubegrænsede hjerter i en begrænset periode.
    m_Metadata:
      m_Items: []
  - m_Id: 57744529809409
    m_Localized: Ingen reklamer
    m_Metadata:
      m_Items: []
  - m_Id: 57744529809410
    m_Localized: Fjerner tvungne reklamer og bannerreklamer permanent.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772544
    m_Localized: Tilbereder en ret automatisk med det samme.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772545
    m_Localized: Fjern en snavset stabel fra bordet.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772546
    m_Localized: Vælg frit én ingredienstallerken.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772547
    m_Localized: Genopret kundernes ventetid, så de bliver længere.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772548
    m_Localized: Byt ingrediensrækker.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772549
    m_Localized: Ingen kok kan lave mad uden lyst i hjertet
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772550
    m_Localized: "Viser, hvor meget folk elsker din restaurant!\r\nJo mere berømmelse, jo flere overraskelser!"
    m_Metadata:
      m_Items: []
