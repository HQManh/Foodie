  m_TableData:
  - m_Id: 57744517226496
    m_Localized: Végtelen szív
    m_Metadata:
      m_Items: []
  - m_Id: 57744529809408
    m_Localized: Korlátlan szívet ad egy ideig.
    m_Metadata:
      m_Items: []
  - m_Id: 57744529809409
    m_Localized: Nincs reklám
    m_Metadata:
      m_Items: []
  - m_Id: 57744529809410
    m_Localized: Véglegesen eltávolítja a kötelező és a bannerhirdetéseket.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772544
    m_Localized: Azonnal automatikusan elkészít egy ételt.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772545
    m_Localized: Eltávolít egy koszos halmot az asztalról.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772546
    m_Localized: Válassz szabadon egy hozzávalótányért.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772547
    m_Localized: Visszaállítja a vendégek várakozási idejét, hogy tovább maradjanak.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772548
    m_Localized: Megcseréli a hozzávalósorokat.
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772549
    m_Localized: Egy séf sem tud főzni szenvedély nélkül
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772550
    m_Localized: "Megmutatja, mennyire szeretik az emberek az éttermedet!\r\nMinél nagyobb a hírneved, annál több meglepetés vár!"
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772551
    m_Localized: Automata főzés
    m_Metadata:
      m_Items: []
  - m_Id: 57793745772552
