    m_Metadata:
      m_Items: []
  - m_Id: 57799278059530
    m_Localized: Ежедневный подарок
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059531
    m_Localized: Ежедневные награды
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059532
    m_Localized: Изменить профиль
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059533
    m_Localized: БЕСПЛАТНО
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059534
