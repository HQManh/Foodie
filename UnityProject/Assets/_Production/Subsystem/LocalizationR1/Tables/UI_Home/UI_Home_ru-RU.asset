  m_TableData:
  - m_Id: 57799240310784
    m_Localized: Будет доступно позже
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059520
    m_Localized: Вниз
    m_Metadata:
      m_Items: []
  - m_Id: 57799278059521
