  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: Map_coffee_da
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: da
  m_SharedData: {fileID: 11400000, guid: 2792ae1db3f1fd44c88392405a58a65e, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 57788163153920
    m_Localized: For hver donut fortjener en fest. Svævende sukkerstemning.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514048
    m_Localized: Starten på noget sødt. Bare mel, vand og en masse ambition.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514049
    m_Localized: Mere glasur, mere plads. Vi hæver dejen for at hæve taget.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514050
    m_Localized: Kan spotte en stærk kop hurtigere end et væltende træ.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514051
    m_Localized: Leverer kaffe med vingefart og holder hver fjer pletfri.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514052
    m_Localized: En pæn cafébestyrer, der tager skumkunst meget alvorligt.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514053
    m_Localized: Læn dig tilbage, slap af, og lad sukkerkomaen tage over.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514054
    m_Localized: Lille bønne, store planer om at vække alle.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514055
    m_Localized: Bønner, som livet har malet ned.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514056
    m_Localized: Bryder caféreglerne, drikker kraftig ristet kaffe og siger aldrig muh stille.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514057
    m_Localized: Fluffy skyer, der altid er situationen voksen.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514058
    m_Localized: Creme med en rig, kakaodrevet mørk side.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514059
    m_Localized: En tom kop, der holder hovedet koldt.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514060
    m_Localized: Kaffe serveret med et køligt sind.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514061
    m_Localized: Iskaffe, der har klædt sig fint på for at vise sig frem.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514062
    m_Localized: Tom nu, men den kan tåle varme.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514063
    m_Localized: Dampende kop med en stærk personlighed.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514064
    m_Localized: Hvor kaffe og mælk endelig udtrykker deres kærlighed.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514065
    m_Localized: En lille kage, der aldrig voksede fra sin kop.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514066
    m_Localized: En cupcake, der viser sin søde pynt frem.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514067
    m_Localized: Dejen er klar – denne kage skal i ovnen.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514068
    m_Localized: Hældt over is til kunder, der aldrig sætter farten ned.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514069
    m_Localized: Dampet, hældt op og serveret, før skummet lægger sig.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514070
    m_Localized: En lille kage med alt for meget frosting – med vilje.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514071
    m_Localized: Frisk dyppet, så glasuren stadig overvejer, hvor den skal dryppe.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514072
    m_Localized: Sød ring med en hel masse charme.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514073
    m_Localized: En dejring, der venter på at blive det helt store hul-i-hovedet.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514074
    m_Localized: En dejbarre, der hæver indsatsen for donuts.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514075
    m_Localized: Dej, der aldrig skal fyldes op.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514076
    m_Localized: Holder orden i caféen med ørneøjne og en småkage formet som et politiskilt.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514077
    m_Localized: Lille bær, der er lidt blå, men smager fantastisk.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514078
    m_Localized: Luden udenpå, strålende grøn indeni.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514079
    m_Localized: Kiwi skåret til, stadig skinnende grøn.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514080
    m_Localized: Tropisk skat med en gylden attitude.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514081
    m_Localized: Ananasskiver klar til at komme på toppen.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514082
    m_Localized: Rød, moden og bær-svær at modstå.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514083
    m_Localized: Bærtynde skiver med maksimal charme.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514084
    m_Localized: En blank glasur med kølig blues.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514085
    m_Localized: Brun, blank og skamløst chokoladeglad.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514086
    m_Localized: Smuk i lyserød, sød i hver bid.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514087
    m_Localized: Enkel hvid glasur med skjult vaniljedybde.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514088
    m_Localized: Frosne terninger, der holder hver drink kølig.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514089
    m_Localized: Lad verden vide, hvor frostingen er. Glaseret og stolt.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514090
    m_Localized: En liste over alt, vi sælger. Mest donuts. Okay, kun donuts.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514091
    m_Localized: Cremet hvid fredsmægler for bitter kaffe.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514092
    m_Localized: Ægte grønt til at balancere den kunstige glasur. Naturens eget krymmel.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514093
    m_Localized: Lidt struktur i sukkeret. Disse krukker mener det alvorligt.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514094
    m_Localized: En tagdonut så stor, at selv fuglene får sukkerchok af at kigge på den.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514095
    m_Localized: Ekstra krymmel til tagets mesterværk. Glasur er ikke nok.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514096
    m_Localized: Ankommer fashionabelt duftende og gør hver kaffepause til en gallafest.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514097
    m_Localized: Små farverige stykker, der drysser glæde overalt.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514098
    m_Localized: Har nødagern med og bedømmer hver latte på skummet.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514099
    m_Localized: Den perfekte højde til at dingle med benene, mens du spiser en masse krymmel.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514100
    m_Localized: Ekstra krymmel til tagets mesterværk. Glasur er ikke nok.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514101
    m_Localized: En munter spilopmager, der på mystisk vis betaler med blade og præcis byttepenge.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514102
    m_Localized: Blender frugt til blød underkastelse.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514103
    m_Localized: Hvor frugten får sin skive af livet.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514104
    m_Localized: Brygger bønner til flydende morgenmotivation.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514105
    m_Localized: Bager dej til gylden kagelykke.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514106
    m_Localized: Steger dej, til den er pande-tastisk.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514107
    m_Localized: Festballoner
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514108
