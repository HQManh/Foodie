  - m_Id: 57788192514160
    m_Localized: Tobi Tanuki
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514161
    m_Localized: Blender
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514162
    m_Localized: Skærebræt
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514163
    m_Localized: Kaffemaskine
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514164
    m_Localized: Ovn
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514165
    m_Localized: Stegepande
    m_Metadata:
      m_Items: []
  - m_Id: 3010518569705472
    m_Localized: Frugten overgiver sig til glathed på få sekunder.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259904
    m_Localized: En frugtig hvirvelvind. Låg anbefales kraftigt.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259905
    m_Localized: Livets skive, bare hurtigere.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259906
    m_Localized: Jordbær skæres midt i en tanke. Kiwier ryster.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259907
    m_Localized: Morgenmotivation, brygget endnu hurtigere.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259908
    m_Localized: Brygger så hurtigt, at kunderne vågner, før de har taget en slurk.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259909
    m_Localized: Bager gylden lykke på ingen tid.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259910
    m_Localized: Cupcakes hæver sig til lejligheden med lynets hast.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259911
    m_Localized: Dejen bliver gylden meget hurtigere.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259912
    m_Localized: Donuts steges i kaotisk fart. Ren pande-monium!
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259913
    m_Localized: Turbo-blender
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259914
    m_Localized: Smoothie-tornado
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259915
    m_Localized: Hurtig skærer
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454208
    m_Localized: Frugt-ninja-bræt
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454209
    m_Localized: Hurtigbryg-maskine
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454210
    m_Localized: Barista-raket
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454211
    m_Localized: Hot Shot-ovn
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454212
    m_Localized: Blaze-ovn
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454213
    m_Localized: Hurtig pande
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454214
    m_Localized: Pande-monium
    m_Metadata:
      m_Items: []
  - m_Id: 8069150969683968
    m_Localized: Frugt ind, smoothie-storm ud.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541568
    m_Localized: Smoothie-orkan
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541569
    m_Localized: Blender så hurtigt, at den bøjer tiden. Hjernefrys inkluderet.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541570
    m_Localized: Galakseblender
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541571
    m_Localized: Kiwierne er skåret, før de kan trille væk.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541572
    m_Localized: Samurai-frugtbræt
    m_Metadata:
      m_Items: []
  - m_Id: 8069151078735872
    m_Localized: Ét sving, en hel frugtsalat.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151078735873
    m_Localized: Legendarisk frugtkniv
    m_Metadata:
      m_Items: []
  - m_Id: 8069151078735874
    m_Localized: Kaffe med jetfart. Hold fast i kruset.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318784
    m_Localized: Espressojet
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318785
    m_Localized: Brygger en perfekt kop, før du er færdig med at blinke.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318786
    m_Localized: Legendarisk bryggemotor
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318787
    m_Localized: Cupcakes bages på et hjerteslag. Det dufter himmelsk.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318788
    m_Localized: Infernoovn
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318789
    m_Localized: Varm som en stjerne. Bagværket kommer skinnende ud.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151095513088
    m_Localized: Legendarisk stjerneovn
    m_Metadata:
      m_Items: []
  - m_Id: 8069151095513089
    m_Localized: Donutsene vender sig selv af ren begejstring.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151095513090
    m_Localized: Pande-tastisk turbo
    m_Metadata:
      m_Items: []
  - m_Id: 8069151095513091
    m_Localized: Gyldne ringe i rekordfart. Ren donutmagi.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151095513092
    m_Localized: Legendarisk donutpande
    m_Metadata:
      m_Items: []
