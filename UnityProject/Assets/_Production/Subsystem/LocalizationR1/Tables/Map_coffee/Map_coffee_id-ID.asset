    m_Localized: Blender
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514162
    m_Localized: Talenan
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514163
    m_Localized: Pembuat Kopi
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514164
    m_Localized: Oven
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514165
    m_Localized: Wajan
    m_Metadata:
      m_Items: []
  - m_Id: 3010518569705472
    m_Localized: Buah menyerah menjadi halus dalam hitungan detik.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259904
    m_Localized: Pusaran buah. Sangat disarankan memakai tutup.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259905
    m_Localized: Irisan kehidupan, tapi lebih cepat.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259906
    m_Localized: Stroberi teriris di tengah lamunan. Kiwi gemetar.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259907
    m_Localized: Semangat pagi, diseduh lebih cepat lagi.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259908
    m_Localized: Menyeduh begitu cepat sampai pelanggan terjaga sebelum menyeruput.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259909
    m_Localized: Memanggang kebahagiaan keemasan dalam sekejap.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259910
    m_Localized: Cupcake mengembang menyambut kesempatan secepat kilat.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259911
    m_Localized: Adonan jadi keemasan jauh lebih cepat.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259912
    m_Localized: Donat digoreng dengan kecepatan kacau. Murni wajan-demonium!
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259913
    m_Localized: Blender Turbo
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259914
    m_Localized: Tornado Smoothie
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259915
    m_Localized: Pengiris Gesit
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454208
    m_Localized: Talenan Ninja Buah
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454209
    m_Localized: Mesin Seduh Cepat
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454210
    m_Localized: Roket Barista
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454211
    m_Localized: Oven Hot Shot
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454212
    m_Localized: Oven Blaze
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454213
    m_Localized: Wajan Kilat
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454214
    m_Localized: Kekacauan Wajan
    m_Metadata:
      m_Items: []
  - m_Id: 8069150969683968
    m_Localized: Buah masuk, badai smoothie keluar.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541568
    m_Localized: Badai Smoothie
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541569
    m_Localized: Memblender begitu cepat sampai waktu melengkung. Termasuk otak beku.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541570
    m_Localized: Blender Galaksi
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541571
    m_Localized: Kiwi sudah teriris sebelum sempat menggelinding.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541572
    m_Localized: Talenan Buah Samurai
    m_Metadata:
      m_Items: []
  - m_Id: 8069151078735872
    m_Localized: Satu ayunan, satu salad buah utuh.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151078735873
    m_Localized: Pisau Buah Legendaris
    m_Metadata:
      m_Items: []
  - m_Id: 8069151078735874
    m_Localized: Kopi secepat jet. Pegang erat cangkirmu.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318784
    m_Localized: Jet Espresso
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318785
    m_Localized: Menyeduh secangkir sempurna sebelum kamu selesai berkedip.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318786
    m_Localized: Mesin Seduh Legendaris
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318787
    m_Localized: Kue mangkuk matang sekejap. Harumnya seperti surga.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318788
    m_Localized: Oven Inferno
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318789
    m_Localized: Panas seperti bintang. Kue keluar berkilau.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151095513088
    m_Localized: Oven Bintang Legendaris
    m_Metadata:
      m_Items: []
  - m_Id: 8069151095513089
    m_Localized: Donat membalik diri saking semangatnya.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151095513090
    m_Localized: Wajan Turbo Hebat
    m_Metadata:
      m_Items: []
  - m_Id: 8069151095513091
    m_Localized: Cincin emas dengan kecepatan rekor. Sihir donat sejati.
    m_Metadata:
