  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Map_coffee_id-ID
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: id-ID
  m_SharedData: {fileID: 11400000, guid: 2792ae1db3f1fd44c88392405a58a65e, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 57788163153920
    m_Localized: Karena setiap donat layak dirayakan. Suasana manis yang melayang.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514048
    m_Localized: Awal dari sesuatu yang manis. Hanya tepung, air, dan banyak ambisi.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514049
    m_Localized: Lebih banyak glasur, lebih banyak ruang. Kami mengembangkan adonan untuk menaikkan atap.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514050
    m_Localized: Bisa mengenali kopi kental lebih cepat dari pohon tumbang.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514051
    m_Localized: Mengantar kopi secepat kepakan sayap sambil menjaga setiap bulu tetap bersih.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514052
    m_Localized: Bos kafe rapi yang menganggap seni busa kopi urusan serius.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514053
    m_Localized: Bersandar, santai, dan biarkan rasa kenyang manis datang perlahan.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514054
    m_Localized: Biji kecil, rencana besar untuk membangunkan semua orang.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514055
    m_Localized: Biji yang digiling oleh kehidupan.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514056
    m_Localized: Melanggar aturan kafe, minum kopi sangrai pekat, dan tak pernah melenguh pelan.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514057
    m_Localized: Awan lembut yang selalu siap naik menghadapi tantangan.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514058
    m_Localized: Krim dengan sisi gelap yang kaya akan kakao.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514059
    m_Localized: Gelas kosong yang tetap kalem.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514060
    m_Localized: Kopi yang disajikan dengan sikap dingin.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514061
    m_Localized: Es kopi yang berdandan untuk pamer.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514062
    m_Localized: Kosong sekarang, tapi tahan panas.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514063
    m_Localized: Kopi mengepul dengan kepribadian kuat.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514064
    m_Localized: Tempat kopi dan susu akhirnya menyatakan cinta.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514065
    m_Localized: Kue kecil yang tak pernah tumbuh melampaui cangkirnya.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514066
    m_Localized: Cupcake yang memamerkan topping manisnya.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514067
    m_Localized: Adonan siap, kue ini butuh waktu di oven.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514068
    m_Localized: Dituang di atas es untuk pelanggan yang tak pernah melambat.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514069
    m_Localized: Dikukus, dituang, dan disajikan sebelum busanya turun.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514070
    m_Localized: Kue kecil yang sengaja memakai frosting terlalu banyak.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514071
    m_Localized: Baru dicelup, glasurnya masih bingung mau menetes ke mana.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514072
    m_Localized: Cincin manis dengan pesona yang bolong-bolong... eh, melimpah.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514073
    m_Localized: Cincin adonan yang menunggu jadi bintang utama.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514074
    m_Localized: Batang adonan yang menaikkan taruhan untuk donat.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514075
    m_Localized: Adonan yang tak pernah perlu diisi ulang.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514076
    m_Localized: Menjaga kafe tetap tertib dengan mata elang dan kue berbentuk lencana.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514077
    m_Localized: Beri mungil yang sedang sendu tapi rasanya luar biasa.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514078
    m_Localized: Berbulu di luar, hijau cemerlang di dalam.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514079
    m_Localized: Kiwi dipotong kecil, masih hijau berkilau.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514080
    m_Localized: Kekasih tropis dengan sikap keemasan.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514081
    m_Localized: Irisan nanas siap diletakkan di atas.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514082
    m_Localized: Merah, matang, dan sulit sekali ditolak.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514083
    m_Localized: Irisan tipis dengan pesona maksimal.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514084
    m_Localized: Lapisan mengilap dengan nuansa biru yang keren.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514085
    m_Localized: Cokelat, mengilap, dan pecandu cokelat tanpa malu.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514086
    m_Localized: Cantik berwarna merah muda, manis di setiap gigitan.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514087
    m_Localized: Glasur putih polos dengan kedalaman vanila tersembunyi.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514088
    m_Localized: Kubus beku yang menjaga setiap minuman tetap dingin.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514089
    m_Localized: Beri tahu dunia di mana frosting berada. Berglasur dan bangga.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514090
    m_Localized: Daftar semua yang kami jual. Kebanyakan donat. Oke, cuma donat.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514091
    m_Localized: Pendamai putih nan lembut untuk kopi pahit.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514092
    m_Localized: Tanaman asli untuk menyeimbangkan glasur buatan. Taburan alami dari alam.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514093
    m_Localized: Menambah struktur pada gula. Pot-pot ini serius.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514094
    m_Localized: Donat di atap yang begitu besar, burung pun kena serangan gula hanya dengan melihatnya.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514095
    m_Localized: Taburan ekstra untuk mahakarya di atap. Glasur saja tak cukup.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514096
    m_Localized: Datang dengan wangi yang modis dan mengubah setiap rehat kopi jadi gala.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514097
    m_Localized: Butiran warna-warni yang menaburkan keceriaan di mana-mana.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514098
    m_Localized: Membawa biji ek darurat dan menilai setiap latte dari busanya.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514099
    m_Localized: Tinggi yang pas untuk mengayun-ayunkan kaki sambil makan banyak meses.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514100
    m_Localized: Taburan ekstra untuk mahakarya di atap. Glasur saja tak cukup.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514101
    m_Localized: Si jahil ceria yang entah bagaimana membayar dengan daun dan uang pas.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514102
    m_Localized: Menghaluskan buah hingga takluk sepenuhnya.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514103
    m_Localized: Tempat buah mendapat irisan kehidupannya.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514104
    m_Localized: Menyeduh biji kopi menjadi motivasi pagi dalam bentuk cair.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514105
    m_Localized: Memanggang adonan menjadi kebahagiaan kue keemasan.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514106
    m_Localized: Menggoreng adonan sampai wajan-tastis.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514107
    m_Localized: Balon Pesta
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514108
    m_Localized: Perluasan Manis
    m_Metadata:
      m_Items: []
