  - m_Id: 57788192514162
    m_Localized: Kesme Tahtası
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514163
    m_Localized: Kahve Makinesi
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514164
    m_Localized: Fırın
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514165
    m_Localized: Tava
    m_Metadata:
      m_Items: []
  - m_Id: 3010518569705472
    m_Localized: Meyveler birkaç saniyede pürüzsüzlüğe teslim olur.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259904
    m_Localized: Meyveli bir kasırga. Kapak kullanmanız şiddetle tavsiye edilir.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259905
    m_Localized: Hayattan bir dilim, sadece daha hızlı.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259906
    m_Localized: Çilekler düşünürken dilimleniyor. Kiviler titriyor.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259907
    m_Localized: Sabah motivasyonu, daha da hızlı demleniyor.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259908
    m_Localized: O kadar hızlı demler ki müşteriler yudumlamadan uyanır.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259909
    m_Localized: Altın sarısı mutluluğu anında pişirir.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259910
    m_Localized: Cupcake'ler şimşek hızıyla kabarır.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259911
    m_Localized: Hamur çok daha çabuk altın rengi olur.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259912
    m_Localized: Donutlar kaotik bir hızla kızarır. Tam bir tava-demonyum!
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259913
    m_Localized: Turbo Blender
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259914
    m_Localized: Smoothie Kasırgası
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259915
    m_Localized: Çevik Dilimleyici
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454208
    m_Localized: Meyve Ninja Tahtası
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454209
    m_Localized: Hızlı Demleme Makinesi
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454210
    m_Localized: Barista Roketi
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454211
    m_Localized: Hot Shot Fırın
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454212
    m_Localized: Alev Fırın
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454213
    m_Localized: Hızlı Tava
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454214
    m_Localized: Tava-demonyum
    m_Metadata:
      m_Items: []
  - m_Id: 8069150969683968
    m_Localized: Meyve giriyor, smoothie fırtınası çıkıyor.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541568
    m_Localized: Smoothie Kasırgası
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541569
    m_Localized: O kadar hızlı karıştırıyor ki zamanı büküyor. Beyin donması dahil.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541570
    m_Localized: Galaksi Blender
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541571
    m_Localized: Kiviler yuvarlanıp kaçamadan dilimleniyor.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541572
    m_Localized: Samuray Meyve Tahtası
    m_Metadata:
      m_Items: []
  - m_Id: 8069151078735872
    m_Localized: Tek vuruş, koca bir meyve salatası.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151078735873
    m_Localized: Efsanevi Meyve Bıçağı
    m_Metadata:
      m_Items: []
  - m_Id: 8069151078735874
    m_Localized: Jet hızında kahve. Kupana sıkı tutun.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318784
    m_Localized: Espresso Jeti
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318785
    m_Localized: Göz kırpmayı bitirmeden mükemmel bir fincan demliyor.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318786
    m_Localized: Efsanevi Demleme Motoru
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318787
    m_Localized: Kekler bir anda pişiyor. Cennet gibi kokuyor.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318788
    m_Localized: Cehennem Fırını
