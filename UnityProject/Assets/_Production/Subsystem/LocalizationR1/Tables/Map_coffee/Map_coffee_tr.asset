  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Map_coffee_tr
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: tr
  m_SharedData: {fileID: 11400000, guid: 2792ae1db3f1fd44c88392405a58a65e, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 57788163153920
    m_Localized: Çünkü her donut bir kutlamayı hak eder. Havada uçuşan şeker havası.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514048
    m_Localized: Tatlı bir şeyin başlangıcı. Sadece un, su ve bolca hırs.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514049
    m_Localized: Daha çok glazür, daha çok alan. Hamuru kabartıp çatıyı yükseltiyoruz.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514050
    m_Localized: Sert bir kahveyi devrilen bir ağaçtan hızlı fark eder.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514051
    m_Localized: Kahveyi kanat hızıyla getirir, tek bir tüyünü bile kirletmez.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514052
    m_Localized: Köpük sanatını ciddi iş sayan şık bir kafe patronu.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514053
    m_Localized: Arkana yaslan, rahatla ve şeker komasının yavaşça gelmesine izin ver.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514054
    m_Localized: Küçük çekirdek, herkesi uyandırmak için büyük planlar.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514055
    m_Localized: Hayatın öğüttüğü çekirdekler.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514056
    m_Localized: Kafe kurallarını çiğner, sert kavrulmuş kahve içer ve asla alçak sesle möölemez.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514057
    m_Localized: Her zaman durumun hakkını veren kabarık bulutlar.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514058
    m_Localized: Zengin, kakao dolu karanlık bir yüzü olan krema.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514059
    m_Localized: Soğukkanlılığını koruyan boş bir bardak.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514060
    m_Localized: Soğuk bir tavırla servis edilen kahve.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514061
    m_Localized: Hava atmak için süslenmiş buzlu kahve.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514062
    m_Localized: Şimdilik boş ama sıcağa dayanır.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514063
    m_Localized: Güçlü karakterli, dumanı tüten bir kahve.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514064
    m_Localized: Kahve ile sütün sonunda aşklarını itiraf ettiği yer.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514065
    m_Localized: Kabından hiç büyüyemeyen minik bir kek.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514066
    m_Localized: Tatlı süslemeleriyle hava atan bir cupcake.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514067
    m_Localized: Hamur hazır, bu kekin fırına girmesi lazım.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514068
    m_Localized: Asla yavaşlamayan müşteriler için buzun üzerine dökülür.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514069
    m_Localized: Köpük inmeden buharlanır, dökülür ve servis edilir.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514070
    m_Localized: Bilerek fazlasıyla krema sürülmüş minik bir kek.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514071
    m_Localized: Yeni batırıldı, glazür hâlâ nereye damlayacağına karar veriyor.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514072
    m_Localized: Deliği kadar büyük bir çekiciliğe sahip tatlı halka.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514073
    m_Localized: Büyük yıldız olmayı bekleyen bir hamur halkası.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514074
    m_Localized: Donutlar için çıtayı yükselten bir hamur çubuğu.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514075
    m_Localized: Hiç yenilenmesi gerekmeyen hamur.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514076
    m_Localized: Kartal gözleri ve rozet şeklinde bir kurabiyeyle kafede düzeni sağlar.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514077
    m_Localized: Biraz hüzünlü ama tadı harika minik bir meyve.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514078
    m_Localized: Dışı tüylü, içi pırıl pırıl yeşil.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514079
    m_Localized: Boyutuna göre doğranmış kivi, hâlâ pırıl pırıl yeşil.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514080
    m_Localized: Altın tavırlı tropik bir tatlılık.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514081
    m_Localized: Üstüne konmaya hazır ananas dilimleri.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514082
    m_Localized: Kırmızı, olgun ve karşı konulmaz.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514083
    m_Localized: İncecik dilimler, maksimum çekicilik.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514084
    m_Localized: Havalı mavilere bürünmüş parlak bir kaplama.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514085
    m_Localized: Kahverengi, parlak ve pişmanlık duymadan çikolata tutkunu.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514086
    m_Localized: Pembesiyle güzel, her lokmada tatlı.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514087
    m_Localized: Gizli bir vanilya derinliğine sahip sade beyaz glazür.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514088
    m_Localized: Her içeceği serin tutan buz küpleri.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514089
    m_Localized: Dünyaya kremanın nerede olduğunu duyur. Glazürlü ve gururlu.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514090
    m_Localized: Sattığımız her şeyin listesi. Çoğunlukla donut. Tamam, sadece donut.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514091
    m_Localized: Acı kahve için kremsi beyaz bir barış elçisi.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514092
    m_Localized: Yapay glazürü dengelemek için gerçek yeşillik. Doğanın kendi şeker süsü.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514093
    m_Localized: Şekere biraz düzen katalım. Bu saksılar işini ciddiye alıyor.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514094
    m_Localized: Çatıdaki donut o kadar büyük ki kuşlar bile bakınca şeker komasına giriyor.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514095
    m_Localized: Çatıdaki başyapıta ekstra şeker süsü. Glazür yetmez.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514096
    m_Localized: Şık bir kokuyla gelir ve her kahve molasını galaya çevirir.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514097
    m_Localized: Her yere neşe serpen minik renkli parçacıklar.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514098
    m_Localized: Acil durum palamutları taşır ve her latteyi köpüğüne göre değerlendirir.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514099
    m_Localized: Bir düzine şeker süsü yerken bacak sallamak için ideal yükseklik.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514100
    m_Localized: Çatıdaki başyapıta ekstra şeker süsü. Glazür yetmez.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514101
    m_Localized: Nasılsa yapraklarla ve tam para ödeyen neşeli bir düzenbaz.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514102
    m_Localized: Meyveleri pürüzsüz bir teslimiyete çevirir.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514103
    m_Localized: Meyvelerin hayattan bir dilim aldığı yer.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514104
    m_Localized: Çekirdekleri sıvı sabah motivasyonuna dönüştürür.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514105
    m_Localized: Hamuru altın rengi kek mutluluğuna dönüştürür.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514106
    m_Localized: Hamuru tava-muhteşem olana dek kızartır.
    m_Metadata:
      m_Items: []
