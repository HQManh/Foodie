  - m_Id: 57788192514125
    m_Localized: Капкейк делюкс
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514126
    m_Localized: Сырое тесто для капкейков
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514127
    m_Localized: Холодный кофе
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514128
    m_Localized: Горячий кофе
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514129
    m_Localized: Капкейк с кремом
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514130
    m_Localized: Пончик в глазури
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514131
    m_Localized: Пончик
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514132
    m_Localized: Тесто для пончиков
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514133
    m_Localized: Брусок теста
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514134
    m_Localized: Бесконечное тесто
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514135
    m_Localized: Шеф Орёл
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514136
    m_Localized: Черника
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514137
    m_Localized: Киви
    m_Metadata:
