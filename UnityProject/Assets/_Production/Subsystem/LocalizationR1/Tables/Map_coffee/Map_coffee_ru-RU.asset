    m_Metadata:
      m_Items: []
  - m_Id: 57788192514139
    m_Localized: Ананас
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514140
    m_Localized: Нарезанный ананас
    m_Metadata:
