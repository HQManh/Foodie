    m_Metadata:
      m_Items: []
  - m_Id: 57788192514165
    m_Localized: Poêle
    m_Metadata:
      m_Items: []
  - m_Id: 3010518569705472
    m_Localized: Les fruits se rendent à la douceur en quelques secondes.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259904
    m_Localized: Un tourbillon fruité. Couvercle fortement recommandé.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259905
    m_Localized: La tranche de vie, en plus rapide.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259906
    m_Localized: Les fraises sont tranchées en plein milieu d'une pensée. Les kiwis tremblent.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259907
    m_Localized: La motivation du matin, infusée encore plus vite.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259908
    m_Localized: Infuse si vite que les clients se réveillent avant de boire.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259909
    m_Localized: Cuit un bonheur doré en un rien de temps.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259910
    m_Localized: Les cupcakes se montrent à la hauteur à la vitesse de l'éclair.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259911
    m_Localized: La pâte devient dorée bien plus vite.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259912
    m_Localized: Les donuts frisent à une vitesse chaotique. Un vrai pandémonium !
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259913
    m_Localized: Blender turbo
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259914
    m_Localized: Tornade de smoothie
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259915
    m_Localized: Trancheur éclair
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454208
    m_Localized: Planche ninja des fruits
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454209
    m_Localized: Cafetière express
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454210
    m_Localized: Fusée barista
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454211
    m_Localized: Four éclair
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454212
    m_Localized: Four brasier
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454213
    m_Localized: Poêle express
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454214
    m_Localized: Pan-démonium
    m_Metadata:
      m_Items: []
  - m_Id: 8069150969683968
    m_Localized: Les fruits entrent, une tempête de smoothie en sort.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541568
    m_Localized: Ouragan à smoothies
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541569
    m_Localized: Mixe si vite qu'il plie le temps. Gel du cerveau inclus.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541570
    m_Localized: Mixeur galactique
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541571
    m_Localized: Les kiwis sont tranchés avant de pouvoir rouler.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541572
    m_Localized: Planche à fruits samouraï
    m_Metadata:
      m_Items: []
  - m_Id: 8069151078735872
    m_Localized: Un seul coup, une salade de fruits entière.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151078735873
    m_Localized: Lame à fruits légendaire
    m_Metadata:
      m_Items: []
  - m_Id: 8069151078735874
    m_Localized: Du café à la vitesse d'un jet. Tenez bien votre tasse.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318784
    m_Localized: Jet d'expresso
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318785
    m_Localized: Prépare une tasse parfaite avant la fin de votre clignement.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318786
    m_Localized: Moteur d'infusion légendaire
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318787
    m_Localized: Les cupcakes cuisent en un battement de cœur. Ça sent le paradis.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318788
    m_Localized: Four infernal
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318789
    m_Localized: Chaud comme une étoile. Les pâtisseries sortent étincelantes.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151095513088
    m_Localized: Four étoilé légendaire
    m_Metadata:
      m_Items: []
  - m_Id: 8069151095513089
    m_Localized: Les donuts se retournent tout seuls d'excitation.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151095513090
    m_Localized: Poêle-tastique turbo
    m_Metadata:
      m_Items: []
  - m_Id: 8069151095513091
    m_Localized: Des anneaux dorés à une vitesse record. La magie du donut.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151095513092
    m_Localized: Poêle à donuts légendaire
    m_Metadata:
      m_Items: []
