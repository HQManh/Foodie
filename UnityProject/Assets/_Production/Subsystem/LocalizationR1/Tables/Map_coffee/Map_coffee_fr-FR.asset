  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Map_coffee_fr-FR
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: fr-FR
  m_SharedData: {fileID: 11400000, guid: 2792ae1db3f1fd44c88392405a58a65e, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 57788163153920
    m_Localized: Parce que chaque donut mérite une fête. Ambiance sucrée qui flotte dans l'air.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514048
    m_Localized: Le début de quelque chose de sucré. Juste de la farine, de l'eau et beaucoup d'ambition.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514049
    m_Localized: Plus de glaçage, plus d'espace. On fait lever la pâte pour faire lever le toit.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514050
    m_Localized: Repère un café corsé plus vite qu'un arbre ne tombe.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514051
    m_Localized: Livre le café à tire-d'aile en gardant chaque plume impeccable.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514052
    m_Localized: Un patron de café raffiné pour qui le latte art est une affaire sérieuse.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514053
    m_Localized: Installez-vous, détendez-vous et laissez le coma sucré s'installer tout doucement.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514054
    m_Localized: Petit grain, grands projets pour réveiller tout le monde.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514055
    m_Localized: Des grains que la vie a moulus.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514056
    m_Localized: Enfreint les règles du café, boit des torréfactions corsées et ne meugle jamais doucement.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514057
    m_Localized: Des nuages moelleux toujours à la hauteur.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514058
    m_Localized: Une crème au côté obscur riche en cacao.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514059
    m_Localized: Un gobelet vide qui garde son calme.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514060
    m_Localized: Un café servi avec un tempérament glacial.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514061
    m_Localized: Un café glacé bien habillé pour frimer.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514062
    m_Localized: Vide pour l'instant, mais il supporte la chaleur.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514063
    m_Localized: Un breuvage fumant au caractère bien trempé.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514064
    m_Localized: Là où le café et le lait se déclarent enfin leur amour.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514065
    m_Localized: Un petit gâteau qui n'a jamais quitté sa tasse.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514066
    m_Localized: Un cupcake qui fait étalage de ses garnitures sucrées.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514067
    m_Localized: La pâte est prête, ce gâteau a besoin du four.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514068
    m_Localized: Versé sur glace pour les clients qui ne ralentissent jamais.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514069
    m_Localized: Chauffé, versé et servi avant que la mousse ne retombe.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514070
    m_Localized: Un petit gâteau qui porte beaucoup trop de glaçage, exprès.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514071
    m_Localized: Fraîchement trempé, le glaçage hésite encore à couler.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514072
    m_Localized: Un anneau sucré au charme trou-blant.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514073
    m_Localized: Un anneau de pâte qui attend de devenir la vraie star.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514074
    m_Localized: Une barre de pâte qui fait monter les enjeux pour les donuts.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514075
    m_Localized: Une pâte qui n'a jamais besoin d'être réapprovisionnée.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514076
    m_Localized: Maintient l'ordre au café avec un œil d'aigle et un biscuit en forme d'insigne.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514077
    m_Localized: Une petite baie qui a le cafard mais un goût génial.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514078
    m_Localized: Duveteux dehors, d'un vert éclatant dedans.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514079
    m_Localized: Un kiwi coupé à la bonne taille, toujours d'un vert éclatant.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514080
    m_Localized: Une douceur tropicale à l'attitude en or.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514081
    m_Localized: Des tranches d'ananas prêtes à garnir le dessus.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514082
    m_Localized: Rouge, mûre et fraise-ment irrésistible.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514083
    m_Localized: Des tranches fines comme tout, au charme maximal.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514084
    m_Localized: Un nappage brillant qui a le blues cool.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514085
    m_Localized: Brun, brillant et accro au chocolat sans complexe.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514086
    m_Localized: Jolie en rose, douce à chaque bouchée.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514087
    m_Localized: Un simple glaçage blanc à la profondeur vanillée cachée.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514088
    m_Localized: Des cubes gelés qui gardent chaque boisson bien fraîche.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514089
    m_Localized: Que le monde sache où se trouve le glaçage. Glacé et fier de l'être.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514090
    m_Localized: La liste de tout ce qu'on vend. Surtout des donuts. D'accord, que des donuts.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514091
    m_Localized: Le pacificateur blanc et crémeux du café amer.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514092
    m_Localized: De la vraie verdure pour équilibrer le glaçage artificiel. Les vermicelles de la nature.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514093
    m_Localized: Un peu de structure dans le sucre. Ces pots ne rigolent pas.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514094
    m_Localized: Un donut sur le toit si grand que même les oiseaux ont un coup de sucre en le regardant.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514095
    m_Localized: Des vermicelles en plus pour le chef-d'œuvre du toit. Le glaçage ne suffit pas.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514096
    m_Localized: Arrive élégamment parfumée et transforme chaque pause café en gala.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514097
    m_Localized: De petits éclats colorés qui saupoudrent de la joie partout.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514098
    m_Localized: Transporte des glands de secours et juge chaque latte à sa mousse.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514099
    m_Localized: La hauteur idéale pour balancer les jambes en dévorant des vermicelles.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514100
    m_Localized: Des vermicelles en plus pour le chef-d'œuvre du toit. Le glaçage ne suffit pas.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514101
    m_Localized: Un joyeux farceur qui paie avec des feuilles, et toujours l'appoint exact.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514102
    m_Localized: Réduit les fruits en une douce soumission.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514103
    m_Localized: Là où les fruits croquent la vie en tranches.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514104
    m_Localized: Transforme les grains en motivation matinale liquide.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514105
    m_Localized: Transforme la pâte en bonheur doré et moelleux.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514106
    m_Localized: Fait frire la pâte jusqu'à ce qu'elle soit poêle-tastique.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514107
    m_Localized: Ballons de fête
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514108
    m_Localized: Agrandissement sucré
    m_Metadata:
