    m_Metadata:
      m_Items: []
  - m_Id: 3010518569705472
    m_Localized: Trái cây đầu hàng và mịn màng chỉ sau vài giây.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259904
    m_Localized: Một cơn lốc trái cây. Rất nên đậy nắp lại.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259905
    m_Localized: Lát cắt của cuộc sống, nhưng nhanh hơn.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259906
    m_Localized: Dâu tây bị thái lát giữa lúc đang suy nghĩ. Kiwi run rẩy.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259907
    m_Localized: Động lực buổi sáng, được pha nhanh hơn nữa.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259908
    m_Localized: Pha nhanh đến mức khách tỉnh ngủ trước khi kịp nhấp môi.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259909
    m_Localized: Nướng ra niềm hạnh phúc vàng ươm trong nháy mắt.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259910
    m_Localized: Bánh cupcake nở phồng nhanh như chớp.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259911
    m_Localized: Bột chuyển vàng ươm nhanh hơn nhiều.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259912
    m_Localized: Bánh donut được chiên với tốc độ hỗn loạn. Đúng là chảo loạn vũ!
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259913
