  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: Map_coffee_vi-VN
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: vi-VN
  m_SharedData: {fileID: 11400000, guid: 2792ae1db3f1fd44c88392405a58a65e, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 57788163153920
    m_Localized: Vì chiếc donut nào cũng xứng đáng được ăn mừng. Không khí ngọt ngào bay bổng.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514048
    m_Localized: Khởi đầu của điều ngọt ngào. Chỉ bột, nước và thật nhiều hoài bão.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514049
    m_Localized: Thêm men, thêm chỗ. Ta ủ bột nở để nâng cả mái nhà.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514050
    m_Localized: Nhận ra cà phê đậm nhanh hơn cả cây đổ.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514051
    m_Localized: Giao cà phê nhanh như chớp mà lông vẫn sạch tinh tươm.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514052
    m_Localized: Ông chủ quán chỉn chu coi latte art là chuyện hệ trọng.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514053
    m_Localized: Ngả lưng, thư giãn và để cơn say đường từ từ ập đến.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514054
    m_Localized: Hạt nhỏ nhưng có kế hoạch lớn đánh thức mọi người.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514055
    m_Localized: Những hạt đã bị cuộc đời nghiền nát.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514056
    m_Localized: Phá luật quán, uống cà phê rang đậm và chẳng bao giờ rống khẽ.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514057
    m_Localized: Những đám mây bông xốp luôn bông lên đúng lúc.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514058
    m_Localized: Kem với mặt tối đậm đà vị ca cao.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514059
    m_Localized: Chiếc cốc rỗng vẫn giữ vẻ điềm tĩnh.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514060
    m_Localized: Cà phê được phục vụ với tính khí lạnh lùng.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514061
    m_Localized: Ly cà phê đá diện đồ thật đẹp để khoe.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514062
    m_Localized: Giờ thì trống, nhưng chịu nóng giỏi lắm.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514063
    m_Localized: Ly cà phê bốc khói đầy cá tính.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514064
    m_Localized: Nơi cà phê và sữa cuối cùng cũng tỏ tình.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514065
    m_Localized: Chiếc bánh nhỏ chưa bao giờ lớn hơn chiếc cốc.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514066
    m_Localized: Chiếc cupcake khoe lớp topping ngọt ngào.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514067
    m_Localized: Bột đã sẵn sàng, chiếc bánh này cần vào lò.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514068
    m_Localized: Thức uống lạnh cho những vị khách chẳng bao giờ chậm lại.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514069
    m_Localized: Làm nóng, rót và phục vụ trước khi bọt kịp lắng.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514070
    m_Localized: Chiếc bánh nhỏ cố tình phủ quá nhiều kem.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514071
    m_Localized: Vừa nhúng xong, lớp men còn đang phân vân chảy về đâu.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514072
    m_Localized: Chiếc vòng ngọt với cả một lỗ đầy duyên dáng.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514073
    m_Localized: Vòng bột đang chờ trở thành ngôi sao chính.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514074
    m_Localized: Thanh bột nâng tầm cuộc chơi cho bánh donut.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514075
    m_Localized: Bột chẳng bao giờ cần nạp thêm.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514076
    m_Localized: Giữ trật tự quán bằng đôi mắt đại bàng và chiếc bánh quy hình phù hiệu.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514077
    m_Localized: Quả mọng tí hon hơi buồn nhưng vị thì tuyệt.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514078
    m_Localized: Bên ngoài lông tơ, bên trong xanh rực rỡ.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514079
    m_Localized: Kiwi được cắt vừa miệng, vẫn xanh óng ánh.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514080
    m_Localized: Người yêu nhiệt đới với thái độ vàng ròng.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514081
    m_Localized: Lát dứa sẵn sàng đặt lên trên.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514082
    m_Localized: Đỏ mọng, chín tới và khó cưỡng vô cùng.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514083
    m_Localized: Những lát mỏng tang nhưng duyên dáng tối đa.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514084
    m_Localized: Lớp phủ bóng bẩy mang sắc xanh lạnh lùng.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514085
    m_Localized: Nâu, bóng bẩy và nghiện sô-cô-la chẳng chút ngại ngùng.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514086
    m_Localized: Xinh xắn sắc hồng, ngọt ngào từng miếng.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514087
    m_Localized: Lớp men trắng giản dị ẩn chứa chiều sâu vani.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514088
    m_Localized: Những viên đá giữ cho mọi thức uống mát lạnh.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514089
    m_Localized: Cho cả thế giới biết kem phủ ở đâu. Bóng bẩy và tự hào.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514090
    m_Localized: Danh sách mọi thứ chúng tôi bán. Chủ yếu là donut. Thôi được, toàn donut.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514091
    m_Localized: Sứ giả hòa bình trắng béo cho cà phê đắng.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514092
    m_Localized: Cây xanh thật để cân bằng lớp men nhân tạo. Cốm màu của thiên nhiên.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514093
    m_Localized: Thêm chút trật tự cho sự ngọt ngào. Mấy chậu này nghiêm túc lắm.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514094
    m_Localized: Chiếc donut trên mái to đến mức chim nhìn thôi cũng bị say đường.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514095
    m_Localized: Thêm cốm màu cho kiệt tác trên mái. Chỉ phủ men là chưa đủ.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514096
    m_Localized: Xuất hiện với mùi hương thời thượng, biến mỗi giờ nghỉ cà phê thành dạ tiệc.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514097
    m_Localized: Những mẩu nhỏ đủ màu rắc niềm vui khắp nơi.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514098
    m_Localized: Luôn mang hạt sồi dự phòng và chấm điểm mỗi ly latte qua lớp bọt.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514099
    m_Localized: Độ cao hoàn hảo để đung đưa chân trong lúc ăn cả nắm cốm màu.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514100
    m_Localized: Thêm cốm màu cho kiệt tác trên mái. Chỉ phủ men là chưa đủ.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514101
    m_Localized: Chàng tinh nghịch vui vẻ, chẳng hiểu sao trả tiền bằng lá mà vẫn đủ từng xu.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514102
    m_Localized: Xay trái cây mịn màng, ngoan ngoãn phục tùng.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514103
    m_Localized: Nơi trái cây được thưởng thức lát cắt cuộc đời.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514104
    m_Localized: Pha hạt cà phê thành động lực buổi sáng dạng lỏng.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514105
    m_Localized: Nướng bột thành niềm hạnh phúc bánh ngọt vàng ươm.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514106
    m_Localized: Chiên bột cho đến khi thơm ngon tuyệt cú mèo.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514107
    m_Localized: Bóng bay tiệc
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514108
    m_Localized: Mở rộng ngọt ngào
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514109
    m_Localized: Hải ly Brewster
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514110
    m_Localized: Chim giao hàng Cánh Xanh
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514111
