  - m_Id: 3010518607454213
    m_Localized: Chảo Siêu Tốc
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454214
    m_Localized: Chảo Loạn Vũ
    m_Metadata:
      m_Items: []
  - m_Id: 8069150969683968
    m_Localized: Trái cây vào, cơn bão sinh tố ra.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541568
    m_Localized: Bão Sinh Tố
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541569
    m_Localized: Xay nhanh đến bẻ cong thời gian. Tặng kèm cảm giác buốt óc.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541570
    m_Localized: Máy Xay Ngân Hà
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541571
    m_Localized: Kiwi bị thái lát trước khi kịp lăn đi.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541572
    m_Localized: Thớt Trái Cây Samurai
    m_Metadata:
      m_Items: []
  - m_Id: 8069151078735872
    m_Localized: Một nhát chém, nguyên đĩa salad trái cây.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151078735873
    m_Localized: Lưỡi Dao Trái Cây Huyền Thoại
    m_Metadata:
      m_Items: []
  - m_Id: 8069151078735874
    m_Localized: Cà phê tốc độ phản lực. Giữ chặt cốc nhé.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318784
    m_Localized: Máy Bay Espresso
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318785
    m_Localized: Pha xong một ly hoàn hảo trước khi bạn kịp chớp mắt.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318786
    m_Localized: Động Cơ Pha Chế Huyền Thoại
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318787
    m_Localized: Bánh cupcake nướng xong trong tích tắc. Thơm như thiên đường.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318788
    m_Localized: Lò Nướng Hỏa Ngục
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318789
    m_Localized: Nóng như một vì sao. Bánh ra lò sáng lấp lánh.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151095513088
    m_Localized: Lò Nướng Ngôi Sao Huyền Thoại
    m_Metadata:
      m_Items: []
  - m_Id: 8069151095513089
    m_Localized: Bánh donut tự lật vì quá phấn khích.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151095513090
    m_Localized: Chảo Turbo Tuyệt Đỉnh
    m_Metadata:
      m_Items: []
  - m_Id: 8069151095513091
    m_Localized: Những chiếc vòng vàng với tốc độ kỷ lục. Phép màu donut thuần túy.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151095513092
    m_Localized: Chảo Donut Huyền Thoại
    m_Metadata:
      m_Items: []
