  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Map_coffee_hi
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: hi
  m_SharedData: {fileID: 11400000, guid: 2792ae1db3f1fd44c88392405a58a65e, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 57788163153920
    m_Localized: क्योंकि हर डोनट जश्न का हक़दार है। हवा में तैरता मीठा माहौल।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514048
    m_Localized: किसी मीठी चीज़ की शुरुआत। बस आटा, पानी और ढेर सारा हौसला।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514049
    m_Localized: ज़्यादा ग्लेज़, ज़्यादा जगह। आटा फुलाकर छत ऊँची कर रहे हैं।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514050
    m_Localized: गिरते पेड़ से भी तेज़ कड़क कॉफ़ी पहचान लेता है।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514051
    m_Localized: पंखों की रफ़्तार से कॉफ़ी पहुँचाता है और हर पंख को बेदाग़ रखता है।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514052
    m_Localized: एक सलीकेदार कैफ़े बॉस, जो फ़ोम आर्ट को बेहद गंभीरता से लेता है।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514053
    m_Localized: आराम से बैठिए, रिलैक्स कीजिए और मीठी झपकी को धीरे-धीरे आने दीजिए।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514054
    m_Localized: छोटी फली, सबको जगाने की बड़ी योजना।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514055
    m_Localized: ज़िंदगी की चक्की में पिसी फलियाँ।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514056
    m_Localized: कैफ़े के नियम तोड़ती है, कड़क कॉफ़ी पीती है और कभी धीरे से मू नहीं करती।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514057
    m_Localized: मुलायम बादल, जो हर मौके पर खरे उतरते हैं।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514058
    m_Localized: कोको से भरपूर गहरे अंदाज़ वाली क्रीम।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514059
    m_Localized: एक खाली कप जो अपनी ठंडक बनाए रखता है।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514060
    m_Localized: ठंडे मिज़ाज के साथ परोसी गई कॉफ़ी।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514061
    m_Localized: दिखावे के लिए सजी-धजी आइस्ड कॉफ़ी।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514062
    m_Localized: अभी खाली है, पर गर्मी झेल सकता है।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514063
    m_Localized: भाप उड़ाती कॉफ़ी, दमदार व्यक्तित्व के साथ।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514064
    m_Localized: जहाँ कॉफ़ी और दूध आख़िरकार अपने प्यार का इज़हार करते हैं।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514065
    m_Localized: एक छोटा केक जो अपने कप से कभी बड़ा नहीं हुआ।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514066
    m_Localized: अपनी मीठी टॉपिंग दिखाता एक कपकेक।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514067
    m_Localized: बैटर तैयार, इस केक को ओवन में जाना है।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514068
    m_Localized: बर्फ़ पर डाली गई, उन ग्राहकों के लिए जो कभी धीमे नहीं पड़ते।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514069
    m_Localized: भाप दी, डाली और परोसी, झाग बैठने से पहले।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514070
    m_Localized: जानबूझकर ढेर सारी फ़्रॉस्टिंग पहना एक छोटा केक।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514071
    m_Localized: ताज़ा डुबोया हुआ, ग्लेज़ अब भी तय कर रहा है कि कहाँ टपके।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514072
    m_Localized: मीठा छल्ला, ढेर सारे आकर्षण के साथ।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514073
    m_Localized: आटे का छल्ला, जो बड़ा सितारा बनने का इंतज़ार कर रहा है।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514074
    m_Localized: डोनट के लिए दांव बढ़ाती आटे की पट्टी।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514075
    m_Localized: ऐसा आटा जिसे कभी दोबारा भरने की ज़रूरत नहीं।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514076
    m_Localized: बाज़ जैसी नज़र और बैज के आकार की कुकी से कैफ़े में अनुशासन रखता है।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514077
    m_Localized: नन्ही बेरी, थोड़ी उदास पर स्वाद में लाजवाब।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514078
    m_Localized: बाहर से रोएँदार, अंदर से चमकीला हरा।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514079
    m_Localized: आकार में कटा कीवी, अब भी चमकता हरा।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514080
    m_Localized: सुनहरे अंदाज़ वाली उष्णकटिबंधीय प्यारी।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514081
    m_Localized: ऊपर सजने को तैयार अनानास की स्लाइसें।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514082
    m_Localized: लाल, पका हुआ और रोकना बेहद मुश्किल।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514083
    m_Localized: बेहद पतली स्लाइसें, भरपूर आकर्षण के साथ।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514084
    m_Localized: कूल ब्लूज़ वाली चमकदार परत।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514085
    m_Localized: भूरा, चमकदार और बेझिझक चॉकलेट का दीवाना।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514086
    m_Localized: गुलाबी में खूबसूरत, हर कौर में मीठी।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514087
    m_Localized: सादी सफ़ेद ग्लेज़, जिसमें छिपी है वनीला की गहराई।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514088
    m_Localized: जमे हुए क्यूब जो हर पेय को ठंडा रखें।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514089
    m_Localized: दुनिया को बताओ कि फ़्रॉस्टिंग कहाँ है। ग्लेज़्ड और गर्व से भरा।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514090
    m_Localized: हम जो कुछ भी बेचते हैं उसकी सूची। ज़्यादातर डोनट। ठीक है, सिर्फ़ डोनट।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514091
    m_Localized: कड़वी कॉफ़ी के लिए मलाईदार सफ़ेद सुलहकर्ता।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514092
    m_Localized: नकली ग्लेज़ को संतुलित करने के लिए असली हरियाली। प्रकृति के अपने स्प्रिंकल्स।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514093
    m_Localized: मिठास में थोड़ा ढांचा। ये गमले कोई मज़ाक नहीं।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514094
    m_Localized: छत पर इतना बड़ा डोनट कि देखकर ही चिड़ियों को शुगर रश हो जाए।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514095
    m_Localized: छत की उत्कृष्ट कृति के लिए एक्स्ट्रा स्प्रिंकल्स। सिर्फ़ ग्लेज़ काफ़ी नहीं।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514096
    m_Localized: फ़ैशनेबल ख़ुशबू के साथ आती है और हर कॉफ़ी ब्रेक को जश्न बना देती है।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514097
    m_Localized: छोटे रंग-बिरंगे टुकड़े जो हर जगह ख़ुशी बिखेरते हैं।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514098
    m_Localized: आपात के लिए बलूत साथ रखती है और हर लाटे को उसके झाग से परखती है।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514099
    m_Localized: स्प्रिंकल्स खाते हुए पैर झुलाने के लिए एकदम सही ऊँचाई।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514100
    m_Localized: छत की उत्कृष्ट कृति के लिए एक्स्ट्रा स्प्रिंकल्स। सिर्फ़ ग्लेज़ काफ़ी नहीं।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514101
    m_Localized: एक खुशमिज़ाज शरारती, जो न जाने कैसे पत्तों से एकदम सही छुट्टे देता है।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514102
    m_Localized: फलों को मुलायम और आज्ञाकारी बना देता है।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514103
    m_Localized: जहाँ फलों को मिलता है ज़िंदगी का एक टुकड़ा।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514104
    m_Localized: फलियों को तरल सुबह की ऊर्जा में बदल देता है।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514105
    m_Localized: बैटर को सुनहरी, केक वाली ख़ुशी में बदल देता है।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514106
    m_Localized: आटे को तलता है जब तक वह कमाल का न हो जाए।
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514107
    m_Localized: पार्टी गुब्बारे
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514108
    m_Localized: मीठा विस्तार
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514109
    m_Localized: ब्रूस्टर बीवर
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514110
    m_Localized: हरे पंखों वाला पक्षी कूरियर
    m_Metadata:
      m_Items: []
