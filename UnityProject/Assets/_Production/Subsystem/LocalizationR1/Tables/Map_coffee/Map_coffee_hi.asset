      m_Items: []
  - m_Id: 57788192514158
    m_Localized: आरामदायक स्टूल
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514159
    m_Localized: मेज़ की सजावट
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514160
    m_Localized: टोबी तनुकी
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514161
    m_Localized: ब्लेंडर
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514162
    m_Localized: कटिंग बोर्ड
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514163
    m_Localized: कॉफ़ी मेकर
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514164
    m_Localized: ओवन
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514165
    m_Localized: फ्राइंग पैन
    m_Metadata:
      m_Items: []
  - m_Id: 3010518569705472
    m_Localized: फल कुछ ही सेकंड में मुलायम होकर हार मान लेते हैं।
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259904
    m_Localized: फलों का बवंडर। ढक्कन लगाना ज़रूर सुझाया जाता है।
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259905
    m_Localized: ज़िंदगी का टुकड़ा, बस और तेज़।
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259906
    m_Localized: स्ट्रॉबेरी सोचते-सोचते कट जाती हैं। कीवी काँप उठते हैं।
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259907
    m_Localized: सुबह की प्रेरणा, और भी तेज़ी से तैयार।
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259908
    m_Localized: इतनी तेज़ बनती है कि ग्राहक चुस्की से पहले ही जाग जाते हैं।
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259909
    m_Localized: पलक झपकते सुनहरी खुशियाँ बेक करता है।
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259910
    m_Localized: कपकेक बिजली की रफ़्तार से फूलकर मौक़े पर खरे उतरते हैं।
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259911
    m_Localized: आटा बहुत जल्दी सुनहरा हो जाता है।
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259912
    m_Localized: डोनट अफ़रा-तफ़री की रफ़्तार से तले जाते हैं। पूरा पैन-डेमोनियम!
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259913
    m_Localized: टर्बो ब्लेंडर
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259914
    m_Localized: स्मूदी टॉरनेडो
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259915
    m_Localized: फुर्तीला स्लाइसर
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454208
    m_Localized: फ़्रूट निंजा बोर्ड
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454209
    m_Localized: क्विक-ब्रू मेकर
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454210
    m_Localized: बरिस्ता रॉकेट
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454211
    m_Localized: हॉट शॉट ओवन
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454212
    m_Localized: ब्लेज़ ओवन
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454213
    m_Localized: स्पीडी पैन
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454214
    m_Localized: पैन-डेमोनियम
    m_Metadata:
      m_Items: []
  - m_Id: 8069150969683968
    m_Localized: फल अंदर, स्मूदी का तूफ़ान बाहर।
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541568
    m_Localized: स्मूदी तूफ़ान
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541569
    m_Localized: इतना तेज़ ब्लेंड करे कि समय मुड़ जाए। ब्रेन फ़्रीज़ मुफ़्त।
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541570
    m_Localized: गैलेक्सी ब्लेंडर
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541571
    m_Localized: कीवी लुढ़कने से पहले ही कट जाते हैं।
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541572
    m_Localized: समुराई फ्रूट बोर्ड
    m_Metadata:
      m_Items: []
  - m_Id: 8069151078735872
    m_Localized: एक वार, पूरा फ्रूट सलाद।
    m_Metadata:
      m_Items: []
  - m_Id: 8069151078735873
    m_Localized: लीजेंडरी फ्रूट ब्लेड
    m_Metadata:
      m_Items: []
  - m_Id: 8069151078735874
    m_Localized: जेट की रफ़्तार से कॉफ़ी। अपना मग कसकर पकड़िए।
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318784
    m_Localized: एस्प्रेसो जेट
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318785
    m_Localized: आपकी पलक झपकने से पहले परफ़ेक्ट कप तैयार।
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318786
    m_Localized: लीजेंडरी ब्रू इंजन
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318787
    m_Localized: कपकेक पल भर में बेक। ख़ुशबू जन्नत जैसी।
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318788
    m_Localized: इन्फ़र्नो ओवन
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318789
    m_Localized: तारे जितना गर्म। पेस्ट्री चमकती हुई निकलती है।
    m_Metadata:
      m_Items: []
  - m_Id: 8069151095513088
    m_Localized: लीजेंडरी स्टार ओवन
    m_Metadata:
      m_Items: []
  - m_Id: 8069151095513089
    m_Localized: डोनट्स ख़ुशी के मारे ख़ुद ही पलट जाते हैं।
    m_Metadata:
      m_Items: []
  - m_Id: 8069151095513090
    m_Localized: पैन-टास्टिक टर्बो
    m_Metadata:
      m_Items: []
  - m_Id: 8069151095513091
    m_Localized: रिकॉर्ड रफ़्तार से सुनहरे छल्ले। शुद्ध डोनट जादू।
    m_Metadata:
      m_Items: []
  - m_Id: 8069151095513092
    m_Localized: लीजेंडरी डोनट पैन
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
