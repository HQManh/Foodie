  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Map_coffee_de-DE
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: de-DE
  m_SharedData: {fileID: 11400000, guid: 2792ae1db3f1fd44c88392405a58a65e, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 57788163153920
    m_Localized: Weil jeder Donut eine Feier verdient. Schwebende Zucker-Vibes.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514048
    m_Localized: Der Anfang von etwas Süßem. Nur Mehl, Wasser und jede Menge Ehrgeiz.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514049
    m_Localized: Mehr Glasur, mehr Platz. Wir lassen den Teig gehen, um das Dach zu heben.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514050
    m_Localized: Erkennt einen starken Kaffee schneller als einen fallenden Baum.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514051
    m_Localized: Liefert Kaffee in Flügeltempo und hält jede Feder blitzsauber.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514052
    m_Localized: Ein eleganter Café-Chef, für den Milchschaumkunst ernstes Geschäft ist.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514053
    m_Localized: Lehn dich zurück, entspann dich und lass das Zuckerkoma langsam kommen.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514054
    m_Localized: Kleine Bohne, große Pläne, alle aufzuwecken.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514055
    m_Localized: Bohnen, die vom Leben zermahlen wurden.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514056
    m_Localized: Bricht Café-Regeln, trinkt kräftige Röstungen und muht niemals leise.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514057
    m_Localized: Fluffige Wolken, die immer über sich hinauswachsen.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514058
    m_Localized: Creme mit einer reichhaltigen, kakaobefeuerten dunklen Seite.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514059
    m_Localized: Ein leerer Becher, der cool bleibt.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514060
    m_Localized: Kaffee, serviert mit kühlem Gemüt.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514061
    m_Localized: Eiskaffee, schick gemacht zum Angeben.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514062
    m_Localized: Noch leer, aber er hält Hitze aus.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514063
    m_Localized: Dampfender Kaffee mit starker Persönlichkeit.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514064
    m_Localized: Wo Kaffee und Milch sich endlich ihre Liebe gestehen.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514065
    m_Localized: Ein kleiner Kuchen, der seiner Tasse nie entwachsen ist.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514066
    m_Localized: Ein Cupcake, der mit seinen süßen Toppings angibt.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514067
    m_Localized: Teig bereit – dieser Kuchen muss in den Ofen.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514068
    m_Localized: Über Eis gegossen für Gäste, die nie langsamer werden.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514069
    m_Localized: Aufgeschäumt, eingegossen und serviert, bevor sich der Schaum setzt.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514070
    m_Localized: Ein kleiner Kuchen mit viel zu viel Frosting – mit Absicht.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514071
    m_Localized: Frisch getaucht – die Glasur überlegt noch, wohin sie tropft.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514072
    m_Localized: Süßer Ring mit jeder Menge Charme.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514073
    m_Localized: Ein Teigring, der darauf wartet, der große Wurf zu werden.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514074
    m_Localized: Ein Teigriegel, der die Messlatte für Donuts höher legt.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514075
    m_Localized: Teig, der nie nachgefüllt werden muss.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514076
    m_Localized: Hält das Café mit Adleraugen und einem Keks in Abzeichenform in Ordnung.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514077
    m_Localized: Kleine Beere, etwas blau drauf, aber köstlich.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514078
    m_Localized: Außen flauschig, innen strahlend grün.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514079
    m_Localized: Kiwi auf Größe geschnitten, immer noch leuchtend grün.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514080
    m_Localized: Tropischer Schatz mit goldener Einstellung.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514081
    m_Localized: Ananasscheiben, bereit für ganz oben.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514082
    m_Localized: Rot, reif und beeren-schwer zu widerstehen.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514083
    m_Localized: Beerendünne Scheiben mit maximalem Charme.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514084
    m_Localized: Ein glänzender Überzug mit coolem Blues.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514085
    m_Localized: Braun, glänzend und ganz ungeniert schokosüchtig.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514086
    m_Localized: Hübsch in Rosa, süß in jedem Bissen.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514087
    m_Localized: Schlichte weiße Glasur mit verborgener Vanilletiefe.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514088
    m_Localized: Gefrorene Würfel, die jedes Getränk cool halten.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514089
    m_Localized: Zeig der Welt, wo das Frosting ist. Glasiert und stolz.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514090
    m_Localized: Eine Liste von allem, was wir verkaufen. Meist Donuts. Okay, nur Donuts.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514091
    m_Localized: Cremig-weißer Friedensstifter für bitteren Kaffee.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514092
    m_Localized: Echtes Grün als Ausgleich zur künstlichen Glasur. Die Streusel der Natur.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514093
    m_Localized: Etwas Struktur für den Zucker. Diese Töpfe meinen es ernst.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514094
    m_Localized: Ein Dach-Donut so groß, dass selbst Vögel beim Hinsehen einen Zuckerschock bekommen.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514095
    m_Localized: Extra Streusel für das Dach-Meisterwerk. Glasur allein reicht nicht.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514096
    m_Localized: Kommt modisch duftend an und macht jede Kaffeepause zur Gala.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514097
    m_Localized: Kleine bunte Stückchen, die überall Freude verstreuen.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514098
    m_Localized: Trägt Notfall-Eicheln bei sich und beurteilt jeden Latte nach seinem Schaum.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514099
    m_Localized: Die perfekte Höhe, um mit den Beinen zu baumeln und Streusel zu naschen.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514100
    m_Localized: Extra Streusel für das Dach-Meisterwerk. Glasur allein reicht nicht.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514101
    m_Localized: Ein fröhlicher Schelm, der irgendwie mit Blättern und passendem Kleingeld bezahlt.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514102
    m_Localized: Mixt Obst zu glatter Unterwerfung.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514103
    m_Localized: Wo Obst sein Stück vom Leben abbekommt.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514104
    m_Localized: Brüht Bohnen zu flüssiger Morgenmotivation.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514105
    m_Localized: Backt Teig zu goldenem Kuchenglück.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514106
    m_Localized: Brät Teig, bis er pfannen-tastisch ist.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514107
    m_Localized: Partyballons
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514108
    m_Localized: Süße Erweiterung
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514109
    m_Localized: Braumeister Biber
    m_Metadata:
      m_Items: []
