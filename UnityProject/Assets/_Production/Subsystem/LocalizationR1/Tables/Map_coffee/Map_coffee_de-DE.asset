  - m_Id: 57788192514162
    m_Localized: Schneidebrett
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514163
    m_Localized: Kaffeemaschine
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514164
    m_Localized: Ofen
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514165
    m_Localized: Bratpfanne
    m_Metadata:
      m_Items: []
  - m_Id: 3010518569705472
    m_Localized: Obst ergibt sich in Sekunden der Geschmeidigkeit.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259904
    m_Localized: Ein fruchtiger Wirbelwind. Deckel dringend empfohlen.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259905
    m_Localized: Das Stück vom Leben, nur schneller.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259906
    m_Localized: Erdbeeren werden mitten im Gedanken geschnitten. Kiwis zittern.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259907
    m_Localized: Morgenmotivation, noch schneller gebrüht.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259908
    m_Localized: Brüht so schnell, dass die Gäste vor dem ersten Schluck wach sind.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259909
    m_Localized: Backt goldenes Glück im Handumdrehen.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259910
    m_Localized: Cupcakes gehen mit Blitzgeschwindigkeit auf.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259911
    m_Localized: Der Teig wird viel schneller goldbraun.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259912
    m_Localized: Donuts braten in chaotischem Tempo. Reines Pfannen-Chaos!
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259913
    m_Localized: Turbo-Mixer
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259914
    m_Localized: Smoothie-Tornado
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259915
    m_Localized: Flinker Schneider
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454208
    m_Localized: Frucht-Ninja-Brett
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454209
    m_Localized: Schnellbrüh-Maschine
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454210
    m_Localized: Barista-Rakete
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454211
    m_Localized: Hot-Shot-Ofen
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454212
    m_Localized: Blaze-Ofen
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454213
    m_Localized: Flinke Pfanne
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454214
    m_Localized: Pfannen-Chaos
    m_Metadata:
      m_Items: []
  - m_Id: 8069150969683968
    m_Localized: Obst rein, Smoothie-Sturm raus.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541568
    m_Localized: Smoothie-Hurrikan
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541569
    m_Localized: Mixt so schnell, dass es die Zeit verbiegt. Hirnfrost inklusive.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541570
    m_Localized: Galaxie-Mixer
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541571
    m_Localized: Kiwis sind geschnitten, bevor sie wegrollen können.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541572
    m_Localized: Samurai-Obstbrett
    m_Metadata:
      m_Items: []
  - m_Id: 8069151078735872
    m_Localized: Ein Schwung, ein ganzer Obstsalat.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151078735873
    m_Localized: Legendäre Obstklinge
    m_Metadata:
      m_Items: []
  - m_Id: 8069151078735874
    m_Localized: Kaffee in Jet-Geschwindigkeit. Halt deine Tasse fest.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318784
    m_Localized: Espresso-Jet
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318785
    m_Localized: Brüht eine perfekte Tasse, bevor du fertig geblinzelt hast.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318786
    m_Localized: Legendäre Brühmaschine
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318787
    m_Localized: Cupcakes backen im Herzschlag. Riecht himmlisch.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318788
    m_Localized: Inferno-Ofen
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318789
    m_Localized: Heiß wie ein Stern. Das Gebäck kommt strahlend heraus.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151095513088
    m_Localized: Legendärer Sternenofen
    m_Metadata:
      m_Items: []
  - m_Id: 8069151095513089
    m_Localized: Donuts wenden sich vor lauter Aufregung selbst.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151095513090
    m_Localized: Pfannen-tastischer Turbo
    m_Metadata:
      m_Items: []
  - m_Id: 8069151095513091
    m_Localized: Goldene Ringe in Rekordzeit. Pure Donut-Magie.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151095513092
    m_Localized: Legendäre Donut-Pfanne
    m_Metadata:
      m_Items: []
