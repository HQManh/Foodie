  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Map_coffee_sv
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: sv
  m_SharedData: {fileID: 11400000, guid: 2792ae1db3f1fd44c88392405a58a65e, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 57788163153920
    m_Localized: För varje munk förtjänar en fest. Svävande sockervibbar.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514048
    m_Localized: Början på något sött. Bara mjöl, vatten och massor av ambition.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514049
    m_Localized: Mer glasyr, mer plats. Vi jäser degen för att höja taket.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514050
    m_Localized: Känner igen ett starkt kaffe snabbare än ett fallande träd.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514051
    m_Localized: Levererar kaffe i vingfart och håller varje fjäder fläckfri.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514052
    m_Localized: En elegant kafébas som ser mjölkskumskonst som seriös business.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514053
    m_Localized: Luta dig tillbaka, slappna av och låt sockerkomat ta över sakta.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514054
    m_Localized: Liten böna, stora planer på att väcka alla.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514055
    m_Localized: Bönor som livet har malt ner.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514056
    m_Localized: Bryter mot kaféreglerna, dricker mörkrost och råmar aldrig tyst.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514057
    m_Localized: Fluffiga moln som alltid växer med uppgiften.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514058
    m_Localized: Kräm med en fyllig, kakaodriven mörk sida.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514059
    m_Localized: En tom mugg som håller sig cool.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514060
    m_Localized: Kaffe serverat med ett kyligt lynne.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514061
    m_Localized: Iskaffe uppklätt för att visa upp sig.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514062
    m_Localized: Tom nu, men den tål värme.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514063
    m_Localized: Rykande kaffe med stark personlighet.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514064
    m_Localized: Där kaffe och mjölk äntligen bekänner sin kärlek.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514065
    m_Localized: En liten kaka som aldrig växte ur sin form.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514066
    m_Localized: En cupcake som visar upp sina söta toppingar.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514067
    m_Localized: Smeten är klar – den här kakan behöver ugnstid.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514068
    m_Localized: Hälld över is för gästerna som aldrig saktar ner.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514069
    m_Localized: Ångad, hälld och serverad innan skummet sjunker.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514070
    m_Localized: En liten kaka med alldeles för mycket frosting – med flit.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514071
    m_Localized: Nydoppad, så glasyren funderar fortfarande på vart den ska droppa.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514072
    m_Localized: Söt ring med massor av charm.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514073
    m_Localized: En degring som väntar på att bli den stora stjärnan.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514074
    m_Localized: En degbit som höjer insatsen för munkar.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514075
    m_Localized: Deg som aldrig behöver fyllas på.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514076
    m_Localized: Håller ordning på kaféet med örnögon och en kaka formad som en polisbricka.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514077
    m_Localized: Litet bär som känner sig lite blå men smakar underbart.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514078
    m_Localized: Luden utanpå, strålande grön inuti.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514079
    m_Localized: Kiwi skuren i lagom bitar, fortfarande lysande grön.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514080
    m_Localized: Tropisk sötnos med gyllene attityd.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514081
    m_Localized: Ananasskivor redo att hamna överst.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514082
    m_Localized: Röd, mogen och bär-svår att motstå.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514083
    m_Localized: Bärtunna skivor med maximal charm.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514084
    m_Localized: En blank glasyr med sval blues.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514085
    m_Localized: Brun, blank och skamlöst chokladtokig.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514086
    m_Localized: Söt i rosa, söt i varje tugga.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514087
    m_Localized: Enkel vit glasyr med dold vaniljdjup.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514088
    m_Localized: Frysta kuber som håller varje dryck kall.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514089
    m_Localized: Låt världen veta var frostingen finns. Glaserad och stolt.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514090
    m_Localized: En lista över allt vi säljer. Mest munkar. Okej, bara munkar.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514091
    m_Localized: Krämig vit fredsmäklare för beskt kaffe.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514092
    m_Localized: Äkta grönska som balanserar den konstgjorda glasyren. Naturens eget strössel.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514093
    m_Localized: Lite struktur åt sockret. De här krukorna menar allvar.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514094
    m_Localized: En takmunk så stor att till och med fåglarna får sockerchock bara av att titta.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514095
    m_Localized: Extra strössel till takets mästerverk. Glasyr räcker inte.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514096
    m_Localized: Kommer moderiktigt doftande och gör varje kaffepaus till en gala.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514097
    m_Localized: Små färgglada bitar som strör glädje överallt.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514098
    m_Localized: Bär på nödekollon och bedömer varje latte efter skummet.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514099
    m_Localized: Perfekt höjd för att dingla med benen medan du äter strössel.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514100
    m_Localized: Extra strössel till takets mästerverk. Glasyr räcker inte.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514101
    m_Localized: En glad skojare som på något sätt betalar med löv och jämna pengar.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514102
    m_Localized: Mixar frukt till len underkastelse.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514103
    m_Localized: Där frukten får sin bit av livet.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514104
    m_Localized: Brygger bönor till flytande morgonmotivation.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514105
    m_Localized: Bakar smet till gyllene kaklycka.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514106
    m_Localized: Steker degen tills den blir stekpanne-tastisk.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514107
    m_Localized: Festballonger
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514108
    m_Localized: Söt utbyggnad
    m_Metadata:
      m_Items: []
