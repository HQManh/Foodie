  - m_Id: 57788192514165
    m_Localized: Stekpanna
    m_Metadata:
      m_Items: []
  - m_Id: 3010518569705472
    m_Localized: Frukten ger upp och blir len på några sekunder.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259904
    m_Localized: En fruktig virvelvind. Lock rekommenderas starkt.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259905
    m_Localized: Livets skiva, fast snabbare.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259906
    m_Localized: Jordgubbar skivas mitt i en tanke. Kiwin darrar.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259907
    m_Localized: Morgonmotivation, bryggd ännu snabbare.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259908
    m_Localized: Bryggar så snabbt att kunderna vaknar innan de tagit en klunk.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259909
    m_Localized: Bakar gyllene lycka på nolltid.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259910
    m_Localized: Cupcakes jäser sig i blixtfart.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259911
    m_Localized: Degen blir gyllene mycket snabbare.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259912
    m_Localized: Donuts steks i kaotisk fart. Rent panne-demonium!
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259913
    m_Localized: Turbo-mixer
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259914
    m_Localized: Smoothie-tornado
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259915
    m_Localized: Snabb skivare
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454208
    m_Localized: Frukt-ninja-bräde
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454209
    m_Localized: Snabbryggare
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454210
    m_Localized: Barista-raket
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454211
    m_Localized: Hot Shot-ugn
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454212
    m_Localized: Blaze-ugn
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454213
    m_Localized: Snabb stekpanna
    m_Metadata:
      m_Items: []
  - m_Id: 3010518607454214
    m_Localized: Panne-demonium
    m_Metadata:
      m_Items: []
  - m_Id: 8069150969683968
    m_Localized: In med frukt, ut med en smoothiestorm.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541568
    m_Localized: Smoothieorkan
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541569
    m_Localized: Mixar så snabbt att tiden böjs. Hjärnfrys ingår.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541570
    m_Localized: Galaxmixer
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541571
    m_Localized: Kiwisarna skivas innan de hinner rulla iväg.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541572
    m_Localized: Samurajfruktbräda
    m_Metadata:
      m_Items: []
  - m_Id: 8069151078735872
    m_Localized: Ett hugg, en hel fruktsallad.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151078735873
    m_Localized: Legendarisk fruktklinga
    m_Metadata:
      m_Items: []
  - m_Id: 8069151078735874
    m_Localized: Kaffe i jetfart. Håll i muggen.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318784
    m_Localized: Espressojet
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318785
    m_Localized: Brygger en perfekt kopp innan du hunnit blinka klart.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318786
    m_Localized: Legendarisk bryggmotor
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318787
    m_Localized: Muffins gräddas på ett ögonblick. Doftar himmelskt.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318788
    m_Localized: Infernougn
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318789
    m_Localized: Het som en stjärna. Bakverken kommer ut skinande.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151095513088
    m_Localized: Legendarisk stjärnugn
    m_Metadata:
      m_Items: []
  - m_Id: 8069151095513089
    m_Localized: Munkarna vänder sig själva av ren förtjusning.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151095513090
    m_Localized: Panntastisk turbo
    m_Metadata:
      m_Items: []
  - m_Id: 8069151095513091
    m_Localized: Gyllene ringar i rekordfart. Ren munkmagi.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151095513092
    m_Localized: Legendarisk munkpanna
    m_Metadata:
      m_Items: []
