    m_Metadata:
      m_Items: []
  - m_Id: 57788192514157
    m_Localized: 헤이즐 다람쥐
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514158
    m_Localized: 아늑한 스툴
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514159
