    m_Metadata:
      m_Items: []
  - m_Id: 8069150969683968
    m_Localized: Buah masuk, ribut smoothie keluar.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541568
    m_Localized: Taufan Smoothie
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541569
    m_Localized: Mengisar begitu laju hingga masa melentur. Termasuk otak beku.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541570
    m_Localized: Pengisar Galaksi
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541571
    m_Localized: Kiwi sudah dihiris sebelum sempat bergolek.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151074541572
    m_Localized: Papan Buah Samurai
    m_Metadata:
      m_Items: []
  - m_Id: 8069151078735872
    m_Localized: Satu hayunan, satu salad buah penuh.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151078735873
    m_Localized: Pisau Buah Legenda
    m_Metadata:
      m_Items: []
  - m_Id: 8069151078735874
    m_Localized: Kopi selaju jet. Pegang kuat mug anda.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318784
    m_Localized: Jet Espresso
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318785
    m_Localized: Membancuh secawan sempurna sebelum anda habis berkelip.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318786
    m_Localized: Enjin Bancuh Legenda
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318787
    m_Localized: Kek cawan dibakar sekelip mata. Wangi seperti syurga.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318788
    m_Localized: Ketuhar Inferno
    m_Metadata:
      m_Items: []
  - m_Id: 8069151091318789
    m_Localized: Panas seperti bintang. Pastri keluar bersinar.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151095513088
    m_Localized: Ketuhar Bintang Legenda
    m_Metadata:
      m_Items: []
  - m_Id: 8069151095513089
    m_Localized: Donut terbalik sendiri kerana terlalu teruja.
    m_Metadata:
      m_Items: []
  - m_Id: 8069151095513090
    m_Localized: Kuali Turbo Hebat
    m_Metadata:
      m_Items: []
