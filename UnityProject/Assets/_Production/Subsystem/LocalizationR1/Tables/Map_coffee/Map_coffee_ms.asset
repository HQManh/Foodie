  - m_Id: 57788192514164
    m_Localized: Ketuhar
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514165
    m_Localized: Kuali
    m_Metadata:
      m_Items: []
  - m_Id: 3010518569705472
    m_Localized: Buah menyerah menjadi licin dalam beberapa saat.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259904
    m_Localized: Pusaran buah-buahan. Sangat disyorkan menggunakan penutup.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259905
    m_Localized: Hirisan kehidupan, cuma lebih pantas.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259906
    m_Localized: Strawberi dihiris di tengah-tengah berfikir. Kiwi menggigil.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259907
    m_Localized: Semangat pagi, diseduh lebih pantas lagi.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259908
    m_Localized: Menyeduh begitu pantas sehingga pelanggan terjaga sebelum menghirup.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259909
    m_Localized: Membakar kebahagiaan keemasan dalam sekelip mata.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259910
    m_Localized: Kek cawan naik dengan pantas bagai kilat.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259911
    m_Localized: Doh menjadi keemasan jauh lebih cepat.
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259912
    m_Localized: Donat digoreng dengan kelajuan huru-hara. Kekecohan kuali sepenuhnya!
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259913
    m_Localized: Pengisar Turbo
    m_Metadata:
      m_Items: []
  - m_Id: 3010518603259914
    m_Localized: Puting Beliung Smoothie
    m_Metadata:
