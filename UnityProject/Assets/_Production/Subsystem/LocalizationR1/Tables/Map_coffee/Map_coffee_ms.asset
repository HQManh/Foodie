  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Map_coffee_ms
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: ms
  m_SharedData: {fileID: 11400000, guid: 2792ae1db3f1fd44c88392405a58a65e, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 57788163153920
    m_Localized: Kerana setiap donat layak diraikan. Suasana manis yang terapung.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514048
    m_Localized: Permulaan sesuatu yang manis. Hanya tepung, air dan banyak cita-cita.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514049
    m_Localized: Lebih sayut, lebih ruang. Kami naikkan doh untuk menaikkan bumbung.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514050
    m_Localized: Boleh mengenal kopi pekat lebih pantas daripada pokok tumbang.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514051
    m_Localized: Menghantar kopi sepantas kepakan sayap sambil memastikan setiap bulu bersih.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514052
    m_Localized: Bos kafe yang kemas, menganggap seni buih kopi urusan serius.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514053
    m_Localized: Bersandar, bersantai dan biarkan rasa manis mengantuk datang perlahan.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514054
    m_Localized: Biji kecil, rancangan besar untuk mengejutkan semua orang.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514055
    m_Localized: Biji yang dikisar oleh kehidupan.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514056
    m_Localized: Melanggar peraturan kafe, minum kopi pekat dan tidak pernah menguak perlahan.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514057
    m_Localized: Awan gebu yang sentiasa bangkit apabila diperlukan.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514058
    m_Localized: Krim dengan sisi gelap yang kaya koko.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514059
    m_Localized: Cawan kosong yang kekal tenang.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514060
    m_Localized: Kopi yang dihidang dengan sikap dingin.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514061
    m_Localized: Kopi ais yang berdandan untuk menunjuk-nunjuk.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514062
    m_Localized: Kosong sekarang, tapi tahan panas.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514063
    m_Localized: Minuman berasap dengan personaliti yang kuat.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514064
    m_Localized: Tempat kopi dan susu akhirnya meluahkan cinta.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514065
    m_Localized: Kek kecil yang tidak pernah membesar melepasi cawannya.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514066
    m_Localized: Kek cawan yang menunjuk-nunjuk hiasan manisnya.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514067
    m_Localized: Adunan sedia, kek ini perlu masuk ketuhar.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514068
    m_Localized: Dituang ke atas ais untuk pelanggan yang tidak pernah perlahan.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514069
    m_Localized: Dikukus, dituang dan dihidang sebelum buihnya turun.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514070
    m_Localized: Kek kecil yang sengaja memakai terlalu banyak krim.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514071
    m_Localized: Baru dicelup, sayutnya masih memikirkan ke mana hendak menitis.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514072
    m_Localized: Gelang manis dengan daya tarikan yang melimpah.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514073
    m_Localized: Gelang doh yang menunggu untuk menjadi bintang utama.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514074
    m_Localized: Bar doh yang menaikkan taruhan untuk donat.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514075
    m_Localized: Doh yang tidak pernah perlu diisi semula.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514076
    m_Localized: Menjaga ketenteraman kafe dengan mata helang dan biskut berbentuk lencana.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514077
    m_Localized: Beri kecil yang sedang murung tapi rasanya hebat.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514078
    m_Localized: Berbulu di luar, hijau terang di dalam.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514079
    m_Localized: Kiwi dipotong kecil, masih hijau berkilat.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514080
    m_Localized: Kekasih tropika dengan sikap keemasan.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514081
    m_Localized: Hirisan nanas sedia diletak di atas.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514082
    m_Localized: Merah, masak dan sukar ditolak.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514083
    m_Localized: Hirisan nipis dengan daya tarikan maksimum.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514084
    m_Localized: Salutan berkilat dengan warna biru yang cool.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514085
    m_Localized: Perang, berkilat dan penggila coklat tanpa segan.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514086
    m_Localized: Cantik berwarna merah jambu, manis dalam setiap gigitan.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514087
    m_Localized: Sayut putih biasa dengan rasa vanila yang tersembunyi.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514088
    m_Localized: Kiub beku yang memastikan setiap minuman sejuk.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514089
    m_Localized: Beritahu dunia di mana krimnya. Bersayut dan bangga.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514090
    m_Localized: Senarai semua yang kami jual. Kebanyakannya donat. Baiklah, donat sahaja.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514091
    m_Localized: Pendamai putih berkrim untuk kopi pahit.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514092
    m_Localized: Tumbuhan sebenar untuk mengimbangi sayut tiruan. Taburan semula jadi.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514093
    m_Localized: Menambah struktur pada gula. Pasu-pasu ini serius.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514094
    m_Localized: Donat bumbung yang begitu besar, burung pun rasa manis hanya dengan melihatnya.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514095
    m_Localized: Taburan tambahan untuk karya agung di bumbung. Sayut sahaja tidak cukup.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514096
    m_Localized: Tiba dengan wangian bergaya dan menjadikan setiap rehat kopi satu gala.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514097
    m_Localized: Cebisan kecil berwarna-warni yang menaburkan kegembiraan di mana-mana.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514098
    m_Localized: Membawa biji oak kecemasan dan menilai setiap latte berdasarkan buihnya.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514099
    m_Localized: Ketinggian sempurna untuk menghayun kaki sambil makan taburan warna.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514100
    m_Localized: Taburan tambahan untuk karya agung di bumbung. Sayut sahaja tidak cukup.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514101
    m_Localized: Si nakal yang ceria, entah bagaimana membayar dengan daun dan wang cukup-cukup.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514102
    m_Localized: Mengisar buah hingga licin dan akur.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514103
    m_Localized: Tempat buah mendapat hirisan kehidupan.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514104
    m_Localized: Membancuh biji kopi menjadi motivasi pagi dalam bentuk cecair.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514105
    m_Localized: Membakar adunan menjadi kebahagiaan kek keemasan.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514106
    m_Localized: Menggoreng doh sehingga jadi kuali-tastik.
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514107
