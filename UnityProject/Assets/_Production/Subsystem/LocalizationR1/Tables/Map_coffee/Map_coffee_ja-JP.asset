  - m_Id: 57788192514139
    m_Localized: パイナップル
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514140
    m_Localized: スライスパイナップル
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514141
    m_Localized: いちご
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514142
    m_Localized: スライスいちご
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514143
    m_Localized: ブルーグレーズ
    m_Metadata:
