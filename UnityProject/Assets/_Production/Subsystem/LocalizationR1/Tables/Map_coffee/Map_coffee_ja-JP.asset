    m_Localized: ドーナツ生地
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514133
    m_Localized: 生地バー
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514134
    m_Localized: 無限の生地
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514135
    m_Localized: イーグル署長
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514136
    m_Localized: ブルーベリー
    m_Metadata:
      m_Items: []
  - m_Id: 57788192514137
