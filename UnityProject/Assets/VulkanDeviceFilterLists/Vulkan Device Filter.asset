%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!1740304944 &1740304944
VulkanDeviceFilterLists:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_Name: Vulkan Device Filter
  m_VulkanAllowFilterList: []
  m_VulkanDenyFilterList:
  - vendorName: ARM
    deviceName: ^Mali-T.*
    brandName:
    productName:
    androidOsVersionString:
    vulkanApiVersionString:
    driverVersionString:
  - vendorName: ARM
    deviceName: ^Mali-G(31|51|52|57).*
    brandName:
    productName:
    androidOsVersionString:
    vulkanApiVersionString:
    driverVersionString:
  - vendorName: Qualcomm
    deviceName: ^Adreno.*(3[0-9]{2}|4[0-9]{2}|50[0-9]|51[0-2]|61[0-2]).*
    brandName:
    productName:
    androidOsVersionString:
    vulkanApiVersionString:
    driverVersionString:
  - vendorName: ^(Imagination.*|PowerVR.*)$
    deviceName: .*(GE8|GM9).*
    brandName:
    productName:
    androidOsVersionString:
    vulkanApiVersionString:
    driverVersionString:
  - vendorName: ^(Imagination.*|PowerVR.*)$
    deviceName: .*BXM.*
    brandName:
    productName:
    androidOsVersionString:
    vulkanApiVersionString:
    driverVersionString:
  - vendorName:
    deviceName:
    brandName:
    productName:
    androidOsVersionString: ^[789](\..*)?$
    vulkanApiVersionString:
    driverVersionString:
  - vendorName:
    deviceName:
    brandName:
    productName:
    androidOsVersionString:
    vulkanApiVersionString: 1.0.999
    driverVersionString:
  m_GfxJobFilterList: []
